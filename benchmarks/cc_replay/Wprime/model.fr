(**********************************************************************************************)
(*                                                                                             *)
(*  Wprime_gen : a W' boson with arbitrary vector and axial-vector couplings to fermions,      *)
(*  plus a massive right-handed neutrino.                                                      *)
(*                                                                                             *)
(*  Extracted from: Z. Sullivan, "Fully differential W' production and decay at NLO in QCD",  *)
(*  arXiv:hep-ph/0207290, Eqs. (1) and (2):                                                    *)
(*                                                                                             *)
(*    L = (1/Sqrt[2]) fbar_i gamma_mu ( g_R E^{i omega} Cos[zeta] V^R_{f_if_j} P_R             *)
(*        + g_L Sin[zeta] V^L_{f_if_j} P_L ) W'^+ f_j  + H.c.                                  *)
(*                                                                                             *)
(*  New particles:                                                                             *)
(*    Wp  : charged vector boson W' (Q = +1), mass MWp                                         *)
(*    NR  : right-handed neutrino (Q = 0), mass MNR (paper: "the mass of the right-handed      *)
(*          neutrino nu_R", single kinematic condition MNR < MWp)                              *)
(*                                                                                             *)
(*  Benchmark values (paper): m_Wp = 500 GeV ("a typical mass"), g_R = g_L = 0.6531              *)
(*  (g^2 = 8 m_W^2 G_F/Sqrt[2] with m_W = 80.4 GeV, G_F = 1.16639*10^-5), zeta = 0               *)
(*  (pure right-handed W'_R), omega = 0, V^R = V^L = V'_CKM (Eq.(ckm), |V'_{tb}| = 1),          *)
(*  V'_{l nu} = identity. W' width default: paper Table 3, 500 GeV, quark+lepton decays open:   *)
(*  Gamma_NLO = 16.701 GeV. m_nu_R = 250 GeV (free choice; paper's open-channel condition       *)
(*  m_nu_R < m_Wp).                                                                             *)
(*                                                                                             *)
(*  NOTE: this FeynRules version contains a LaHaC (LHC Higgs cross-section) UFO writer   *)
(*  bug for models with a new charged vector boson: it emits a malformed (unevaluated)    *)
(*  `lhacode` class attribute in object_library.py, which makes MadGraph fail the import  *)
(*  with "invalid syntax". The LaHaC output is not part of the model physics (the Feyn-   *)
(*  Rules compile and all four consistency checks pass for this model); the MadGraph      *)
(*  import failure is a toolchain bug, reproducible with a W'-only model, and independent *)
(*  of the nu_R content, the W' width and the PDG codes.                                 *)
(*                                                                                             *)
(**********************************************************************************************)

M$ModelName = "Wprime_gen";

M$Information = {
  Authors      -> {"Benchmark automated extraction"},
  Version      -> "1.0",
  Date         -> "28. 09. 2026",
  Institutions -> {"-"},
  Emails       -> {"-"},
  URLs         -> "arXiv:hep-ph/0207290"
};

M$InteractionOrderHierarchy = {
  {QCD, 1},
  {QED, 2},
  {NP, 1}
};

(* ************************** *)
(* ***** Parameters  ****** *)
(* ************************** *)

M$Parameters = {

  (* External parameters: the W' couplings, mixing and phase, Eq.(2) *)

  gRp == {
    ParameterType    -> External,
    BlockName        -> WPRIME,
    OrderBlock       -> 1,
    Value            -> 0.6531,
    InteractionOrder -> {NP, 1},
    TeX              -> "g_R",
    Description      -> "Right-handed gauge coupling g_R, Eq.(2)"
  },
  gLP == {
    ParameterType    -> External,
    BlockName        -> WPRIME,
    OrderBlock       -> 2,
    Value            -> 0.6531,
    InteractionOrder -> {NP, 1},
    TeX              -> "g_L",
    Description      -> "Left-handed gauge coupling g_L, Eq.(2)"
  },
  zeta == {
    ParameterType    -> External,
    BlockName        -> WPRIME,
    OrderBlock       -> 3,
    Value            -> 0.,
    InteractionOrder -> {NP, 1},
    TeX              -> "\[Zeta]",
    Description      -> "Left-right mixing angle zeta, Eq.(2)"
  },
  omega == {
    ParameterType    -> External,
    BlockName        -> WPRIME,
    OrderBlock       -> 4,
    Value            -> 0.,
    InteractionOrder -> {NP, 1},
    TeX              -> "\[Omega]",
    Description      -> "CP-violating phase omega, absorbable into V^R, Eq.(2)"
  },

  (* External parameters: the generalized CKM (GCKM) matrices, Eqs.(1)-(2).
     Quark GCKM benchmark: V'_CKM, Eq.(ckm) (average CKM, |V'_{tb}| = 1).
     Lepton GCKM benchmark: identity, text of Sec. 3.1. *)

  WpQqR == {
    ParameterType    -> External,
    BlockName        -> WPRIME,
    OrderBlock       -> 5,
    Indices          -> {Index[Generation], Index[Generation]},
    InteractionOrder -> {NP, 1},
    TeX              -> "V^R_{qq'}",
    Value -> {
      WpQqR[1,1] -> 0.9751, WpQqR[1,2] -> 0.2215, WpQqR[1,3] -> 0.0035,
      WpQqR[2,1] -> 0.2210, WpQqR[2,2] -> 0.9743, WpQqR[2,3] -> 0.0410,
      WpQqR[3,1] -> 0.0090, WpQqR[3,2] -> 0.0400, WpQqR[3,3] -> 1.0000
    },
    Description -> "GCKM matrix V^R for W'-uq-dq; benchmark = V'_CKM, Eq.(ckm)"
  },
  WpQqL == {
    ParameterType    -> External,
    BlockName        -> WPRIME,
    OrderBlock       -> 6,
    Indices          -> {Index[Generation], Index[Generation]},
    InteractionOrder -> {NP, 1},
    TeX              -> "V^L_{qq'}",
    Value -> {
      WpQqL[1,1] -> 0.9751, WpQqL[1,2] -> 0.2215, WpQqL[1,3] -> 0.0035,
      WpQqL[2,1] -> 0.2210, WpQqL[2,2] -> 0.9743, WpQqL[2,3] -> 0.0410,
      WpQqL[3,1] -> 0.0090, WpQqL[3,2] -> 0.0400, WpQqL[3,3] -> 1.0000
    },
    Description -> "GCKM matrix V^L for W'-uq-dq; benchmark = V'_CKM, Eq.(ckm)"
  },
  WpLeR == {
    ParameterType    -> External,
    BlockName        -> WPRIME,
    OrderBlock       -> 7,
    Indices          -> {Index[Generation]},
    InteractionOrder -> {NP, 1},
    TeX              -> "V^R_{l nu}",
    Value -> {
      WpLeR[1] -> 1., WpLeR[2] -> 1., WpLeR[3] -> 1.
    },
    Description -> "Couplings of W' to charged leptons and the right-handed neutrino NR; paper: V'_{l nu} is the identity"
  },
  WpLeL == {
    ParameterType    -> External,
    BlockName        -> WPRIME,
    OrderBlock       -> 8,
    Indices          -> {Index[Generation], Index[Generation]},
    InteractionOrder -> {NP, 1},
    TeX              -> "V^L_{l nu}",
    Value -> {
      WpLeL[1,1] -> 1., WpLeL[1,2] -> 0., WpLeL[1,3] -> 0.,
      WpLeL[2,1] -> 0., WpLeL[2,2] -> 1., WpLeL[2,3] -> 0.,
      WpLeL[3,1] -> 0., WpLeL[3,2] -> 0., WpLeL[3,3] -> 1.
    },
    Description -> "GCKM matrix V^L for W'-l-nu (active neutrinos); benchmark = identity, Sec. 3.1"
  },

  (* Internal parameters *)

  CZ == {
    ParameterType    -> Internal,
    Value            -> Cos[zeta],
    InteractionOrder -> {NP, 1},
    TeX              -> "cos(zeta)",
    Description      -> "Cosine of the left-right mixing angle"
  },
  SZ == {
    ParameterType    -> Internal,
    Value            -> Sin[zeta],
    InteractionOrder -> {NP, 1},
    TeX              -> "sin(zeta)",
    Description      -> "Sine of the left-right mixing angle"
  },
  Eom == {
    ParameterType    -> Internal,
    Value            -> Exp[I omega],
    InteractionOrder -> {NP, 1},
    TeX              -> "e^{i omega}",
    Description      -> "CP phase factor e^{i omega}, Eq.(2)"
  }
};

(* ************************** *)
(* **** Particle classes *** *)
(* ************************** *)

M$ClassesDescription = {

  (* The W' boson: complex charged vector, SM-gauge singlet, Q = +1 *)
  V[100] == {
    ClassName        -> Wp,
    SelfConjugate    -> False,
    Mass             -> {MWp, 500.},
    Width            -> {WWp, 16.7},
    ParticleName     -> "Wp",
    AntiParticleName -> "Wpbar",
    QuantumNumbers   -> {Q -> 1},
    PDG              -> 8901,
    PropagatorLabel  -> "Wp",
    PropagatorType   -> Sine,
    PropagatorArrow  -> Forward,
    FullName         -> "W-prime"
  },

  (* The right-handed neutrino: massive Dirac singlet, Q = 0 *)
  F[100] == {
    ClassName        -> NR,
    SelfConjugate    -> False,
    Mass             -> {MNR, 250.},
    Width            -> 0,
    ParticleName     -> "NR",
    AntiParticleName -> "NRbar",
    QuantumNumbers   -> {Q -> 0, LeptonNumber -> 1},
    PDG              -> 1000022,
    PropagatorLabel  -> "NR",
    PropagatorType   -> Straight,
    PropagatorArrow  -> Forward,
    FullName         -> "Right-handed neutrino"
  }
};

(* ************************** *)
(* ***** Lagrangian  ****** *)
(* ************************** *)

(* Free terms: W' kinetic + mass *)
LWpKin := Block[{mu, nu},
  -1/2 FS[Wpbar, mu, nu] FS[Wp, mu, nu] + MWp^2 Wpbar[mu] Wp[mu]
];

(* Free terms: NR kinetic + mass *)
LNRKin := Block[{mu},
  I NRbar.Ga[mu].DC[NR, mu] - MNR NRbar.NR
];

(* W' - quark interactions, Eq.(2):
   (1/Sqrt[2]) ( g_R e^{i omega} cos(zeta) V^R  ubar gamma_mu P_R d
               + g_L sin(zeta)             V^L  ubar gamma_mu P_L d ) W'^+  + H.c.
   (FeynRules projectors: ProjP = P_R, ProjM = P_L) *)
LWpQuark := Block[{mu, term},
  term = 1/Sqrt[2] (
    gRp Eom CZ WpQqR uqbar.Ga[mu].ProjP.dq +
    gLP SZ    WpQqL uqbar.Ga[mu].ProjM.dq
    ) Wp[mu];
  term + HC[term]
];

(* W' - lepton interactions, Eq.(2):
   (1/Sqrt[2]) ( g_R e^{i omega} cos(zeta) V^R  nu_Rbar gamma_mu P_R l
               + g_L sin(zeta)             V^L  nu_Lbar gamma_mu P_L l ) W'^+  + H.c.
   nu_R is the new right-handed neutrino NR, nu_L the active neutrino vl. *)
LWpLepton := Block[{mu, term},
  term = 1/Sqrt[2] (
    gRp Eom CZ WpLeR NRbar.Ga[mu].ProjP.l +
    gLP SZ    WpLeL vlbar.Ga[mu].ProjM.l
    ) Wp[mu];
  term + HC[term]
];

(* Total Lagrangian: SM + new-physics terms *)
LTotal := LSM + LWpKin + LNRKin + LWpQuark + LWpLepton;
