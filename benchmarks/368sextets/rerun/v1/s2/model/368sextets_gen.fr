(* sigma^{mu nu} = (I/2) [Ga[mu], Ga[nu]] *)
SigMN[mu_, nu_] := I/2 (Ga[mu].Ga[nu] - Ga[nu].Ga[mu]);

(* Clebsch-Gordan coefficients J^{s i a} of the 3 x 6 x 8 invariant, Eq. (A18): *)
(* J^{sia} = -I Sqrt[2] L^{ijk} [T^a]^l_j Kbar^s_{lk}, with Sqrt[2] L^{ijk} = Eps[i,j,k]. *)
(* Built from the FeynRules objects K6bar (3 x 3 -> 6bar) and T (generators of the 3). *)
Jsix[s_, i_, a_] := Module[{jj, kk, ll}, -I Eps[i, jj, kk] T[a, ll, jj] K6bar[s, ll, kk]];

LSextetKin := Block[{mu, sx}, ExpandIndices[ I*Psiubar[sx].Ga[mu].DC[Psiu[sx], mu] - MPsiu Psiubar[sx].Psiu[sx] + I*Psidbar[sx].Ga[mu].DC[Psid[sx], mu] - MPsid Psidbar[sx].Psid[sx] + DC[Phiubar[sx], mu] DC[Phiu[sx], mu] - MPhiu^2 Phiubar[sx] Phiu[sx] + DC[Phidbar[sx], mu] DC[Phid[sx], mu] - MPhid^2 Phidbar[sx] Phid[sx] ]];

LPsiqG0 := Block[{mu, nu, sx, ii, aa, ff}, ExpandIndices[ (kapu[ff]/LamPsiu) Jsix[sx, ii, aa] (CC[uRbar[ff, ii]].SigMN[mu, nu].Psiu[sx]) FS[G, mu, nu, aa] + (kapd[ff]/LamPsid) Jsix[sx, ii, aa] (CC[dRbar[ff, ii]].SigMN[mu, nu].Psid[sx]) FS[G, mu, nu, aa], FlavorExpand -> {Generation}]];

LPsiqGB0 := Block[{mu, nu, sx, ii, aa, ff}, ExpandIndices[ (kapuB[ff]/LamPsiuB^3) Jsix[sx, ii, aa] (CC[uRbar[ff, ii]].Psiu[sx]) FS[B, mu, nu] FS[G, mu, nu, aa] + (kapdB[ff]/LamPsidB^3) Jsix[sx, ii, aa] (CC[dRbar[ff, ii]].Psid[sx]) FS[B, mu, nu] FS[G, mu, nu, aa], FlavorExpand -> {Generation}]];

LPhiqlG0 := Block[{mu, nu, sx, ii, aa, ff, ffl}, ExpandIndices[ (lamu[ffl, ff]/LamPhiu^2) Jsix[sx, ii, aa] Phiu[sx] (CC[uRbar[ff, ii]].SigMN[mu, nu].lR[ffl]) FS[G, mu, nu, aa] + (lamd[ffl, ff]/LamPhid^2) Jsix[sx, ii, aa] Phid[sx] (CC[dRbar[ff, ii]].SigMN[mu, nu].lR[ffl]) FS[G, mu, nu, aa], FlavorExpand -> {Generation}]];

LSextets := LSextetKin + LPsiqG0 + HC[LPsiqG0] + LPsiqGB0 + HC[LPsiqGB0] + LPhiqlG0 + HC[LPhiqlG0];
