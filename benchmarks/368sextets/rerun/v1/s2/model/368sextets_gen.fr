M$InteractionOrderHierarchy = {{QCD, 1}, {QED, 2}, {NP, 3}};

(* Color-sextet fields of arXiv:2110.11359 (Table X):                       *)
(* Phiu ~ (6,1,1/3), Phid ~ (6,1,4/3)   scalars,  L = -1                   *)
(* Psiu ~ (6,1,-2/3), Psid ~ (6,1,1/3)  Dirac fermions, L = 0              *)
(* The sextet index carries the 6 of SU(3)c: the SU3C gauge group of SM.fr *)
(* must list the sextet representation, Representations -> {{T,Colour},    *)
(* {T6,Sextet}}, so that DC[] builds the correct gluon coupling.           *)

IndexRange[Index[Sextet]] = NoUnfold[Range[6]];
IndexStyle[Sextet, sx];

