M$InteractionOrderHierarchy = {{QCD, 1}, {QED, 2}, {NP, 1}};

(* SimpleExtensions add-on for SM.fr: color-sextet scalars and fermions,          *)
(* arXiv:2110.11359 (Carpenter, Murphy, Tait), Eqs. (12), (13) and Table X.       *)
(* The new fields carry Index[Sextet]; SM.fr's SU3C gauge group must include the  *)
(* sextet representation {T6, Sextet} so that DC[] below builds the QCD gauge     *)
(* interactions of Phiu, Phid, Psiu, Psid.                                        *)
(* The Clebsch-Gordan coefficients J^{sia} of Table I are NOT hard-coded in       *)
(* FeynRules. Per Eq. (A18) they are built from objects that are:                 *)
(*   J[s,i,a] = -I Eps[i,j,k] T[a,j,l] K6bar[s,l,k],   using Sqrt[2] L^{ijk} = Eps[i,j,k]. *)

IndexRange[Index[Sextet]] = NoUnfold[Range[6]];
IndexStyle[Sextet, s];

M$Parameters = {
  LamPsiu == {
    ParameterType -> External,
    Value -> 1000.,
    BlockName -> CUTOFF,
    OrderBlock -> 1,
    InteractionOrder -> {QED, -1},
    TeX -> "\\Lambda_{\\Psi_u}",
    Description -> "EFT cutoff [GeV] of the dimension-five up-type sextet fermion - quark - gluon operator, Eq.(12); benchmark 1 TeV"
  },
  LamPsid == {
