    Value -> {lamu[1,1] -> 0.1, lamu[1,2] -> 0., lamu[1,3] -> 0., lamu[2,1] -> 0., lamu[2,2] -> 0.1, lamu[2,3] -> 0., lamu[3,1] -> 0., lamu[3,2] -> 0., lamu[3,3] -> 0.1},
    Indices -> {Index[Generation], Index[Generation]},
    BlockName -> LAMBDAU,
