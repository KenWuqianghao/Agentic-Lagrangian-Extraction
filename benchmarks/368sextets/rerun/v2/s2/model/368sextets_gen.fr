LPhiukin := Block[{mu, ss}, ExpandIndices[DC[Phiubar[ss], mu] DC[Phiu[ss], mu] - MPhiu^2 Phiubar[ss] Phiu[ss]]];

LPhidkin := Block[{mu, ss}, ExpandIndices[DC[Phidbar[ss], mu] DC[Phid[ss], mu] - MPhid^2 Phidbar[ss] Phid[ss]]];

LPsiukin := Block[{mu}, ExpandIndices[I Psiubar.Ga[mu].DC[Psiu, mu] - MPsiu Psiubar.Psiu]];

LPsidkin := Block[{mu}, ExpandIndices[I Psidbar.Ga[mu].DC[Psid, mu] - MPsid Psidbar.Psid]];

LPsiuG := Block[{mu, nu, ff, ii, jj, kk, ll, aa, ss}, Module[{lag}, lag = ExpandIndices[(kapu[ff]/LamPsiu) (-I) Eps[ii, jj, kk] T[aa, jj, ll] K6bar[ss, ll, kk] (I/2) (CC[uRbar[ff, ii]].Ga[mu].Ga[nu].Psiu[ss] - CC[uRbar[ff, ii]].Ga[nu].Ga[mu].Psiu[ss]) FS[G, mu, nu, aa]]; lag + HC[lag]]];

LPsidG := Block[{mu, nu, ff, ii, jj, kk, ll, aa, ss}, Module[{lag}, lag = ExpandIndices[(kapd[ff]/LamPsid) (-I) Eps[ii, jj, kk] T[aa, jj, ll] K6bar[ss, ll, kk] (I/2) (CC[dRbar[ff, ii]].Ga[mu].Ga[nu].Psid[ss] - CC[dRbar[ff, ii]].Ga[nu].Ga[mu].Psid[ss]) FS[G, mu, nu, aa]]; lag + HC[lag]]];

LPsiuB := Block[{mu, nu, ff, ii, jj, kk, ll, aa, ss}, Module[{lag}, lag = ExpandIndices[(kapuB[ff]/LamPsiuB^3) (-I) Eps[ii, jj, kk] T[aa, jj, ll] K6bar[ss, ll, kk] (CC[uRbar[ff, ii]].Psiu[ss]) FS[B, mu, nu] FS[G, mu, nu, aa]]; lag + HC[lag]]];

LPsidB := Block[{mu, nu, ff, ii, jj, kk, ll, aa, ss}, Module[{lag}, lag = ExpandIndices[(kapdB[ff]/LamPsidB^3) (-I) Eps[ii, jj, kk] T[aa, jj, ll] K6bar[ss, ll, kk] (CC[dRbar[ff, ii]].Psid[ss]) FS[B, mu, nu] FS[G, mu, nu, aa]]; lag + HC[lag]]];

LPhiuG := Block[{mu, nu, xx, ff, ii, jj, kk, ll, aa, ss}, Module[{lag}, lag = ExpandIndices[(lamu[xx, ff]/LamPhiu^2) (-I) Eps[ii, jj, kk] T[aa, jj, ll] K6bar[ss, ll, kk] Phiu[ss] (I/2) (CC[uRbar[ff, ii]].Ga[mu].Ga[nu].lR[xx] - CC[uRbar[ff, ii]].Ga[nu].Ga[mu].lR[xx]) FS[G, mu, nu, aa]]; lag + HC[lag]]];

LPhidG := Block[{mu, nu, xx, ff, ii, jj, kk, ll, aa, ss}, Module[{lag}, lag = ExpandIndices[(lamd[xx, ff]/LamPhid^2) (-I) Eps[ii, jj, kk] T[aa, jj, ll] K6bar[ss, ll, kk] Phid[ss] (I/2) (CC[dRbar[ff, ii]].Ga[mu].Ga[nu].lR[xx] - CC[dRbar[ff, ii]].Ga[nu].Ga[mu].lR[xx]) FS[G, mu, nu, aa]]; lag + HC[lag]]];

LNP := LPhiukin + LPhidkin + LPsiukin + LPsidkin + LPsiuG + LPsidG + LPsiuB + LPsidB + LPhiuG + LPhidG;

LSextet := LSM + LNP;
