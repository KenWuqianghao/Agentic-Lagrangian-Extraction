LPsiukin := Block[{mu}, ExpandIndices[I Psiubar.Ga[mu].DC[Psiu, mu] - MPsiu Psiubar.Psiu]];

LPsidkin := Block[{mu}, ExpandIndices[I Psidbar.Ga[mu].DC[Psid, mu] - MPsid Psidbar.Psid]];

LPhiukin := Block[{mu, ss}, ExpandIndices[DC[Phiubar[ss], mu] DC[Phiu[ss], mu] - MPhiu^2 Phiubar[ss] Phiu[ss]]];

LPhidkin := Block[{mu, ss}, ExpandIndices[DC[Phidbar[ss], mu] DC[Phid[ss], mu] - MPhid^2 Phidbar[ss] Phid[ss]]];

LPsiuG := Block[{mu, nu, sp1, sp2, sp3, ii, jj, kk, ll, ss, aa, ff, op}, op = kapu[ff]/LamPsiu (-I) Eps[ii, jj, kk] T[aa, ll, jj] K6bar[ss, ll, kk] (I/2) (Ga[mu, sp1, sp3] Ga[nu, sp3, sp2] - Ga[nu, sp1, sp3] Ga[mu, sp3, sp2]) CC[uRbar[sp1, ff, ii]] Psiu[sp2, ss] FS[G, mu, nu, aa]; ExpandIndices[op + HC[op]]];

LPsidG := Block[{mu, nu, sp1, sp2, sp3, ii, jj, kk, ll, ss, aa, ff, op}, op = kapd[ff]/LamPsid (-I) Eps[ii, jj, kk] T[aa, ll, jj] K6bar[ss, ll, kk] (I/2) (Ga[mu, sp1, sp3] Ga[nu, sp3, sp2] - Ga[nu, sp1, sp3] Ga[mu, sp3, sp2]) CC[dRbar[sp1, ff, ii]] Psid[sp2, ss] FS[G, mu, nu, aa]; ExpandIndices[op + HC[op]]];

LPsiuB := Block[{mu, nu, sp1, ii, jj, kk, ll, ss, aa, ff, op}, op = kapuB[ff]/LamPsiuB^3 (-I) Eps[ii, jj, kk] T[aa, ll, jj] K6bar[ss, ll, kk] CC[uRbar[sp1, ff, ii]] Psiu[sp1, ss] FS[B, mu, nu] FS[G, mu, nu, aa]; ExpandIndices[op + HC[op]]];

LPsidB := Block[{mu, nu, sp1, ii, jj, kk, ll, ss, aa, ff, op}, op = kapdB[ff]/LamPsidB^3 (-I) Eps[ii, jj, kk] T[aa, ll, jj] K6bar[ss, ll, kk] CC[dRbar[sp1, ff, ii]] Psid[sp1, ss] FS[B, mu, nu] FS[G, mu, nu, aa]; ExpandIndices[op + HC[op]]];

LPhiuG := Block[{mu, nu, sp1, sp2, sp3, ii, jj, kk, ll, ss, aa, ff, xx, op}, op = lamu[xx, ff]/LamPhiu^2 (-I) Eps[ii, jj, kk] T[aa, ll, jj] K6bar[ss, ll, kk] Phiu[ss] (I/2) (Ga[mu, sp1, sp3] Ga[nu, sp3, sp2] - Ga[nu, sp1, sp3] Ga[mu, sp3, sp2]) CC[uRbar[sp1, ff, ii]] lR[sp2, xx] FS[G, mu, nu, aa]; ExpandIndices[op + HC[op]]];

LPhidG := Block[{mu, nu, sp1, sp2, sp3, ii, jj, kk, ll, ss, aa, ff, xx, op}, op = lamd[xx, ff]/LamPhid^2 (-I) Eps[ii, jj, kk] T[aa, ll, jj] K6bar[ss, ll, kk] Phid[ss] (I/2) (Ga[mu, sp1, sp3] Ga[nu, sp3, sp2] - Ga[nu, sp1, sp3] Ga[mu, sp3, sp2]) CC[dRbar[sp1, ff, ii]] lR[sp2, xx] FS[G, mu, nu, aa]; ExpandIndices[op + HC[op]]];

LSextet := LPsiukin + LPsidkin + LPhiukin + LPhidkin + LPsiuG + LPsidG + LPsiuB + LPsidB + LPhiuG + LPhidG;
