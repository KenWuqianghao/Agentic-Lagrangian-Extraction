LPhiuKin := Block[{mu}, ExpandIndices[DC[PhiUbar, mu] DC[PhiU, mu] - MPhiu^2 PhiUbar PhiU]];

LPhidKin := Block[{mu}, ExpandIndices[DC[PhiDbar, mu] DC[PhiD, mu] - MPhid^2 PhiDbar PhiD]];

LPsiuKin := Block[{mu}, ExpandIndices[I PsiUbar.Ga[mu].DC[PsiU, mu] - MPsiu PsiUbar.PsiU]];

LPsidKin := Block[{mu}, ExpandIndices[I PsiDbar.Ga[mu].DC[PsiD, mu] - MPsid PsiDbar.PsiD]];

LPsiuG := Block[{mu, nu, ff, ii, ss, aa, tmp}, tmp = ExpandIndices[1/LamPsiu kapu[ff] Jsix[ss, ii, aa] (CC[uqbar[ff, ii]].Sig[mu, nu].ProjP.PsiU[ss]) FS[G, mu, nu, aa]]; tmp + HC[tmp]];

LPsidG := Block[{mu, nu, ff, ii, ss, aa, tmp}, tmp = ExpandIndices[1/LamPsid kapd[ff] Jsix[ss, ii, aa] (CC[dqbar[ff, ii]].Sig[mu, nu].ProjP.PsiD[ss]) FS[G, mu, nu, aa]]; tmp + HC[tmp]];

LPsiuB := Block[{mu, nu, ff, ii, ss, aa, tmp}, tmp = ExpandIndices[1/LamPsiuB^3 kapuB[ff] Jsix[ss, ii, aa] (CC[uqbar[ff, ii]].ProjP.PsiU[ss]) FS[B, mu, nu] FS[G, mu, nu, aa]]; tmp + HC[tmp]];

LPsidB := Block[{mu, nu, ff, ii, ss, aa, tmp}, tmp = ExpandIndices[1/LamPsidB^3 kapdB[ff] Jsix[ss, ii, aa] (CC[dqbar[ff, ii]].ProjP.PsiD[ss]) FS[B, mu, nu] FS[G, mu, nu, aa]]; tmp + HC[tmp]];

LPhiuL := Block[{mu, nu, ff1, ff2, ii, ss, aa, tmp}, tmp = ExpandIndices[1/LamPhiu^2 lamu[ff1, ff2] Jsix[ss, ii, aa] PhiU[ss] (CC[uqbar[ff2, ii]].Sig[mu, nu].ProjP.l[ff1]) FS[G, mu, nu, aa]]; tmp + HC[tmp]];

LPhidL := Block[{mu, nu, ff1, ff2, ii, ss, aa, tmp}, tmp = ExpandIndices[1/LamPhid^2 lamd[ff1, ff2] Jsix[ss, ii, aa] PhiD[ss] (CC[dqbar[ff2, ii]].Sig[mu, nu].ProjP.l[ff1]) FS[G, mu, nu, aa]]; tmp + HC[tmp]];

LTotal := LPhiuKin + LPhidKin + LPsiuKin + LPsidKin + LPsiuG + LPsidG + LPsiuB + LPsidB + LPhiuL + LPhidL;
