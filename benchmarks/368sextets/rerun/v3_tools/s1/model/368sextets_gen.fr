LSXukin := Block[{mu}, ExpandIndices[DC[SXubar, mu] DC[SXu, mu] - MSXu^2 SXubar SXu]];

LSXdkin := Block[{mu}, ExpandIndices[DC[SXdbar, mu] DC[SXd, mu] - MSXd^2 SXdbar SXd]];

LFXukin := Block[{mu}, ExpandIndices[I FXubar.Ga[mu].DC[FXu, mu] - MFXu FXubar.FXu]];

LFXdkin := Block[{mu}, ExpandIndices[I FXdbar.Ga[mu].DC[FXd, mu] - MFXd FXdbar.FXd]];

LFXuG := Block[{mu, nu, aa, ii, jj, kk, ll, ss, ff, lag}, lag = ExpandIndices[(-I) kapFXu[ff]/LamFXu Eps[ii, jj, kk] T[aa, jj, ll] K6bar[ss, ll, kk] (CC[uRbar[ff, ii]].(I/2 (Ga[mu].Ga[nu] - Ga[nu].Ga[mu])).FXu[ss]) FS[G, mu, nu, aa]]; lag + HC[lag]];

LFXdG := Block[{mu, nu, aa, ii, jj, kk, ll, ss, ff, lag}, lag = ExpandIndices[(-I) kapFXd[ff]/LamFXd Eps[ii, jj, kk] T[aa, jj, ll] K6bar[ss, ll, kk] (CC[dRbar[ff, ii]].(I/2 (Ga[mu].Ga[nu] - Ga[nu].Ga[mu])).FXd[ss]) FS[G, mu, nu, aa]]; lag + HC[lag]];

LFXuB := Block[{mu, nu, aa, ii, jj, kk, ll, ss, ff, lag}, lag = ExpandIndices[(-I) kapFXuB[ff]/LamFXuB^3 Eps[ii, jj, kk] T[aa, jj, ll] K6bar[ss, ll, kk] (CC[uRbar[ff, ii]].FXu[ss]) FS[B, mu, nu] FS[G, mu, nu, aa]]; lag + HC[lag]];

LFXdB := Block[{mu, nu, aa, ii, jj, kk, ll, ss, ff, lag}, lag = ExpandIndices[(-I) kapFXdB[ff]/LamFXdB^3 Eps[ii, jj, kk] T[aa, jj, ll] K6bar[ss, ll, kk] (CC[dRbar[ff, ii]].FXd[ss]) FS[B, mu, nu] FS[G, mu, nu, aa]]; lag + HC[lag]];

LSXuG := Block[{mu, nu, aa, ii, jj, kk, ll, ss, ff, xx, lag}, lag = ExpandIndices[(-I) lamSXu[xx, ff]/LamSXu^2 Eps[ii, jj, kk] T[aa, jj, ll] K6bar[ss, ll, kk] SXu[ss] (CC[uRbar[ff, ii]].(I/2 (Ga[mu].Ga[nu] - Ga[nu].Ga[mu])).lR[xx]) FS[G, mu, nu, aa]]; lag + HC[lag]];

LSXdG := Block[{mu, nu, aa, ii, jj, kk, ll, ss, ff, xx, lag}, lag = ExpandIndices[(-I) lamSXd[xx, ff]/LamSXd^2 Eps[ii, jj, kk] T[aa, jj, ll] K6bar[ss, ll, kk] SXd[ss] (CC[dRbar[ff, ii]].(I/2 (Ga[mu].Ga[nu] - Ga[nu].Ga[mu])).lR[xx]) FS[G, mu, nu, aa]]; lag + HC[lag]];

LTotal := LSXukin + LSXdkin + LFXukin + LFXdkin + LFXuG + LFXdG + LFXuB + LFXdB + LSXuG + LSXdG;
