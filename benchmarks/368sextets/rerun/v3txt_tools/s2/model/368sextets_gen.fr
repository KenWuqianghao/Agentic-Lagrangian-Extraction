LFXdB := Block[{mu, nu, sp, ii, jj, kk, ll, ss, aa, ff, op}, op = ExpandIndices[(-I) Eps[ii, jj, kk] T[aa, jj, ll] K6bar[ss, ll, kk] (kapFXdB[ff]/CutFXdB^3) (CC[dq[sp, ff, ii]].ProjP.FXd[sp, ss]) FS[B, mu, nu] FS[G, mu, nu, aa]]; op + HC[op]];

LSXuG := Block[{mu, nu, sp, ii, jj, kk, ll, ss, aa, ffq, ffl, op}, op = ExpandIndices[(-I) Eps[ii, jj, kk] T[aa, jj, ll] K6bar[ss, ll, kk] (I lamSXu[ffl, ffq]/CutSXu^2) SXu[ss] (CC[uq[sp, ffq, ii]].ProjP.Ga[mu].Ga[nu].l[sp, ffl]) FS[G, mu, nu, aa]]; op + HC[op]];

LSXdG := Block[{mu, nu, sp, ii, jj, kk, ll, ss, aa, ffq, ffl, op}, op = ExpandIndices[(-I) Eps[ii, jj, kk] T[aa, jj, ll] K6bar[ss, ll, kk] (I lamSXd[ffl, ffq]/CutSXd^2) SXd[ss] (CC[dq[sp, ffq, ii]].ProjP.Ga[mu].Ga[nu].l[sp, ffl]) FS[G, mu, nu, aa]]; op + HC[op]];

LTotal := LSXukin + LSXdkin + LFXukin + LFXdkin + LFXuG + LFXdG + LFXuB + LFXdB + LSXuG + LSXdG;
