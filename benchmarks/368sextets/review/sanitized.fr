


M$ModelName = "ANON-MODEL";


M$InteractionOrderHierarchy = {{QCD, 1}, {QED, 2}, {NP, 1}};
M$InteractionOrderLimit = {{QCD, 99}, {QED, 99}, {NP, 99}};

AddGaugeRepresentation[SU3C -> {T6, Sextet}];

IndexRange[Index[Sextet]] = NoUnfold[Range[6]];
IndexStyle[Sextet, u];

