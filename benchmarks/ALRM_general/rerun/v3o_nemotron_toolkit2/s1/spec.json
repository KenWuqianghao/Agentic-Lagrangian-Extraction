    },
    {
      "name": "MWp",
      "parameter_type": "Internal",
      "value": "gR*Sqrt[k^2 + vR^2]/2",
      "interaction_order": ["NP", 1],
      "description": "W' boson mass [GeV]"
    },
    {
      "name": "WZp",
      "parameter_type": "Internal",
      "value": "1.",
      "interaction_order": ["NP", 1],
      "description": "Z' boson width [GeV], placeholder"
    },
    {
      "name": "WWp",
      "parameter_type": "Internal",
      "value": "1.",
      "interaction_order": ["NP", 1],
      "description": "W' boson width [GeV], placeholder"
    },
    {
      "name": "MH1",
      "parameter_type": "Internal",
      "value": "Sqrt[- (alp2 - alp3)*(vL^2 + vR^2) - kap*vL*vR/(Sqrt[2]*k) + 2*k^2*lam2]",
      "interaction_order": ["NP", 1],
      "description": "Mass of H1^0 (CP-even) [GeV]"
    },
    {
      "name": "MH2",
      "parameter_type": "Internal",
      "value": "Sqrt[(a + Sqrt[a^2 + 4*(b + a*MH0^2)])/2]",
      "interaction_order": ["NP", 1],
      "description": "Mass of H2^0 (CP-even) [GeV]"
    },
    {
      "name": "MH3",
      "parameter_type": "Internal",
      "value": "Sqrt[(a - Sqrt[a^2 + 4*(b + a*MH0^2)])/2]",
      "interaction_order": ["NP", 1],
      "description": "Mass of H3^0 (CP-even) [GeV]"
    },
    {
      "name": "MA1",
      "parameter_type": "Internal",
      "value": "Sqrt[- (alp2 - alp3)*(vL^2 + vR^2) - kap*vL*vR/(Sqrt[2]*k) + 2*k^2*lam2]",
      "interaction_order": ["NP", 1],
      "description": "Mass of A1^0 (CP-odd) [GeV]"
    },
    {
      "name": "MA2",
      "parameter_type": "Internal",
      "value": "Sqrt[-kap/(Sqrt[2]*k*vL*vR)*(vL^2*vR^2 + k^2*(vL^2 + vR^2))]",
      "interaction_order": ["NP", 1],
      "description": "Mass of A2^0 (CP-odd) [GeV]"
    },
    {
      "name": "MHp1",
      "parameter_type": "Internal",
      "value": "(k^2 + vL^2)/(2*k*vL)*(-2*(alp2 - alp3)*k*vL - Sqrt[2]*kap*vR)",
      "interaction_order": ["NP", 1],
      "description": "Mass of H1^+ (charged) [GeV]"
    },
    {
      "name": "MHp2",
      "parameter_type": "Internal",
      "value": "(k^2 + vR^2)/(2*k*vR)*(-2*(alp2 - alp3)*k*vR - Sqrt[2]*kap*vL)",
      "interaction_order": ["NP", 1],
      "description": "Mass of H2^+ (charged) [GeV]"
    },
    {
      "name": "v",
      "parameter_type": "Internal",
      "value": "Sqrt[1/(Sqrt[2]*Gf)]",
      "interaction_order": ["QED", -1],
      "description": "EW vev v = sqrt(k^2 + vL^2) [GeV]"
    },
    {
      "name": "vL",
      "parameter_type": "Internal",
      "value": "v*Cos[ArcTan[tb]]",
      "interaction_order": ["NP", 1],
      "description": "vev of chi_L [GeV]"
    },
    {
      "name": "k",
      "parameter_type": "Internal",
      "value": "v*Sin[ArcTan[tb]]",
      "interaction_order": ["NP", 1],
      "description": "vev of phi_2^0 [GeV]"
    },
    {
      "name": "vR",
      "parameter_type": "Internal",
      "value": "Sqrt[vevp^2 - k^2]",
      "interaction_order": ["NP", 1],
      "description": "vev of chi_R [GeV]"
    },
    {
      "name": "gL",
      "parameter_type": "Internal",
      "value": "2*MW/Sqrt[k^2 + vL^2]",
      "interaction_order": ["QED", 1],
      "description": "SU(2)_L gauge coupling"
    },
    {
      "name": "gY",
      "parameter_type": "Internal",
      "value": "ee/cw",
      "interaction_order": ["QED", 1],
      "description": "Hypercharge gauge coupling"
    },
    {
      "name": "gBL",
      "parameter_type": "Internal",
      "value": "gR*gY/Sqrt[gR^2 - gY^2]",
      "interaction_order": ["NP", 1],
      "description": "U(1)_B-L gauge coupling"
    },
    {
      "name": "sphw",
      "parameter_type": "Internal",
      "value": "gBL/Sqrt[gBL^2 + gR^2]",
      "interaction_order": ["NP", 1],
      "description": "sin(phi_W) mixing angle"
    },
    {
      "name": "cphw",
      "parameter_type": "Internal",
      "value": "gR/Sqrt[gBL^2 + gR^2]",
      "interaction_order": ["NP", 1],
      "description": "cos(phi_W) mixing angle"
    },
    {
      "name": "stw",
      "parameter_type": "Internal",
      "value": "ee/gL",
      "interaction_order": ["QED", 1],
      "description": "sin(theta_W)"
    },
    {
      "name": "ctw",
      "parameter_type": "Internal",
      "value": "Sqrt[1 - (ee/gL)^2]",
      "interaction_order": ["QED", 1],
      "description": "cos(theta_W)"
    },
    {
      "name": "szw",
      "parameter_type": "Internal",
      "value": "Sin[(1/2)*ArcTan[(2*cphw*ctw*gL*gR*(cphw^2*k^2 - sphw^2*vL^2))/(-(gL^2 - cphw^2*ctw^2*gR^2)*cphw^2*k^2 - (gL^2 - ctw^2*gBL^2*sphw^2)*cphw^2*vL^2 + ctw^2*gR^2*vR^2)]]",
      "interaction_order": ["NP", 1],
      "description": "sin(zeta_W) Z-Z' mixing angle"
    },
    {
      "name": "czw",
      "parameter_type": "Internal",
      "value": "Cos[(1/2)*ArcTan[(2*cphw*ctw*gL*gR*(cphw^2*k^2 - sphw^2*vL^2))/(-(gL^2 - cphw^2*ctw^2*gR^2)*cphw^2*k^2 - (gL^2 - ctw^2*gBL^2*sphw^2)*cphw^2*vL^2 + ctw^2*gR^2*vR^2)]]",
      "interaction_order": ["NP", 1],
      "description": "cos(zeta_W) Z-Z' mixing angle"
    },
    {
      "name": "mu1",
      "parameter_type": "Internal",
      "value": "(alp1 + alp2)*(vL^2 + vR^2) + k^2*lam1 + kap*vL*vR/(Sqrt[2]*k)",
      "interaction_order": ["NP", 1],
      "description": "Higgs bilinear parameter mu1 [GeV]"
    },
    {
      "name": "mu2",
      "parameter_type": "Internal",
      "value": "(alp1 + alp2)*k^2 + lam3*(vL^2 + vR^2)",
      "interaction_order": ["NP", 1],
      "description": "Higgs bilinear parameter mu2 [GeV]"
    },
    {
      "name": "lam1",
      "parameter_type": "Internal",
      "value": "(Sqrt[2]*k*vL*vR*MH0^6 + a4*MH0^4 - 2*a2*MH0^2 - 4*(alp1+alp2)^2*kap*k^4*(vL^2 - vR^2)^2) / (2*k^3*(Sqrt[2]*vL*vR*MH0^4 + (kap*k - 2*Sqrt[2]*lam3*vL*vR)*(vL^2+vR^2)*MH0^2 - 2*kap*k*lam3*(vL^2-vR^2)^2))",
      "interaction_order": ["NP", 1],
      "description": "Higgs quartic lambda_1 (derived from MH0)"
    },
    {
      "name": "lam4",
      "parameter_type": "Internal",
      "value": "lam3 - kap*k/(Sqrt[2]*vL*vR)",
      "interaction_order": ["NP", 1],
      "description": "Higgs quartic lambda_4 (derived)"
    },
    {
      "name": "a4",
      "parameter_type": "Internal",
      "value": "-2*Sqrt[2]*k*lam3*vL*vR*(vL^2+vR^2) + kap*(vL^2*vR^2 + k^2*(vL^2+vR^2))",
      "interaction_order": ["NP", 1],
      "description": "Intermediate parameter for lambda_1"
    },
    {
      "name": "a2",
      "parameter_type": "Internal",
      "value": "2*Sqrt[2]*(alp1+alp2)^2*k^3*vL*vR*(vL^2+vR^2) + kap*(lam3*vL^2*vR^2*(vL^2+vR^2) + k^2*(4*(alp1+alp2)*vL^2*vR^2 + lam3*(vL^2-vR^2)^2))",
      "interaction_order": ["NP", 1],
      "description": "Intermediate parameter for lambda_1"
    },
    {
      "name": "a",
      "parameter_type": "Internal",
      "value": "(vL*vR*(2*Sqrt[2]*k^3*lam1 - kap*vL*vR) + k*(2*Sqrt[2]*lam3*vL*vR - kap*k)*(vL^2+vR^2))/(Sqrt[2]*k*vL*vR) - MH0^2",
      "interaction_order": ["NP", 1],
      "description": "Intermediate parameter for H2,H3 masses"
    },
    {
      "name": "b",
      "parameter_type": "Internal",
      "value": "(Sqrt[2]*kap*k^2*(4*(alp1+alp2)*vL^2*vR^2 + lam3*(vL^2-vR^2)^2) + (4*k^3*((alp1+alp2)^2 - lam1*lam3)*vL*vR + Sqrt[2]*kap*(k^4*lam1 + lam3*vL^2*vR^2))*(vL^2+vR^2))/(k*vL*vR)",
      "interaction_order": ["NP", 1],
      "description": "Intermediate parameter for H2,H3 masses"
    },
    {
      "name": "MH0",
      "parameter_type": "External",
      "value": "125.",
      "block_name": "MASS",
      "order_block": 25,
      "interaction_order": ["QED", 1],
      "description": "SM-like Higgs mass H0^0 [GeV]"
    },
    {
      "name": "CKMp",
      "parameter_type": "Internal",
      "indices": ["Generation", "Generation"],
      "unitary": true,
      "value_rules": [
        {"lhs": "CKMp[1,1]", "rhs": "Cos[ArcSin[CKMps12]]*Cos[ArcSin[CKMps13]]", "delayed": false},
        {"lhs": "CKMp[1,2]", "rhs": "Sin[ArcSin[CKMps12]]*Cos[ArcSin[CKMps13]]", "delayed": false},
        {"lhs": "CKMp[1,3]", "rhs": "Sin[ArcSin[CKMps13]]*Exp[-I*CKMpdel]", "delayed": false},
        {"lhs": "CKMp[2,1]", "rhs": "-Sin[ArcSin[CKMps12]]*Cos[ArcSin[CKMps23]] - Cos[ArcSin[CKMps12]]*Sin[ArcSin[CKMps23]]*Sin[ArcSin[CKMps13]]*Exp[I*CKMpdel]", "delayed": false},
        {"lhs": "CKMp[2,2]", "rhs": "Cos[ArcSin[CKMps12]]*Cos[ArcSin[CKMps23]] - Sin[ArcSin[CKMps12]]*Sin[ArcSin[CKMps23]]*Sin[ArcSin[CKMps13]]*Exp[I*CKMpdel]", "delayed": false},
        {"lhs": "CKMp[2,3]", "rhs": "Sin[ArcSin[CKMps23]]*Cos[ArcSin[CKMps13]]", "delayed": false},
        {"lhs": "CKMp[3,1]", "rhs": "Sin[ArcSin[CKMps12]]*Sin[ArcSin[CKMps23]] - Cos[ArcSin[CKMps12]]*Cos[ArcSin[CKMps23]]*Sin[ArcSin[CKMps13]]*Exp[I*CKMpdel]", "delayed": false},
        {"lhs": "CKMp[3,2]", "rhs": "-Cos[ArcSin[CKMps12]]*Sin[ArcSin[CKMps23]] - Sin[ArcSin[CKMps12]]*Cos[ArcSin[CKMps23]]*Sin[ArcSin[CKMps13]]*Exp[I*CKMpdel]", "delayed": false},
        {"lhs": "CKMp[3,3]", "rhs": "Cos[ArcSin[CKMps23]]*Cos[ArcSin[CKMps13]]", "delayed": false}
      ],
      "interaction_order": ["NP", 1],
      "description": "CKM' matrix for exotic quark mixing"
    },
    {
      "name": "PMNSp",
      "parameter_type": "Internal",
      "indices": ["Generation", "Generation"],
      "unitary": true,
      "value_rules": [
        {"lhs": "PMNSp[1,1]", "rhs": "Cos[ArcSin[PMNSps12]]*Cos[ArcSin[PMNSps13]]", "delayed": false},
        {"lhs": "PMNSp[1,2]", "rhs": "Sin[ArcSin[PMNSps12]]*Cos[ArcSin[PMNSps13]]", "delayed": false},
        {"lhs": "PMNSp[1,3]", "rhs": "Sin[ArcSin[PMNSps13]]*Exp[-I*PMNSpdel]", "delayed": false},
        {"lhs": "PMNSp[2,1]", "rhs": "-Sin[ArcSin[PMNSps12]]*Cos[ArcSin[PMNSps23]] - Cos[ArcSin[PMNSps12]]*Sin[ArcSin[PMNSps23]]*Sin[ArcSin[PMNSps13]]*Exp[I*PMNSpdel]", "delayed": false},
        {"lhs": "PMNSp[2,2]", "rhs": "Cos[ArcSin[PMNSps12]]*Cos[ArcSin[PMNSps23]] - Sin[ArcSin[PMNSps12]]*Sin[ArcSin[PMNSps23]]*Sin[ArcSin[PMNSps13]]*Exp[I*PMNSpdel]", "delayed": false},
        {"lhs": "PMNSp[2,3]", "rhs": "Sin[ArcSin[PMNSps23]]*Cos[ArcSin[PMNSps13]]", "delayed": false},
        {"lhs": "PMNSp[3,1]", "rhs": "Sin[ArcSin[PMNSps12]]*Sin[ArcSin[PMNSps23]] - Cos[ArcSin[PMNSps12]]*Cos[ArcSin[PMNSps23]]*Sin[ArcSin[PMNSps13]]*Exp[I*PMNSpdel]", "delayed": false},
        {"lhs": "PMNSp[3,2]", "rhs": "-Cos[ArcSin[PMNSps12]]*Sin[ArcSin[PMNSps23]] - Sin[ArcSin[PMNSps12]]*Cos[ArcSin[PMNSps23]]*Sin[ArcSin[PMNSps13]]*Exp[I*PMNSpdel]", "delayed": false},
        {"lhs": "PMNSp[3,3]", "rhs": "Cos[ArcSin[PMNSps23]]*Cos[ArcSin[PMNSps13]]", "delayed": false}
      ],
      "interaction_order": ["NP", 1],
      "description": "PMNS' matrix for scotino mixing"
    },
    {
      "name": "Ynu",
      "parameter_type": "Internal",
      "indices": ["Generation", "Generation"],
      "value_rules": [
        {"lhs": "Ynu[1,1]", "rhs": "Sqrt[2]*Mve/(vL)", "delayed": false},
        {"lhs": "Ynu[2,2]", "rhs": "Sqrt[2]*Mvm/(vL)", "delayed": false},
        {"lhs": "Ynu[3,3]", "rhs": "Sqrt[2]*Mvt/(vL)", "delayed": false},
        {"lhs": "Ynu[1,2]", "rhs": "0", "delayed": false},
        {"lhs": "Ynu[2,1]", "rhs": "0", "delayed": false},
        {"lhs": "Ynu[1,3]", "rhs": "0", "delayed": false},
        {"lhs": "Ynu[3,1]", "rhs": "0", "delayed": false},
        {"lhs": "Ynu[2,3]", "rhs": "0", "delayed": false},
        {"lhs": "Ynu[3,2]", "rhs": "0", "delayed": false}
      ],
      "interaction_order": ["NP", 1],
      "description": "Neutrino Yukawa matrix (diagonal in mass basis)"
    },
    {
      "name": "Yn",
      "parameter_type": "Internal",
      "indices": ["Generation", "Generation"],
