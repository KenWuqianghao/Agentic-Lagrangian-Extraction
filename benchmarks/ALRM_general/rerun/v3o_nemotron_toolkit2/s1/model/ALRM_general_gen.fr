    FullName -> {"Exotic down quark d'", "Exotic strange quark s'", "Exotic bottom quark b'"},
    PropagatorLabel -> {"dqp", "dp", "sp", "bp"},
    PropagatorType -> Straight,
    PropagatorArrow -> Forward
  },
  S[104] == {
    ClassName -> h0,
    SelfConjugate -> True,
    ClassMembers -> {H1, H2, H3},
    FlavorIndex -> Generation,
    Mass -> {Mh0, {MH1, 193.}, {MH2, 907.}, {MH3, 1546.}},
    Width -> {Wh0, {WH1, 1.}, {WH2, 1.}, {WH3, 1.}},
    QuantumNumbers -> {Q -> 0},
    PDG -> {35, 45, 55},
    ParticleName -> {"H1", "H2", "H3"},
    AntiParticleName -> {"H1", "H2", "H3"},
    FullName -> {"H1^0 (CP-even)", "H2^0 (CP-even)", "H3^0 (CP-even)"},
    PropagatorLabel -> {"h0", "H1", "H2", "H3"},
    PropagatorType -> D,
    PropagatorArrow -> None
  },
  S[105] == {
    ClassName -> A0,
    SelfConjugate -> True,
    ClassMembers -> {A1, A2},
    FlavorIndex -> Generation,
    Mass -> {MA0, {MA1, 193.}, {MA2, 907.}},
    Width -> {WA0, {WA1, 1.}, {WA2, 1.}},
    QuantumNumbers -> {Q -> 0},
    PDG -> {36, 46},
    ParticleName -> {"A1", "A2"},
    AntiParticleName -> {"A1", "A2"},
    FullName -> {"A1^0 (CP-odd)", "A2^0 (CP-odd)"},
    PropagatorLabel -> {"A0", "A1", "A2"},
    PropagatorType -> D,
    PropagatorArrow -> None
  },
  S[106] == {
    ClassName -> Hp,
    SelfConjugate -> False,
    ClassMembers -> {H1p, H2p},
    FlavorIndex -> Generation,
    Mass -> {MHp, {MHp1, 907.}, {MHp2, 194.}},
    Width -> {WHp, {WHp1, 1.}, {WHp2, 1.}},
    QuantumNumbers -> {Q -> 1},
    PDG -> {37, 47},
    ParticleName -> {"H1+", "H2+"},
    AntiParticleName -> {"H1-", "H2-"},
    FullName -> {"H1^+ (charged)", "H2^+ (charged)"},
    PropagatorLabel -> {"Hp", "H1p", "H2p"},
    PropagatorType -> D,
    PropagatorArrow -> None
  }
};

LZpKin := -1/4 FS[Zp, mu, nu] FS[Zp, mu, nu] + 1/2 MZp^2 Zp[mu] Zp[mu];

LWpKin := -1/2 FS[Wpbar, mu, nu] FS[Wp, mu, nu] + MWp^2 Wpbar[mu] Wp[mu];

LnKin := I nlbar.Ga[mu].DC[nl, mu] - nlbar.Mn.nl;

LdqpKin := I dqpbar.Ga[mu].DC[dqp, mu] - dqpbar.Mdq.dqp;

Lh0Kin := DC[h0, mu] DC[h0, mu] - h0.Mh0^2.h0;

LA0Kin := 1/2 del[A0, mu] del[A0, mu] - 1/2 A0.MA0^2.A0;

LHpKin := DC[Hpbar, mu] DC[Hp, mu] - Hpbar.MHp^2.Hp;

LYukawa := ExpandIndices[ -Yd[ff2, ff3] CKM[ff1, ff2] QLbar[sp, ii, ff1, cc].dR[sp, ff3, cc] Phi[ii] - Ye[ff1, ff3] LLbar[sp, ii, ff1].lR[sp, ff3] Phi[ii] - Yu[ff1, ff2] QLbar[sp, ii, ff1, cc].uR[sp, ff2, cc] Phibar[jj] Eps[ii, jj] - Ydp[ff2, ff3] CKMp[ff1, ff2] QLbar[sp, ii, ff1, cc].dqp[sp, ff3, cc] ChiL[ii] - Yn[ff1, ff3] LLbar[sp, ii, ff1].nl[sp, ff3] ChiRbar[ii] Eps[ii, jj] - Ynu[ff1, ff3] LLbar[sp, ii, ff1].vl[sp, ff3] ChiLbar[ii] Eps[ii, jj] + HC[...] ];

LHiggsPotential := -mu1^2 Tr[Phidag.Phi] - mu2^2 (ChiLdag.ChiL + ChiRdag.ChiR) + lam1 (Tr[Phidag.Phi])^2 + lam2 (Phi.Phihat).(Phihatdag.Phidag) + lam3 ((ChiLdag.ChiL)^2 + (ChiRdag.ChiR)^2) + 2*lam4 (ChiLdag.ChiL)(ChiRdag.ChiR) + 2*alp1 Tr[Phidag.Phi](ChiLdag.ChiL + ChiRdag.ChiR) + 2*alp2 ((ChiLdag.Phi)(ChiL.Phidag) + (Phidag.ChiRdag)(Phi.ChiR)) + 2*alp3 ((ChiLdag.Phihatdag)(ChiL.Phihat) + (Phihat.ChiRdag)(Phihatdag.ChiR)) + kap (ChiLdag.Phi.ChiR + ChiRdag.Phidag.ChiL);

LEffHiggs := -1/4 Ghgg H FS[G, mu, nu, aa] FS[G, mu, nu, aa] - 1/4 Ghaa H FS[A, mu, nu] FS[A, mu, nu];

LTotal := LZpKin + LWpKin + LnKin + LdqpKin + Lh0Kin + LA0Kin + LHpKin + LYukawa + LHiggsPotential + LEffHiggs;
