LZpkin = -1/4 FS[Zp,mu,nu] FS[Zp,mu,nu] + 1/2 MZp^2 Zp[mu] Zp[mu];

LWpkin = -1/2 FS[Wpbar,mu,nu] FS[Wp,mu,nu] + MWp^2 Wpbar[mu] Wp[mu];

Lnlkin = I nlbar.Ga[mu].DC[nl,mu] - Mne n1bar.n1 - Mnm n2bar.n2 - Mnt n3bar.n3;

Ldqpkin = I dqpbar.Ga[mu].DC[dqp,mu] - MDP dp1bar.dp1 - MSP dp2bar.dp2 - MBP dp3bar.dp3;

Lnurkin = I nurbar.Ga[mu].DC[nur,mu] - Mve vrebar.vre - Mvm vrmbar.vrm - Mvt vrtbar.vrt;

Lh0kin = 1/2 del[H01,mu] del[H01,mu] - 1/2 MH01^2 H01^2 + 1/2 del[H02,mu] del[H02,mu] - 1/2 MH02^2 H02^2 + 1/2 del[H03,mu] del[H03,mu] - 1/2 MH03^2 H03^2;

LA0kin = 1/2 del[A10,mu] del[A10,mu] - 1/2 MA01^2 A10^2 + 1/2 del[A20,mu] del[A20,mu] - 1/2 MA02^2 A20^2;

LHpkin = DC[Hp1bar,mu] DC[Hp1,mu] - MHp1^2 Hp1bar Hp1 + DC[Hp2bar,mu] DC[Hp2,mu] - MHp2^2 Hp2bar Hp2;

LYuk = Block[{sp,ii,jj,kk,aa,bb,ff1,ff2,ff3,cc}, ExpandIndices[ QLbar[sp,ii,ff1,cc] Yu[ff1,ff2] QR[sp,jj,ff2,cc] Eps[ii,aa] Eps[jj,bb] PhiBbar[aa,bb] - QLbar[sp,ii,ff1,cc] Yd[ff1,ff2] dR[sp,ff2,cc] ChiL[ii] - QRbar[sp,ii,ff1,cc] Ydp[ff1,ff2] dLp[sp,ff2,cc] ChiR[ii] - LLbar[sp,ii,ff1] Ye[ff1,ff2] LR[sp,jj,ff2] PhiB[ii,jj] + LLbar[sp,ii,ff1] Ynu[ff1,ff2] nur[sp,ff2] Eps[ii,kk] ChiLbar[kk] + LRbar[sp,ii,ff1] Yn[ff1,ff2] nlL[sp,ff2] Eps[ii,kk] ChiRbar[kk], FlavorExpand -> {SU2D,SU2R}]];

Lpot = lam3 ((ChiLbar[ii] ChiL[ii])^2+(ChiRbar[ii] ChiR[ii])^2) + 2 alp1 (PhiBbar[ii,jj] PhiB[ii,jj]) (ChiLbar[kk] ChiL[kk]+ChiRbar[kk] ChiR[kk]) + 2 alp2 (ChiLbar[ii] PhiB[ii,jj] PhiBbar[kk,jj] ChiL[kk] + PhiBbar[ii,jj] ChiRbar[jj] PhiB[ii,kk] ChiR[kk]) + 2 alp3 (ChiLbar[ii] Eps[ii,aa] PhiBbar[kk,bb] Eps[jj,aa] ChiL[jj] Eps[ii,cc] PhiB[kk,dd] Eps[jj,cc] + PhiBbar[ii,jj] ChiRbar[jj] Eps[ii,kk] PhiB[kk,ll] ChiR[ll]) + lam2 (PhiB[1,1] PhiBbar[1,1]+PhiB[1,2] PhiBbar[1,2]+PhiB[2,1] PhiBbar[2,1]+PhiB[2,2] PhiBbar[2,2])^2 + kap (ChiLbar[ii] PhiB[ii,jj] ChiR[jj] + ChiRbar[ii] PhiBbar[ii,jj] ChiL[jj]);

Leff = -1/4 Ghgg H FS[G,mu,nu,aa] FS[G,mu,nu,aa] - 1/4 Ghaa H FS[A,mu,nu] FS[A,mu,nu];

LWpint = Block[{mu}, gR/Sqrt[2] (Wp[mu] uRbar.Ga[mu].dRp + Wpbar[mu] dRpbar.Ga[mu].uR + Wp[mu] nRpbar.Ga[mu].lR + Wpbar[mu] lRbar.Ga[mu].nRp)];

LZpint = Block[{mu}, Zp[mu] (gR*cphiW/2 (uRbar.Ga[mu].uR - dRpbar.Ga[mu].dRp + nRpbar.Ga[mu].nRp - lRbar.Ga[mu].lR) - gBL*sphiW/6 (uRbar.Ga[mu].uR + dRpbar.Ga[mu].dRp) + gBL*sphiW/2 (lbar.Ga[mu].l + vlbar.Ga[mu].vl) + gBL*sphiW/2 (nRpbar.Ga[mu].nRp + lRbar.Ga[mu].lR) + gBL*sphiW/3 (dRbar.Ga[mu].dR + dLpbar.Ga[mu].dLp))];

LTotal = LZpkin + LWpkin + Lnlkin + Ldqpkin + Lnurkin + Lh0kin + LA0kin + LHpkin + LYuk + Lpot + Leff + LWpint + LZpint;
