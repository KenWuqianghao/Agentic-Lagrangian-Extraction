      "description": "W' mass, eq:mw_mwp"
    },
    {
      "name": "MZp",
      "parameter_type": "Internal",
      "value": "1/2*Sqrt[gBL^2*sphiW^2*vLv^2+gR^2*(cphiW^4*kvev^2+vRv^2)/cphiW^2]",
      "interaction_order": ["NP", 1],
      "tex": "M_{Z'}",
      "description": "Z' mass, eq:mz_mzp"
    },
    {
      "name": "thzw",
      "parameter_type": "External",
      "value": "0.",
      "interaction_order": ["NP", 1],
