      "value": "Sqrt[vevp^2-kvev^2]",
      "interaction_order": ["NP", 1],
      "tex": "v_{R}",
      "description": "chi_R vev vR = sqrt(v'^2-k^2)"
    },
    {
      "name": "gBL",
      "parameter_type": "Internal",
      "value": "g1*gR/Sqrt[gR^2-g1^2]",
      "interaction_order": ["NP", 1],
      "tex": "g_{B-L}",
      "description": "U(1)_{B-L} coupling from 1/gY^2=1/gR^2+1/gBL^2"
    },
    {
      "name": "sphiW",
      "parameter_type": "Internal",
      "value": "g1/gR",
      "description": "sin(varphi_W)=gY/gR"
    },
    {
      "name": "cphiW",
      "parameter_type": "Internal",
      "value": "Sqrt[1-(g1/gR)^2]",
      "description": "cos(varphi_W)"
    },
    {
      "name": "MWp",
      "parameter_type": "Internal",
      "value": "gR/2*Sqrt[kvev^2+vRv^2]",
