    Indices -> {Index[Generation], Index[Generation]},
    InteractionOrder -> {QED, 1},
    Definitions -> {yeA[i_?NumericQ, j_?NumericQ] :> 0 /; (i =!= j)},
    Description -> "Charged-lepton Yukawa matrix Ye of Eq.(2.3), mass generated by the k vev, Eq.(B.2)"
  },
  yvA == {
    ParameterType -> Internal,
    Value -> {yvA[1,1] -> Sqrt[2]*Mve/vevL, yvA[2,2] -> Sqrt[2]*Mvm/vevL, yvA[3,3] -> Sqrt[2]*Mvt/vevL},
    Indices -> {Index[Generation], Index[Generation]},
    InteractionOrder -> {QED, 1},
    Definitions -> {yvA[i_?NumericQ, j_?NumericQ] :> 0 /; (i =!= j)},
    Description -> "Neutrino Yukawa matrix Ynu of Eq.(2.3), Dirac mass generated by the vL vev, Eq.(B.2)"
  },
  ydpA == {
    ParameterType -> Internal,
    Value -> {ydpA[1,1] -> Sqrt[2]*MDP/vevR, ydpA[2,2] -> Sqrt[2]*MSP/vevR, ydpA[3,3] -> Sqrt[2]*MBP/vevR},
    Indices -> {Index[Generation], Index[Generation]},
    InteractionOrder -> {QED, 1},
    Definitions -> {ydpA[i_?NumericQ, j_?NumericQ] :> 0 /; (i =!= j)},
    Description -> "Exotic down-type quark Yukawa matrix Yd-prime of Eq.(2.3), mass from the vR vev, Eq.(B.2)"
  },
  ynA == {
    ParameterType -> Internal,
    Value -> {ynA[1,1] -> Sqrt[2]*Mne/vevR, ynA[2,2] -> Sqrt[2]*Mnm/vevR, ynA[3,3] -> Sqrt[2]*Mnt/vevR},
    Indices -> {Index[Generation], Index[Generation]},
    InteractionOrder -> {QED, 1},
    Definitions -> {ynA[i_?NumericQ, j_?NumericQ] :> 0 /; (i =!= j)},
    Description -> "Scotino Yukawa matrix Yn of Eq.(2.3), mass generated by the vR vev, Eq.(B.2)"
  }
};

