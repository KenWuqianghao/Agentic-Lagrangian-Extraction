    Indices -> {Index[Generation], Index[Generation]},
    InteractionOrder -> {QED, 1},
    Definitions -> {ydA[i_?NumericQ, j_?NumericQ] :> 0 /; (i =!= j)},
    Description -> "Down-type Yukawa matrix Yd of Eq.(2.3), mass generated by the vL vev, Eq.(B.2)"
  },
  yeA == {
    ParameterType -> Internal,
