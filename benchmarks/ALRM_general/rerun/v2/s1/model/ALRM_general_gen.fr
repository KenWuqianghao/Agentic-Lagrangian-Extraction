GaugeXi[V[100]] = GaugeXi[Zp];

GaugeXi[V[101]] = GaugeXi[Wp];

GaugeXi[S[107]] = GaugeXi[Zp];

GaugeXi[S[108]] = GaugeXi[Wp];

GaugeXi[S[100]] = 1;

GaugeXi[S[101]] = 1;

GaugeXi[S[102]] = 1;

GaugeXi[S[103]] = 1;

GaugeXi[S[104]] = 1;

GaugeXi[S[105]] = 1;

GaugeXi[S[106]] = 1;

LNPgauge := Block[{mu,nu}, ExpandIndices[-1/4 FS[Zp,mu,nu] FS[Zp,mu,nu] + 1/2 MZp^2 Zp[mu] Zp[mu] - 1/2 FS[Wpbar,mu,nu] FS[Wp,mu,nu] + MWp^2 Wpbar[mu] Wp[mu]]];

LNPferm := Block[{mu}, ExpandIndices[I*(dpLbar.Ga[mu].DC[dpL,mu] + dpRbar.Ga[mu].DC[dpR,mu] + nLbar.Ga[mu].del[nL,mu] + nRbar.Ga[mu].del[nR,mu] + nuRbar.Ga[mu].del[nuR,mu]), FlavorExpand->{SU2D,SU2W}]];

LNPscal := Block[{mu,ii,jj}, ExpandIndices[DC[ChiLbar[ii],mu] DC[ChiL[ii],mu] + DC[ChiRbar[ii],mu] DC[ChiR[ii],mu] + DC[Phibdbar[ii,jj],mu] DC[Phibd[ii,jj],mu], FlavorExpand->{SU2D,SU2RD,SU2W}]];

LNPWp := Block[{mu,sp1,sp2,cc,ff1,ff2,LWc}, LWc = gR/Sqrt[2] Wp[mu] (CKMp[ff1,ff2] uRbar[sp1,ff1,cc].Ga[mu,sp1,sp2].dpR[sp2,ff2,cc] + PMNSp[ff1,ff2] nRbar[sp1,ff1].Ga[mu,sp1,sp2].lR[sp2,ff2]); ExpandIndices[LWc + HC[LWc], FlavorExpand->{SU2D,SU2W}]];

LNPZp := Block[{mu,sp1,sp2,ii,ff,cc}, ExpandIndices[Zp[mu] ((gR cphiW/2 - gBL sphiW/6) uRbar[sp1,ff,cc].Ga[mu,sp1,sp2].uR[sp2,ff,cc] + (-gR cphiW/2 - gBL sphiW/6) dpRbar[sp1,ff,cc].Ga[mu,sp1,sp2].dpR[sp2,ff,cc] + (gBL sphiW/3) dpLbar[sp1,ff,cc].Ga[mu,sp1,sp2].dpL[sp2,ff,cc] + (gBL sphiW/3) dRbar[sp1,ff,cc].Ga[mu,sp1,sp2].dR[sp2,ff,cc] - (gBL sphiW/6) QLbar[sp1,ii,ff,cc].Ga[mu,sp1,sp2].QL[sp2,ii,ff,cc] + (gBL sphiW/2) LLbar[sp1,ii,ff].Ga[mu,sp1,sp2].LL[sp2,ii,ff] + (gR cphiW/2 + gBL sphiW/2) nRbar[sp1,ff].Ga[mu,sp1,sp2].nR[sp2,ff] + (-gR cphiW/2 + gBL sphiW/2) lRbar[sp1,ff].Ga[mu,sp1,sp2].lR[sp2,ff]), FlavorExpand->{SU2D,SU2W}]];

LNPyuk := Block[{sp,ii,jj,kk,ll,cc,ff1,ff2,ff3,yuk,feynmangaugerules}, feynmangaugerules = If[Not[FeynmanGauge], {G0|GP|GPbar|GZp|GWp|GWpbar ->0}, {}]; yuk = ExpandIndices[yuA[ff1,ff2] QLbar[sp,ii,ff1,cc].QR[sp,jj,ff2,cc] Eps[ii,kk] Eps[jj,ll] Phibdbar[ll,kk] - ydA[ff2,ff3] CKM[ff1,ff2] QLbar[sp,ii,ff1,cc].dR[sp,ff3,cc] ChiL[ii] - ydpA[ff2,ff3] CKMp[ff1,ff2] QRbar[sp,ii,ff1,cc].dpL[sp,ff3,cc] ChiR[ii] - yeA[ff1,ff2] LLbar[sp,ii,ff1].LR[sp,jj,ff2] Phibd[ii,jj] + yvA[ff1,ff2] LLbar[sp,ii,ff1].nuR[sp,ff2] ChiLbar[jj] Eps[ii,jj] + ynA[ff2,ff3] PMNSp[ff1,ff2] LRbar[sp,ii,ff1].nL[sp,ff3] ChiRbar[jj] Eps[ii,jj], FlavorExpand->{SU2D,SU2RD}]; yuk = yuk /. {CKM[a_,b_] Conjugate[CKM[a_,c_]] -> IndexDelta[b,c], CKM[b_,a_] Conjugate[CKM[c_,a_]] -> IndexDelta[b,c], CKMp[a_,b_] Conjugate[CKMp[a_,c_]] -> IndexDelta[b,c], CKMp[b_,a_] Conjugate[CKMp[c_,a_]] -> IndexDelta[b,c], PMNSp[a_,b_] Conjugate[PMNSp[a_,c_]] -> IndexDelta[b,c], PMNSp[b_,a_] Conjugate[PMNSp[c_,a_]] -> IndexDelta[b,c]}; yuk + HC[yuk] /. feynmangaugerules];

LNPpot := Block[{i1,i2,i3,i4,j1,j2,j3,j4,k1,k2,k3,k4,l1,l2,feynmangaugerules}, feynmangaugerules = If[Not[FeynmanGauge], {G0|GP|GPbar|GZp|GWp|GWpbar ->0}, {}]; ExpandIndices[-(-mu1sq Phibdbar[i1,j1] Phibd[i1,j1] - mu2sq (ChiLbar[i1] ChiL[i1] + ChiRbar[j1] ChiR[j1]) + lam1 (Phibdbar[i1,j1] Phibd[i1,j1]) (Phibdbar[i2,j2] Phibd[i2,j2]) + lam2 (Phibd[i1,j1] Eps[i1,i2] Eps[j1,j2] Phibd[i2,j2]) (Phibdbar[i3,j3] Eps[i3,i4] Eps[j3,j4] Phibdbar[i4,j4]) + lam3 ((ChiLbar[i1] ChiL[i1]) (ChiLbar[i2] ChiL[i2]) + (ChiRbar[j1] ChiR[j1]) (ChiRbar[j2] ChiR[j2])) + 2 lam4 (ChiLbar[i1] ChiL[i1]) (ChiRbar[j1] ChiR[j1]) + 2 alp1 (Phibdbar[i1,j1] Phibd[i1,j1]) (ChiLbar[i2] ChiL[i2] + ChiRbar[j2] ChiR[j2]) + 2 alp2 ((ChiLbar[i1] Phibd[i1,j1]) (ChiL[i2] Phibdbar[i2,j1]) + (Phibdbar[i3,j2] ChiRbar[j2]) (Phibd[i3,j3] ChiR[j3])) + 2 alp3 ((ChiLbar[i1] Eps[i1,k1] Eps[j1,l1] Phibdbar[l1,k1]) (ChiL[i2] Eps[i2,k2] Eps[j1,l2] Phibd[l2,k2]) + (Eps[i3,k3] Eps[j3,l1] Phibd[l1,k3] ChiRbar[j3]) (Eps[i3,k4] Eps[j4,l2] Phibdbar[l2,k4] ChiR[j4])) + kap (ChiLbar[i1] Phibd[i1,j1] ChiR[j1] + ChiRbar[j2] Phibdbar[i2,j2] ChiL[i2])), FlavorExpand->{SU2D,SU2RD}] /. feynmangaugerules];

LNPheff := Block[{mu,nu,aa}, ExpandIndices[-1/4 Ghgg H FS[G,mu,nu,aa] FS[G,mu,nu,aa] - 1/4 Ghaa H FS[A,mu,nu] FS[A,mu,nu]]];

LALRSM := LNPgauge + LNPferm + LNPscal + LNPWp + LNPZp + LNPyuk + LNPpot + LNPheff;
