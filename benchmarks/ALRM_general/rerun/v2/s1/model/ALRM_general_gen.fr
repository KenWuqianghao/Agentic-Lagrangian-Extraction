    Description -> "VPMNS rotation of the left-handed neutrinos, Eqs.(2.15),(C.3)"
  },
  PMNSp == {
    ParameterType -> Internal,
    Value -> {PMNSp[1,1] -> Sqrt[1-PMNSps12^2]*Sqrt[1-PMNSps13^2], PMNSp[1,2] -> PMNSps12*Sqrt[1-PMNSps13^2], PMNSp[1,3] -> PMNSps13*Exp[-I*PMNSpdel], PMNSp[2,1] -> -PMNSps12*Sqrt[1-PMNSps23^2] - Sqrt[1-PMNSps12^2]*PMNSps23*PMNSps13*Exp[I*PMNSpdel], PMNSp[2,2] -> Sqrt[1-PMNSps12^2]*Sqrt[1-PMNSps23^2] - PMNSps12*PMNSps23*PMNSps13*Exp[I*PMNSpdel], PMNSp[2,3] -> PMNSps23*Sqrt[1-PMNSps13^2], PMNSp[3,1] -> PMNSps12*PMNSps23 - Sqrt[1-PMNSps12^2]*Sqrt[1-PMNSps23^2]*PMNSps13*Exp[I*PMNSpdel], PMNSp[3,2] -> -Sqrt[1-PMNSps12^2]*PMNSps23 - PMNSps12*Sqrt[1-PMNSps23^2]*PMNSps13*Exp[I*PMNSpdel], PMNSp[3,3] -> Sqrt[1-PMNSps23^2]*Sqrt[1-PMNSps13^2]},
    Indices -> {Index[Generation], Index[Generation]},
