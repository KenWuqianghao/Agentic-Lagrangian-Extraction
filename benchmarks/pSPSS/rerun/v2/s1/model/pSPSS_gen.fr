(* ****************************************************************** *)
(* *****   Auxiliary definitions of the pSPSS model file        ***** *)
(* ****************************************************************** *)

(* Rotation of the SM neutrino interaction eigenstates onto the five     *)
(* neutrino mass eigenstates, Eq. (5.2): nu_alpha = UnCL[alpha, i] n_i.  *)
MixNeutrinos = {
  vl[sp_, ff_]    :> Module[{ii}, UnCL[ff, ii] nL[sp, ii]],
  vlbar[sp_, ff_] :> Module[{ii}, Conjugate[UnCL[ff, ii]] nLbar[sp, ii]]
};

(* The mixing matrix Un is valid up to second order in theta only.       *)
(* Expand the Lagrangian in theta and drop all terms beyond O(|theta|^2).*)
RemoveHigherOrder[expr_] := Module[{eps, res},
  res = expr /. MR$Definitions;
  res = res /. {theta1 -> eps theta1, theta2 -> eps theta2, theta3 -> eps theta3};
  Normal[Series[res, {eps, 0, 2}]] /. eps -> 1
];

LNkin := Block[{mu}, ExpandIndices[I (N1Lbar.Ga[mu].del[N1L, mu] + N2Lbar.Ga[mu].del[N2L, mu]), FlavorExpand -> {NuGeneration}]];

LNmass := Block[{sp1, mass}, mass = ExpandIndices[- Mmaj CC[N1Lbar[sp1]].N2L[sp1], FlavorExpand -> {NuGeneration}]; mass + HC[mass]];

LNYuk := Block[{sp1, ii, jj, ff1, yuk}, yuk = ExpandIndices[yvn[ff1] (CC[N1Lbar[sp1]].LL[sp1, ii, ff1] PhiNP[jj] Eps[ii, jj]), FlavorExpand -> {SU2D, NuGeneration}]; yuk + HC[yuk]];

LNP := LNmass + LNYuk;

LpSPSS := RemoveHigherOrder[(LSM + LNkin + LNP) /. MixNeutrinos];
