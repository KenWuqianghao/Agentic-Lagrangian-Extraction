Ln4 := Block[{mu}, ExpandIndices[I/2 n4bar.Ga[mu].del[n4,mu] - 1/2 MN4 n4bar.n4]];

Ln5 := Block[{mu}, ExpandIndices[I/2 n5bar.Ga[mu].del[n5,mu] - 1/2 MN5 n5bar.n5]];

LNPYuk := Block[{sp1,ii,jj,ff1}, ExpandIndices[yn4[ff1] CC[n4bar[sp1]].LL[sp1,ii,ff1] PhiNPbar[jj] Eps[ii,jj] + yn5[ff1] CC[n5bar[sp1]].LL[sp1,ii,ff1] PhiNPbar[jj] Eps[ii,jj], FlavorExpand->SU2D]];

LNP := LNPYuk + HC[LNPYuk];

LTotal := LSM + Ln4 + Ln5 + LNP;
