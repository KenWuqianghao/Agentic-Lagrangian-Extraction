LNPkin := I (N1Lbar.Ga[mu].del[N1L, mu] + N2Lbar.Ga[mu].del[N2L, mu]);

LNPmass := - Mmaj CC[N1Lbar[sp1]].N2L[sp1] + HC[- Mmaj CC[N1Lbar[sp1]].N2L[sp1]];

