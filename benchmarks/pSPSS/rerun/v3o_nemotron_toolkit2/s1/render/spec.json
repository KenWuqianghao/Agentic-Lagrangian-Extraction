  "lagrangian_terms": [
    {
      "name": "LKinN1L",
      "expression": "I N1Lbar.Ga[mu].del[N1L, mu]",
      "delayed": true
    },
    {
      "name": "LKinN2L",
      "expression": "I N2Lbar.Ga[mu].del[N2L, mu]",
      "delayed": true
    },
    {
      "name": "LKinN4",
      "expression": "I/2 n4bar.Ga[mu].del[n4, mu]",
      "delayed": true
    },
    {
      "name": "LKinN5",
      "expression": "I/2 n5bar.Ga[mu].del[n5, mu]",
      "delayed": true
    },
    {
      "name": "LMassN1N2",
      "expression": "- Mmaj CC[N1Lbar[sp1]].N2L[sp1]",
      "delayed": true
