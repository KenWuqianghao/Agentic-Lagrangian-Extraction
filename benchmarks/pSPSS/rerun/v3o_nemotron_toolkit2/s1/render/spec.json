      "tex": "y_{\\nu}",
      "value_rules": [
        {"lhs": "yvn[1]", "rhs": "theta1*Mmaj/vevNP", "delayed": false},
        {"lhs": "yvn[2]", "rhs": "theta2*Mmaj/vevNP", "delayed": false},
        {"lhs": "yvn[3]", "rhs": "theta3*Mmaj/vevNP", "delayed": false}
