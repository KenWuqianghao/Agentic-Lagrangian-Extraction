      "delayed": true
    },
    {
      "name": "LYukN1HC",
      "expression": "HC[yvn[ff1] CC[N1Lbar[sp1]].LL[sp1, ii, ff1] PhiNPbar[jj] Eps[ii, jj]]",
      "delayed": true
    },
    {
      "name": "LTotal",
      "expression": "LKinN1L + LKinN2L + LKinN4 + LKinN5 + LMassN1N2 + LMassN4 + LMassN5 + LYukN1 + LYukN1HC",
