    {
      "name": "LMassN4",
      "expression": "-1/2 Mn4 n4bar.n4",
      "delayed": true
    },
    {
      "name": "LMassN5",
      "expression": "-1/2 Mn5 n5bar.n5",
      "delayed": true
    },
    {
      "name": "LYukN1",
