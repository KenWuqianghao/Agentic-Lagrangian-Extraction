LKinN1L := I N1Lbar.Ga[mu].del[N1L, mu];

LKinN2L := I N2Lbar.Ga[mu].del[N2L, mu];

LKinN4 := I/2 n4bar.Ga[mu].del[n4, mu];

LKinN5 := I/2 n5bar.Ga[mu].del[n5, mu];

LMassN1N2 := - Mmaj CC[N1Lbar[sp1]].N2L[sp1];

LMassN4 := -1/2 Mn4 n4bar.n4;

LMassN5 := -1/2 Mn5 n5bar.n5;

LYukN1 := yvn[ff1] CC[N1Lbar[sp1]].LL[sp1, ii, ff1] PhiNPbar[jj] Eps[ii, jj];

LYukN1HC := HC[yvn[ff1] CC[N1Lbar[sp1]].LL[sp1, ii, ff1] PhiNPbar[jj] Eps[ii, jj]];

LTotal := LKinN1L + LKinN2L + LKinN4 + LKinN5 + LMassN1N2 + LMassN4 + LMassN5 + LYukN1 + LYukN1HC;
