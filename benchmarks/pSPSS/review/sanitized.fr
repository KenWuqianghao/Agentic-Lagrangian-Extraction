


M$ModelName = "ANON-MODEL";


M$InteractionOrderHierarchy = {{NP, 2}};

IndexRange[Index[Neutrino]] = NoUnfold[Range[5]];
IndexRange[Index[HNL]] = NoUnfold[Range[2]];
IndexStyle[Neutrino, n];
IndexStyle[HNL, N];

M$Parameters = {
  Mmaj == {
    ParameterType -> External,
    Value -> 1.000000*^02,
    ComplexParameter -> False,
    BlockName -> PSPSS,
    OrderBlock -> 1,
    TeX -> "Subscript[m,M]",
    Description -> ""
  },
  deltaM == {
    ParameterType -> External,
    Value -> 1.000000*^-12,
    ComplexParameter -> False,
    BlockName -> PSPSS,
    OrderBlock -> 2,
    TeX -> "\\[CapitalDelta]m",
    Description -> ""
  },
  theta1 == {
    ParameterType -> External,
    Value -> 0.000000,
    ComplexParameter -> False,
    BlockName -> PSPSS,
    OrderBlock -> 3,
    InteractionOrder -> {NP, 1},
    TeX -> "Subscript[\\[Theta],e]",
    Description -> ""
  },
  theta2 == {
    ParameterType -> External,
    Value -> 1.000000*^-03,
    ComplexParameter -> False,
    BlockName -> PSPSS,
    OrderBlock -> 4,
    InteractionOrder -> {NP, 1},
    TeX -> "Subscript[\\[Theta],\\[Mu]]",
    Description -> ""
  },
  theta3 == {
    ParameterType -> External,
    Value -> 0.000000,
    ComplexParameter -> False,
    BlockName -> PSPSS,
    OrderBlock -> 5,
    InteractionOrder -> {NP, 1},
    TeX -> "Subscript[\\[Theta],\\[Tau]]",
    Description -> ""
  },
  damping == {
    ParameterType -> External,
    Value -> 0.000000,
    ComplexParameter -> False,
    BlockName -> PSPSS,
    OrderBlock -> 6,
    Description -> ""
  },
  thetaSq == {
    ParameterType -> Internal,
    Value -> theta1^2 + theta2^2 + theta3^2,
    ComplexParameter -> False,
    Description -> ""
  },
  vevNP == {
    ParameterType -> Internal,
    Value -> vev,
    ComplexParameter -> False,
    InteractionOrder -> {NP, -1},
    Description -> ""
  },
  Mn4 == {
    ParameterType -> Internal,
    Value -> Mmaj*(1 + thetaSq/2) - deltaM/2,
    ComplexParameter -> False,
    Description -> ""
  },
  Mn5 == {
    ParameterType -> Internal,
    Value -> Mmaj*(1 + thetaSq/2) + deltaM/2,
    ComplexParameter -> False,
    Description -> ""
  },
  yvn == {
    ParameterType -> Internal,
    Value -> {yvn[1] -> Mmaj*theta1/vevNP, yvn[2] -> Mmaj*theta2/vevNP, yvn[3] -> Mmaj*theta3/vevNP},
    Indices -> {Index[Generation]},
    ComplexParameter -> False,
    InteractionOrder -> {NP, 1},
    Description -> ""
  },
  UnCL == {
    ParameterType -> Internal,
    Value -> {UnCL[1,1] -> 1 - theta1^2/2, UnCL[1,2] -> -theta1*theta2/2, UnCL[1,3] -> -theta1*theta3/2, UnCL[1,4] -> -I*theta1/Sqrt[2], UnCL[1,5] -> theta1/Sqrt[2], UnCL[2,1] -> -theta2*theta1/2, UnCL[2,2] -> 1 - theta2^2/2, UnCL[2,3] -> -theta2*theta3/2, UnCL[2,4] -> -I*theta2/Sqrt[2], UnCL[2,5] -> theta2/Sqrt[2], UnCL[3,1] -> -theta3*theta1/2, UnCL[3,2] -> -theta3*theta2/2, UnCL[3,3] -> 1 - theta3^2/2, UnCL[3,4] -> -I*theta3/Sqrt[2], UnCL[3,5] -> theta3/Sqrt[2]},
    Indices -> {Index[Generation], Index[Neutrino]},
    ComplexParameter -> True,
    Description -> ""
  },
  Un == {
    ParameterType -> Internal,
    Value -> {Un[1,1] -> 1 - theta1^2/2, Un[1,2] -> -theta1*theta2/2, Un[1,3] -> -theta1*theta3/2, Un[1,4] -> -I*theta1/Sqrt[2], Un[1,5] -> theta1/Sqrt[2], Un[2,1] -> -theta2*theta1/2, Un[2,2] -> 1 - theta2^2/2, Un[2,3] -> -theta2*theta3/2, Un[2,4] -> -I*theta2/Sqrt[2], Un[2,5] -> theta2/Sqrt[2], Un[3,1] -> -theta3*theta1/2, Un[3,2] -> -theta3*theta2/2, Un[3,3] -> 1 - theta3^2/2, Un[3,4] -> -I*theta3/Sqrt[2], Un[3,5] -> theta3/Sqrt[2], Un[4,1] -> 0, Un[4,2] -> 0, Un[4,3] -> 0, Un[4,4] -> I/Sqrt[2], Un[4,5] -> 1/Sqrt[2], Un[5,1] -> -theta1, Un[5,2] -> -theta2, Un[5,3] -> -theta3, Un[5,4] -> -I*(1 - thetaSq/2)/Sqrt[2], Un[5,5] -> (1 - thetaSq/2)/Sqrt[2]},
    Indices -> {Index[Neutrino], Index[Neutrino]},
    ComplexParameter -> True,
    Description -> ""
  }
};

M$ClassesDescription = {
  F[100] == {
    ClassName -> nH,
    SelfConjugate -> True,
    ClassMembers -> {n4, n5},
    Indices -> {Index[HNL]},
    FlavorIndex -> HNL,
    Mass -> {MN, {Mn4, Internal}, {Mn5, Internal}},
    Width -> {WN, {Wn4, 1.}, {Wn5, 1.}},
    PDG -> {9900012, 9900014},
    ParticleName -> {"n4", "n5"},
    FullName -> {"Heavy Majorana neutrino n4", "Heavy Majorana neutrino n5"},
    PropagatorLabel -> {"n4", "n5"},
    PropagatorType -> Straight,
    PropagatorArrow -> None
  },
  W[100] == {
    ClassName -> N1L,
    SelfConjugate -> False,
    QuantumNumbers -> {Q -> 0, Y -> 0},
    Chirality -> Left,
    Unphysical -> True,
    Definitions -> {N1L[sp1_] :> I/Sqrt[2] n4[sp1] + 1/Sqrt[2] n5[sp1]}
  },
  W[101] == {
    ClassName -> N2L,
    SelfConjugate -> False,
    QuantumNumbers -> {Q -> 0, Y -> 0},
    Chirality -> Left,
    Unphysical -> True,
    Definitions -> {N2L[sp1_] :> Module[{nn}, Sum[Un[5, nn] nL[sp1, nn], {nn, 1, 5}]]}
  }
};

RemoveHigherOrder[expr_] := Module[{eps}, Normal[Series[expr /. {theta1 -> eps theta1, theta2 -> eps theta2, theta3 -> eps theta3}, {eps, 0, 2}]] /. eps -> 1]

PhiNP[i_] := Phi[i] /. vev -> vevNP

PhiNPbar[i_] := Phibar[i] /. vev -> vevNP

nL[sp_, 1] := vl[sp, 1]; nL[sp_, 2] := vl[sp, 2]; nL[sp_, 3] := vl[sp, 3]; nL[sp_, 4] := n4[sp]; nL[sp_, 5] := n5[sp]

MR$Definitions = Join[MR$Definitions, {LL[sp1_, 1, ff_] :> Module[{sp2, nn}, ProjM[sp1, sp2] Sum[UnCL[ff, nn] nL[sp2, nn], {nn, 1, 5}]]}]

LKineticSterile = RemoveHigherOrder[Block[{mu}, I (N1Lbar.Ga[mu].del[N1L, mu] + N2Lbar.Ga[mu].del[N2L, mu])]];

NuMixE = UnCL[1, 1] ve + UnCL[1, 2] vm + UnCL[1, 3] vt + UnCL[1, 4] n4 + UnCL[1, 5] n5;
NuMixM = UnCL[2, 1] ve + UnCL[2, 2] vm + UnCL[2, 3] vt + UnCL[2, 4] n4 + UnCL[2, 5] n5;
NuMixT = UnCL[3, 1] ve + UnCL[3, 2] vm + UnCL[3, 3] vt + UnCL[3, 4] n4 + UnCL[3, 5] n5;

YukawaNP =
  yvn[1] (((-n4bar.ProjM.NuMixE + I n5bar.ProjM.NuMixE)/Sqrt[2]) PhiNP[2] -
    ((-n4bar.ProjM.e + I n5bar.ProjM.e)/Sqrt[2]) PhiNP[1]) +
  yvn[2] (((-n4bar.ProjM.NuMixM + I n5bar.ProjM.NuMixM)/Sqrt[2]) PhiNP[2] -
    ((-n4bar.ProjM.mu + I n5bar.ProjM.mu)/Sqrt[2]) PhiNP[1]) +
  yvn[3] (((-n4bar.ProjM.NuMixT + I n5bar.ProjM.NuMixT)/Sqrt[2]) PhiNP[2] -
    ((-n4bar.ProjM.ta + I n5bar.ProjM.ta)/Sqrt[2]) PhiNP[1]);

LNP = RemoveHigherOrder[Block[{sp1}, - Mmaj CC[N1Lbar[sp1]].N2L[sp1] + YukawaNP + HC[- Mmaj CC[N1Lbar[sp1]].N2L[sp1] + YukawaNP]]];

LTot := LKineticSterile + LNP;
