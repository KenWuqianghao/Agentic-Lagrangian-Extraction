RemoveHigherOrder[expr_] := Module[{eps}, Normal[Series[expr /. {theta1 -> eps theta1, theta2 -> eps theta2, theta3 -> eps theta3}, {eps, 0, 2}]] /. eps -> 1]

PhiNP[i_] := Phi[i] /. vev -> vevNP

PhiNPbar[i_] := Phibar[i] /. vev -> vevNP

nL[sp_, 1] := vl[sp, 1]; nL[sp_, 2] := vl[sp, 2]; nL[sp_, 3] := vl[sp, 3]; nL[sp_, 4] := n4[sp]; nL[sp_, 5] := n5[sp]

MR$Definitions = Join[MR$Definitions, {LL[sp1_, 1, ff_] :> Module[{sp2, nn}, ProjM[sp1, sp2] Sum[UnCL[ff, nn] nL[sp2, nn], {nn, 1, 5}]]}]

LKineticSterile = RemoveHigherOrder[Block[{mu}, I (N1Lbar.Ga[mu].del[N1L, mu] + N2Lbar.Ga[mu].del[N2L, mu])]];

YukawaNP = Block[{sp1},
  yvn[1] (CC[N1Lbar[sp1]].LL[sp1, 1, 1] PhiNP[2] - CC[N1Lbar[sp1]].LL[sp1, 2, 1] PhiNP[1]) +
  yvn[2] (CC[N1Lbar[sp1]].LL[sp1, 1, 2] PhiNP[2] - CC[N1Lbar[sp1]].LL[sp1, 2, 2] PhiNP[1]) +
  yvn[3] (CC[N1Lbar[sp1]].LL[sp1, 1, 3] PhiNP[2] - CC[N1Lbar[sp1]].LL[sp1, 2, 3] PhiNP[1])
];

LNP = RemoveHigherOrder[Block[{sp1}, - Mmaj CC[N1Lbar[sp1]].N2L[sp1] + YukawaNP + HC[- Mmaj CC[N1Lbar[sp1]].N2L[sp1] + YukawaNP]]];

LTot := LKineticSterile + LNP;
