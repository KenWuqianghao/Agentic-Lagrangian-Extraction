                      ynd[2,1] ->  0, ynd[2,2] -> Sqrt[2] VmuN2 MN2/(vev), ynd[2,3] -> 0,
                      ynd[3,1] -> 0,          ynd[3,2] -> 0,         ynd[3,3] -> Sqrt[2] VtaN3 MN3/(vev)},
    TeX         -> Superscript[y,nd],
