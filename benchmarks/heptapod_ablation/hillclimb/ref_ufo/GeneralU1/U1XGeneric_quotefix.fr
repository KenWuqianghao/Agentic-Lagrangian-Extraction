  } ,
  U[13] == {
        ClassName -> ghBp,
	SelfConjugate -> False,
        Definitions -> {ghBp -> Sp ghZ + Cp ghZp },
	Indices -> {},
        Unphysical -> True,
	Ghost -> Bp},

