LD6Kin := Block[{mu, ii, jj, kk, gg, hh},
 ExpandIndices[
   del[D6uubar[ii], mu] del[D6uu[ii], mu] - MD6uu^2 D6uubar[ii] D6uu[ii]
 + I gs T6[gg,ii,jj] G[mu,gg] (D6uubar[ii] del[D6uu[jj], mu] - del[D6uubar[ii], mu] D6uu[jj])
 + gs^2 T6[gg,ii,jj] T6[hh,jj,kk] G[mu,gg] G[mu,hh] D6uubar[ii] D6uu[kk]
 + del[D6udbar[ii], mu] del[D6ud[ii], mu] - MD6ud^2 D6udbar[ii] D6ud[ii]
 + I gs T6[gg,ii,jj] G[mu,gg] (D6udbar[ii] del[D6ud[jj], mu] - del[D6udbar[ii], mu] D6ud[jj])
 + gs^2 T6[gg,ii,jj] T6[hh,jj,kk] G[mu,gg] G[mu,hh] D6udbar[ii] D6ud[kk]
 + del[D6ddbar[ii], mu] del[D6dd[ii], mu] - MD6dd^2 D6ddbar[ii] D6dd[ii]
 + I gs T6[gg,ii,jj] G[mu,gg] (D6ddbar[ii] del[D6dd[jj], mu] - del[D6ddbar[ii], mu] D6dd[jj])
 + gs^2 T6[gg,ii,jj] T6[hh,jj,kk] G[mu,gg] G[mu,hh] D6ddbar[ii] D6dd[kk]
 ]];

LD6EM := Block[{mu, ii, jj, gg},
 ExpandIndices[
   I ee (4/3) A[mu] (D6uubar[ii] del[D6uu[ii], mu] - del[D6uubar[ii], mu] D6uu[ii])
 + ee^2 (4/3)^2 A[mu] A[mu] D6uubar[ii] D6uu[ii]
 + 2 gs ee (4/3) T6[gg,ii,jj] G[mu,gg] A[mu] D6uubar[ii] D6uu[jj]
 + I ee (1/3) A[mu] (D6udbar[ii] del[D6ud[ii], mu] - del[D6udbar[ii], mu] D6ud[ii])
 + ee^2 (1/3)^2 A[mu] A[mu] D6udbar[ii] D6ud[ii]
 + 2 gs ee (1/3) T6[gg,ii,jj] G[mu,gg] A[mu] D6udbar[ii] D6ud[jj]
 + I ee (-2/3) A[mu] (D6ddbar[ii] del[D6dd[ii], mu] - del[D6ddbar[ii], mu] D6dd[ii])
 + ee^2 (2/3)^2 A[mu] A[mu] D6ddbar[ii] D6dd[ii]
 + 2 gs ee (-2/3) T6[gg,ii,jj] G[mu,gg] A[mu] D6ddbar[ii] D6dd[jj]
 ]];

LD3Kin := Block[{mu, cc},
 ExpandIndices[
   DC[D3uubar[cc], mu] DC[D3uu[cc], mu] - MD3uu^2 D3uubar[cc] D3uu[cc]
 + DC[D3udbar[cc], mu] DC[D3ud[cc], mu] - MD3ud^2 D3udbar[cc] D3ud[cc]
 + DC[D3ddbar[cc], mu] DC[D3dd[cc], mu] - MD3dd^2 D3ddbar[cc] D3dd[cc]
 ]];

LD3EM := Block[{mu, cc, dd, gg},
 ExpandIndices[
   I ee (4/3) A[mu] (D3uubar[cc] del[D3uu[cc], mu] - del[D3uubar[cc], mu] D3uu[cc])
 + ee^2 (4/3)^2 A[mu] A[mu] D3uubar[cc] D3uu[cc]
 + 2 gs ee (4/3) T[gg,cc,dd] G[mu,gg] A[mu] D3uubar[cc] D3uu[dd]
 + I ee (1/3) A[mu] (D3udbar[cc] del[D3ud[cc], mu] - del[D3udbar[cc], mu] D3ud[cc])
 + ee^2 (1/3)^2 A[mu] A[mu] D3udbar[cc] D3ud[cc]
 + 2 gs ee (1/3) T[gg,cc,dd] G[mu,gg] A[mu] D3udbar[cc] D3ud[dd]
 + I ee (-2/3) A[mu] (D3ddbar[cc] del[D3dd[cc], mu] - del[D3ddbar[cc], mu] D3dd[cc])
 + ee^2 (2/3)^2 A[mu] A[mu] D3ddbar[cc] D3dd[cc]
 + 2 gs ee (-2/3) T[gg,cc,dd] G[mu,gg] A[mu] D3ddbar[cc] D3dd[dd]
 ]];

LDQ6 := Block[{sp1, sp2, ff1, ff2, ii, aa, bb, ldq6},
 ldq6 = 2 Sqrt[2] K6[ii,aa,bb] (
     D6uu[ii] ( lamL6uu[ff1,ff2] uqbar[sp1,ff1,aa].ProjM[sp1,sp2].CC[uq][sp2,ff2,bb]
              + lamR6uu[ff1,ff2] uqbar[sp1,ff1,aa].ProjP[sp1,sp2].CC[uq][sp2,ff2,bb] )
   + D6ud[ii] ( lamL6ud[ff1,ff2] uqbar[sp1,ff1,aa].ProjM[sp1,sp2].CC[dq][sp2,ff2,bb]
              + lamR6ud[ff1,ff2] uqbar[sp1,ff1,aa].ProjP[sp1,sp2].CC[dq][sp2,ff2,bb] )
   + D6dd[ii] ( lamL6dd[ff1,ff2] dqbar[sp1,ff1,aa].ProjM[sp1,sp2].CC[dq][sp2,ff2,bb]
              + lamR6dd[ff1,ff2] dqbar[sp1,ff1,aa].ProjP[sp1,sp2].CC[dq][sp2,ff2,bb] ) );
 ExpandIndices[ldq6 + HC[ldq6]]];

LDQ3 := Block[{sp1, sp2, ff1, ff2, aa, bb, cc, ldq3},
 ldq3 = 2 Sqrt[2] (Eps[aa,bb,cc]/Sqrt[2]) (
     D3uu[cc] ( lamL3uu[ff1,ff2] uqbar[sp1,ff1,aa].ProjM[sp1,sp2].CC[uq][sp2,ff2,bb]
              + lamR3uu[ff1,ff2] uqbar[sp1,ff1,aa].ProjP[sp1,sp2].CC[uq][sp2,ff2,bb] )
   + D3ud[cc] ( lamL3ud[ff1,ff2] uqbar[sp1,ff1,aa].ProjM[sp1,sp2].CC[dq][sp2,ff2,bb]
              + lamR3ud[ff1,ff2] uqbar[sp1,ff1,aa].ProjP[sp1,sp2].CC[dq][sp2,ff2,bb] )
   + D3dd[cc] ( lamL3dd[ff1,ff2] dqbar[sp1,ff1,aa].ProjM[sp1,sp2].CC[dq][sp2,ff2,bb]
              + lamR3dd[ff1,ff2] dqbar[sp1,ff1,aa].ProjP[sp1,sp2].CC[dq][sp2,ff2,bb] ) );
 ExpandIndices[ldq3 + HC[ldq3]]];

LDiquark := LD6Kin + LD6EM + LD3Kin + LD3EM + LDQ6 + LDQ3;
