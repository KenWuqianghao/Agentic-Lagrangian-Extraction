LK2kin := Block[{ii, mu}, ExpandIndices[DC[K2bar[ii], mu] DC[K2[ii], mu] - MK2^2 K2bar[ii] K2[ii], FlavorExpand -> {SU2D, SU2W}]];

Lpi3kin := Block[{aa, mu}, ExpandIndices[1/2 DC[pi3[aa], mu] DC[pi3[aa], mu] - 1/2 Mpi3^2 pi3[aa] pi3[aa], FlavorExpand -> SU2W]];

Letakin := Block[{mu}, ExpandIndices[1/2 del[eta, mu] del[eta, mu] - 1/2 Meta^2 eta eta]];

Letapkin := Block[{mu}, ExpandIndices[1/2 del[etap, mu] del[etap, mu] - 1/2 Metap^2 etap etap]];

Lrlxkin := Block[{mu}, ExpandIndices[1/2 del[rlx, mu] del[rlx, mu] - 1/2 Mrlx^2 rlx rlx]];

LKmix0 := Block[{ii}, ExpandIndices[-I Sqrt[2] gRho fpi^2 BB K2bar[ii] Phi[ii], FlavorExpand -> SU2D]];

LKmix := LKmix0 + HC[LKmix0];

LKpi0 := Block[{ii, jj, aa}, ExpandIndices[-Sqrt[2] gRho AA fpi (2 K2bar[ii] Ta[aa, ii, jj] Phi[jj] pi3[aa] - eta K2bar[ii] Phi[ii]/Sqrt[3]), FlavorExpand -> {SU2D, SU2W}]];

LKpi := LKpi0 + HC[LKpi0];

Leta3 := Block[{ii, jj, aa}, ExpandIndices[gRho (mLim - mNim) eta/Sqrt[3] (4 fpi^2 - 2 eta eta/9) + 2 gRho eta/Sqrt[3] (mNim K2bar[ii] K2[ii] - mLim pi3[aa] pi3[aa]) + 4/3 gRho (2 mLim + mNim) K2bar[ii] Ta[aa, ii, jj] K2[jj] pi3[aa], FlavorExpand -> {SU2D, SU2W}]];

Lpi3anom := Block[{mu, nu, ro, si, aa}, ExpandIndices[g1 gw NHC/(64 Pi^2 fpi) Eps[mu, nu, ro, si] pi3[aa] FS[Wi, mu, nu, aa] FS[B, ro, si], FlavorExpand -> SU2W]];

Letaanom := Block[{mu, nu, ro, si, aa}, ExpandIndices[-NHC/(64 Sqrt[3] Pi^2 fpi) eta Eps[mu, nu, ro, si] (gw^2 FS[Wi, mu, nu, aa] FS[Wi, ro, si, aa] + g1^2 FS[B, mu, nu] FS[B, ro, si]), FlavorExpand -> SU2W]];

LVLCLN := LK2kin + Lpi3kin + Letakin + Letapkin + Lrlxkin + LKmix + LKpi + Leta3 + Lpi3anom + Letaanom;
