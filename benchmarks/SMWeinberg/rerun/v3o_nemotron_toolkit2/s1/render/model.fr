LG0GP := gw^2*mNv/(4*Sqrt[2]*MW^2) G0.GP (Nvbar.ProjM.l[ff] + bar[CC[l[ff]]].ProjM.Nv) + HC[gw^2*mNv/(4*Sqrt[2]*MW^2) G0.GP (Nvbar.ProjM.l[ff] + bar[CC[l[ff]]].ProjM.Nv)];

