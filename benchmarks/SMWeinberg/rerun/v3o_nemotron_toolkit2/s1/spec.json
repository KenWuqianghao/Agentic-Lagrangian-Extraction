    "date": "25.09.2026",
    "institutions": ["Sorbonne Universite", "DESY", "Institute of Nuclear Physics PAN", "CERN"],
    "emails": ["fuks@lpthe.jussieu.fr", "jonas.neundorf@desy.de", "krisztian.peters@desy.de", "rruiz@ifj.edu.pl", "matthias.saimpert@cern.ch"]
  },
  "interaction_order_hierarchy": [["QCD", 1], ["QED", 2], ["NP", 1]],
  "interaction_order_limit": [["NP", 1]],
  "feynman_gauge": true,
  "vevs": [],
  "gauge_groups": [],
  "index_decls": [],
  "parameters": [
    {
      "name": "Lambda",
      "parameter_type": "External",
      "value": "200000.",
      "block_name": "NUPHYSICS",
      "order_block": 1,
      "interaction_order": ["NP", -1],
      "description": "EFT cutoff scale [GeV], Eq.(108)"
    },
    {
      "name": "C5ll",
      "parameter_type": "External",
      "indices": ["Generation", "Generation"],
      "value_rules": [
        {"lhs": "C5ll[1,1]", "rhs": "0", "delayed": false},
        {"lhs": "C5ll[1,2]", "rhs": "0", "delayed": false},
        {"lhs": "C5ll[1,3]", "rhs": "0", "delayed": false},
        {"lhs": "C5ll[2,1]", "rhs": "C5ll[1,2]", "delayed": false},
        {"lhs": "C5ll[2,2]", "rhs": "1", "delayed": false},
        {"lhs": "C5ll[2,3]", "rhs": "0", "delayed": false},
        {"lhs": "C5ll[3,1]", "rhs": "C5ll[1,3]", "delayed": false},
        {"lhs": "C5ll[3,2]", "rhs": "C5ll[2,3]", "delayed": false},
        {"lhs": "C5ll[3,3]", "rhs": "0", "delayed": false}
      ],
      "block_name": "NUPHYSICS",
      "interaction_order": ["NP", 1],
      "description": "Wilson coefficient matrix C_5^{ll'} for Weinberg operator, symmetric, Eq.(108)",
      "symmetric": true
    },
    {
      "name": "mNv",
      "parameter_type": "Internal",
      "value": "Abs[C5ll[1,1]+C5ll[1,2]+C5ll[1,3]+C5ll[2,1]+C5ll[2,2]+C5ll[2,3]+C5ll[3,1]+C5ll[3,2]+C5ll[3,3]]*vev^2/Lambda",
      "interaction_order": ["NP", -1],
      "description": "Majorana neutrino mass m_N = |sum C_5^{ll'}| v^2/Lambda, Eq.(188)"
    },
    {
      "name": "wNv",
      "parameter_type": "Internal",
      "value": "1.",
      "description": "Majorana neutrino width placeholder"
    }
  ],
  "particles": [
    {
      "spin_type": "F",
      "class_index": 100,
      "class_name": "Nv",
      "self_conjugate": true,
      "indices": [],
      "flavor_index": null,
      "class_members": [],
      "mass": {"massless": false, "sym": "mNv", "value": "Internal"},
      "width": {"massless": false, "sym": "wNv", "value": "Internal"},
      "quantum_numbers": {},
      "pdg": 9900012,
      "particle_name": "Nv",
      "antiparticle_name": "Nv",
      "full_name": "Majorana Neutrino (Weinberg)",
      "propagator_label": "Nv",
      "propagator_type": "Straight",
      "propagator_arrow": "None",
      "unphysical": false,
      "definitions": [],
      "chirality": "L"
    }
  ],
  "gauge_xi": [],
  "lagrangian_terms": [
    {
      "name": "LKinNv",
      "expression": "I/2 Nvbar.Ga[mu].del[Nv, mu] - 1/2 mNv Nvbar.Nv",
      "delayed": true
    },
    {
      "name": "LCC",
      "expression": "-gw/Sqrt[2] W[mu] (Nvbar.Ga[mu].ProjM.l[ff]) + HC[-gw/Sqrt[2] W[mu] (Nvbar.Ga[mu].ProjM.l[ff])]",
      "delayed": true
    },
    {
      "name": "LNC",
      "expression": "-gw/(2*cw) Z[mu] (Nvbar.Ga[mu].ProjM.vl[ff]) + HC[-gw/(2*cw) Z[mu] (Nvbar.Ga[mu].ProjM.vl[ff])]",
      "delayed": true
    },
    {
      "name": "LHiggsNv",
      "expression": "-gw*mNv/(2*MW) H (1 + gw/(4*MW) H) (Nvbar.ProjM.vl[ff]) + HC[-gw*mNv/(2*MW) H (1 + gw/(4*MW) H) (Nvbar.ProjM.vl[ff])]",
      "delayed": true
    },
    {
      "name": "LGP",
      "expression": "-I*gw*mNv/(2*Sqrt[2]*MW) GP (1 + gw/(2*MW) H) (Nvbar.ProjM.l[ff] + bar[CC[l[ff]]].ProjM.Nv) + HC[-I*gw*mNv/(2*Sqrt[2]*MW) GP (1 + gw/(2*MW) H) (Nvbar.ProjM.l[ff] + bar[CC[l[ff]]].ProjM.Nv)]",
      "delayed": true
    },
    {
      "name": "LG0",
      "expression": "-I*gw*mNv/(2*MW) G0 (1 + gw/(2*MW) H) (Nvbar.ProjM.vl[ff]) + HC[-I*gw*mNv/(2*MW) G0 (1 + gw/(2*MW) H) (Nvbar.ProjM.vl[ff])]",
      "delayed": true
    },
    {
      "name": "LGPGP",
      "expression": "gw^2*mNv/(8*MW^2) (2 GP.GP (bar[CC[l[ff]]].ProjM.l[ffp]) + G0.G0 (Nvbar.ProjM.vl[ff])) + HC[gw^2*mNv/(8*MW^2) (2 GP.GP (bar[CC[l[ff]]].ProjM.l[ffp]) + G0.G0 (Nvbar.ProjM.vl[ff]))]",
      "delayed": true
    },
    {
      "name": "LG0GP",
      "expression": "gw^2*mNv/(4*Sqrt[2]*MW^2) G0.GP (Nvbar.ProjM.l[ff] + bar[CC[l[ff]]].ProjM.Nv) + HC[gw^2*mNv/(4*Sqrt[2]*MW^2) G0.GP (Nvbar.ProjM.l[ff] + bar[CC[l[ff]]].ProjM.Nv)]",
      "delayed": true
    },
    {
      "name": "LTotal",
      "expression": "LKinNv + LCC + LNC + LHiggsNv + LGP + LG0 + LGPGP + LG0GP",
      "delayed": true
    }
  ],
  "raw_preamble": [],
  "raw_blocks": []
}