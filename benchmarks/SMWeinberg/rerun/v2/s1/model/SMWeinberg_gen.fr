M$ClassesDescription = {
  F[100] == {
    ClassName -> N,
    SelfConjugate -> True,
    Mass -> {mN, Internal},
    Width -> {wN, Internal},
    PDG -> 9900012,
    ParticleName -> "n1",
    FullName -> "Unphysical Majorana neutrino",
    PropagatorLabel -> "N",
    PropagatorType -> S,
    PropagatorArrow -> None
  }
