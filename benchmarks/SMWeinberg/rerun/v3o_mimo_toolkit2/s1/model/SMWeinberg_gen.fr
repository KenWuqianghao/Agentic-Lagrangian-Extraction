LNkin := Block[{mu}, I/2 NMbar.Ga[mu].del[NM, mu] - 1/2 mN NMbar.NM];

LNW := Block[{mu, ff}, Sum[-gw/Sqrt[2] W[mu] NMbar.Ga[mu].ProjM.l[ff] + HC[-gw/Sqrt[2] W[mu] NMbar.Ga[mu].ProjM.l[ff]], {ff, 1, 3}]];

