LNH := Block[{ff}, Sum[-gw*mN/(2*MW)*H*(1 + gw/(4*MW)*H)*NMbar.ProjM.vl[ff] + HC[-gw*mN/(2*MW)*H*(1 + gw/(4*MW)*H)*NMbar.ProjM.vl[ff]], {ff, 1, 3}]];

LNGP := Block[{ff}, Sum[-I*gw*mN/(2*Sqrt[2]*MW)*GP*(1 + gw/(2*MW)*H)*(NMbar.ProjM.l[ff] + bar[CC[l[ff]]].ProjM.NM) + HC[-I*gw*mN/(2*Sqrt[2]*MW)*GP*(1 + gw/(2*MW)*H)*(NMbar.ProjM.l[ff] + bar[CC[l[ff]]].ProjM.NM)], {ff, 1, 3}]];

LNG0 := Block[{ff}, Sum[-I*gw*mN/(2*MW)*G0*(1 + gw/(2*MW)*H)*NMbar.ProjM.vl[ff] + HC[-I*gw*mN/(2*MW)*G0*(1 + gw/(2*MW)*H)*NMbar.ProjM.vl[ff]], {ff, 1, 3}]];

LGG1 := Block[{ff, ff2}, gw^2*mN/(8*MW^2)*(2*GP*GP*Sum[bar[CC[l[ff]]].ProjM.l[ff2], {ff, 1, 3}, {ff2, 1, 3}] + G0*G0*Sum[NMbar.ProjM.vl[ff], {ff, 1, 3}]) + HC[gw^2*mN/(8*MW^2)*(2*GP*GP*Sum[bar[CC[l[ff]]].ProjM.l[ff2], {ff, 1, 3}, {ff2, 1, 3}] + G0*G0*Sum[NMbar.ProjM.vl[ff], {ff, 1, 3}])]];

LGG2 := Block[{ff}, gw^2*mN/(4*Sqrt[2]*MW^2)*G0*GP*Sum[NMbar.ProjM.l[ff] + bar[CC[l[ff]]].ProjM.NM, {ff, 1, 3}] + HC[gw^2*mN/(4*Sqrt[2]*MW^2)*G0*GP*Sum[NMbar.ProjM.l[ff] + bar[CC[l[ff]]].ProjM.NM, {ff, 1, 3}]]];

LTotal := LNkin + LNW + LNZ + LNH + LNGP + LNG0 + LGG1 + LGG2;
