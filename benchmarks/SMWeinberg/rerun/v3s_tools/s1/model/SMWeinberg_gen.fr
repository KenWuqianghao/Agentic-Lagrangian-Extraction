LNkin := Block[{mu}, ExpandIndices[I/2 NMbar.Ga[mu].del[NM,mu] - 1/2 mN NMbar.NM]];

LNCC := Block[{mu, expr}, expr = ExpandIndices[-(gw/Sqrt[2]) W[mu] NMbar.Ga[mu].ProjM.l, FlavorExpand -> Generation]; expr + HC[expr]];

LNNC := Block[{mu, expr}, expr = ExpandIndices[-(gw/(2 cw)) Z[mu] NMbar.Ga[mu].ProjM.vl, FlavorExpand -> Generation]; expr + HC[expr]];

LNH := Block[{expr}, expr = ExpandIndices[-(gw mN/(2 MW)) H (1 + (gw/(4 MW)) H) NMbar.ProjM.vl, FlavorExpand -> Generation]; expr + HC[expr]];

LNGP := Block[{expr}, expr = ExpandIndices[-I (gw mN/(2 Sqrt[2] MW)) GP (1 + (gw/(2 MW)) H) (NMbar.ProjM.l + bar[CC[l]].ProjM.NM), FlavorExpand -> Generation]; expr + HC[expr]];

LNG0 := Block[{expr}, expr = ExpandIndices[-I (gw mN/(2 MW)) G0 (1 + (gw/(2 MW)) H) NMbar.ProjM.vl, FlavorExpand -> Generation]; expr + HC[expr]];

LNGPGP := Block[{ff1, ff2, expr}, expr = ExpandIndices[(gw^2 mN/(4 MW^2)) GP GP bar[CC[l[ff1]]].ProjM.l[ff2], FlavorExpand -> Generation]; expr + HC[expr]];

LNG0G0 := Block[{expr}, expr = ExpandIndices[(gw^2 mN/(8 MW^2)) G0 G0 NMbar.ProjM.vl, FlavorExpand -> Generation]; expr + HC[expr]];

LNG0GP := Block[{expr}, expr = ExpandIndices[(gw^2 mN/(4 Sqrt[2] MW^2)) G0 GP (NMbar.ProjM.l + bar[CC[l]].ProjM.NM), FlavorExpand -> Generation]; expr + HC[expr]];

LWeinberg := LNkin + LNCC + LNNC + LNH + LNGP + LNG0 + LNGPGP + LNG0G0 + LNG0GP;

LTotal := LSM + LWeinberg;
