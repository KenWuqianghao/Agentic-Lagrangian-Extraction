LNkin := I/2 Nwbar[sp].Ga[mu].del[Nw[sp], mu] - 1/2 mN Nwbar[sp].Nw[sp];

LintW := -gw/Sqrt[2] W[mu] Sum[Nwbar[sp].Ga[mu].ProjM.l[sp,ff], {ff, 3}];

LintZ := -gw/(2*cw) Z[mu] Sum[Nwbar[sp].Ga[mu].ProjM.vl[sp,ff], {ff, 3}];

Linth := -gw*mN/(2*MW) H (1 + gw/(4*MW) H) Sum[Nwbar[sp].ProjM.vl[sp,ff], {ff, 3}];

LintGP := -I*gw*mN/(2*Sqrt[2]*MW) GP (1 + gw/(2*MW) H) Sum[Nwbar[sp].ProjM.l[sp,ff] + bar[CC[l[sp,ff]]].ProjM.Nw[sp], {ff, 3}];

LintG0 := -I*gw*mN/(2*MW) G0 (1 + gw/(2*MW) H) Sum[Nwbar[sp].ProjM.vl[sp,ff], {ff, 3}];

LintGPGP := gw^2*mN/(8*MW^2) (2 GP*GP Sum[bar[CC[l[sp,ff]]].ProjM.l[sp2,ff2], {ff, 3}, {ff2, 3}] + G0*G0 Sum[Nwbar[sp].ProjM.vl[sp,ff], {ff, 3}]);

LintG0GP := gw^2*mN/(4*Sqrt[2]*MW^2) G0*GP Sum[Nwbar[sp].ProjM.l[sp,ff] + bar[CC[l[sp,ff]]].ProjM.Nw[sp], {ff, 3}];

LTotal := LNkin + HC[LintW] + HC[LintZ] + HC[Linth] + HC[LintGP] + HC[LintG0] + HC[LintGPGP] + HC[LintG0GP];
