LSkin := Block[{mu}, ExpandIndices[1/2 del[s,mu] del[s,mu] - 1/2 Ms^2 s^2]];

LT := Block[{mu}, ExpandIndices[I*Tpbar.Ga[mu].DC[Tp,mu] - gTS*Sgauge*Tpbar.Tp]];

LYT := Block[{sp,ii,jj,cc,yuk}, yuk = ExpandIndices[-yprime*QLbar[sp,ii,3,cc].TpR[sp,cc]*Phibar[jj]*Eps[ii,jj], FlavorExpand->SU2D]; yuk + HC[yuk]];

LPortal := Block[{ii}, ExpandIndices[(kappa/2)*Sgauge^2*Phibar[ii]*Phi[ii], FlavorExpand->SU2D]];

LSself := (lambdaS/24)*Sgauge^4;

LTotal := LSM + LSkin + LT + LYT + LPortal + LSself;
