(* ======================================================================= *)
(*  pSPSS_gen : FeynRules add-on for the phenomenological Symmetry         *)
(*  Protected Seesaw Scenario (pSPSS), extracted from arXiv:2210.10738     *)
(*  (Antusch, Hajer, Rosskopp). Loads on top of SM.fr (Christensen/Duhr/   *)
(*  Fuks v1.4.7). No reference or cached model file was read; extraction   *)
(*  is from the paper's LaTeX source alone.                                *)
(* ======================================================================= *)

M$ModelName = "pSPSS_gen";

M$Information = {
  Authors     -> {"extracted from arXiv:2210.10738"},
  Version     -> "1.0",
  Date        -> "2023",
  Description -> "pSPSS: two pseudo-Dirac sterile Majorana neutrinos N1,N2 \
(interaction basis) with physical mass eigenstates n4,n5, mixing with the SM \
lepton doublet via active-sterile mixing theta_e,theta_mu,theta_tau, a common \
Majorana mass Mmaj and a mass splitting deltaM. See paper Secs. 3-4."
};

(* ************************** *)
(* *** Interaction orders *** *)
(* ************************** *)
M$InteractionOrderHierarchy = {
  {QCD, 1},
  {QED, 2},
  {NP,  1}
};

(* No new index types are required: N1L, N2L, n4, n5, PhiNP carry no new    *)
(* index (a single pseudo-Dirac pair, minimal n=2 sterile-neutrino setup). *)
(* Generation, SU2D, SU2W, Colour, Gluon are already declared by SM.fr.    *)

(* ************************** *)
(* *****   Parameters   ***** *)
(* ************************** *)
M$Parameters = {

  (* ---- External: the six pSPSS param.card entries, BLOCK PSPSS, Table 2 ---- *)
  Mmaj == {
    ParameterType -> External,
    BlockName     -> PSPSS,
    OrderBlock    -> 1,
    Value         -> 100.,
    TeX           -> Subscript[m,M],
    Description   -> "pSPSS Majorana mass parameter m_M [GeV], Eq. (4.9)"
  },
  deltaM == {
    ParameterType -> External,
    BlockName     -> PSPSS,
    OrderBlock    -> 2,
    Value         -> 1.*^-12,
    TeX           -> Subscript[\[CapitalDelta]m,1],
    Description   -> "Heavy-neutrino mass splitting Delta m [GeV], Eq. (4.9)"
  },
  theta1 == {
    ParameterType -> External,
    BlockName     -> PSPSS,
    OrderBlock    -> 3,
    Value         -> 0.,
    TeX           -> Subscript[\[Theta], e],
    Description   -> "Active-sterile mixing parameter theta_e, Eq. (3.9)"
  },
  theta2 == {
    ParameterType -> External,
    BlockName     -> PSPSS,
    OrderBlock    -> 4,
    Value         -> 1.*^-3,
    TeX           -> Subscript[\[Theta], \[Mu]],
    Description   -> "Active-sterile mixing parameter theta_mu, Eq. (3.9)"
  },
  theta3 == {
    ParameterType -> External,
    BlockName     -> PSPSS,
    OrderBlock    -> 5,
    Value         -> 0.,
    TeX           -> Subscript[\[Theta], \[Tau]],
    Description   -> "Active-sterile mixing parameter theta_tau, Eq. (3.9)"
  },
  damping == {
    ParameterType -> External,
    BlockName     -> PSPSS,
    OrderBlock    -> 6,
    Value         -> 0.,
    TeX           -> \[Lambda],
    Description   -> "Decoherence damping parameter lambda (Sec. 3.3/4.1). Not \
a Lagrangian coupling: consumed only by the patched do_add_time_of_flight \
routine of App. B (param_card.get_value['PSPSS',6])."
  },

  (* ---- Internal: derived quantities ---- *)
  vevNP == {
    ParameterType    -> Internal,
    Value            -> vev,
    InteractionOrder -> {NP,-1},
    Description      -> "NP-power-counting copy of the Higgs VEV (numerically \
= vev); lets MadGraph count the seesaw Yukawa insertion as one power of NP, \
Sec. 4.1"
  },
  theta == {
    ParameterType    -> Internal,
    Indices          -> {Index[Generation]},
    Value            -> {theta[1] -> theta1, theta[2] -> theta2, theta[3] -> theta3},
    InteractionOrder -> {NP,1},
    TeX              -> Subscript[\[Theta], ff],
    Description      -> "Active-sterile mixing vector (theta_e,theta_mu,theta_tau), Eq. (3.9)"
  },
  thetaSq == {
    ParameterType -> Internal,
    Value         -> theta1^2 + theta2^2 + theta3^2,
    Description   -> "|theta|^2, used in the mass formula Eq. (4.9)/(3.6)"
  },
  yvn == {
    ParameterType    -> Internal,
    Indices          -> {Index[Generation]},
    Value            -> {yvn[1] -> Sqrt[2] theta[1] Mmaj / vevNP,
                          yvn[2] -> Sqrt[2] theta[2] Mmaj / vevNP,
                          yvn[3] -> Sqrt[2] theta[3] Mmaj / vevNP},
    InteractionOrder -> {NP,1},
    TeX              -> Superscript[y, \[Nu]N],
    Description      -> "Sterile-neutrino Yukawa vector y_(alpha 1), Eq. (2.1)/(4.2), \
fixed by theta_alpha = m_D/Mmaj (Eq. 3.9) with m_D = yvn*vevNP/Sqrt[2] (SM.fr Yukawa normalisation)"
  },
  Mn4 == {
    ParameterType -> Internal,
    Value         -> Mmaj (1 + thetaSq/2) - deltaM/2,
    TeX           -> Subscript[m,4],
    Description   -> "Physical mass of n4, Eq. (4.9)"
  },
  Mn5 == {
    ParameterType -> Internal,
    Value         -> Mmaj (1 + thetaSq/2) + deltaM/2,
    TeX           -> Subscript[m,5],
    Description   -> "Physical mass of n5, Eq. (4.9)"
  }
};

(* ************************** *)
(* **** Particle classes **** *)
(* ************************** *)
M$ClassesDescription = {

  (* Physical heavy Majorana mass eigenstates; PDG codes from App. B code listing *)
  F[104] == {
    ClassName       -> n4,
    SelfConjugate   -> True,
    Mass            -> {Mn4, Internal},
    Width           -> {Wn4, 1.*^-10},
    PDG             -> 8000011,
    ParticleName    -> "n4",
    PropagatorLabel -> "n4",
    PropagatorType  -> S,
    PropagatorArrow -> None,
    FullName        -> "Heavy neutrino mass eigenstate n4"
  },
  F[105] == {
    ClassName       -> n5,
    SelfConjugate   -> True,
    Mass            -> {Mn5, Internal},
    Width           -> {Wn5, 1.*^-10},
    PDG             -> 8000012,
    ParticleName    -> "n5",
    PropagatorLabel -> "n5",
    PropagatorType  -> S,
    PropagatorArrow -> None,
    FullName        -> "Heavy neutrino mass eigenstate n5"
  },

  (* Unphysical interaction-basis sterile Majorana fields, Sec. 4.1, Eq. (2.4)-(2.5).
     Relation to n4,n5 taken from the symmetric-limit U_N block of Sec. 3.1
     (leading order in theta, consistent with RemoveHigherOrder truncation). *)
  F[111] == {
    ClassName     -> N1L,
    Unphysical    -> True,
    SelfConjugate -> True,
    Definitions   -> { N1L[sp1_] :> (I n4[sp1] + n5[sp1])/Sqrt[2] }
  },
  F[112] == {
    ClassName     -> N2L,
    Unphysical    -> True,
    SelfConjugate -> True,
    Definitions   -> { N2L[sp1_] :> (-I n4[sp1] + n5[sp1])/Sqrt[2] }
  },

  (* Unphysical NP copy of the Higgs doublet, Sec. 4.1 *)
  S[111] == {
    ClassName      -> PhiNP,
    Unphysical     -> True,
    Indices        -> {Index[SU2D]},
    FlavorIndex    -> SU2D,
    SelfConjugate  -> False,
    QuantumNumbers -> {Y -> 1/2},
    Definitions    -> { PhiNP[1] -> -I GP, PhiNP[2] -> (vevNP + H + I G0)/Sqrt[2] }
  },

  (* Override of SM.fr's lepton doublet: the active neutrino component picks up
     an n4,n5 admixture through the active-sterile mixing, Eq. (3.13)/(4.6).
     The charged-lepton component is unchanged. *)
  F[11] == {
    ClassName      -> LL,
    Unphysical     -> True,
    Indices        -> {Index[SU2D], Index[Generation]},
    FlavorIndex    -> SU2D,
    SelfConjugate  -> False,
    QuantumNumbers -> {Y -> -1/2},
    Definitions    -> {
      LL[sp1_,1,ff_] :> Module[{sp2},
        ProjM[sp1,sp2] (vl[sp2,ff]
          - I/Sqrt[2] Conjugate[theta[ff]] n4[sp2]
          + 1/Sqrt[2] Conjugate[theta[ff]] n5[sp2]) ],
      LL[sp1_,2,ff_] :> Module[{sp2}, ProjM[sp1,sp2] l[sp2,ff]]
    }
  }
};

(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

(* Kinetic term of the sterile neutrinos, added to LFermions (Sec. 4.1, verbatim) *)
LNPkin := Block[{mu},
  ExpandIndices[ I (N1Lbar.Ga[mu].del[N1L,mu] + N2Lbar.Ga[mu].del[N2L,mu]) ]
];

(* Pseudo-Dirac Majorana mass term, added to LNP (Sec. 4.1, verbatim; Eq. (2.5)) *)
LNPmass := Block[{sp1},
  ExpandIndices[ - Mmaj CC[N1Lbar[sp1]].N2L[sp1] + HC[- Mmaj CC[N1Lbar[sp1]].N2L[sp1]] ]
];

(* Sterile-neutrino Yukawa term, added to LNP (Sec. 4.1, verbatim; Eq. (2.1)/(4.2)) *)
LNPyukawa := Block[{sp1,ii,jj,ff1,yuk},
  yuk = yvn[ff1] (CC[N1Lbar[sp1]].LL[sp1,ii,ff1] PhiNPbar[jj] Eps[ii,jj]);
  ExpandIndices[ yuk + HC[yuk], FlavorExpand -> {SU2D,Generation} ]
];

(* Truncate to second order in the mixing parameters theta1,theta2,theta3, as
   required by the validity of the LO mixing used above (Sec. 4.1). Exact code
   for the paper's own RemoveHigherOrder is not given; this is a documented
   reconstruction that drops individual powers above 2. *)
RemoveHigherOrder[expr_] := expr //. {
  theta1^n_ /; n > 2 :> 0,
  theta2^n_ /; n > 2 :> 0,
  theta3^n_ /; n > 2 :> 0
};

LpSPSS := RemoveHigherOrder[LNPkin + LNPmass + LNPyukawa];

LTotal := LSM + LpSPSS;
