LDQudKin := Block[{mu, cc}, DC[phiudbar[cc], mu] DC[phiud[cc], mu] - MDQud^2 phiudbar[cc] phiud[cc]];

LDQddKin := Block[{mu, cc}, DC[phiddbar[cc], mu] DC[phidd[cc], mu] - MDQdd^2 phiddbar[cc] phidd[cc]];

LDQuuKin := Block[{mu, cc}, DC[phiuubar[cc], mu] DC[phiuu[cc], mu] - MDQuu^2 phiuubar[cc] phiuu[cc]];

LDQudInt := Block[{ff1, ff2, cc1, cc2, cc3}, 2 Eps[cc1, cc2, cc3] phiud[cc1] (uqbar[ff1, cc2].(lamL1[ff1, ff2] ProjM + lamR1[ff1, ff2] ProjP).CC[dq][ff2, cc3])];

LDQddInt := Block[{ff1, ff2, cc1, cc2, cc3}, 2 Eps[cc1, cc2, cc3] phidd[cc1] (dqbar[ff1, cc2].(lamL2[ff1, ff2] ProjM + lamR2[ff1, ff2] ProjP).CC[dq][ff2, cc3])];

LDQuuInt := Block[{ff1, ff2, cc1, cc2, cc3}, 2 Eps[cc1, cc2, cc3] phiuu[cc1] (uqbar[ff1, cc2].(lamL3[ff1, ff2] ProjM + lamR3[ff1, ff2] ProjP).CC[uq][ff2, cc3])];

LDiquark := LDQudKin + LDQddKin + LDQuuKin + LDQudInt + HC[LDQudInt] + LDQddInt + HC[LDQddInt] + LDQuuInt + HC[LDQuuInt];

LTotal := LSM + LDiquark;
