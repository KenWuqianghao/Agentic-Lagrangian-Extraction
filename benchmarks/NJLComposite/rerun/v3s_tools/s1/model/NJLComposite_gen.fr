LPiLQCI3 := Block[{sp,ff,cc,vv}, vv = ExpandIndices[ gYLQ[ff] nuRbar[sp,ff].QL[sp,1,ff,cc] PiLQ23ubar[ff,cc] ]; vv + HC[vv]];

LPiLQCI4 := Block[{sp,ff,cc,vv}, vv = ExpandIndices[ gYLQ[ff] lRbar[sp,ff].dqL[sp,ff,cc] PiLQ23dbar[ff,cc] ]; vv + HC[vv]];

LTotal := LPiKin + LNrKin + LPiCI1 + LPiCI2 + LPiCI3 + LPiLQCI1 + LPiLQCI2 + LPiLQCI3 + LPiLQCI4;
