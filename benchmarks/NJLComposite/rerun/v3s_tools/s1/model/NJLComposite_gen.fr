LPiCI1 := Block[{sp,ff,cc,vv}, vv = ExpandIndices[ gY[ff] dRbar[sp,ff,cc].QL[sp,1,ff,cc] PiPlusbar[ff] ]; vv + HC[vv]];

LPiCI2 := Block[{sp,ff,cc,vv}, vv = ExpandIndices[ gY[ff] dRbar[sp,ff,cc].dqL[sp,ff,cc] Pi0dbar[ff] ]; vv + HC[vv]];

LPiCI3 := Block[{sp,ff,cc,vv}, vv = ExpandIndices[ gY[ff] uRbar[sp,ff,cc].QL[sp,1,ff,cc] Pi0ubar[ff] ]; vv + HC[vv]];

LPiLQCI1 := Block[{sp,ff,cc,vv}, vv = ExpandIndices[ gYLQ[ff] lRbar[sp,ff].QL[sp,1,ff,cc] PiLQ53bar[ff,cc] ]; vv + HC[vv]];

