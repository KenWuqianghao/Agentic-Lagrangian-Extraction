LPiKin := Block[{mu}, ExpandIndices[ DC[PiPlusbar,mu] DC[PiPlus,mu] - MPi^2 PiPlusbar PiPlus + DC[Pi0dbar,mu] DC[Pi0d,mu] - MPi^2 Pi0dbar Pi0d + DC[Pi0ubar,mu] DC[Pi0u,mu] - MPi^2 Pi0ubar Pi0u + DC[PiLQ53bar,mu] DC[PiLQ53,mu] - MPiLQ^2 PiLQ53bar PiLQ53 + DC[PiLQm13bar,mu] DC[PiLQm13,mu] - MPiLQ^2 PiLQm13bar PiLQm13 + DC[PiLQ23ubar,mu] DC[PiLQ23u,mu] - MPiLQ^2 PiLQ23ubar PiLQ23u + DC[PiLQ23dbar,mu] DC[PiLQ23d,mu] - MPiLQ^2 PiLQ23dbar PiLQ23d ]];

