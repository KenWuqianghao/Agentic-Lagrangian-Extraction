L_Pi12_kin := DC[Pi12bar, mu, ii] DC[Pi12, mu, ii] - MPi^2 Pi12bar[ii] Pi12[ii];

L_PiM12_kin := DC[PiM12bar, mu, ii] DC[PiM12, mu, ii] - MPi^2 PiM12bar[ii] PiM12[ii];

L_LQPi16_kin := DC[LQPi16bar, mu, ii, cc] DC[LQPi16, mu, ii, cc] - MPi^2 LQPi16bar[ii, cc] LQPi16[ii, cc];

L_LQPi76_kin := DC[LQPi76bar, mu, ii, cc] DC[LQPi76, mu, ii, cc] - MPi^2 LQPi76bar[ii, cc] LQPi76[ii, cc];

L_NR_kin := I NRbar.Ga[mu].DC[NR, mu] - MF NRbar.NR;

L_ER_kin := I ERbar.Ga[mu].DC[ER, mu] - MF ERbar.ER;

L_UR_kin := I URbar.Ga[mu].DC[UR, mu] - MF URbar.UR;

L_DR_kin := I DRbar.Ga[mu].DC[DR, mu] - MF DRbar.DR;

L_NRA_kin := I NRAbar.Ga[mu].DC[NRA, mu] - MF NRAbar.NRA;

L_ERA_kin := I ERAbar.Ga[mu].DC[ERA, mu] - MF ERAbar.ERA;

L_nuR_kin := I nuRbar.Ga[mu].DC[nuR, mu];

L_PiPlus_CI := gY dRbar.ProjP.uq PiMinus + HC[gY dRbar.ProjP.uq PiMinus];

L_Pi0d_CI := gY dRbar.ProjP.dq Pi0d + HC[gY dRbar.ProjP.dq Pi0d];

L_Pi0u_CI := gY uRbar.ProjP.uq Pi0u + HC[gY uRbar.ProjP.uq Pi0u];

L_Pi53_CI := gY lRbar.ProjP.uq Pi53 + HC[gY lRbar.ProjP.uq Pi53];

L_PiM13_CI := gY nuRbar.ProjP.dq PiM13 + HC[gY nuRbar.ProjP.dq PiM13];

L_Pi23u_CI := gY nuRbar.ProjP.uq Pi23u + HC[gY nuRbar.ProjP.uq Pi23u];

L_Pi23d_CI := gY lRbar.ProjP.dq Pi23d + HC[gY lRbar.ProjP.dq Pi23d];

L_U0bar_CI := (gStar^2/Lam^2) URbar.Ga[mu].ProjP.uR uqbar.Ga[mu].ProjP.vl + HC[(gStar^2/Lam^2) URbar.Ga[mu].ProjP.uR uqbar.Ga[mu].ProjP.vl];

L_Upbar_CI := (gStar^2/Lam^2) URbar.Ga[mu].ProjP.uR uqbar.Ga[mu].ProjP.l + HC[(gStar^2/Lam^2) URbar.Ga[mu].ProjP.uR uqbar.Ga[mu].ProjP.l];

L_Dpbar_CI := (gStar^2/Lam^2) DRbar.Ga[mu].ProjP.dR dqbar.Ga[mu].ProjP.l + HC[(gStar^2/Lam^2) DRbar.Ga[mu].ProjP.dR dqbar.Ga[mu].ProjP.l];

L_D0bar_CI := (gStar^2/Lam^2) DRbar.Ga[mu].ProjP.dR dqbar.Ga[mu].ProjP.vl + HC[(gStar^2/Lam^2) DRbar.Ga[mu].ProjP.dR dqbar.Ga[mu].ProjP.vl];

L_EM23bar_CI := (gStar^2/Lam^2) ERAbar.Ga[mu].ProjM.lR lRbar.Ga[mu].ProjM.uq + HC[(gStar^2/Lam^2) ERAbar.Ga[mu].ProjM.lR lRbar.Ga[mu].ProjM.uq];

L_Np13bar_CI := (gStar^2/Lam^2) NRAbar.Ga[mu].ProjM.nuR nuRbar.Ga[mu].ProjM.dq + HC[(gStar^2/Lam^2) NRAbar.Ga[mu].ProjM.nuR nuRbar.Ga[mu].ProjM.dq];

L_Ep13bar_CI := (gStar^2/Lam^2) ERAbar.Ga[mu].ProjM.lR lRbar.Ga[mu].ProjM.dq + HC[(gStar^2/Lam^2) ERAbar.Ga[mu].ProjM.lR lRbar.Ga[mu].ProjM.dq];

L_NM23bar_CI := (gStar^2/Lam^2) NRAbar.Ga[mu].ProjM.nuR nuRbar.Ga[mu].ProjM.uq + HC[(gStar^2/Lam^2) NRAbar.Ga[mu].ProjM.nuR nuRbar.Ga[mu].ProjM.uq];

L_U0_CI := (gStar^2/Lam^2) uRbar.Ga[mu].ProjP.UR uqbar.Ga[mu].ProjP.nuR + HC[(gStar^2/Lam^2) uRbar.Ga[mu].ProjP.UR uqbar.Ga[mu].ProjP.nuR];

L_Um_CI := (gStar^2/Lam^2) uRbar.Ga[mu].ProjP.UR uqbar.Ga[mu].ProjP.lR + HC[(gStar^2/Lam^2) uRbar.Ga[mu].ProjP.UR uqbar.Ga[mu].ProjP.lR];

L_Dm_CI := (gStar^2/Lam^2) dRbar.Ga[mu].ProjP.DR dqbar.Ga[mu].ProjP.lR + HC[(gStar^2/Lam^2) dRbar.Ga[mu].ProjP.DR dqbar.Ga[mu].ProjP.lR];

L_D0_CI := (gStar^2/Lam^2) dRbar.Ga[mu].ProjP.DR dqbar.Ga[mu].ProjP.nuR + HC[(gStar^2/Lam^2) dRbar.Ga[mu].ProjP.DR dqbar.Ga[mu].ProjP.nuR];

L_E23_CI := (gStar^2/Lam^2) eLbar.Ga[mu].ProjP.ERA lRbar.Ga[mu].ProjP.uR + HC[(gStar^2/Lam^2) eLbar.Ga[mu].ProjP.ERA lRbar.Ga[mu].ProjP.uR];

L_Nm13_CI := (gStar^2/Lam^2) nuLbar.Ga[mu].ProjP.NRA nuRbar.Ga[mu].ProjP.dR + HC[(gStar^2/Lam^2) nuLbar.Ga[mu].ProjP.NRA nuRbar.Ga[mu].ProjP.dR];

L_Ep13_CI := (gStar^2/Lam^2) eLbar.Ga[mu].ProjP.ERA lRbar.Ga[mu].ProjP.dR + HC[(gStar^2/Lam^2) eLbar.Ga[mu].ProjP.ERA lRbar.Ga[mu].ProjP.dR];

L_N23_CI := (gStar^2/Lam^2) nuLbar.Ga[mu].ProjP.NRA nuRbar.Ga[mu].ProjP.uR + HC[(gStar^2/Lam^2) nuLbar.Ga[mu].ProjP.NRA nuRbar.Ga[mu].ProjP.uR];

LTotal := L_Pi12_kin + L_PiM12_kin + L_LQPi16_kin + L_LQPi76_kin + L_NR_kin + L_ER_kin + L_UR_kin + L_DR_kin + L_NRA_kin + L_ERA_kin + L_nuR_kin + L_PiPlus_CI + L_Pi0d_CI + L_Pi0u_CI + L_Pi53_CI + L_PiM13_CI + L_Pi23u_CI + L_Pi23d_CI + L_U0bar_CI + L_Upbar_CI + L_Dpbar_CI + L_D0bar_CI + L_EM23bar_CI + L_Np13bar_CI + L_Ep13bar_CI + L_NM23bar_CI + L_U0_CI + L_Um_CI + L_Dm_CI + L_D0_CI + L_E23_CI + L_Nm13_CI + L_Ep13_CI + L_N23_CI;
