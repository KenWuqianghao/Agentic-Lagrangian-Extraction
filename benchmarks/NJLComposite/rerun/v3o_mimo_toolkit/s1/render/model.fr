LPI1kin := ExpandIndices[DC[PI1bar[ii],mu] DC[PI1[ii],mu] - mPi^2 PI1bar[ii] PI1[ii], FlavorExpand->SU2D];

LPI2kin := ExpandIndices[DC[PI2bar[ii],mu] DC[PI2[ii],mu] - mPi^2 PI2bar[ii] PI2[ii], FlavorExpand->SU2D];

LHc1kin := ExpandIndices[DC[Hc1bar[ii],mu] DC[Hc1[ii],mu] - mPi^2 Hc1bar[ii] Hc1[ii], FlavorExpand->SU2D];

LHc2kin := ExpandIndices[DC[Hc2bar[ii],mu] DC[Hc2[ii],mu] - mPi^2 Hc2bar[ii] Hc2[ii], FlavorExpand->SU2D];

LLQ1kin := ExpandIndices[DC[LQ1bar[ii,cc],mu] DC[LQ1[ii,cc],mu] - mPi^2 LQ1bar[ii,cc] LQ1[ii,cc], FlavorExpand->SU2D];

LLQ2kin := ExpandIndices[DC[LQ2bar[ii,cc],mu] DC[LQ2[ii,cc],mu] - mPi^2 LQ2bar[ii,cc] LQ2[ii,cc], FlavorExpand->SU2D];

LFN1kin := ExpandIndices[I FN1bar.Ga[mu].DC[FN1, mu] - MF FN1bar.FN1, FlavorExpand->SU2D];

LFE1kin := ExpandIndices[I FE1bar.Ga[mu].DC[FE1, mu] - MF FE1bar.FE1, FlavorExpand->SU2D];

LFNskin := ExpandIndices[I FNsbar.Ga[mu].DC[FNs, mu] - MF FNsbar.FNs, FlavorExpand->Generation];

LFEskin := ExpandIndices[I FEsbar.Ga[mu].DC[FEs, mu] - MF FEsbar.FEs, FlavorExpand->Generation];

LFN2kin := ExpandIndices[I FN2bar.Ga[mu].DC[FN2, mu] - MF FN2bar.FN2, FlavorExpand->SU2D];

LFE2kin := ExpandIndices[I FE2bar.Ga[mu].DC[FE2, mu] - MF FE2bar.FE2, FlavorExpand->SU2D];

LFNsCkin := ExpandIndices[I FNsCbar.Ga[mu].DC[FNsC, mu] - MF FNsCbar.FNsC, FlavorExpand->Generation];

LFEsCkin := ExpandIndices[I FEsCbar.Ga[mu].DC[FEsC, mu] - MF FEsCbar.FEsC, FlavorExpand->Generation];

LFU1kin := ExpandIndices[I FU1bar.Ga[mu].DC[FU1, mu] - MF FU1bar.FU1, FlavorExpand->SU2D];

LFD1kin := ExpandIndices[I FD1bar.Ga[mu].DC[FD1, mu] - MF FD1bar.FD1, FlavorExpand->SU2D];

LFUsCkin := ExpandIndices[I FUsCbar.Ga[mu].DC[FUsC, mu] - MF FUsCbar.FUsC, FlavorExpand->Generation];

LFDsCkin := ExpandIndices[I FDsCbar.Ga[mu].DC[FDsC, mu] - MF FDsCbar.FDsC, FlavorExpand->Generation];

Lnurkin := I/2 nurbar.Ga[mu].del[nur, mu] - 1/2 MN nurbar.nur;

LYPI := ExpandIndices[gY dRbar[sp1,ff,cc] QL[sp1,1,ff,cc] PIm + gY dRbar[sp1,ff,cc] QL[sp1,2,ff,cc] PI0dbar + gY uRbar[sp1,ff,cc] QL[sp1,1,ff,cc] PI0ubar + gY uRbar[sp1,ff,cc] Conjugate[CKM[ff,ff2]] dq[sp1,ff2,cc] Pip + gYp dRbar[sp1,ff,cc] QL[sp1,1,ff,cc] PIm, FlavorExpand->{SU2D,SU2W}] + HC[gY dRbar[sp1,ff,cc] QL[sp1,1,ff,cc] PIm + gY dRbar[sp1,ff,cc] QL[sp1,2,ff,cc] PI0dbar + gY uRbar[sp1,ff,cc] QL[sp1,1,ff,cc] PI0ubar + gY uRbar[sp1,ff,cc] Conjugate[CKM[ff,ff2]] dq[sp1,ff2,cc] Pip];

LYLQ := ExpandIndices[gY eRbar[sp1,ff] QL[sp1,1,ff,cc] LQ53[cc] + gY vyRbar[sp1,ff] QL[sp1,2,ff,cc] LQm13[cc] + gY vyRbar[sp1,ff] QL[sp1,1,ff,cc] LQ23u[cc] + gY eRbar[sp1,ff] QL[sp1,2,ff,cc] LQ23d[cc], FlavorExpand->SU2D] + HC[gY eRbar[sp1,ff] QL[sp1,1,ff,cc] LQ53[cc] + gY vyRbar[sp1,ff] QL[sp1,2,ff,cc] LQm13[cc] + gY vyRbar[sp1,ff] QL[sp1,1,ff,cc] LQ23u[cc] + gY eRbar[sp1,ff] QL[sp1,2,ff,cc] LQ23d[cc]];

LHcFF := ExpandIndices[gY dRbar[sp1,ff,cc] QL[sp1,1,ff,cc] Hcm + gY dRbar[sp1,ff,cc] QL[sp1,2,ff,cc] Hc0dbar + gY uRbar[sp1,ff,cc] QL[sp1,1,ff,cc] Hc0ubar + gY uRbar[sp1,ff,cc] Conjugate[CKM[ff,ff2]] dq[sp1,ff2,cc] Hcp, FlavorExpand->{SU2D,SU2W}] + HC[gY dRbar[sp1,ff,cc] QL[sp1,1,ff,cc] Hcm + gY dRbar[sp1,ff,cc] QL[sp1,2,ff,cc] Hc0dbar + gY uRbar[sp1,ff,cc] QL[sp1,1,ff,cc] Hc0ubar + gY uRbar[sp1,ff,cc] Conjugate[CKM[ff,ff2]] dq[sp1,ff2,cc] Hcp];

LFCI := gst^2/Lam^2 ((FU0bar[sp1,ff,cc] uR[sp2,ff,cc])(uRbar[sp2,ff2,cc] vl[sp1,ff2]) + (FUpb[sp1,ff,cc] uR[sp2,ff,cc])(uRbar[sp2,ff2,cc] l[sp1,ff2]) + (FDpb[sp1,ff,cc] dq[sp2,ff,cc])(dqbar[sp2,ff2,cc] l[sp1,ff2]) + (FD0bar[sp1,ff,cc] dq[sp2,ff,cc])(dqbar[sp2,ff2,cc] vl[sp1,ff2]) + (FE23bar[sp1,ff,cc] eR[sp2,ff])(eRbar[sp2,ff] uL[sp1,ff,cc]) + (FNm13bar[sp1,ff,cc] vyR[sp2,ff])(vyRbar[sp2,ff] dL[sp1,ff,cc]) + (FEp13bar[sp1,ff,cc] eR[sp2,ff])(eRbar[sp2,ff] dL[sp1,ff,cc]) + (FN23bar[sp1,ff,cc] vyR[sp2,ff])(vyRbar[sp2,ff] uL[sp1,ff,cc])) + HC[gst^2/Lam^2 ((FU0bar[sp1,ff,cc] uR[sp2,ff,cc])(uRbar[sp2,ff2,cc] vl[sp1,ff2]) + (FUpb[sp1,ff,cc] uR[sp2,ff,cc])(uRbar[sp2,ff2,cc] l[sp1,ff2]) + (FDpb[sp1,ff,cc] dq[sp2,ff,cc])(dqbar[sp2,ff2,cc] l[sp1,ff2]) + (FD0bar[sp1,ff,cc] dq[sp2,ff,cc])(dqbar[sp2,ff2,cc] vl[sp1,ff2]) + (FE23bar[sp1,ff,cc] eR[sp2,ff])(eRbar[sp2,ff] uL[sp1,ff,cc]) + (FNm13bar[sp1,ff,cc] vyR[sp2,ff])(vyRbar[sp2,ff] dL[sp1,ff,cc]) + (FEp13bar[sp1,ff,cc] eR[sp2,ff])(eRbar[sp2,ff] dL[sp1,ff,cc]) + (FN23bar[sp1,ff,cc] vyR[sp2,ff])(vyRbar[sp2,ff] uL[sp1,ff,cc]))];

LANOMPI0 := Sum over PI0: (ee gw Nc)/(4 Pi^2 FPi Sqrt[2]) Eps[mu,nu,rho,sig] FS[A,rho,mu] FS[W,sig,nu] PI0 fields - written as anomaly couplings for PI0u and PI0d to gamma gamma, gamma Z, ZZ, WW, gg via paper Eqs.(PiGG)-(PiGGg): (2 ee^2 Nc)/(3 4 Pi^2 FPi) Eps[mu,nu,rho,sig] FS[A,rho,mu] FS[A,sig,nu] PI0ubar + (ee^2 Nc)/(9 4 Pi^2 FPi) Eps[mu,nu,rho,sig] FS[A,rho,mu] FS[A,sig,nu] PI0dbar + (gs^2/2)/(4 Pi^2 FPi) Eps[mu,nu,rho,sig] FS[G,rho,mu,aa] FS[G,sig,nu,aa] PI0ubar + (gs^2/2)/(4 Pi^2 FPi) Eps[mu,nu,rho,sig] FS[G,rho,mu,aa] FS[G,sig,nu,aa] PI0dbar + HC[(2 ee^2 Nc)/(3 4 Pi^2 FPi) Eps[mu,nu,rho,sig] FS[A,rho,mu] FS[A,sig,nu] PI0ubar + (ee^2 Nc)/(9 4 Pi^2 FPi) Eps[mu,nu,rho,sig] FS[A,rho,mu] FS[A,sig,nu] PI0dbar + (gs^2/2)/(4 Pi^2 FPi) Eps[mu,nu,rho,sig] FS[G,rho,mu,aa] FS[G,sig,nu,aa] PI0ubar + (gs^2/2)/(4 Pi^2 FPi) Eps[mu,nu,rho,sig] FS[G,rho,mu,aa] FS[G,sig,nu,aa] PI0dbar];

LANOMPIc := gQ2 Nc/(4 Pi^2 FPi) Eps[mu,nu,rho,sig] FS[A,rho,mu] FS[W,sig,nu] PIm + HC[gQ2 Nc/(4 Pi^2 FPi) Eps[mu,nu,rho,sig] FS[A,rho,mu] FS[W,sig,nu] PIm] where gQ2 is the fractional charge factor (2/3 ee)*(gw/(2 Sqrt[2])) or (-(1/3) ee)*(gw/(2 Sqrt[2])) from Eqs.(PiGG1+1)-(PiGG1+2);

LTotal := LPI1kin + LPI2kin + LHc1kin + LHc2kin + LLQ1kin + LLQ2kin + LFN1kin + LFE1kin + LFNskin + LFEskin + LFN2kin + LFE2kin + LFNsCkin + LFEsCkin + LFU1kin + LFD1kin + LFUsCkin + LFDsCkin + Lnurkin + LYPI + LYLQ + LHcFF + LFCI + LANOMPI0 + LANOMPIc;
