LZpKin := Block[{mu, nu}, -1/4 FS[Zp, mu, nu] FS[Zp, mu, nu] + 1/2 MZp^2 Zp[mu] Zp[mu]];

LVKin := Block[{mu, nu}, -1/2 FS[Vbbar, mu, nu] FS[Vb, mu, nu] + MV^2 Vbbar[mu] Vb[mu]];

LYKin := Block[{mu, nu}, -1/2 FS[Ybbar, mu, nu] FS[Yb, mu, nu] + MY^2 Ybbar[mu] Yb[mu]];

LNKQ := Block[{mu}, I DQbar.Ga[mu].DC[DQ, mu] - MDQ DQbar.DQ + I SQbar.Ga[mu].DC[SQ, mu] - MSQ SQbar.SQ + I TQbar.Ga[mu].DC[TQ, mu] - MTQ TQbar.TQ];

LNKEL := Block[{mu}, ExpandIndices[I ELbar.Ga[mu].DC[EL, mu] - MElo ELbar.EL]];

LNScal := Block[{mu}, 1/2 del[H2, mu] del[H2, mu] - 1/2 MH2^2 H2^2 + 1/2 del[H3, mu] del[H3, mu] - 1/2 MH3^2 H3^2 + 1/2 del[H0, mu] del[H0, mu] - 1/2 MH0^2 H0^2 + DC[Hpbar, mu] DC[Hp, mu] - MHp^2 Hpbar.Hp + DC[HVbar, mu] DC[HV, mu] - MHV^2 HVbar.HV + DC[HYbar, mu] DC[HY, mu] - MHY^2 HYbar.HY];

LYukH0 := ExpandIndices[H0 (uqbar.yHu331.uq + dqbar.yHd331.dq + lbar.yHl331.l + (o31 MElo/v3) ELbar.EL)];

LYukC := Block[{sp, sp2, ff, yuk}, yuk = HVbar (Sqrt[2] s13 MT/v1 uqbar[sp, 3].ProjM[sp, sp2].TQ[sp2] + Sqrt[2] c13 MTQ/v3 uqbar[sp, 3].ProjP[sp, sp2].TQ[sp2]) + HVbar CKM[1, 1] DQbar[sp].(-Sqrt[2] c13 MDQ/v3 ProjM[sp, sp2] - Sqrt[2] s13 MD/v1 ProjP[sp, sp2]).dq[sp2, 1] + HVbar CKM[2, 2] SQbar[sp].(-Sqrt[2] c13 MSQ/v3 ProjM[sp, sp2] - Sqrt[2] s13 MS/v1 ProjP[sp, sp2]).dq[sp2, 2] + HV ELbar[sp, ff].(-Sqrt[2] c13 MElo/v3 ProjM[sp, sp2]).vl[sp2, ff] + HY uqbar[sp, 1].(Sqrt[2] s23 MU/v2 ProjM[sp, sp2] + Sqrt[2] c23 MDQ/v3 ProjP[sp, sp2]).DQ[sp2] + HY uqbar[sp, 2].(Sqrt[2] s23 MC/v2 ProjM[sp, sp2] + Sqrt[2] c23 MSQ/v3 ProjP[sp, sp2]).SQ[sp2] + HY CKM[3, 3] TQbar[sp].(Sqrt[2] c23 MTQ/v3 ProjM[sp, sp2] + Sqrt[2] s23 MB/v2 ProjP[sp, sp2]).dq[sp2, 3] + HY ELbar[sp, ff].(-s23 yl[ff, ff] vev/v2 ProjM[sp, sp2] - Sqrt[2] c23 MElo/v3 ProjP[sp, sp2]).l[sp2, ff] + Hp CKM[3, 3] uqbar[sp, 3].(Sqrt[2] s12 MT/v1 ProjM[sp, sp2] + Sqrt[2] c12 MB/v2 ProjP[sp, sp2]).dq[sp2, 3] + Hp CKM[1, 1] uqbar[sp, 1].(-Sqrt[2] c12 MU/v2 ProjM[sp, sp2] - Sqrt[2] s12 MD/v1 ProjP[sp, sp2]).dq[sp2, 1] + Hp CKM[2, 2] uqbar[sp, 2].(-Sqrt[2] c12 MC/v2 ProjM[sp, sp2] - Sqrt[2] s12 MS/v1 ProjP[sp, sp2]).dq[sp2, 2] + Hp vlbar[sp, ff].(c12 yl[ff, ff] vev/v2 ProjP[sp, sp2]).l[sp2, ff]; ExpandIndices[yuk] + HC[ExpandIndices[yuk]]];

LGg331 := Block[{mu, sp, sp2, ff, yc}, yc = ExpandIndices[-gw/Sqrt[2] (Yb[mu] (ELbar.Ga[mu].ProjM.l + uqbar[sp, 1].Ga[mu].ProjM[sp, sp2].DQ[sp2] + uqbar[sp, 2].Ga[mu].ProjM[sp, sp2].SQ[sp2] + CKM[3, 3] TQbar[sp].Ga[mu].ProjM[sp, sp2].dq[sp2, 3]) + Vb[mu] (ELbar.Ga[mu].ProjM.vl + TQbar[sp].Ga[mu].ProjM[sp, sp2].uq[sp2, 3] + CKM[1, 1] dqbar[sp, 1].Ga[mu].ProjM[sp, sp2].DQ[sp2] + CKM[2, 2] dqbar[sp, 2].Ga[mu].ProjM[sp, sp2].SQ[sp2]))]; ExpandIndices[Zp[mu] (gLZpE lbar.Ga[mu].ProjM.l + gRZpE lbar.Ga[mu].ProjP.l + gLZpE vlbar.Ga[mu].ProjM.vl + uqbar.gLZpu.Ga[mu].ProjM.uq + uqbar.gRZpu.Ga[mu].ProjP.uq + dqbar.gLZpd.Ga[mu].ProjM.dq + dqbar.gRZpd.Ga[mu].ProjP.dq + ELbar.gLZpEL.Ga[mu].ProjM.EL + ELbar.gRZpEL.Ga[mu].ProjP.EL + gLZpDQ DQbar.Ga[mu].ProjM.DQ + gRZpDQ DQbar.Ga[mu].ProjP.DQ + gLZpDQ SQbar.Ga[mu].ProjM.SQ + gRZpDQ SQbar.Ga[mu].ProjP.SQ + gLZpTQ TQbar.Ga[mu].ProjM.TQ + gRZpTQ TQbar.Ga[mu].ProjP.TQ)] + yc + HC[yc]];

LTotal := LZpKin + LVKin + LYKin + LNKQ + LNKEL + LNScal + LYukH0 + LYukC + LGg331;
