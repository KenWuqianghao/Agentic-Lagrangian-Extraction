      "parameter_type": "Internal",
      "value": "v2/v",
      "description": "sin(theta_12) = v2/v"
    },
    {
      "name": "c12",
      "parameter_type": "Internal",
      "value": "v1/v",
      "description": "cos(theta_12) = v1/v"
    },
    {
      "name": "s23",
      "parameter_type": "Internal",
      "value": "v3/Sqrt[v2^2 + v3^2]",
      "description": "sin(theta_23)"
    },
    {
      "name": "c23",
      "parameter_type": "Internal",
      "value": "v2/Sqrt[v2^2 + v3^2]",
      "description": "cos(theta_23)"
    },
    {
      "name": "s13",
      "parameter_type": "Internal",
      "value": "v3/Sqrt[v1^2 + v3^2]",
      "description": "sin(theta_13)"
    },
    {
      "name": "c13",
      "parameter_type": "Internal",
      "value": "v1/Sqrt[v1^2 + v3^2]",
      "description": "cos(theta_13)"
    },
    {
      "name": "MZp",
      "parameter_type": "Internal",
