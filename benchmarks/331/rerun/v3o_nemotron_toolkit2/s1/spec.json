      "parameter_type": "Internal",
      "value": "g/Sqrt[g^2 + gY^2]",
      "description": "Cosine of Weinberg angle"
    },
    {
      "name": "ee",
      "parameter_type": "Internal",
      "value": "g*sW",
      "interaction_order": ["QED", 1],
      "description": "Electric coupling"
    },
    {
      "name": "a0",
      "parameter_type": "Internal",
      "value": "Sqrt[1 - (1 + beta^2)*sW^2]",
      "description": "a0 = sqrt(1-(1+beta^2) sW^2)"
    },
    {
      "name": "ap",
      "parameter_type": "Internal",
      "value": "Sqrt[3]*beta + 1",
      "description": "a_+ = sqrt(3) beta + 1"
    },
    {
      "name": "am",
      "parameter_type": "Internal",
      "value": "Sqrt[3]*beta - 1",
      "description": "a_- = sqrt(3) beta - 1"
    },
    {
      "name": "bp",
      "parameter_type": "Internal",
      "value": "Sqrt[3]*beta + 2",
      "description": "b_+ = sqrt(3) beta + 2"
    },
    {
      "name": "bm",
      "parameter_type": "Internal",
      "value": "Sqrt[3]*beta - 2",
      "description": "b_- = sqrt(3) beta - 2"
    },
    {
      "name": "QV",
      "parameter_type": "Internal",
      "value": "(Sqrt[3]*beta - 1)/2",
      "description": "Electric charge of V boson"
    },
    {
      "name": "QY",
      "parameter_type": "Internal",
      "value": "(Sqrt[3]*beta + 1)/2",
      "description": "Electric charge of Y boson"
    },
    {
      "name": "QD",
      "parameter_type": "Internal",
      "value": "1/6 - Sqrt[3]*beta/2",
      "description": "Electric charge of D, S quarks"
    },
    {
      "name": "QT",
      "parameter_type": "Internal",
      "value": "1/6 + Sqrt[3]*beta/2",
      "description": "Electric charge of T quark"
    },
    {
      "name": "QE",
      "parameter_type": "Internal",
      "value": "-1/2 + Sqrt[3]*beta/2",
      "description": "Electric charge of E leptons"
    },
    {
      "name": "Xrho",
      "parameter_type": "Internal",
      "value": "1/2 - beta/(2*Sqrt[3])",
      "description": "U(1)_X charge of rho triplet"
    },
    {
      "name": "Xeta",
      "parameter_type": "Internal",
      "value": "-1/2 - beta/(2*Sqrt[3])",
      "description": "U(1)_X charge of eta triplet"
    },
    {
      "name": "Xchi",
      "parameter_type": "Internal",
      "value": "beta/Sqrt[3]",
      "description": "U(1)_X charge of chi triplet"
    },
    {
