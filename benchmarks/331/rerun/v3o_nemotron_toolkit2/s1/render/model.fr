LZpKin := -1/4 FS[Zp, mu, nu] FS[Zp, mu, nu] + 1/2 MZp^2 Zp[mu] Zp[mu];

LVKin := -1/2 FS[Vpbar, mu, nu] FS[Vp, mu, nu] + MV^2 Vpbar[mu] Vp[mu];

LYKin := -1/2 FS[Ypbar, mu, nu] FS[Yp, mu, nu] + MY^2 Ypbar[mu] Yp[mu];

LH0Kin := 1/2 del[H0, mu] del[H0, mu] - 1/2 MH0^2 H0^2;

LH2Kin := 1/2 del[H2, mu] del[H2, mu] - 1/2 MH2^2 H2^2;

LH3Kin := 1/2 del[H3, mu] del[H3, mu] - 1/2 MH3^2 H3^2;

LHpKin := DC[Hpbar, mu] DC[Hp, mu] - MHpm^2 Hpbar Hp;

LHVKin := DC[HVpbar, mu] DC[HVp, mu] - MHQV^2 HVpbar HVp;

LHYKin := DC[HYpbar, mu] DC[HYp, mu] - MHQY^2 HYpbar HYp;

LDqKin := I Dqbar.Ga[mu].DC[Dq, mu] - MDq Dqbar.Dq;

LTqKin := I Tqbar.Ga[mu].DC[Tq, mu] - MTq Tqbar.Tq;

LElKin := I Elbar.Ga[mu].DC[El, mu] - MEe Elbar.El;

LZpNewFerm := Zp[mu] * ( Dqbar.Ga[mu].(gZpDqL*ProjM + gZpDqR*ProjP).Dq + Tqbar.Ga[mu].(gZpTqL*ProjM + gZpTqR*ProjP).Tq + Elbar.Ga[mu].(gZpElL*ProjM + gZpElR*ProjP).El );

LVNewFerm := Vp[mu] * ( Dqbar.Ga[mu].gVdqL*ProjM.dq + Tqbar.Ga[mu].gVTqL*ProjM.bq ) + HC[ Vp[mu] * ( Dqbar.Ga[mu].gVdqL*ProjM.dq + Tqbar.Ga[mu].gVTqL*ProjM.bq ) ];

LYNewFerm := Yp[mu] * ( Dqbar.Ga[mu].gYdqL*ProjM.uq + Elbar.Ga[mu].gYElL*ProjM.vl ) + HC[ Yp[mu] * ( Dqbar.Ga[mu].gYdqL*ProjM.uq + Elbar.Ga[mu].gYElL*ProjM.vl ) ];

LVSint := I*ee/2 * ( am * (Vp[mu]*Hpbar*del[Hp,mu] - del[Vp[mu],mu]*Hpbar*Hp) + ap * (Yp[mu]*HYpbar*del[HYp,mu] - del[Yp[mu],mu]*HYpbar*HYp) );

LVVSint := ee^2/2 * ( Vpbar[mu]*Vp[mu] * (Hpbar*Hp + HVpbar*HVp) + Ypbar[mu]*Yp[mu] * (Hpbar*Hp + HYpbar*HYp) );

LYukNew := yD*v3/Sqrt[2] * Dqbar.Dq + yS*v3/Sqrt[2] * Dqbar.Dq + yT*v3/Sqrt[2] * Tqbar.Tq + yEe*v3/Sqrt[2] * Elbar.El;

LTotal := LZpKin + LVKin + LYKin + LH0Kin + LH2Kin + LH3Kin + LHpKin + LHVKin + LHYKin + LDqKin + LTqKin + LElKin + LZpNewFerm + LVNewFerm + LYNewFerm + LVSint + LVVSint + LYukNew;
