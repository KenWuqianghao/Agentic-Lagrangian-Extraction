(* ************************** *)
(* *****  Information   ***** *)
(* ************************** *)
M$ModelName = "331_gen";

M$Information = {
  Authors      -> {"Qing-Hong Cao", "Dong-Ming Zhang"},
  Version      -> "1.0",
  Date         -> "2026-09-24",
  Institutions -> {"Peking University"},
  Emails       -> {"qinghongcao@pku.edu.cn", "zhangdongming@pku.edu.cn"},
  URLs         -> "https://arxiv.org/abs/1611.09337"
};

(* ************************** *)
(* *** Interaction orders *** *)
(* ************************** *)
M$InteractionOrderHierarchy = {
  {QCD, 1},
  {QED, 2},
  {NP, 1}
};

(* ************************** *)
(* *****    Indices     ***** *)
(* ************************** *)
(* No new indices needed - all new particles use existing Colour, Generation indices from SM.fr *)

(* ************************** *)
(* *****   Parameters   ***** *)
(* ************************** *)
M$Parameters = {

  (* New gauge couplings *)
  g331 == {
    ParameterType    -> External,
    Value            -> 0.65,
    InteractionOrder -> {NP, 1},
    TeX              -> g_{331},
    Description      -> "SU(3)_L gauge coupling"
  },
  gX == {
    ParameterType    -> External,
    Value            -> 0.35,
    InteractionOrder -> {NP, 1},
    TeX              -> g_X,
    Description      -> "U(1)_X gauge coupling"
  },

  (* Beta parameter characterizing the model *)
  beta == {
    ParameterType    -> External,
    Value            -> 1/Sqrt[3],
    InteractionOrder -> {NP, 0},
    TeX              -> \\beta,
    Description      -> "Model parameter beta = ±1/√3, ±√3"
  },

  (* Higgs vevs *)
  v1 == {
    ParameterType    -> External,
    Value            -> 174.,
    InteractionOrder -> {NP, 0},
    TeX              -> v_1,
    Description      -> "VEV of rho^0 [GeV]"
  },
  v2 == {
    ParameterType    -> External,
    Value            -> 174.,
    InteractionOrder -> {NP, 0},
    TeX              -> v_2,
    Description      -> "VEV of eta^0 [GeV]"
  },
  v3 == {
    ParameterType    -> External,
    Value            -> 2000.,
    InteractionOrder -> {NP, 0},
    TeX              -> v_3,
    Description      -> "VEV of chi^0 [GeV] (TeV scale)"
  },

  (* Derived: v = Sqrt[v1^2 + v2^2] *)
  v == {
    ParameterType    -> Internal,
    Value            -> Sqrt[v1^2 + v2^2],
    TeX              -> v,
    Description      -> "Electroweak VEV = 246 GeV"
  },

  (* Higgs potential parameters *)
  mu1 == {
    ParameterType    -> External,
    Value            -> 100.,
    InteractionOrder -> {NP, 0},
    TeX              -> \\mu_1,
    Description      -> "Higgs mass parameter for rho [GeV]"
  },
  mu2 == {
    ParameterType    -> External,
    Value            -> 100.,
    InteractionOrder -> {NP, 0},
    TeX              -> \\mu_2,
    Description      -> "Higgs mass parameter for eta [GeV]"
  },
  mu3 == {
    ParameterType    -> External,
    Value            -> 1000.,
    InteractionOrder -> {NP, 0},
    TeX              -> \\mu_3,
    Description      -> "Higgs mass parameter for chi [GeV]"
  },
  lam1 == {
    ParameterType    -> External,
    Value            -> 0.1,
    InteractionOrder -> {NP, 0},
    TeX              -> \\lambda_1,
    Description      -> "Higgs quartic coupling (rho^2)^2"
  },
  lam2 == {
    ParameterType    -> External,
    Value            -> 0.1,
    InteractionOrder -> {NP, 0},
    TeX              -> \\lambda_2,
    Description      -> "Higgs quartic coupling (eta^2)^2"
  },
  lam3 == {
    ParameterType    -> External,
    Value            -> 0.1,
    InteractionOrder -> {NP, 0},
    TeX              -> \\lambda_3,
    Description      -> "Higgs quartic coupling (chi^2)^2"
  },
  lam12 == {
    ParameterType    -> External,
    Value            -> 0.05,
    InteractionOrder -> {NP, 0},
    TeX              -> \\lambda_{12},
    Description      -> "Higgs portal coupling rho^2 eta^2"
  },
  lam13 == {
    ParameterType    -> External,
    Value            -> 0.05,
    InteractionOrder -> {NP, 0},
    TeX              -> \\lambda_{13},
    Description      -> "Higgs portal coupling rho^2 chi^2"
  },
  lam23 == {
    ParameterType    -> External,
    Value            -> 0.05,
    InteractionOrder -> {NP, 0},
    TeX              -> \\lambda_{23},
    Description      -> "Higgs portal coupling eta^2 chi^2"
  },
  lam12p == {
    ParameterType    -> External,
    Value            -> 0.05,
    InteractionOrder -> {NP, 0},
    TeX              -> \\lambda'_{12},
    Description      -> "Higgs portal coupling (rho^dagger eta)(eta^dagger rho)"
  },
  lam13p == {
    ParameterType    -> External,
    Value            -> 0.05,
    InteractionOrder -> {NP, 0},
    TeX              -> \\lambda'_{13},
    Description      -> "Higgs portal coupling (rho^dagger chi)(chi^dagger rho)"
  },
  lam23p == {
    ParameterType    -> External,
    Value            -> 0.05,
    InteractionOrder -> {NP, 0},
    TeX              -> \\lambda'_{23},
    Description      -> "Higgs portal coupling (eta^dagger chi)(chi^dagger eta)"
  },
  fparam == {
    ParameterType    -> External,
    Value            -> 1000.,
    InteractionOrder -> {NP, 0},
    TeX              -> f,
    Description      -> "Trilinear scalar coupling parameter [GeV]"
  },

  (* Mixing angles *)
  s12 == {
    ParameterType    -> Internal,
    Value            -> v2/v,
    TeX              -> s_{12},
    Description      -> "sin of rho-eta mixing angle"
  },
  c12 == {
    ParameterType    -> Internal,
    Value            -> v1/v,
    TeX              -> c_{12},
    Description      -> "cos of rho-eta mixing angle"
  },
  s23 == {
    ParameterType    -> Internal,
    Value            -> v3/Sqrt[v2^2 + v3^2],
    TeX              -> s_{23},
    Description      -> "sin of eta-chi mixing angle"
  },
  c23 == {
    ParameterType    -> Internal,
    Value            -> v2/Sqrt[v2^2 + v3^2],
    TeX              -> c_{23},
    Description      -> "cos of eta-chi mixing angle"
  },
  s13 == {
    ParameterType    -> Internal,
    Value            -> v3/Sqrt[v1^2 + v3^2],
    TeX              -> s_{13},
    Description      -> "sin of rho-chi mixing angle"
  },
  c13 == {
    ParameterType    -> Internal,
    Value            -> v1/Sqrt[v1^2 + v3^2],
    TeX              -> c_{13},
    Description      -> "cos of rho-chi mixing angle"
  },

  (* Z-Z' mixing *)
  s331 == {
    ParameterType    -> Internal,
    Value            -> g331/Sqrt[g331^2 + beta^2*gX^2],
    TeX              -> s_{331},
    Description      -> "sin of Z-Z' mixing angle"
  },
  c331 == {
    ParameterType    -> Internal,
    Value            -> beta*gX/Sqrt[g331^2 + beta^2*gX^2],
    TeX              -> c_{331},
    Description      -> "cos of Z-Z' mixing angle"
  },

  (* Neutral scalar mixing matrix elements (CP-even) *)
  U11 == {
    ParameterType    -> External,
    Value            -> 0.7,
    InteractionOrder -> {NP, 0},
    TeX              -> U_{11},
    Description      -> "CP-even scalar mixing matrix element (1,1)"
  },
  U12 == {
    ParameterType    -> External,
    Value            -> 0.,
    InteractionOrder -> {NP, 0},
    TeX              -> U_{12},
    Description      -> "CP-even scalar mixing matrix element (1,2)"
  },
  U13 == {
    ParameterType    -> External,
    Value            -> 0.,
    InteractionOrder -> {NP, 0},
    TeX              -> U_{13},
    Description      -> "CP-even scalar mixing matrix element (1,3)"
  },
  U21 == {
    ParameterType    -> External,
    Value            -> 0.7,
    InteractionOrder -> {NP, 0},
    TeX              -> U_{21},
    Description      -> "CP-even scalar mixing matrix element (2,1)"
  },
  U22 == {
    ParameterType    -> External,
    Value            -> 0.,
    InteractionOrder -> {NP, 0},
    TeX              -> U_{22},
    Description      -> "CP-even scalar mixing matrix element (2,2)"
  },
  U23 == {
    ParameterType    -> External,
    Value            -> 0.,
    InteractionOrder -> {NP, 0},
    TeX              -> U_{23},
    Description      -> "CP-even scalar mixing matrix element (2,3)"
  },
  U31 == {
    ParameterType    -> External,
    Value            -> 0.,
    InteractionOrder -> {NP, 0},
    TeX              -> U_{31},
    Description      -> "CP-even scalar mixing matrix element (3,1)"
  },
  U32 == {
    ParameterType    -> External,
    Value            -> 0.,
    InteractionOrder -> {NP, 0},
    TeX              -> U_{32},
    Description      -> "CP-even scalar mixing matrix element (3,2)"
  },
  U33 == {
    ParameterType    -> External,
    Value            -> 1.,
    InteractionOrder -> {NP, 0},
    TeX              -> U_{33},
    Description      -> "CP-even scalar mixing matrix element (3,3)"
  },

  (* CP-odd scalar mixing matrix elements *)
  O11 == {
    ParameterType    -> External,
    Value            -> 0.7,
    InteractionOrder -> {NP, 0},
    TeX              -> O_{11},
    Description      -> "CP-odd scalar mixing matrix element (1,1)"
  },
  O12 == {
    ParameterType    -> External,
    Value            -> -0.7,
    InteractionOrder -> {NP, 0},
    TeX              -> O_{12},
    Description      -> "CP-odd scalar mixing matrix element (1,2)"
  },
  O13 == {
    ParameterType    -> External,
    Value            -> 0.,
    InteractionOrder -> {NP, 0},
    TeX              -> O_{13},
    Description      -> "CP-odd scalar mixing matrix element (1,3)"
  },
  O21 == {
    ParameterType    -> External,
    Value            -> 0.7,
    InteractionOrder -> {NP, 0},
    TeX              -> O_{21},
    Description      -> "CP-odd scalar mixing matrix element (2,1)"
  },
  O22 == {
    ParameterType    -> External,
    Value            -> 0.7,
    InteractionOrder -> {NP, 0},
    TeX              -> O_{22},
    Description      -> "CP-odd scalar mixing matrix element (2,2)"
  },
  O23 == {
    ParameterType    -> External,
    Value            -> 0.,
    InteractionOrder -> {NP, 0},
    TeX              -> O_{23},
    Description      -> "CP-odd scalar mixing matrix element (2,3)"
  },
  O31 == {
    ParameterType    -> External,
    Value            -> 0.,
    InteractionOrder -> {NP, 0},
    TeX              -> O_{31},
    Description      -> "CP-odd scalar mixing matrix element (3,1)"
  },
  O32 == {
    ParameterType    -> External,
    Value            -> 0.,
    InteractionOrder -> {NP, 0},
    TeX              -> O_{32},
    Description      -> "CP-odd scalar mixing matrix element (3,2)"
  },
  O33 == {
    ParameterType    -> External,
    Value            -> 1.,
    InteractionOrder -> {NP, 0},
    TeX              -> O_{33},
    Description      -> "CP-odd scalar mixing matrix element (3,3)"
  },

  (* New gauge boson masses *)
  MZp == {
    ParameterType    -> Internal,
    Value            -> g331*c331*v3/Sqrt[3*(1 - (1 + beta^2)*sw2)],
    TeX              -> M_{Z'},
    Description      -> "Z' boson mass [GeV]"
  },
  MWp == {
    ParameterType    -> Internal,
    Value            -> g331*v/2,
    TeX              -> M_{W'},
    Description      -> "W boson mass [GeV]"
  },
  MY == {
    ParameterType    -> Internal,
    Value            -> g331*Sqrt[v3^2 + v2^2]/2,
    TeX              -> M_{Y},
    Description      -> "Y boson mass [GeV]"
  },
  MV == {
    ParameterType    -> Internal,
    Value            -> g331*Sqrt[v3^2 + v1^2]/2,
    TeX              -> M_{V},
    Description      -> "V boson mass [GeV]"
  },

  (* Scalar masses *)
  Mh == {
    ParameterType    -> External,
    Value            -> 125.,
    InteractionOrder -> {NP, 0},
    TeX              -> m_h,
    Description      -> "SM-like Higgs mass [GeV]"
  },
  MH2 == {
    ParameterType    -> Internal,
    Value            -> v^2/(v1*v2)*fparam*v3,
    TeX              -> M_{H_2},
    Description      -> "Heavy CP-even scalar H2 mass [GeV]"
  },
  MH3 == {
    ParameterType    -> Internal,
    Value            -> Sqrt[2*lam3]*v3,
    TeX              -> M_{H_3},
    Description      -> "Heavy CP-even scalar H3 mass [GeV]"
  },
  MH0 == {
    ParameterType    -> Internal,
    Value            -> Sqrt[fparam*(v1^2*v2^2 + v2^2*v3^2 + v1^2*v3^2)/(v1*v2*v3)],
    TeX              -> M_{H_0},
    Description      -> "CP-odd scalar H0 mass [GeV]"
  },
  MHpm == {
    ParameterType    -> Internal,
    Value            -> Sqrt[(2*fparam*v3 + lam12p*v1*v2)/(2*v1*v2)]*v,
    TeX              -> M_{H^\\pm},
    Description      -> "Charged scalar H^± mass [GeV]"
  },
  MHpmQY == {
    ParameterType    -> Internal,
    Value            -> Sqrt[(2*fparam*v1 + lam23p*v2*v3)/(2*v2*v3)]*Sqrt[v2^2 + v3^2],
    TeX              -> M_{H^{\\pm Q_Y}},
    Description      -> "Charged scalar H^±Q_Y mass [GeV]"
  },
  MHpmQV == {
    ParameterType    -> Internal,
    Value            -> Sqrt[(2*fparam*v2 + lam13p*v1*v3)/(2*v1*v3)]*Sqrt[v1^2 + v3^2],
    TeX              -> M_{H^{\\pm Q_V}},
    Description      -> "Charged scalar H^±Q_V mass [GeV]"
  },

  (* Heavy fermion masses *)
  MD == {
    ParameterType    -> External,
    Value            -> 1000.,
    InteractionOrder -> {NP, 0},
    TeX              -> M_D,
    Description      -> "Heavy quark D mass [GeV]"
  },
  MS == {
    ParameterType    -> External,
    Value            -> 1000.,
    InteractionOrder -> {NP, 0},
    TeX              -> M_S,
    Description      -> "Heavy quark S mass [GeV]"
  },
  MT == {
    ParameterType    -> External,
    Value            -> 1000.,
    InteractionOrder -> {NP, 0},
    TeX              -> M_T,
    Description      -> "Heavy quark T mass [GeV]"
  },
  MEe == {
    ParameterType    -> External,
    Value            -> 1000.,
    InteractionOrder -> {NP, 0},
    TeX              -> M_{E_e},
    Description      -> "Heavy lepton E_e mass [GeV]"
  },
  MEmu == {
    ParameterType    -> External,
    Value            -> 1000.,
    InteractionOrder -> {NP, 0},
    TeX              -> M_{E_\\mu},
    Description      -> "Heavy lepton E_mu mass [GeV]"
  },
  MEtau == {
    ParameterType    -> External,
    Value            -> 1000.,
    InteractionOrder -> {NP, 0},
    TeX              -> M_{E_\\tau},
    Description      -> "Heavy lepton E_tau mass [GeV]"
  },

  (* Yukawa couplings for new fermions *)
  yD == {
    ParameterType    -> External,
    Value            -> 1.,
    Indices          -> {Index[Generation]},
    InteractionOrder -> {NP, 1},
    TeX              -> y_D,
    Description      -> "Yukawa coupling for D quark"
  },
  yS == {
    ParameterType    -> External,
    Value            -> 1.,
    Indices          -> {Index[Generation]},
    InteractionOrder -> {NP, 1},
    TeX              -> y_S,
    Description      -> "Yukawa coupling for S quark"
  },
  yT == {
    ParameterType    -> External,
    Value            -> 1.,
    InteractionOrder -> {NP, 1},
    TeX              -> y_T,
    Description      -> "Yukawa coupling for T quark"
  },
  yEe == {
    ParameterType    -> External,
    Value            -> 1.,
    InteractionOrder -> {NP, 1},
    TeX              -> y_{E_e},
    Description      -> "Yukawa coupling for E_e lepton"
  },
  yEmu == {
    ParameterType    -> External,
    Value            -> 1.,
    InteractionOrder -> {NP, 1},
    TeX              -> y_{E_\\mu},
    Description      -> "Yukawa coupling for E_mu lepton"
  },
  yEtau == {
    ParameterType    -> External,
    Value            -> 1.,
    InteractionOrder -> {NP, 1},
    TeX              -> y_{E_\\tau},
    Description      -> "Yukawa coupling for E_tau lepton"
  },

  (* Electric charges of new particles *)
  QD == {
    ParameterType    -> Internal,
    Value            -> 1/6 - Sqrt[3]*beta/2,
    TeX              -> Q_D,
    Description      -> "Electric charge of D, S quarks"
  },
  QT == {
    ParameterType    -> Internal,
    Value            -> 1/6 + Sqrt[3]*beta/2,
    TeX              -> Q_T,
    Description      -> "Electric charge of T quark"
  },
  QE == {
    ParameterType    -> Internal,
    Value            -> -1/2 + Sqrt[3]*beta/2,
    TeX              -> Q_E,
    Description      -> "Electric charge of E leptons"
  },
  QV == {
    ParameterType    -> Internal,
    Value            -> -1/2 + Sqrt[3]*beta/2,
    TeX              -> Q_V,
    Description      -> "Electric charge of V boson"
  },
  QY == {
    ParameterType    -> Internal,
    Value            -> 1/2 + Sqrt[3]*beta/2,
    TeX              -> Q_Y,
    Description      -> "Electric charge of Y boson"
  },

  (* U(1)_X charges *)
  Xrho == {
    ParameterType    -> Internal,
    Value            -> 1/2 - beta/(2*Sqrt[3]),
    TeX              -> X_\\rho,
    Description      -> "U(1)_X charge of rho triplet"
  },
  Xeta == {
    ParameterType    -> Internal,
    Value            -> -1/2 - beta/(2*Sqrt[3]),
    TeX              -> X_\\eta,
    Description      -> "U(1)_X charge of eta triplet"
  },
  Xchi == {
    ParameterType    -> Internal,
    Value            -> beta/Sqrt[3],
    TeX              -> X_\\chi,
    Description      -> "U(1)_X charge of chi triplet"
  },

  (* a0 parameter for Z' couplings *)
  a0 == {
    ParameterType    -> Internal,
    Value            -> Sqrt[1 - (1 + beta^2)*sw2],
    TeX              -> a_0,
    Description      -> "Z' coupling normalization factor"
  },
  ap == {
    ParameterType    -> Internal,
    Value            -> Sqrt[3]*beta + 1,
    TeX              -> a_+,
    Description      -> "a_+ = √3 β + 1"
  },
  am == {
    ParameterType    -> Internal,
    Value            -> Sqrt[3]*beta - 1,
    TeX              -> a_-,
    Description      -> "a_- = √3 β - 1"
  },
  bp == {
    ParameterType    -> Internal,
    Value            -> Sqrt[3]*beta + 2,
    TeX              -> b_+,
    Description      -> "b_+ = √3 β + 2"
  },
  bm == {
    ParameterType    -> Internal,
    Value            -> Sqrt[3]*beta - 2,
    TeX              -> b_-,
    Description      -> "b_- = √3 β - 2"
  }
};

