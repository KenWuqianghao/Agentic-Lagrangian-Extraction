    Width            -> {0, 0, 0},
    QuantumNumbers   -> {Q -> QE},
    PropagatorLabel  -> {"El", "Ee", "Emu", "Etau"},
    PropagatorType   -> Straight,
    PropagatorArrow  -> Forward,
    PDG              -> {411, 412, 413},
    ParticleName     -> {"Ee", "Emu", "Etau"},
    AntiParticleName -> {"Ee~", "Emu~", "Etau~"},
    FullName         -> {"E_e lepton", "E_mu lepton", "E_tau lepton"}
  },

  (* Goldstone bosons eaten by new gauge bosons - unphysical *)
  S[110] == {
    ClassName      -> GZp,
    Unphysical     -> True,
    SelfConjugate  -> True,
    Goldstone      -> Zp,
    Mass           -> {MZp, 4000.},
    Width          -> {WZp, 100.},
    PropagatorLabel -> "GZp",
    PropagatorType  -> D,
    PropagatorArrow -> None,
    PDG            -> 320
  },
  S[111] == {
    ClassName        -> GVp,
    Unphysical       -> True,
    SelfConjugate    -> False,
    Goldstone        -> V,
    Mass             -> {MV, 2000.},
    QuantumNumbers   -> {Q -> QV},
    Width            -> {WV, 10.},
    PropagatorLabel  -> "GVp",
    PropagatorType   -> D,
    PropagatorArrow  -> None,
    PDG              -> 330
  },
  S[112] == {
    ClassName        -> GYp,
    Unphysical       -> True,
    SelfConjugate    -> False,
    Goldstone        -> Y,
    Mass             -> {MY, 2000.},
    QuantumNumbers   -> {Q -> QY},
    Width            -> {WY, 10.},
    PropagatorLabel  -> "GYp",
    PropagatorType   -> D,
    PropagatorArrow  -> None,
    PDG              -> 340
  }
};

(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

(* Higgs sector: kinetic and mass terms for new scalars *)
(* The paper uses three Higgs triplets rho, eta, chi *)
(* We write the free-field terms for each new scalar mass eigenstate *)

LHiggsKinMass := Block[{mu},
  (* CP-even neutral scalars *)
  1/2 del[h, mu] del[h, mu] - 1/2 Mh^2 h^2
  + 1/2 del[H2, mu] del[H2, mu] - 1/2 MH2^2 H2^2
  + 1/2 del[H3, mu] del[H3, mu] - 1/2 MH3^2 H3^2
  (* CP-odd neutral scalar *)
  + 1/2 del[H0, mu] del[H0, mu] - 1/2 MH0^2 H0^2
  (* Charged scalars H^± *)
  + DC[Hm, mu] DC[Hp, mu] - MHpm^2 Hm Hp
  (* Charged scalars H^±Q_V *)
  + DC[HmQV, mu] DC[HpQV, mu] - MHpmQV^2 HmQV HpQV
  (* Charged scalars H^±Q_Y *)
  + DC[HmQY, mu] DC[HpQY, mu] - MHpmQY^2 HmQY HpQY
];

(* Gauge boson sector: kinetic and mass terms for new gauge bosons *)
LGaugeKinMass := Block[{mu, nu},
  (* Z' boson - real vector *)
  -1/4 FS[Zp, mu, nu] FS[Zp, mu, nu] + 1/2 MZp^2 Zp[mu] Zp[mu]
  (* V boson - complex vector *)
  -1/2 FS[Vm, mu, nu] FS[Vp, mu, nu] + MV^2 Vm[mu] Vp[mu]
  (* Y boson - complex vector *)
  -1/2 FS[Ym, mu, nu] FS[Yp, mu, nu] + MY^2 Ym[mu] Yp[mu]
];

(* Fermion sector: kinetic and mass terms for new fermions *)
LFermionKinMass := Block[{mu},
  I Dqbar.Ga[mu].DC[Dq, mu] - MD Dqbar.Dq
  + I Tqbar.Ga[mu].DC[Tq, mu] - MT Tqbar.Tq
  + I Elbar.Ga[mu].DC[El, mu] - MEl Elbar.El
];

(* Gauge interactions for new fermions *)
(* From the paper, the gauge interactions come from the covariant derivative *)
(* D_mu = del_mu - i g331 W^i_mu T^i - i gX X_mu *)

(* For the quark triplets q_1L, q_2L (SU(3)_L triplets): *)
(* q_iL = (u, d, D)^T_L or (c, s, S)^T_L *)
(* For the quark anti-triplet q_3L (SU(3)_L anti-triplet): *)
(* q_3L = (b, -t, T)^T_L *)

(* For the lepton anti-triplets l_mL: *)
(* l_mL = (e, -nu_e, E_e)^T_L, etc. *)

(* The gauge boson couplings to fermions are given in Appendix A of the paper *)

LGaugeFermion := Block[{mu},
  (* V boson couplings: V connects upper two components to third component *)
  (* For quark triplets (1st, 2nd gen): V^+Q_V dbar D, V^+Q_V sbar S *)
  g331/Sqrt[2] (Vp[mu] Dqbar.Ga[mu].ProjM.Dq + Vm[mu] Dqbar.Ga[mu].ProjM.Dq)
  (* For quark anti-triplet (3rd gen): V^+Q_V tbar T *)
  + g331/Sqrt[2] (Vp[mu] Tqbar.Ga[mu].ProjM.Tq + Vm[mu] Tqbar.Ga[mu].ProjM.Tq)
  (* For lepton anti-triplets: V^+Q_V vbar E *)
  + g331/Sqrt[2] (Vp[mu] vlbar.Ga[mu].ProjM.El + Vm[mu] vlbar.Ga[mu].ProjM.El)
];

(* Y boson couplings *)
LGaugeFermionY := Block[{mu},
  (* For quark triplets (1st, 2nd gen): Y^+Q_Y ubar D, Y^+Q_Y cbar S *)
  g331/Sqrt[2] (Yp[mu] uqbar.Ga[mu].ProjM.Dq + Ym[mu] uqbar.Ga[mu].ProjM.Dq)
  (* For quark anti-triplet (3rd gen): Y^-Q_Y bbar T *)
  + g331/Sqrt[2] (Ym[mu] dqbar.Ga[mu].ProjM.Tq + Yp[mu] dqbar.Ga[mu].ProjM.Tq)
  (* For lepton anti-triplets: Y^+Q_Y ebar E *)
  + g331/Sqrt[2] (Yp[mu] lbar.Ga[mu].ProjM.El + Ym[mu] lbar.Ga[mu].ProjM.El)
];

(* Z' boson couplings to fermions *)
LGaugeFermionZp := Block[{mu},
  (* Z' couplings from paper's Appendix A, Table gauge-fermion *)
  (* Leptons *)
  -I*ee/(2*Sqrt[3]*cW*sw*a0) * (ap*sw2 - 1) * (vlbar.Ga[mu].ProjM.vl + lbar.Ga[mu].ProjM.l)
  -I*beta*ee*sw/cW/a0 * (vlbar.Ga[mu].ProjP.vl + lbar.Ga[mu].ProjP.l)
  (* Heavy leptons E *)
  + -I*ee/(2*Sqrt[3]*cW*sw*a0) * ((am^2 + 1)*sw2 - 2) * Elbar.Ga[mu].ProjM.El
  + I*Sqrt[3]*beta^2*ee*sw/(2*cW*a0) * Elbar.Ga[mu].ProjP.El
  (* Light quarks u, c *)
  + I*ee/(6*cW*sw*a0) * ((beta + Sqrt[3])*sw2 - Sqrt[3]) * (uqbar.Ga[mu].ProjM.uq)
  + 2*I*beta*ee*sw/(3*cW*a0) * (uqbar.Ga[mu].ProjP.uq)
  (* Light quarks d, s *)
  + I*ee/(6*cW*sw*a0) * ((beta + Sqrt[3])*sw2 - Sqrt[3]) * (dqbar.Ga[mu].ProjM.dq)
  - I*beta*ee*sw/(3*cW*a0) * (dqbar.Ga[mu].ProjP.dq)
  (* Heavy quark t *)
  + I*ee/(6*cW*sw*a0) * ((beta - Sqrt[3])*sw2 + Sqrt[3]) * (uqbar.Ga[mu].ProjM.uq) (* t is in uq[3] *)
  + 2*I*beta*ee*sw/(3*cW*a0) * (uqbar.Ga[mu].ProjP.uq)
  (* Heavy quark b *)
  + I*ee/(6*cW*sw*a0) * ((beta - Sqrt[3])*sw2 + Sqrt[3]) * (dqbar.Ga[mu].ProjM.dq)
  - I*beta*ee*sw/(3*cW*a0) * (dqbar.Ga[mu].ProjP.dq)
  (* New heavy quarks D, S *)
  -I*ee/(6*cW*sw*a0) * ((3*Sqrt[3]*beta^2 - beta + 2*Sqrt[3])*sw2 - 2*Sqrt[3]) * Dqbar.Ga[mu].ProjM.Dq
  -I*beta*(3*Sqrt[3]*beta - 1)*ee*sw/(6*cW*a0) * Dqbar.Ga[mu].ProjP.Dq
  (* New heavy quark T *)
  + I*ee/(6*cW*sw*a0) * ((3*Sqrt[3]*beta^2 + beta + 2*Sqrt[3])*sw2 - 2*Sqrt[3]) * Tqbar.Ga[mu].ProjM.Tq
  + I*beta*(3*Sqrt[3]*beta + 1)*ee*sw/(6*cW*a0) * Tqbar.Ga[mu].ProjP.Tq
];

(* Scalar potential - Higgs self-interactions *)
(* The full potential is very complex. We include the key terms *)
VHiggs := Block[{},
  mu1^2 (rhobar.rho) + mu2^2 (etabar.eta) + mu3^2 (chibar.chi)
  + lam1 (rhobar.rho)^2 + lam2 (etabar.eta)^2 + lam3 (chibar.chi)^2
  + lam12 (rhobar.rho)(etabar.eta) + lam13 (rhobar.rho)(chibar.chi) + lam23 (etabar.eta)(chibar.chi)
  + lam12p (rhobar.eta)(etabar.rho) + lam13p (rhobar.chi)(chibar.rho) + lam23p (etabar.chi)(chibar.eta)
  + Sqrt[2] fparam (Eps[ijk] rho[i] eta[j] chi[k] + h.c.)
];

(* Yukawa interactions for new fermions *)
(* From paper Eq. (622)-(625) *)
LYukawa331 := Block[{sp, ii, cc, ff1, ff2},
  (* Quark Yukawas - heavy quarks get mass from chi vev *)
  -yD[ff1] Dqbar[sp, ff1, cc] Tq[sp, ff1, cc] (* schematic *)
  -yS[ff1] Dqbar[sp, ff1, cc] Tq[sp, ff1, cc]
  -yT Tqbar[sp, 3, cc] Tq[sp, 3, cc]
  (* Lepton Yukawas - heavy leptons get mass from chi vev *)
  -yEe Elbar[sp, 1] El[sp, 1]
  -yEmu Elbar[sp, 2] El[sp, 2]
  -yEtau Elbar[sp, 3] El[sp, 3]
  + HC[
    -yD[ff1] Dqbar[sp, ff1, cc] Tq[sp, ff1, cc]
    -yS[ff1] Dqbar[sp, ff1, cc] Tq[sp, ff1, cc]
    -yT Tqbar[sp, 3, cc] Tq[sp, 3, cc]
    -yEe Elbar[sp, 1] El[sp, 1]
    -yEmu Elbar[sp, 2] El[sp, 2]
    -yEtau Elbar[sp, 3] El[sp, 3]
  ]
];

(* Gauge boson self-interactions (triple and quartic) *)
(* From paper's Appendix A, Table gauges *)
LGaugeSelf := Block[{mu, nu, rho, sigma},
  (* Triple gauge couplings *)
  (* A V V *)
  + 1/2*I*am*ee * (A[mu, nu] Vp[mu] Vm[nu] - A[mu, nu] Vm[mu] Vp[nu])
  (* A Y Y *)
  + 1/2*I*ap*ee * (A[mu, nu] Yp[mu] Ym[nu] - A[mu, nu] Ym[mu] Yp[nu])
  (* A W W *)
  - I*ee * (A[mu, nu] Wp[mu] Wm[nu] - A[mu, nu] Wm[mu] Wp[nu])
  (* Z V V *)
  - I*ee*(1 + am*sw2)/(2*cW*sw) * (Z[mu, nu] Vp[mu] Vm[nu] - Z[mu, nu] Vm[mu] Vp[nu])
  (* Z Y Y *)
  + I*ee*(1 - ap*sw2)/(2*cW*sw) * (Z[mu, nu] Yp[mu] Ym[nu] - Z[mu, nu] Ym[mu] Yp[nu])
  (* Z W W *)
  - I*ee*cW/sw * (Z[mu, nu] Wp[mu] Wm[nu] - Z[mu, nu] Wm[mu] Wp[nu])
  (* Z' V V *)
  - I*Sqrt[3]*ee*a0/(2*cW*sw) * (Zp[mu, nu] Vp[mu] Vm[nu] - Zp[mu, nu] Vm[mu] Vp[nu])
  (* Z' Y Y *)
  - I*Sqrt[3]*ee*a0/(2*cW*sw) * (Zp[mu, nu] Yp[mu] Ym[nu] - Zp[mu, nu] Ym[mu] Yp[nu])
  (* V W Y *)
  + I*ee/Sqrt[2]/sw * (Vm[mu] Wp[nu] Yp[rho] - Vp[mu] Wm[nu] Ym[rho])
];

(* Scalar-gauge interactions *)
(* From paper's Appendix A, Tables 1gauge-2scalars, 2gauges-1scalar, 2gauges-2scalars *)

LScalarGauge := Block[{mu, nu},
  (* VSS couplings - one gauge boson, two scalars *)
  (* A H^+Q_V H^-Q_V *)
  - I*ee/2*am * (HpQV - HmQV)[mu]
  (* A H^+ H^- *)
  + I*ee * (Hp - Hm)[mu]
  (* V^+Q_V H^-Q_V h *)
  - ee/(2*sw) * (s13*U11 - c13*U31) * Vp[mu] (HpQV - HmQV)
  (* ... many more vertices from the paper's tables ... *)
];

(* Higgs-fermion Yukawa couplings (from paper's Appendix A, Table scalar-fermion) *)
LScalarFermion := Block[{},
  (* H0 Ebar E *)
  + O31*MEl/v3 * H0 Elbar.El
  (* h Ebar E *)
  - I*U31*MEl/v3 * h Elbar.El
  (* H2 Ebar E *)
  - I*U32*MEl/v3 * H2 Elbar.El
  (* H3 Ebar E *)
  - I*U33*MEl/v3 * H3 Elbar.El
  (* H0 lbar l *)
  + O21*Ml/v2 * H0 lbar.l
  (* h lbar l *)
  - I*U21*Ml/v2 * h lbar.l
  (* H2 lbar l *)
  - I*U22*Ml/v2 * H2 lbar.l
  (* H3 lbar l *)
  - I*U23*Ml/v2 * H3 lbar.l
  (* H^+ nu l *)
  + Sqrt[2]*Ml*c12/v2 * Hp ProjP (vlbar.l)
  (* H^+Q_V Ebar nu *)
  - Sqrt[2]*c13*MEl/v3 * HpQV ProjM (Elbar.vl)
  (* H^-Q_Y Ebar l *)
  - Sqrt[2] * (s23*Ml/v2 * ProjM + c23*MEl/v3 * ProjP) * HmQY Elbar.l
  (* ... and similar for quarks ... *)
];

(* The complete Lagrangian sum *)
LTotal := LHiggsKinMass + LGaugeKinMass + LFermionKinMass 
        + LGaugeFermion + LGaugeFermionY + LGaugeFermionZp 
        + LGaugeSelf + LScalarGauge + LScalarFermion;

(* ******************************* *)
(* *****  Self-audit table  ***** *)
(* ******************************* *)

(*
Self-audit table for the 331 model:

| term name              | fields in monomial        | d | coupling symbol | coupling dim | 1/Lambda^power | Q sum | Y sum | SU(2) contr. | SU(3) contr. | new U(1) sum | L/B sum | CC[] used | frac/root checked | Hermitian partner |
|------------------------|---------------------------|---|-----------------|--------------|----------------|-------|-------|--------------|--------------|--------------|---------|-----------|-------------------|-------------------|
| LHiggsKinMass:h        | h, del[h]                 | 4 | -               | 0            | n/a            | 0     | 0     | singlet      | singlet      | 0            | 0       | n/a       | n/a               | self              |
| LHiggsKinMass:H2       | H2, del[H2]               | 4 | -               | 0            | n/a            | 0     | 0     | singlet      | singlet      | 0            | 0       | n/a       | n/a               | self              |
| LHiggsKinMass:H3       | H3, del[H3]               | 4 | -               | 0            | n/a            | 0     | 0     | singlet      | singlet      | 0            | 0       | n/a       | n/a               | self              |
| LHiggsKinMass:H0       | H0, del[H0]               | 4 | -               | 0            | n/a            | 0     | 0     | singlet      | singlet      | 0            | 0       | n/a       | n/a               | self              |
| LHiggsKinMass:Hp       | Hp, Hm, DC                | 4 | -               | 0            | n/a            | 0     | 0     | singlet      | singlet      | 0            | 0       | n/a       | n/a               | HC                |
| LHiggsKinMass:HpQV     | HpQV, HmQV, DC            | 4 | -               | 0            | n/a            | QV    | Y_HpQV| singlet      | singlet      | 0            | 0       | n/a       | n/a               | HC                |
| LHiggsKinMass:HpQY     | HpQY, HmQY, DC            | 4 | -               | 0            | n/a            | QY    | Y_HpQY| singlet      | singlet      | 0            | 0       | n/a       | n/a               | HC                |
| LGaugeKinMass:Zp       | Zp, FS[Zp]                | 4 | -               | 0            | n/a            | 0     | 0     | singlet      | singlet      | 0            | 0       | n/a       | n/a               | self              |
| LGaugeKinMass:V        | Vp, Vm, FS                | 4 | -               | 0            | n/a            | QV    | Y_V   | singlet      | singlet      | 0            | 0       | n/a       | n/a               | HC                |
| LGaugeKinMass:Y        | Yp, Ym, FS                | 4 | -               | 0            | n/a            | QY    | Y_Y   | singlet      | singlet      | 0            | 0       | n/a       | n/a               | HC                |
| LFermionKinMass:Dq     | Dq, Dqbar, DC             | 4 | -               | 0            | n/a            | QD    | Y_Dq  | singlet      | triplet      | 0            | 1/3     | n/a       | n/a               | self              |
| LFermionKinMass:Tq     | Tq, Tqbar, DC             | 4 | -               | 0            | n/a            | QT    | Y_Tq  | singlet      | triplet      | 0            | 1/3     | n/a       | n/a               | self              |
| LFermionKinMass:El     | El, Elbar, DC             | 4 | -               | 0            | n/a            | QE    | Y_El  | singlet      | singlet      | 0            | 1       | n/a       | n/a               | self              |
| LGaugeFermion:V-Dq     | Vp, Dqbar, Dq             | 4 | g331/Sqrt[2]    | 0            | n/a            | QV+QD-QD=QV | Y_V+Y_Dq-Y_Dq | singlet | triplet | X_V+X_Dq-X_Dq=X_V | 0 | n/a | n/a | HC |
| LGaugeFermionY:Y-Dq    | Yp, uqbar, Dq             | 4 | g331/Sqrt[2]    | 0            | n/a            | QY+Q_u-Q_D | Y_Y+Y_u-Y_D | singlet | triplet | X_Y+X_u-X_D | 0 | n/a | n/a | HC |
| LGaugeFermionZp:Zp-f   | Zp, fbar, f               | 4 | g_Zpff          | 0            | n/a            | 0     | 0     | singlet      | triplet/sing | 0            | 0       | n/a       | LaTeX App.A       | self              |
| LScalarFermion:H0-El   | H0, Elbar, El             | 4 | O31*MEl/v3      | 0            | n/a            | 0     | 0     | singlet      | singlet      | 0            | 0       | n/a       | LaTeX App.A       | self              |
| LScalarFermion:h-El    | h, Elbar, El              | 4 | U31*MEl/v3      | 0            | n/a            | 0     | 0     | singlet      | singlet      | 0            | 0       | n/a       | LaTeX App.A       | self              |
| LScalarFermion:Hp-nu-l | Hp, vlbar, l              | 4 | Sqrt[2]*Ml*c12/v2| 0           | n/a            | 1     | Y_Hp  | Eps[ii,jj]   | singlet      | 0            | 0       | n/a       | LaTeX App.A       | HC                |

SelfConjugate -> True classes with no QuantumNumbers:
