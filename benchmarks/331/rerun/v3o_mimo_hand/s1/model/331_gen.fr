(******************************************************************)
(*  331 (SimpleExtensions) add-on for SM.fr                       *)
(*  Based on arXiv:1611.09337 (Cao, Zhang)                        *)
(*  Benchmark beta = Sqrt[3]: QV=1, QY=2, QD=QS=-4/3, QT=5/3,     *)
(*  QE=1, a+=4, a-=2, b+=5, b-=1.                                 *)
(******************************************************************)

M$ModelName = "331_gen";

M$Information = {
  Authors      -> {"Automated extraction from arXiv:1611.09337"},
  Version      -> "1.0",
  Date         -> "24. 09. 2026",
  Institutions -> {"N/A"},
  References   -> {"arXiv:1611.09337"},
  Description  -> "3-3-1 model add-on on top of SM.fr (beta = Sqrt[3] benchmark)"
};

FeynmanGauge = True;

M$InteractionOrderHierarchy = {
  {QCD, 1},
  {QED, 2},
  {NP, 1}
};

(* Indices Colour, Gluon, Generation, SU2D, SU2W come from SM.fr. *)


(* ************************** *)
(* *****   Parameters   ***** *)
(* **************************)
M$Parameters = {

  (* --- External new-physics parameters --- *)
  beta == {
    ParameterType -> External,
    BlockName     -> NPINPUTS,
    OrderBlock    -> 1,
    Value         -> Sqrt[3],
    InteractionOrder -> {NP, 1},
    Description   -> "331 parameter beta (benchmark Sqrt[3])"
  },
  v1 == {
    ParameterType -> External,
    BlockName     -> NPINPUTS,
    OrderBlock    -> 2,
    Value         -> 200.,
    Description   -> "rho vev [GeV]"
  },
  v3 == {
    ParameterType -> External,
    BlockName     -> NPINPUTS,
    OrderBlock    -> 3,
    Value         -> 2000.,
    Description   -> "chi vev [GeV]"
  },
  kk == {
    ParameterType -> External,
    BlockName     -> NPINPUTS,
    OrderBlock    -> 4,
    Value         -> 1.,
    InteractionOrder -> {NP, 1},
    Description   -> "k with f = k v3"
  },
  lam1 == {
    ParameterType -> External,
    BlockName     -> NPINPUTS,
    OrderBlock    -> 5,
    Value         -> 0.1,
    InteractionOrder -> {NP, 1},
    Description   -> "quartic lambda1"
  },
  lam2 == {
    ParameterType -> External,
    BlockName     -> NPINPUTS,
    OrderBlock    -> 6,
    Value         -> 0.1,
    InteractionOrder -> {NP, 1},
    Description   -> "quartic lambda2"
  },
  lam3 == {
    ParameterType -> External,
    BlockName     -> NPINPUTS,
    OrderBlock    -> 7,
    Value         -> 0.1,
    InteractionOrder -> {NP, 1},
    Description   -> "quartic lambda3"
  },
  lam12 == {
    ParameterType -> External,
    BlockName     -> NPINPUTS,
    OrderBlock    -> 8,
    Value         -> 0.1,
    InteractionOrder -> {NP, 1},
    Description   -> "quartic lambda12"
  },
  lam13 == {
    ParameterType -> External,
    BlockName     -> NPINPUTS,
    OrderBlock    -> 9,
    Value         -> 0.1,
    InteractionOrder -> {NP, 1},
    Description   -> "quartic lambda13"
  },
  lam23 == {
    ParameterType -> External,
    BlockName     -> NPINPUTS,
    OrderBlock    -> 10,
    Value         -> 0.1,
    InteractionOrder -> {NP, 1},
    Description   -> "quartic lambda23"
  },
  lam12p == {
    ParameterType -> External,
    BlockName     -> NPINPUTS,
    OrderBlock    -> 11,
    Value         -> 0.1,
    InteractionOrder -> {NP, 1},
    Description   -> "quartic lambda'_12"
  },
  lam13p == {
    ParameterType -> External,
    BlockName     -> NPINPUTS,
    OrderBlock    -> 12,
    Value         -> 0.1,
    InteractionOrder -> {NP, 1},
    Description   -> "quartic lambda'_13"
  },
  lam23p == {
    ParameterType -> External,
    BlockName     -> NPINPUTS,
    OrderBlock    -> 13,
    Value         -> 0.1,
    InteractionOrder -> {NP, 1},
    Description   -> "quartic lambda'_23"
  },
  yHD == {
    ParameterType -> External,
    BlockName     -> NPINPUTS,
    OrderBlock    -> 14,
    Value         -> 0.7,
    InteractionOrder -> {NP, 1},
    Description   -> "Yukawa y^J for D (q1 chi D_R)"
  },
  yHS == {
    ParameterType -> External,
    BlockName     -> NPINPUTS,
    OrderBlock    -> 15,
    Value         -> 0.7,
    InteractionOrder -> {NP, 1},
    Description   -> "Yukawa y^J for S (q2 chi S_R)"
  },
  yHT == {
    ParameterType -> External,
    BlockName     -> NPINPUTS,
    OrderBlock    -> 16,
    Value         -> 0.7,
    InteractionOrder -> {NP, 1},
    Description   -> "Yukawa y^J33 for T (q3 chi* T_R)"
  },
  yHE == {
    ParameterType -> External,
    BlockName     -> NPINPUTS,
    OrderBlock    -> 17,
    Value         -> 0.7,
    InteractionOrder -> {NP, 1},
    Description   -> "Yukawa y^E for heavy leptons El"
  },

  (* External new-particle masses (GeV) *)
  MZp == {
    ParameterType -> External,
    BlockName     -> NPMASS,
    OrderBlock    -> 1,
    Value         -> 6000.,
    Description   -> "Z' mass"
  },
  MH2 == {
    ParameterType -> External,
    BlockName     -> NPMASS,
    OrderBlock    -> 2,
    Value         -> 500.,
    Description   -> "H2 mass (CP-even)"
  },
  MH3 == {
    ParameterType -> External,
    BlockName     -> NPMASS,
    OrderBlock    -> 3,
    Value         -> 2000.,
    Description   -> "H3 mass (CP-even, chi-like)"
  },
  MH0 == {
    ParameterType -> External,
    BlockName     -> NPMASS,
    OrderBlock    -> 4,
    Value         -> 500.,
    Description   -> "H0 mass (CP-odd)"
  },
  MHP == {
    ParameterType -> External,
    BlockName     -> NPMASS,
    OrderBlock    -> 5,
    Value         -> 500.,
    Description   -> "H+- mass (charge +/-1)"
  },
  MHV == {
    ParameterType -> External,
    BlockName     -> NPMASS,
    OrderBlock    -> 6,
    Value         -> 1300.,
    Description   -> "H+-QV mass"
  },
  MHY == {
    ParameterType -> External,
    BlockName     -> NPMASS,
    OrderBlock    -> 7,
    Value         -> 1400.,
    Description   -> "H+-QY mass"
  },
  MDq == {
    ParameterType -> External,
    BlockName     -> NPMASS,
    OrderBlock    -> 8,
    Value         -> 1000.,
    Description   -> "heavy quark D mass"
  },
  MSq == {
    ParameterType -> External,
    BlockName     -> NPMASS,
    OrderBlock    -> 9,
    Value         -> 1000.,
    Description   -> "heavy quark S mass"
  },
  MTq == {
    ParameterType -> External,
    BlockName     -> NPMASS,
    OrderBlock    -> 10,
    Value         -> 1000.,
    Description   -> "heavy quark T mass"
  },
  MEl == {
    ParameterType -> External,
    BlockName     -> NPMASS,
    OrderBlock    -> 11,
    Value         -> 1000.,
    Description   -> "heavy lepton El mass (all generations)"
  },

  (* --- Internal derived parameters --- *)
  v2 == {
    ParameterType -> Internal,
    Value         -> Sqrt[Max[vev^2 - v1^2, 0]],
    Description   -> "eta vev, v1^2+v2^2=vev^2"
  },
  fv == {
    ParameterType -> Internal,
    Value         -> kk*v3,
    InteractionOrder -> {NP, 1},
    Description   -> "f = k v3"
  },
  MVq == {
    ParameterType -> Internal,
    Value         -> gw/2*Sqrt[v3^2+v1^2],
    Description   -> "V mass, M^2 = g^2 (v3^2+v1^2)/4"
  },
  MYq == {
    ParameterType -> Internal,
    Value         -> gw/2*Sqrt[v3^2+v2^2],
    Description   -> "Y mass, M^2 = g^2 (v3^2+v2^2)/4"
  },
  a0 == {
    ParameterType -> Internal,
    Value         -> Sqrt[1 - (1 + beta^2)*sw^2],
    Description   -> "a0 = Sqrt[1-(1+beta^2) sW^2]"
  },
  ap == {
    ParameterType -> Internal,
    Value         -> Sqrt[3]*beta + 1,
    Description   -> "a+ = Sqrt[3] beta + 1"
  },
  am == {
    ParameterType -> Internal,
    Value         -> Sqrt[3]*beta - 1,
    Description   -> "a- = Sqrt[3] beta - 1"
  },
  bp == {
    ParameterType -> Internal,
    Value         -> Sqrt[3]*beta + 2,
    Description   -> "b+ = Sqrt[3] beta + 2"
  },
  bm == {
    ParameterType -> Internal,
    Value         -> Sqrt[3]*beta - 2,
    Description   -> "b- = Sqrt[3] beta - 2"
  },
  s12 == {
    ParameterType -> Internal,
    Value         -> v2/vev,
    Description   -> "s12 = v2/v"
  },
  c12 == {
    ParameterType -> Internal,
    Value         -> v1/vev,
    Description   -> "c12 = v1/v"
  },
  s13 == {
    ParameterType -> Internal,
    Value         -> v3/Sqrt[v1^2 + v3^2],
    Description   -> "s13"
  },
  c13 == {
    ParameterType -> Internal,
    Value         -> v1/Sqrt[v1^2 + v3^2],
    Description   -> "c13"
  },
  s23 == {
    ParameterType -> Internal,
    Value         -> v3/Sqrt[v2^2 + v3^2],
    Description   -> "s23"
  },
  c23 == {
    ParameterType -> Internal,
    Value         -> v2/Sqrt[v2^2 + v3^2],
    Description   -> "c23"
  },
  U11 == {
    ParameterType -> Internal,
    Value         -> c12,
    Description   -> "CP-even mixing U11 (decoupling)"
  },
  U21 == {
    ParameterType -> Internal,
    Value         -> s12,
    Description   -> "CP-even mixing U21 (decoupling)"
  },
  U31 == {
    ParameterType -> Internal,
    Value         -> (kk*v1*v2/(lam3*vev) - (lam13*v1^2 + lam23*v2^2)/(2*lam3*vev))/v3,
    InteractionOrder -> {NP, 1},
    Description   -> "CP-even mixing U31 = g31/v3"
  },
  U12 == {
    ParameterType -> Internal,
    Value         -> s12,
    Description   -> "CP-even mixing U12 (approx)"
  },
  U22 == {
    ParameterType -> Internal,
    Value         -> -c12,
    Description   -> "CP-even mixing U22 (approx)"
  },
  U32 == {
    ParameterType -> Internal,
    Value         -> 0,
    Description   -> "CP-even mixing U32 (leading decoupling)"
  },
  U13 == {
    ParameterType -> Internal,
    Value         -> 0,
    Description   -> "CP-even mixing U13 (leading decoupling)"
  },
  U23 == {
    ParameterType -> Internal,
    Value         -> 0,
    Description   -> "CP-even mixing U23 (leading decoupling)"
  },
  U33 == {
    ParameterType -> Internal,
    Value         -> 1,
    Description   -> "CP-even mixing U33 (chi-like)"
  },
  O11 == {
    ParameterType -> Internal,
    Value         -> v2*v3/Sqrt[v1^2*v2^2 + vev^2*v3^2],
    Description   -> "CP-odd O11"
  },
  O21 == {
    ParameterType -> Internal,
    Value         -> v1*v3/Sqrt[v1^2*v2^2 + vev^2*v3^2],
    Description   -> "CP-odd O21"
  },
  O31 == {
    ParameterType -> Internal,
    Value         -> v1*v2/Sqrt[v1^2*v2^2 + vev^2*v3^2],
    Description   -> "CP-odd O31"
  },
  O12 == {
    ParameterType -> Internal,
    Value         -> -v1*v3^2/Sqrt[(v1^2 + v3^2)*(v1^2*v2^2 + vev^2*v3^2)],
    Description   -> "CP-odd O12"
  },
  O22 == {
    ParameterType -> Internal,
    Value         -> v2*Sqrt[(v1^2 + v3^2)/(v1^2*v2^2 + vev^2*v3^2)],
    Description   -> "CP-odd O22"
  },
  O32 == {
    ParameterType -> Internal,
    Value         -> v1^2*v3/Sqrt[(v1^2 + v3^2)*(v1^2*v2^2 + vev^2*v3^2)],
    Description   -> "CP-odd O32"
  },
  O13 == {
    ParameterType -> Internal,
    Value         -> -v1/Sqrt[v1^2 + v3^2],
    Description   -> "CP-odd O13"
  },
  O23 == {
    ParameterType -> Internal,
    Value         -> 0,
    Description   -> "CP-odd O23"
  },
  O33 == {
    ParameterType -> Internal,
    Value         -> v3/Sqrt[v1^2 + v3^2],
    Description   -> "CP-odd O33"
  },

  (* Generation projectors (explicit components) *)
  P1 == {
    ParameterType -> Internal,
    Indices       -> {Index[Generation], Index[Generation]},
    Value         -> {
      P1[1,1] -> 1, P1[1,2] -> 0, P1[1,3] -> 0,
      P1[2,1] -> 0, P1[2,2] -> 0, P1[2,3] -> 0,
      P1[3,1] -> 0, P1[3,2] -> 0, P1[3,3] -> 0
    },
    Description   -> "projector onto generation 1"
  },
  P2 == {
    ParameterType -> Internal,
    Indices       -> {Index[Generation], Index[Generation]},
    Value         -> {
      P2[1,1] -> 0, P2[1,2] -> 0, P2[1,3] -> 0,
      P2[2,1] -> 0, P2[2,2] -> 1, P2[2,3] -> 0,
      P2[3,1] -> 0, P2[3,2] -> 0, P2[3,3] -> 0
    },
    Description   -> "projector onto generation 2"
  },
  P3 == {
    ParameterType -> Internal,
    Indices       -> {Index[Generation], Index[Generation]},
    Value         -> {
      P3[1,1] -> 0, P3[1,2] -> 0, P3[1,3] -> 0,
      P3[2,1] -> 0, P3[2,2] -> 0, P3[2,3] -> 0,
      P3[3,1] -> 0, P3[3,2] -> 0, P3[3,3] -> 1
    },
    Description   -> "projector onto generation 3"
  },
  P12 == {
    ParameterType -> Internal,
    Indices       -> {Index[Generation], Index[Generation]},
    Value         -> {
      P12[1,1] -> 1, P12[1,2] -> 0, P12[1,3] -> 0,
      P12[2,1] -> 0, P12[2,2] -> 1, P12[2,3] -> 0,
      P12[3,1] -> 0, P12[3,2] -> 0, P12[3,3] -> 0
    },
    Description   -> "projector onto generations 1,2"
  },

  (* Z' chiral couplings as generation matrices (L coefficients) *)
  zpQLu == {
    ParameterType -> Internal,
    Indices       -> {Index[Generation], Index[Generation]},
    Value         -> {
      zpQLu[1,1] -> ee*((beta + Sqrt[3])*sw^2 - Sqrt[3])/(6*cw*sw*a0),
      zpQLu[1,2] -> 0, zpQLu[1,3] -> 0,
      zpQLu[2,1] -> 0,
      zpQLu[2,2] -> ee*((beta + Sqrt[3])*sw^2 - Sqrt[3])/(6*cw*sw*a0),
      zpQLu[2,3] -> 0,
      zpQLu[3,1] -> 0, zpQLu[3,2] -> 0,
      zpQLu[3,3] -> ee*((beta - Sqrt[3])*sw^2 + Sqrt[3])/(6*cw*sw*a0)
    },
    InteractionOrder -> {NP, 1},
    Description   -> "Z' gL matrix for up-type quarks"
  },
  zpQRu == {
    ParameterType -> Internal,
    Indices       -> {Index[Generation], Index[Generation]},
    Value         -> {
      zpQRu[1,1] -> 2*beta*ee*sw/(3*cw*a0),
      zpQRu[1,2] -> 0, zpQRu[1,3] -> 0,
      zpQRu[2,1] -> 0, zpQRu[2,2] -> 2*beta*ee*sw/(3*cw*a0), zpQRu[2,3] -> 0,
      zpQRu[3,1] -> 0, zpQRu[3,2] -> 0, zpQRu[3,3] -> 2*beta*ee*sw/(3*cw*a0)
    },
    InteractionOrder -> {NP, 1},
    Description   -> "Z' gR matrix for up-type quarks"
  },
  zpQLd == {
    ParameterType -> Internal,
    Indices       -> {Index[Generation], Index[Generation]},
    Value         -> {
      zpQLd[1,1] -> ee*((beta + Sqrt[3])*sw^2 - Sqrt[3])/(6*cw*sw*a0),
      zpQLd[1,2] -> 0, zpQLd[1,3] -> 0,
      zpQLd[2,1] -> 0,
      zpQLd[2,2] -> ee*((beta + Sqrt[3])*sw^2 - Sqrt[3])/(6*cw*sw*a0),
      zpQLd[2,3] -> 0,
      zpQLd[3,1] -> 0, zpQLd[3,2] -> 0,
      zpQLd[3,3] -> ee*((beta - Sqrt[3])*sw^2 + Sqrt[3])/(6*cw*sw*a0)
    },
    InteractionOrder -> {NP, 1},
    Description   -> "Z' gL matrix for down-type quarks"
  },
  zpQRd == {
    ParameterType -> Internal,
    Indices       -> {Index[Generation], Index[Generation]},
    Value         -> {
      zpQRd[1,1] -> -beta*ee*sw/(3*cw*a0),
      zpQRd[1,2] -> 0, zpQRd[1,3] -> 0,
      zpQRd[2,1] -> 0, zpQRd[2,2] -> -beta*ee*sw/(3*cw*a0), zpQRd[2,3] -> 0,
      zpQRd[3,1] -> 0, zpQRd[3,2] -> 0, zpQRd[3,3] -> -beta*ee*sw/(3*cw*a0)
    },
    InteractionOrder -> {NP, 1},
    Description   -> "Z' gR matrix for down-type quarks"
  },
  zpQLe == {
    ParameterType -> Internal,
    Indices       -> {Index[Generation], Index[Generation]},
    Value         -> {
      zpQLe[1,1] -> ee*(1 - ap*sw^2)/(2*Sqrt[3]*cw*sw*a0),
      zpQLe[1,2] -> 0, zpQLe[1,3] -> 0,
      zpQLe[2,1] -> 0, zpQLe[2,2] -> ee*(1 - ap*sw^2)/(2*Sqrt[3]*cw*sw*a0), zpQLe[2,3] -> 0,
      zpQLe[3,1] -> 0, zpQLe[3,2] -> 0, zpQLe[3,3] -> ee*(1 - ap*sw^2)/(2*Sqrt[3]*cw*sw*a0)
    },
    InteractionOrder -> {NP, 1},
    Description   -> "Z' gL matrix for charged leptons"
  },
  zpQRe == {
    ParameterType -> Internal,
    Indices       -> {Index[Generation], Index[Generation]},
    Value         -> {
      zpQRe[1,1] -> -beta*ee*sw/(cw*a0),
      zpQRe[1,2] -> 0, zpQRe[1,3] -> 0,
      zpQRe[2,1] -> 0, zpQRe[2,2] -> -beta*ee*sw/(cw*a0), zpQRe[2,3] -> 0,
      zpQRe[3,1] -> 0, zpQRe[3,2] -> 0, zpQRe[3,3] -> -beta*ee*sw/(cw*a0)
    },
    InteractionOrder -> {NP, 1},
    Description   -> "Z' gR matrix for charged leptons"
  },
  zpQLv == {
    ParameterType -> Internal,
    Indices       -> {Index[Generation], Index[Generation]},
    Value         -> {
      zpQLv[1,1] -> ee*(1 - ap*sw^2)/(2*Sqrt[3]*cw*sw*a0),
      zpQLv[1,2] -> 0, zpQLv[1,3] -> 0,
      zpQLv[2,1] -> 0, zpQLv[2,2] -> ee*(1 - ap*sw^2)/(2*Sqrt[3]*cw*sw*a0), zpQLv[2,3] -> 0,
      zpQLv[3,1] -> 0, zpQLv[3,2] -> 0, zpQLv[3,3] -> ee*(1 - ap*sw^2)/(2*Sqrt[3]*cw*sw*a0)
    },
    InteractionOrder -> {NP, 1},
    Description   -> "Z' gL matrix for neutrinos"
  },
  zpQLD == {
    ParameterType -> Internal,
    Value         -> -ee*((3*Sqrt[3]*beta^2 - beta + 2*Sqrt[3])*sw^2 - 2*Sqrt[3])/(6*cw*sw*a0),
    InteractionOrder -> {NP, 1},
    Description   -> "Z' gL for D,S (L coefficient)"
  },
  zpQRD == {
    ParameterType -> Internal,
    Value         -> -beta*(3*Sqrt[3]*beta - 1)*ee*sw/(6*cw*a0),
    InteractionOrder -> {NP, 1},
    Description   -> "Z' gR for D,S (L coefficient)"
  },
  zpQLT == {
    ParameterType -> Internal,
    Value         -> ee*((3*Sqrt[3]*beta^2 + beta + 2*Sqrt[3])*sw^2 - 2*Sqrt[3])/(6*cw*sw*a0),
    InteractionOrder -> {NP, 1},
    Description   -> "Z' gL for T (L coefficient)"
  },
  zpQRT == {
    ParameterType -> Internal,
    Value         -> beta*(3*Sqrt[3]*beta + 1)*ee*sw/(6*cw*a0),
    InteractionOrder -> {NP, 1},
    Description   -> "Z' gR for T (L coefficient)"
  },
  zpQLE == {
    ParameterType -> Internal,
    Indices       -> {Index[Generation], Index[Generation]},
    Value         -> {
      zpQLE[1,1] -> ee*((am^2 + 1)*sw^2 - 2)/(2*Sqrt[3]*cw*sw*a0),
      zpQLE[1,2] -> 0, zpQLE[1,3] -> 0,
      zpQLE[2,1] -> 0, zpQLE[2,2] -> ee*((am^2 + 1)*sw^2 - 2)/(2*Sqrt[3]*cw*sw*a0), zpQLE[2,3] -> 0,
      zpQLE[3,1] -> 0, zpQLE[3,2] -> 0, zpQLE[3,3] -> ee*((am^2 + 1)*sw^2 - 2)/(2*Sqrt[3]*cw*sw*a0)
    },
    InteractionOrder -> {NP, 1},
    Description   -> "Z' gL matrix for heavy leptons El"
  },
  zpQRE == {
    ParameterType -> Internal,
    Indices       -> {Index[Generation], Index[Generation]},
    Value         -> {
      zpQRE[1,1] -> Sqrt[3]*beta^2*ee*sw/(2*cw*a0),
      zpQRE[1,2] -> 0, zpQRE[1,3] -> 0,
      zpQRE[2,1] -> 0, zpQRE[2,2] -> Sqrt[3]*beta^2*ee*sw/(2*cw*a0), zpQRE[2,3] -> 0,
      zpQRE[3,1] -> 0, zpQRE[3,2] -> 0, zpQRE[3,3] -> Sqrt[3]*beta^2*ee*sw/(2*cw*a0)
    },
    InteractionOrder -> {NP, 1},
    Description   -> "Z' gR matrix for heavy leptons El"
  },

  (* Heavy-fermion Z couplings (vector-like as in paper) *)
  zD == {
    ParameterType -> Internal,
    Value         -> ee*(3*Sqrt[3]*beta - 1)*sw/(6*cw),
    InteractionOrder -> {NP, 1},
    Description   -> "Z coupling of D,S (L coefficient)"
  },
  zT == {
    ParameterType -> Internal,
    Value         -> -ee*(3*Sqrt[3]*beta + 1)*sw/(6*cw),
    InteractionOrder -> {NP, 1},
    Description   -> "Z coupling of T (L coefficient)"
  },
  zE == {
    ParameterType -> Internal,
    Value         -> -am*ee*sw/(2*cw),
    InteractionOrder -> {NP, 1},
    Description   -> "Z coupling of El (L coefficient)"
  },
  aE == {
    ParameterType -> Internal,
    Value         -> am*ee/2,
    InteractionOrder -> {NP, 1},
    Description   -> "photon coupling of El (L coefficient = Q_E ee)"
  },

  (* V,Y gauge-fermion L coefficients (paper gL / i) *)
  vyCoup == {
    ParameterType -> Internal,
    Value         -> -ee/(Sqrt[2]*sw),
    InteractionOrder -> {NP, 1},
    Description   -> "V,Y fermion chiral coupling -e/(sqrt2 sW)"
  }
};


(* ************************** *)
(* **** Particle classes **** *)
(* ************************** *)
M$ClassesDescription = {

  (* ----- New gauge bosons ----- *)
  V[100] == {
    ClassName       -> Zp,
    SelfConjugate   -> True,
    Mass            -> {MZp, 6000.},
    Width           -> {WZp, 100.},
    ParticleName    -> "Zp",
    PDG             -> 6000023,
    PropagatorLabel -> "Zp",
    PropagatorType  -> Sine,
    PropagatorArrow -> None,
