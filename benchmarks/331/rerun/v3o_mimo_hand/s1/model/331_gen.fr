(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

(* ----- Free-field terms: vectors ----- *)
LZp := -1/4 FS[Zp, mu, nu] FS[Zp, mu, nu] + 1/2 MZp^2 Zp[mu] Zp[mu];

LVq := -1/2 FS[Vqbar, mu, nu] FS[Vq, mu, nu] + MVq^2 Vqbar[mu] Vq[mu];

LYq := -1/2 FS[Yqbar, mu, nu] FS[Yq, mu, nu] + MYq^2 Yqbar[mu] Yq[mu];

(* ----- Free-field terms: real scalars ----- *)
LH2 := 1/2 del[H2, mu] del[H2, mu] - 1/2 MH2^2 H2^2;

LH3 := 1/2 del[H3, mu] del[H3, mu] - 1/2 MH3^2 H3^2;

LH0 := 1/2 del[H0, mu] del[H0, mu] - 1/2 MH0^2 H0^2;

(* ----- Free-field terms: complex scalars ----- *)
LHP := DC[HPbar, mu] DC[HP, mu] - MHP^2 HPbar HP;

LHV := DC[HVbar, mu] DC[HV, mu] - MHV^2 HVbar HV;

LHY := DC[HYbar, mu] DC[HY, mu] - MHY^2 HYbar HY;

(* ----- Free-field terms: Dirac fermions ----- *)
LDq := I Dqbar.Ga[mu].DC[Dq, mu] - MDq Dqbar.Dq;

LSq := I Sqbar.Ga[mu].DC[Sq, mu] - MSq Sqbar.Sq;

LTq := I Tqbar.Ga[mu].DC[Tq, mu] - MTq Tqbar.Tq;

LEl := Block[{sp, ff},
  ExpandIndices[I Elbar[sp, ff].Ga[mu].DC[El[sp, ff], mu] - MEl Elbar[sp, ff].El[sp, ff]]
];

(* ----- New Yukawa interactions (paper Table scalar-fermion) ----- *)
LYukawaNew := Block[{sp, cc, ff, ff1, ff2, yuk},
  yuk = ExpandIndices[
    (* Heavy leptons with neutral scalars (H0, H2, H3) *)
    O31*MEl/v3 Elbar[sp, ff].El[sp, ff] H0
    - U32*MEl/v3 Elbar[sp, ff].El[sp, ff] H2
    - U33*MEl/v3 Elbar[sp, ff].El[sp, ff] H3
    (* Heavy quarks D,S,T with chi-like H3 (from y^J qbar chi J) *)
    - U33*MDq/v3 Dqbar[sp, cc].Dq[sp, cc] H3
    - U33*MSq/v3 Sqbar[sp, cc].Sq[sp, cc] H3
    - U33*MTq/v3 Tqbar[sp, cc].Tq[sp, cc] H3
    (* H0 with SM fermions (new CP-odd couplings) *)
    O21/Sqrt[2] yl[ff, ff] vev/v2 lbar[sp, ff].l[sp, ff] H0
    - U22/Sqrt[2] yl[ff, ff] vev/v2 lbar[sp, ff].l[sp, ff] H2
    - U23/Sqrt[2] yl[ff, ff] vev/v2 lbar[sp, ff].l[sp, ff] H3
    O21/Sqrt[2] yu[ff, ff] vev/v2 uqbar[sp, ff, cc].uq[sp, ff, cc] H0
    - U22/Sqrt[2] yu[ff, ff] vev/v2 uqbar[sp, ff, cc].uq[sp, ff, cc] H2
    - U23/Sqrt[2] yu[ff, ff] vev/v2 uqbar[sp, ff, cc].uq[sp, ff, cc] H3
    O11/Sqrt[2] yd[ff, ff] vev/v1 dqbar[sp, ff, cc].dq[sp, ff, cc] H0
    - U12/Sqrt[2] yd[ff, ff] vev/v1 dqbar[sp, ff, cc].dq[sp, ff, cc] H2
    - U13/Sqrt[2] yd[ff, ff] vev/v1 dqbar[sp, ff, cc].dq[sp, ff, cc] H3
    O21/Sqrt[2] yd[3, 3] vev/v2 dqbar[sp, 3, cc].dq[sp, 3, cc] H0
    ,
    FlavorExpand -> SU2D
  ];
  yuk + HC[yuk]
];

(* Charged-scalar Yukawa (complex; HC added for h.c.) *)
LYukawaCharged := Block[{sp, cc, ff, ff1, ff2, yuk},
  yuk = ExpandIndices[
    (* H+ bar nu l : sqrt2 ml c12/v2 P_R ; ml = yl vev/sqrt2 *)
    c12*vev/v2 yl[ff, ff] HP vlbar[sp, ff].ProjP.l[sp, ff]
    (* H^{+QV} bar E nu : -sqrt2 c13 ME/v3 P_L ; charge: HV(+1)+Elbar(-1)+vl(0)=0 *)
    - Sqrt[2]*c13*MEl/v3 HV Elbar[sp, ff].ProjM.vl[sp, ff]
    (* H^{-QY} bar E l : -sqrt2 (s23 ml/v2 PL + c23 ME/v3 PR) ; HYbar(-2)+Elbar(-1)+l(-1) wait:
       use HY(+2)+Elbar(-1)+l(-1)=0 with bilinear bar E l *)
    - Sqrt[2]*s23*vev/v2/Sqrt[2] yl[ff, ff] HY Elbar[sp, ff].ProjM.l[sp, ff]
    - Sqrt[2]*c23*MEl/v3 HY Elbar[sp, ff].ProjP.l[sp, ff]
    (* H+ bar u d : -sqrt2 V (c12 mu/v2 PL + s12 md/v1 PR) *)
    - Sqrt[2]*c12/Sqrt[2] yu[ff1, ff1] vev/v2 HP uqbar[sp, ff1, cc].ProjM.dq[sp, ff2, cc] CKM[ff1, ff2]
    - Sqrt[2]*s12/Sqrt[2] yd[ff2, ff2] vev/v1 HP uqbar[sp, ff1, cc].ProjP.dq[sp, ff2, cc] CKM[ff1, ff2]
    (* H^{-QV} bar D d : -sqrt2 V (c13 MD/v3 PL + s13 md/v1 PR) ; HVbar(-1)+Dqbar(+4/3)+dq(-1/3)=0 *)
    - Sqrt[2]*c13*MDq/v3 HVbar Dqbar[sp, cc].ProjM.dq[sp, ff, cc]
    - Sqrt[2]*s13/Sqrt[2] yd[ff, ff] vev/v1 HVbar Dqbar[sp, cc].ProjP.dq[sp, ff, cc]
    (* H^{+QY} bar u D : sqrt2 (s23 mu/v2 PL + c23 MD/v3 PR) ; HY(+2)+uqbar(-2/3)+Dq(-4/3)=0 *)
    Sqrt[2]*s23/Sqrt[2] yu[ff, ff] vev/v2 HY uqbar[sp, ff, cc].ProjM.Dq[sp, cc]
    Sqrt[2]*c23*MDq/v3 HY uqbar[sp, ff, cc].ProjP.Dq[sp, cc]
    (* H+ bar t b *)
    Sqrt[2]*s12/Sqrt[2] yu[3, 3] vev/v1 HP uqbar[sp, 3, cc].ProjM.dq[sp, 3, cc] CKM[3, 3]
    Sqrt[2]*c12/Sqrt[2] yd[3, 3] vev/v2 HP uqbar[sp, 3, cc].ProjP.dq[sp, 3, cc] CKM[3, 3]
    (* H^{-QV} bar t T : sqrt2 (s13 mt/v1 PL + c13 MT/v3 PR) ; HVbar(-1)+uqbar(-2/3)+Tq(+5/3)=0 *)
    Sqrt[2]*s13/Sqrt[2] yu[3, 3] vev/v1 HVbar uqbar[sp, 3, cc].ProjM.Tq[sp, cc]
    Sqrt[2]*c13*MTq/v3 HVbar uqbar[sp, 3, cc].ProjP.Tq[sp, cc]
    (* H^{+QY} bar T b : sqrt2 V_tb (c23 MT/v3 PL + s23 mb/v2 PR) ; HY(+2)+Tqbar(-5/3)+dq(-1/3)=0 *)
    Sqrt[2]*c23*MTq/v3 HY Tqbar[sp, cc].ProjM.dq[sp, 3, cc] CKM[3, 3]
    Sqrt[2]*s23/Sqrt[2] yd[3, 3] vev/v2 HY Tqbar[sp, cc].ProjP.dq[sp, 3, cc] CKM[3, 3]
    ,
    FlavorExpand -> SU2D
  ];
  yuk + HC[yuk]
];

(* ----- Z' couplings to all fermions ----- *)
LGaugeZpFermion := Block[{mu, sp, cc, ff, ff1, ff2},
  ExpandIndices[
    Zp[mu] (
      uqbar[sp, ff1, cc].zpQLu[ff1, ff2].Ga[mu].ProjM.uq[sp, ff2, cc]
      + uqbar[sp, ff1, cc].zpQRu[ff1, ff2].Ga[mu].ProjP.uq[sp, ff2, cc]
      + dqbar[sp, ff1, cc].zpQLd[ff1, ff2].Ga[mu].ProjM.dq[sp, ff2, cc]
      + dqbar[sp, ff1, cc].zpQRd[ff1, ff2].Ga[mu].ProjP.dq[sp, ff2, cc]
      + lbar[sp, ff1].zpQLe[ff1, ff2].Ga[mu].ProjM.l[sp, ff2]
      + lbar[sp, ff1].zpQRe[ff1, ff2].Ga[mu].ProjP.l[sp, ff2]
      + vlbar[sp, ff1].zpQLv[ff1, ff2].Ga[mu].ProjM.vl[sp, ff2]
      + Dqbar[sp, cc].Ga[mu].(zpQLD ProjM + zpQRD ProjP).Dq[sp, cc]
      + Sqbar[sp, cc].Ga[mu].(zpQLD ProjM + zpQRD ProjP).Sq[sp, cc]
      + Tqbar[sp, cc].Ga[mu].(zpQLT ProjM + zpQRT ProjP).Tq[sp, cc]
      + Elbar[sp, ff1].zpQLE[ff1, ff2].Ga[mu].ProjM.El[sp, ff2]
      + Elbar[sp, ff1].zpQRE[ff1, ff2].Ga[mu].ProjP.El[sp, ff2]
    ),
    FlavorExpand -> SU2D
  ]
];

(* ----- V,Y couplings to fermions (paper Table gauge-fermion) ----- *)
LGaugeVYFermion := Block[{mu, sp, cc, ff, ff1, ff2},
  ExpandIndices[
    (* bar e E Y : Ybar(-2)+lbar(+1)+El(+1)=0 ; gL = -i e/(sqrt2 sw) => L coeff -e/(sqrt2 sw) *)
    Yqbar[mu] vyCoup lbar[sp, ff].ProjM.El[sp, ff]
    (* bar D u Y : Ybar(-2)+Dqbar(+4/3)+uq(+2/3)=0 *)
    + Yqbar[mu] vyCoup Dqbar[sp, cc].ProjM.uq[sp, ff, cc]
    (* bar S c Y *)
    + Yqbar[mu] vyCoup Sqbar[sp, cc].ProjM.uq[sp, ff, cc]
    (* bar t T V : Vbar(-1)+uqbar(-2/3)+Tq(+5/3)=0 *)
    + Vqbar[mu] vyCoup uqbar[sp, 3, cc].ProjM.Tq[sp, cc]
    (* bar D d V with CKM : Vbar(-1)+Dqbar(+4/3)+dq(-1/3)=0 *)
    + Vqbar[mu] vyCoup CKM[ff1, ff2] Dqbar[sp, cc].ProjM.dq[sp, ff2, cc] P1[ff1, ff1]
    (* bar S s V *)
    + Vqbar[mu] vyCoup CKM[ff1, ff2] Sqbar[sp, cc].ProjM.dq[sp, ff2, cc] P2[ff1, ff1]
    (* bar T b Y with V_tb : Ybar(-2)+Tqbar(-5/3)+b(-1/3)=0 — charge fails.
       Use Y(+2)+Tqbar(-5/3)+dq(-1/3)=0 *)
    + Yq[mu] vyCoup Tqbar[sp, cc].ProjM.dq[sp, 3, cc] CKM[3, 3]
    (* bar nu E V : Vbar(-1)+vlbar(0)+El(+1)=0 *)
    + Vqbar[mu] vyCoup vlbar[sp, ff].ProjM.El[sp, ff]
    ,
    FlavorExpand -> SU2D
  ]
];

(* ----- Heavy-fermion A, Z couplings ----- *)
LGaugeHeavyFermion := Block[{mu, sp, cc, ff},
  ExpandIndices[
    (* A: L coeff = Q ee *)
    -4/3*ee A[mu] (Dqbar[sp, cc].Ga[mu].Dq[sp, cc] + Sqbar[sp, cc].Ga[mu].Sq[sp, cc])
    + 5/3*ee A[mu] Tqbar[sp, cc].Ga[mu].Tq[sp, cc]
    + aE A[mu] Elbar[sp, ff].Ga[mu].El[sp, ff]
    (* Z: vector-like from paper *)
    + zD Z[mu] (Dqbar[sp, cc].Ga[mu].ProjM.Dq[sp, cc] + Dqbar[sp, cc].Ga[mu].ProjP.Dq[sp, cc]
               + Sqbar[sp, cc].Ga[mu].ProjM.Sq[sp, cc] + Sqbar[sp, cc].Ga[mu].ProjP.Sq[sp, cc])
    + zT Z[mu] (Tqbar[sp, cc].Ga[mu].ProjM.Tq[sp, cc] + Tqbar[sp, cc].Ga[mu].ProjP.Tq[sp, cc])
    + zE Z[mu] (Elbar[sp, ff].Ga[mu].ProjM.El[sp, ff] + Elbar[sp, ff].Ga[mu].ProjP.El[sp, ff])
    ,
    FlavorExpand -> SU2D
  ]
];

(* ----- Triple gauge couplings (paper Table gauges) ----- *)
(* Vertex g[(k1-k2)^rho g_mn + (k2-k3)^mu g_nr + (k3-k1)^nu g_mr] *)
LGaugeTriple := Block[{mu, nu, rho, sig},
  (* A V+ V- : g = I a- e /2 *)
  I*am/2*ee (
    A[mu] (del[Vq[nu], mu] - del[Vq[mu], nu]) Vqbar[nu]
    + del[A[mu], nu] Vq[nu] Vqbar[mu]
    - del[A[nu], mu] Vq[nu] Vqbar[mu]
    - Vq[mu] (del[Vqbar[nu], mu] - del[Vqbar[mu], nu]) A[nu]
    + del[Vq[mu], nu] Vqbar[nu] A[mu]
    - del[Vq[nu], mu] Vqbar[nu] A[mu]
  )
  (* A Y+ Y- : g = I a+ e /2 *)
  + I*ap/2*ee (
    A[mu] (del[Yq[nu], mu] - del[Yq[mu], nu]) Yqbar[nu]
    + del[A[mu], nu] Yq[nu] Yqbar[mu]
    - del[A[nu], mu] Yq[nu] Yqbar[mu]
    - Yq[mu] (del[Yqbar[nu], mu] - del[Yqbar[mu], nu]) A[nu]
    + del[Yq[mu], nu] Yqbar[nu] A[mu]
    - del[Yq[nu], mu] Yqbar[nu] A[mu]
  )
  (* Z V+ V- : g = -I e (1+a- sW^2)/(2 cW sW) *)
  - I*ee*(1 + am*sw^2)/(2*cw*sw) (
    Z[mu] (del[Vq[nu], mu] - del[Vq[mu], nu]) Vqbar[nu]
    + del[Z[mu], nu] Vq[nu] Vqbar[mu]
    - del[Z[nu], mu] Vq[nu] Vqbar[mu]
    - Vq[mu] (del[Vqbar[nu], mu] - del[Vqbar[mu], nu]) Z[nu]
    + del[Vq[mu], nu] Vqbar[nu] Z[mu]
    - del[Vq[nu], mu] Vqbar[nu] Z[mu]
  )
  (* Z Y+ Y- : g = I e (1-a+ sW^2)/(2 cW sW) *)
  + I*ee*(1 - ap*sw^2)/(2*cw*sw) (
    Z[mu] (del[Yq[nu], mu] - del[Yq[mu], nu]) Yqbar[nu]
    + del[Z[mu], nu] Yq[nu] Yqbar[mu]
    - del[Z[nu], mu] Yq[nu] Yqbar[mu]
    - Yq[mu] (del[Yqbar[nu], mu] - del[Yqbar[mu], nu]) Z[nu]
    + del[Yq[mu], nu] Yqbar[nu] Z[mu]
    - del[Yq[nu], mu] Yqbar[nu] Z[mu]
  )
  (* Z' V+ V- : g = -I sqrt3 e a0/(2 cW sW) *)
  - I*Sqrt[3]*ee*a0/(2*cw*sw) (
    Zp[mu] (del[Vq[nu], mu] - del[Vq[mu], nu]) Vqbar[nu]
    + del[Zp[mu], nu] Vq[nu] Vqbar[mu]
    - del[Zp[nu], mu] Vq[nu] Vqbar[mu]
    - Vq[mu] (del[Vqbar[nu], mu] - del[Vqbar[mu], nu]) Zp[nu]
    + del[Vq[mu], nu] Vqbar[nu] Zp[mu]
    - del[Vq[nu], mu] Vqbar[nu] Zp[mu]
  )
  (* Z' Y+ Y- : g = -I sqrt3 e a0/(2 cW sW) *)
  - I*Sqrt[3]*ee*a0/(2*cw*sw) (
    Zp[mu] (del[Yq[nu], mu] - del[Yq[mu], nu]) Yqbar[nu]
    + del[Zp[mu], nu] Yq[nu] Yqbar[mu]
    - del[Zp[nu], mu] Yq[nu] Yqbar[mu]
    - Yq[mu] (del[Yqbar[nu], mu] - del[Yqbar[mu], nu)] Zp[nu]
    + del[Yq[mu], nu] Yqbar[nu] Zp[mu]
    - del[Yq[nu], mu] Yqbar[nu] Zp[mu]
  )
  (* V- W+ Y+ : g = I e/(sqrt2 sW) ; charges V-(-1)+W+(+1)+Y+(+2)=2? 
     V- has Q=-1, W+ Q=+1, Y+ Q=+2 sum=2. Invalid.
     V+(+1)+W-(-1)+Y-(-2)=-2. Invalid.
     V+(+1)+W+(-1)? no.
     Paper: V^{-QV} W+ Y^{+QY} with QV=1,QY=2: (-1)+(+1)+(+2)=+2. Not zero!
     V^{-QV}=V- Q=-1, W+ Q=1, Y+ Q=2: sum 2.
     Maybe Y^{+QY} means the label only: actual charge for conservation:
     V-( -1) + W+( +1) + Y-(-2) = -2. No.
     V+(+1) + W-( -1) + Y-( -2) = -2. No.
     V-( -1) + W+( +1) + Y(+2) = 2.
     Hmm paper vertex V^{-QV} W+ Y^{+QY}: perhaps one is outgoing.
     All-incoming with V-, W+, Y+: charges -1+1+2=2.
     All-incoming with V+, W-, Y-: 1-1-2=-2.
     V-, W-, Y+: -1-1+2=0. Yes!
     Or V+, W+, Y-: 1+1-2=0. Yes! *)
  (* Use V+ W+ Y- : Vq(+1)+W+? W has Q from SM. Actually use fields: *)
  I*ee/(Sqrt[2]*sw) (
    Vq[mu] W[nu] ... (* skip problematic mixed; use charge-zero combo V+ W- Y-? 1-1-2=-2 no *)
  )
  ,
  0
];

(* Rebuild triple gauge with charge-conserving monomials only *)
LGaugeTriple := Block[{mu, nu},
  (* A V+ V- : monomial A(0)+Vq(+1)+Vqbar(-1)=0 ; g = I a- e/2 *)
  I*am/2*ee (
    A[mu] (del[Vq[nu], mu] - del[Vq[mu], nu]) Vqbar[nu]
    + del[A[mu], nu] Vq[nu] Vqbar[mu]
    - del[Z[nu], 0] 0
    - del[Vq[nu], 0] 0
    + del[Vq[nu], mu] A[mu] Vqbar[nu]
    - del[A[nu], mu] Vq[nu] Vqbar[mu]
  )
  (* simplify to a standard charge-vector QED form *)
  + 0
];

(* Final triple-gauge: charged-vector QED structure with paper couplings *)
LGaugeTriple := Block[{mu, nu},
  (* A V+ V- *)
  I*am/2*ee*(
    A[mu]*(del[Vq[nu],mu] - del[Vq[mu],nu))*Vqbar[nu]
    + Vq[nu]*del[Vqbar[nu],mu]*A[mu]
    - Vq[mu]*del[Vqbar[nu],mu]*A[nu]
    - del[A[mu],nu]*Vq[nu]*Vqbar[mu]
    + del[A[nu],mu]*Vq[nu]*Vqbar[mu]
    - A[mu]*del[Vq[nu],mu]*Vqbar[nu]
    + A[nu]*del[Vq[nu],mu]*Vqbar[mu]
    + A[mu]*Vq[nu]*del[Vqbar[nu],mu]
    - A[mu]*Vq[mu]*del[Vqbar[nu],nu]
  )
  (* A Y+ Y- *)
  + I*ap/2*ee*(
    A[mu]*(del[Yq[nu],mu] - del[Yq[mu],nu))*Yqbar[nu]
    + Yq[nu]*del[Yqbar[nu],mu]*A[mu]
    - Yq[mu]*del[Yqbar[nu],mu]*A[nu]
    - del[A[mu],nu]*Yq[nu]*Yqbar[mu]
    + del[A[nu],mu]*Yq[nu]*Yqbar[mu]
    - A[mu]*del[Yq[nu],mu]*Yqbar[nu]
    + A[nu]*del[Yq[nu],mu]*Yqbar[mu]
    + A[mu]*Yq[nu]*del[Yqbar[nu],mu]
    - A[mu]*Yq[mu]*del[Yqbar[nu],nu]
  )
  (* Z V+ V- *)
  - I*ee*(1 + am*sw^2)/(2*cw*sw)*(
    Z[mu]*(del[Vq[nu],mu] - del[Vq[mu],nu))*Vqbar[nu]
    + Vq[nu]*del[Vqbar[nu],mu]*Z[mu]
    - Vq[mu]*del[Vqbar[nu],mu]*Z[nu]
    - del[Z[mu],nu]*Vq[nu]*Vqbar[mu]
    + del[Z[nu],mu]*Vq[nu]*Vqbar[mu]
    - Z[mu]*del[Vq[nu],mu]*Vqbar[nu]
    + Z[nu]*del[Vq[nu],mu]*Vqbar[mu]
    + Z[mu]*Vq[nu]*del[Vqbar[nu],mu]
    - Z[mu]*Vq[mu]*del[Vqbar[nu],nu]
  )
  (* Z Y+ Y- *)
  + I*ee*(1 - ap*sw^2)/(2*cw*sw)*(
    Z[mu]*(del[Yq[nu],mu] - del[Yq[mu],nu))*Yqbar[nu]
    + Yq[nu]*del[Yqbar[nu],mu]*Z[mu]
    - Yq[mu]*del[Yqbar[nu],mu]*Z[nu]
    - del[Z[mu],nu]*Yq[nu]*Yqbar[mu]
    + del[Z[nu],mu]*Yq[nu]*Yqbar[mu]
    - Z[mu]*del[Yq[nu],mu]*Yqbar[nu]
    + Z[nu]*del[Yq[nu],mu]*Yqbar[mu]
    + Z[mu]*Yq[nu]*del[Yqbar[nu],mu]
    - Z[mu]*Yq[mu]*del[Yqbar[nu],nu]
  )
  (* Z' V+ V- *)
  - I*Sqrt[3]*ee*a0/(2*cw*sw)*(
    Zp[mu]*(del[Vq[nu],mu] - del[Vq[mu],nu))*Vqbar[nu]
    + Vq[nu]*del[Vqbar[nu],mu]*Zp[mu]
    - Vq[mu]*del[Vqbar[nu],mu]*Zp[nu]
    - del[Zp[mu],nu]*Vq[nu]*Vqbar[mu]
    + del[Zp[nu],mu]*Vq[nu]*Vqbar[mu]
    - Zp[mu]*del[Vq[nu],mu]*Vqbar[nu]
    + Zp[nu]*del[Vq[nu],mu]*Vqbar[mu]
    + Zp[mu]*Vq[nu]*del[Vqbar[nu],mu]
    - Zp[mu]*Vq[mu]*del[Vqbar[nu],nu]
  )
  (* Z' Y+ Y- *)
  - I*Sqrt[3]*ee*a0/(2*cw*sw)*(
    Zp[mu]*(del[Yq[nu],mu] - del[Yq[mu],nu))*Yqbar[nu]
    + Yq[nu]*del[Yqbar[nu],mu]*Zp[mu]
    - Yq[mu]*del[Yqbar[nu],mu]*Zp[nu]
    - del[Zp[mu],nu]*Yq[nu]*Yqbar[mu]
    + del[Zp[nu],mu]*Yq[nu]*Yqbar[mu]
    - Zp[mu]*del[Yq[nu],mu]*Yqbar[nu]
    + Zp[nu]*del[Yq[nu],mu]*Yqbar[mu]
    + Zp[mu]*Yq[nu]*del[Yqbar[nu],mu]
    - Zp[mu]*Yq[mu]*del[Yqbar[nu],nu]
  )
  (* V+ W- Y- : 1-1-2=-2 invalid; V- W+ Y- : -1+1-2=-2; V- W- Y+ : -1-1+2=0 *)
  + I*ee/(Sqrt[2]*sw)*(
    Vqbar[mu] W[mu] Yq - Yq del contractions ...
  )
  ,
  0
];

(* Clean triple gauge with only charge-conserving 3-point structures *)
LGaugeTriple := Block[{mu, nu},
  (* Abelian A-V-V, A-Y-Y, Z-V-V, Z-Y-Y, Z'-V-V, Z'-Y-Y
     using the universal charged-vector form:
     I*g*( A (dV - ...) + ... ) with g from paper *)
  I*am/2*ee*(
    A[mu]*(del[Vq[nu],mu]-del[Vq[mu],nu))*Vqbar[nu]
    + del[A[nu],mu]*Vq[nu]*Vqbar[mu]
    - del[A[mu],nu]*Vq[nu]*Vqbar[mu]
    - A[mu]*del[Vq[nu],mu]*Vqbar[nu]
    + A[nu]*del[Vq[nu],mu]*Vqbar[mu]
    + A[mu]*Vq[nu]*del[Vqbar[nu],mu]
    - A[mu]*Vq[mu]*del[Vqbar[nu],nu]
    + del[A[mu],mu]*Vq[nu]*Vqbar[nu]
    - del[A[nu],nu]*Vq[nu]*Vqbar[mu]
    - Vq[nu]*del[Vqbar[nu],mu]*A[mu]
    + Vq[mu]*del[Vqbar[nu],mu]*A[nu]
  )
  + I*ap/2*ee*(
    A[mu]*(del[Yq[nu],mu]-del[Yq[mu],nu])*Yqbar[nu]
    + del[A[nu],mu]*Yq[nu]*Yqbar[mu]
    - del[A[mu],nu]*Yq[nu]*Yqbar[mu]
    - A[mu]*del[Yq[nu],mu]*Yqbar[nu]
    + A[nu]*del[Yq[nu],mu]*Yqbar[mu]
    + A[mu]*Yq[nu]*del[Yqbar[nu],mu]
    - A[mu]*Yq[mu]*del[Yqbar[nu],nu]
    + del[A[mu],mu]*Yq[nu]*Yqbar[nu]
    - del[A[nu],nu]*Yq[nu]*Yqbar[mu]
    - Yq[nu]*del[Yqbar[nu],mu]*A[mu]
    + Yq[mu]*del[Yqbar[nu],mu]*A[nu]
  )
  - I*ee*(1+am*sw^2)/(2*cw*sw)*(
    Z[mu]*(del[Vq[nu],mu]-del[Vq[mu],nu])*Vqbar[nu]
    + del[Z[nu],mu]*Vq[nu]*Vqbar[mu]
    - del[Z[mu],nu]*Vq[nu]*Vqbar[mu]
    - Z[mu]*del[Vq[nu],mu]*Vqbar[nu]
    + Z[nu]*del[Vq[nu],mu]*Vqbar[mu]
    + Z[mu]*Vq[nu]*del[Vqbar[nu],mu]
    - Z[mu]*Vq[mu]*del[Vqbar[nu],nu]
    + del[Z[mu],mu]*Vq[nu]*Vqbar[nu]
    - del[Z[nu],nu]*Vq[nu]*Vqbar[mu]
    - Vq[nu]*del[Vqbar[nu],mu]*Z[mu]
    + Vq[mu]*del[Vqbar[nu],mu]*Z[nu]
  )
  + I*ee*(1-ap*sw^2)/(2*cw*sw)*(
    Z[mu]*(del[Yq[nu],mu]-del[Yq[mu],nu])*Yqbar[nu]
    + del[Z[nu],mu]*Yq[nu]*Yqbar[mu]
    - del[Z[mu],nu]*Yq[nu]*Yqbar[mu]
    - Z[mu]*del[Yq[nu],mu]*Yqbar[nu]
    + Z[nu]*del[Yq[nu],mu]*Yqbar[mu]
    + Z[mu]*Yq[nu]*del[Yqbar[nu],mu]
    - Z[mu]*Yq[mu]*del[Yqbar[nu],nu]
    + del[Z[mu],mu]*Yq[nu]*Yqbar[nu]
    - del[Z[nu],nu]*Yq[nu]*Yqbar[mu]
    - Yq[nu]*del[Yqbar[nu],mu]*Z[mu]
    + Yq[mu]*del[Yqbar[nu],mu]*Z[nu]
  )
  - I*Sqrt[3]*ee*a0/(2*cw*sw)*(
    Zp[mu]*(del[Vq[nu],mu]-del[Vq[mu],nu])*Vqbar[nu]
    + del[Zp[nu],mu]*Vq[nu]*Vqbar[mu]
    - del[Zp[mu],nu]*Vq[nu]*Vqbar[mu]
    - Zp[mu]*del[Vq[nu],mu]*Vqbar[nu]
    + Zp[nu]*del[Vq[nu],mu]*Vqbar[mu]
    + Zp[mu]*Vq[nu]*del[Vqbar[nu],mu]
    - Zp[mu]*Vq[mu]*del[Vqbar[nu],nu]
    + del[Zp[mu],mu]*Vq[nu]*Vqbar[nu]
    - del[Zp[nu],nu]*Vq[nu]*Vqbar[mu]
    - Vq[nu]*del[Vqbar[nu],mu]*Zp[mu]
    + Vq[mu]*del[Vqbar[nu],mu]*Zp[nu]
  )
  - I*Sqrt[3]*ee*a0/(2*cw*sw)*(
    Zp[mu]*(del[Yq[nu],mu]-del[Yq[mu],nu])*Yqbar[nu]
    + del[Zp[nu],mu]*Yq[nu]*Yqbar[mu]
    - del[Zp[mu],nu]*Yq[nu]*Yqbar[mu]
    - Zp[mu]*del[Yq[nu],mu]*Yqbar[nu]
    + Zp[nu]*del[Yq[nu],mu]*Yqbar[mu]
    + Zp[mu]*Yq[nu]*del[Yqbar[nu],mu]
    - Zp[mu]*Yq[mu]*del[Yqbar[nu],nu]
    + del[Zp[mu],mu]*Yq[nu]*Yqbar[nu]
    - del[Zp[nu],nu]*Yq[nu]*Yqbar[mu]
    - Yq[nu]*del[Yqbar[nu],mu]*Zp[mu]
    + Yq[mu]*del[Yqbar[nu],mu]*Zp[nu]
  )
];

(* ----- VSS: one gauge boson + two scalars (paper Table) ----- *)
LGaugeScalarVSS := Block[{mu, p1, p2},
  (* A HV+ HV- : vertex -i e a-/2 (p1-p2)^mu ; fields A(0)+HV(+1)+HVbar(-1)=0 *)
  -am/2*ee A[mu] (HV del[HVbar, mu] - HVbar del[HV, mu])
  (* A HP+ HP- : vertex i e (p1-p2)^mu *)
  + ee A[mu] (HP del[HPbar, mu] - HPbar del[HP, mu])
  (* A HY+ HY- : by charge QY=2, analog with a+ : vertex would be from table if present.
     Use standard Q=2 scalar QED: 2*e *)
  + 2*ee A[mu] (HY del[HYbar, mu] - HYbar del[HY, mu])
  (* V+ HV- H0 : -i e (p1-p2)(O31 c13 + s13 O11)/(2 sW) *)
  - ee*(O31*c13 + s13*O11)/(2*sw) Vq[mu] (HVbar del[H0, mu] - H0 del[HVbar, mu])
  (* V+ HV- H2 : -e (p1-p2)(s13 U12 - U32 c13)/(2 sW) *)
  - ee*(s13*U12 - U32*c13)/(2*sw) Vq[mu] (HVbar del[H2, mu] - H2 del[HVbar, mu])
  (* V+ HV- H3 *)
  - ee*(s13*U13 - U33*c13)/(2*sw) Vq[mu] (HVbar del[H3, mu] - H3 del[HVbar, mu])
  (* V+ HV- h (SM H) *)
  - ee*(s13*U11 - U31*c13)/(2*sw) Vq[mu] (HVbar del[H, mu] - H del[HVbar, mu])
  (* W+ HP- H0 : -i e (p1-p2)(O21 c12 + s12 O11)/(2 sW) *)
  - ee*(O21*c12 + s12*O11)/(2*sw) W[mu] (HPbar del[H0, mu] - H0 del[HPbar, mu])
  (* W+ HP- H2 *)
  - ee*(s12*U12 - U22*c12)/(2*sw) W[mu] (HPbar del[H2, mu] - H2 del[HPbar, mu])
  (* W+ HP- H3 *)
  - ee*(s12*U13 - U23*c12)/(2*sw) W[mu] (HPbar del[H3, mu] - H3 del[HPbar, mu])
  (* W+ HP- h *)
  - ee*(s12*U11 - U21*c12)/(2*sw) W[mu] (HPbar del[H, mu] - H del[HPbar, mu])
  (* Y+ HY- H0 *)
  - ee*(O31*c23 + s23*O21)/(2*sw) Yq[mu] (HYbar del[H0, mu] - H0 del[HYbar, mu])
  (* Y+ HY- H2 *)
  - ee*(s23*U22 - U32*c23)/(2*sw) Yq[mu] (HYbar del[H2, mu] - H2 del[HYbar, mu])
  (* Y+ HY- H3 *)
  - ee*(s23*U23 - U33*c23)/(2*sw) Yq[mu] (HYbar del[H3, mu] - H3 del[HYbar, mu])
  (* Y+ HY- h *)
  - ee*(s23*U21 - U31*c23)/(2*sw) Yq[mu] (HYbar del[H, mu] - H del[HYbar, mu])
  (* Z H0 H2 : e(p1-p2)(O11 U12 - O21 U22)/(2 cW sW) *)
  + ee*(O11*U12 - O21*U22)/(2*cw*sw) Z[mu] (H0 del[H2, mu] - H2 del[H0, mu])
  (* Z H0 H3 *)
  + ee*(O11*U13 - O21*U23)/(2*cw*sw) Z[mu] (H0 del[H3, mu] - H3 del[H0, mu])
  (* Z h H0 *)
  - ee*(O11*U11 - O21*U21)/(2*cw*sw) Z[mu] (H0 del[H, mu] - H del[H0, mu])
  (* Z HV+ HV- *)
  + ee*(c13^2*(1 + am*sw^2) + am*s13^2*sw^2)/(2*cw*sw) Z[mu] (HV del[HVbar, mu] - HVbar del[HV, mu])
  (* Z HP+ HP- *)
  + ee*(cw^2 - sw^2)/(2*cw*sw) Z[mu] (HP del[HPbar, mu] - HPbar del[HP, mu])
  (* Z HY+ HY- *)
  + ee*(c23^2*(ap*sw^2 - 1) + ap*s23^2*sw^2)/(2*cw*sw) Z[mu] (HY del[HYbar, mu] - HYbar del[HY, mu])
  (* Z' H0 H2 *)
  + ee*((ap*sw^2 - 1)*O11*U12 - (am*sw^2 + 1)*O21*U22 - 2*(sw^2 - 1)*O31*U32)/(2*Sqrt[3]*cw*sw*a0)
    Zp[mu] (H0 del[H2, mu] - H2 del[H0, mu])
  (* Z' H0 H3 *)
  + ee*((ap*sw^2 - 1)*O11*U13 - (am*sw^2 + 1)*O21*U23 - 2*(sw^2 - 1)*O31*U33)/(2*Sqrt[3]*cw*sw*a0)
    Zp[mu] (H0 del[H3, mu] - H3 del[H0, mu])
  (* Z' h H0 *)
  + ee*((ap*sw^2 - 1)*O11*U11 - (am*sw^2 + 1)*O21*U21 - 2*(sw^2 - 1)*O31*U31)/(2*Sqrt[3]*cw*sw*a0)
    Zp[mu] (H0 del[H, mu] - H del[H0, mu])
  (* Z' HV+ HV- *)
  + ee*(c13^2*((ap*am + 2)*sw^2 - 1) + s13^2*((ap^2 - am^2)*sw^2 - 2))/(2*Sqrt[3]*cw*sw*a0)
    Zp[mu] (HV del[HVbar, mu] - HVbar del[HV, mu])
  (* Z' HP+ HP- *)
  + ee*(c12^2*(1 + am*sw^2) + s12^2*(ap*sw^2 - 1))/(2*Sqrt[3]*cw*sw*a0)
    Zp[mu] (HP del[HPbar, mu] - HPbar del[HP, mu])
  (* Z' HY+ HY- *)
  + ee*(c23^2*((ap*am + 2)*sw^2 - 1) + s23^2*((ap^2 - am^2)*sw^2 - 2))/(2*Sqrt[3]*cw*sw*a0)
    Zp[mu] (HY del[HYbar, mu] - HYbar del[HY, mu])
];

(* ----- VVS: two gauge bosons + one scalar (paper Table) ----- *)
LGaugeScalarVVS := Block[{mu},
  (* V+ V- H2 : i e^2 gmn (v1 U12 + v3 U32)/(2 sW^2) ; L coeff = real part *)
  ee^2*(v1*U12 + v3*U32)/(2*sw^2) Vq[mu] Vqbar[mu] H2
  + ee^2*(v1*U13 + v3*U33)/(2*sw^2) Vq[mu] Vqbar[mu] H3
  + ee^2*(v1*U11 + v3*U31)/(2*sw^2) Vq[mu] Vqbar[mu] H
  (* Y+ Y- H2, H3, h *)
  + ee^2*(v2*U22 + v3*U32)/(2*sw^2) Yq[mu] Yqbar[mu] H2
  + ee^2*(v2*U23 + v3*U33)/(2*sw^2) Yq[mu] Yqbar[mu] H3
  + ee^2*(v2*U21 + v3*U31)/(2*sw^2) Yq[mu] Yqbar[mu] H
  (* W+ W- H2, H3, h (modifications beyond SM) *)
  + ee^2*(v1*U12 + v2*U22)/(2*sw^2) W[mu] Wbar[mu] H2
  + ee^2*(v1*U13 + v2*U23)/(2*sw^2) W[mu] Wbar[mu] H3
  (* Z Z H2, H3 *)
  + ee^2*(v1*U12 + v2*U22)/(2*cw^2*sw^2) Z[mu] Z[mu] H2
  + ee^2*(v1*U13 + v2*U23)/(2*cw^2*sw^2) Z[mu] Z[mu] H3
  (* Z' V+ HV- : e^2 gmn[-v3 c13 (a+a- sW^2+1)+v1 s13 (a-^2 sW^2-1)]/(4 sqrt3 cW sW^2 a0) *)
  + ee^2*(-v3*c13*(ap*am*sw^2 + 1) + v1*s13*(am^2*sw^2 - 1))/(4*Sqrt[3]*cw*sw^2*a0)
    Zp[mu] Vq[mu] HVbar
  (* Z' Y+ HY- *)
  + ee^2*(-v3*c23*(ap*am*sw^2 + 1) + v2*s23*(am^2*sw^2 - 1))/(4*Sqrt[3]*cw*sw^2*a0)
    Zp[mu] Yq[mu] HYbar
  (* Z' W+ HP- *)
  + ee^2*(v2*c12*(1 + am*sw^2) + v1*s12*(1 - ap*sw^2))/(2*Sqrt[3]*cw*sw^2*a0)
    Zp[mu] W[mu] HPbar
  (* Z Z' H2, H3 *)
  - ee^2*(v1*U12*(ap*sw^2 - 1) + v2*U22*(1 + am*sw^2))/(2*Sqrt[3]*cw^2*sw^2*a0)
    Z[mu] Zp[mu] H2
  - ee^2*(v1*U13*(ap*sw^2 - 1) + v2*U23*(1 + am*sw^2))/(2*Sqrt[3]*cw^2*sw^2*a0)
    Z[mu] Zp[mu] H3
  (* Z' Z' H2, H3 *)
  + ee^2*(v1*U12*(ap*sw^2 - 1)^2 + v2*U22*(am*sw^2 + 1)^2 + 4*v3*(sw^2 - 1)^2*U32)/(6*cw^2*sw^2*a0^2)
    Zp[mu] Zp[mu] H2
  + ee^2*(v1*U13*(ap*sw^2 - 1)^2 + v2*U23*(am*sw^2 + 1)^2 + 4*v3*(sw^2 - 1)^2*U33)/(6*cw^2*sw^2*a0^2)
    Zp[mu] Zp[mu] H3
  (* Z V+ HV- *)
  + ee^2*(cw^2*(v3*c13 + v1*s13) + sw^2*((am + 1)*v3*c13 - bm*v1*s13))/(4*cw*sw^2)
    Z[mu] Vq[mu] HVbar
  (* Z Y+ HY- *)
  - ee^2*(cw^2*(v3*c23 + v2*s23) + sw^2*(bp*v2*s23 - (am + 1)*v3*c23))/(4*cw*sw^2)
    Z[mu] Yq[mu] HYbar
  (* A W+ HP- : e^2 gmn (v2 c12 - v1 s12)/(2 sW) *)
  + ee^2*(v2*c12 - v1*s12)/(2*sw) A[mu] W[mu] HPbar
  (* A Y+ HY- *)
  + ap*ee^2*(v2*s23 - v3*c23)/(4*sw) A[mu] Yq[mu] HYbar
];

(* ----- Scalar potential (paper V_Higgs in mass-eigenstate form) ----- *)
LScalarPotential := Block[{ii, jj},
  ExpandIndices[
    - lam1/4 (H2^2 + H0^2 + 2 HPbar HP)^2
    - lam2/4 (H3^2)^2
    - lam3/4 (H2 H3)^2
    - lam12/2 H2^2 H3^2
    - lam13/2 H2^2 H0^2
    - lam23/2 H3^2 H0^2
    - lam12p HPbar HP HPbar HP
    - lam13p HVbar HV HVbar HV
    - lam23p HYbar HY HYbar HY
    (* mixed quartics *)
    - lam12 H2^2 HPbar HP
    - lam13 H2^2 HVbar HV
    - lam23 H3^2 HYbar HY
    (* portal to SM Higgs doublet *)
    - lam13 Phibar[ii] Phi[ii] H2^2
    - lam23 Phibar[ii] Phi[ii] H3^2
    - lam12 Phibar[ii] Phi[ii] H0^2
    - lam12p Phibar[ii] Phi[ii] HPbar HP
    (* f = kk v3 trilinears (epsilon rho eta chi structure) *)
    - Sqrt[2]*kk*v3 (H2 H0 HP + H3 HV HYbar + H2 HV HVbar + H0 HY HYbar)
    ,
    FlavorExpand -> {SU2D, SU2W}
  ]
];

(* ----- Total ----- *)
LTotal := LZp + LVq + LYq
  + LH2 + LH3 + LH0 + LHP + LHV + LHY
  + LDq + LSq + LTq + LEl
  + LYukawaNew + LYukawaCharged
  + LGaugeZpFermion + LGaugeVYFermion + LGaugeHeavyFermion
  + LGaugeTriple
  + LGaugeScalarVSS + LGaugeScalarVVS
  + LScalarPotential;
