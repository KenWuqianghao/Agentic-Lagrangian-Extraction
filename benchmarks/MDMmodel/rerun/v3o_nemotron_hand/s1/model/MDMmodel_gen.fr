(* ************************** *)
(* *****  Information   ***** *)
(* ************************** *)
M$ModelName = "MDMmodel_gen";

M$Information = {
   Authors      -> {"Auto-generated from arXiv:1311.6661"},
   Version      -> "1.0",
   Date         -> "2026-09-24",
   Institutions -> {"Generated by opencode"},
   Emails       -> {"none"},
   URLs         -> "https://arxiv.org/abs/1311.6661"
};

(* ************************** *)
(* *** Interaction orders *** *)
(* ************************** *)
M$InteractionOrderHierarchy = {
   {QCD, 1},
   {QED, 2},
   {NP, 1}
};

(* ************************** *)
(* *****   Parameters   ***** *)
(* ************************** *)
M$Parameters = {

(* External parameters *)
   fDil == {
      ParameterType    -> External,
      BlockName        -> MDM,
      OrderBlock       -> 1,
      Value            -> 1000.,
      InteractionOrder -> {NP, -1},
      Description      -> "Dilaton decay constant f [GeV]"
   },
   thS == {
      ParameterType    -> External,
      BlockName        -> MDM,
      OrderBlock       -> 2,
      Value            -> 0.1,
      InteractionOrder -> {NP, 0},
      Description      -> "Scalar mixing angle theta_S"
   },
   mSdil == {
      ParameterType    -> External,
      BlockName        -> MDM,
      OrderBlock       -> 3,
      Value            -> 400.,
      InteractionOrder -> {NP, 0},
      Description      -> "Dilaton mass m_s [GeV]"
   },
   Mscale == {
      ParameterType    -> External,
      BlockName        -> MDM,
      OrderBlock       -> 4,
      Value            -> 1500.,
      InteractionOrder -> {NP, 0},
      Description      -> "Top partner mass scale M [GeV]"
   },
   yp == {
      ParameterType    -> External,
      BlockName        -> MDM,
      OrderBlock       -> 5,
      Value            -> 1.,
      InteractionOrder -> {NP, 1},
      Description      -> "Top partner Yukawa coupling y'"
   },
   sThL == {
      ParameterType    -> External,
      BlockName        -> MDM,
      OrderBlock       -> 6,
      Value            -> 0.1,
      InteractionOrder -> {NP, 0},
      Description      -> "sin(theta_L) top mixing angle"
   },

(* Internal parameters: derived from fDil, thS, mSdil, MH, vev *)
   eta == {
      ParameterType -> Internal,
      Value         -> vev/fDil,
      Description   -> "eta = v/f"
   },
   kappa == {
      ParameterType -> Internal,
      Value         -> Abs[MH^2 - mSdil^2]/(2*fDil*vev)*Abs[Sin[2*thS]],
      Description   -> "Portal coupling kappa, Eq.(lambda)"
   },
   lamH == {
      ParameterType -> Internal,
      Value         -> Abs[MH^2 - mSdil^2]/vev^2*(Abs[(MH^2 + mSdil^2)/(MH^2 - mSdil^2)] + Sign[Sin[2*thS]]*Cos[2*thS]),
      Description   -> "Higgs quartic lambda_H, Eq.(lambda)"
   },
   lamS == {
      ParameterType -> Internal,
      Value         -> 3*Abs[MH^2 - mSdil^2]/(2*fDil^2)*(Abs[(MH^2 + mSdil^2)/(MH^2 - mSdil^2)] - Sign[Sin[2*thS]]*Cos[2*thS]),
      Description   -> "Dilaton quartic lambda_S, Eq.(lambda)"
   },
   mS2 == {
      ParameterType -> Internal,
      Value         -> -lamS/6*fDil^2 - kappa/2*vev^2,
      Description   -> "Bare dilaton mass squared m_S^2 from minimization"
   },
   mH2 == {
      ParameterType -> Internal,
      Value         -> -lamH/4*vev^2 - kappa/2*fDil^2,
      Description   -> "Bare Higgs mass squared m_H^2 from minimization"
   },

(* Override SM Higgs potential parameters to match MDM potential *)
   muH == {
      ParameterType -> Internal,
      Value         -> mH2 + kappa/2*fDil^2,
      Description   -> "MDM: muH^2 = m_H^2 + kappa/2 f^2"
   },
   lam == {
      ParameterType -> Internal,
      Value         -> lamH/4,
      Description   -> "MDM: lam = lambda_H/4"
   },

(* Remove SM top Yukawa; top mass generated via mixing with Tp *)
   yu == {
      ParameterType    -> Internal,
      Indices          -> {Index[Generation], Index[Generation]},
      Definitions      -> {yu[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j),
                           yu[3,3] -> 0},
      Value            -> {yu[1,1] -> Sqrt[2] ymup/vev, yu[2,2] -> Sqrt[2] ymc/vev, yu[3,3] -> 0},
      InteractionOrder -> {QED, 1},
      ParameterName    -> {yu[1,1] -> yup, yu[2,2] -> yc, yu[3,3] -> yt},
      TeX              -> Superscript[y, u],
      Description      -> "Up-type Yukawa couplings (top set to 0)"
   }
};

(* ************************** *)
(* *** Particle classes *** *)
(* ************************** *)
M$ClassesDescription = {

(* New scalar: dilaton S (real singlet) *)
   S[100] == {
      ClassName        -> S,
      SelfConjugate    -> True,
      Mass             -> {MS, Internal},
      Width            -> {WS, 0.},
      PropagatorLabel  -> "S",
      PropagatorType   -> D,
      PropagatorArrow  -> None,
      PDG              -> 9000005,
      ParticleName     -> "S",
      FullName         -> "Dilaton"
   },

(* New fermion: top partner Tp (vector-like, color triplet, SU(2) singlet, Y=2/3) *)
   F[100] == {
      ClassName        -> Tp,
      ClassMembers     -> {Tp},
      Indices          -> {Index[Colour]},
      FlavorIndex      -> Colour,
      SelfConjugate    -> False,
      Mass             -> {MTp, Mscale},
      Width            -> {WTp, 0.},
      QuantumNumbers   -> {Q -> 2/3},
      PropagatorLabel  -> "Tp",
      PropagatorType   -> Straight,
      PropagatorArrow  -> Forward,
      PDG              -> 9000006,
      ParticleName     -> "Tp",
      AntiParticleName -> "Tpbar",
      FullName         -> "TopPartner"
   }
};

(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

(* Dilaton kinetic term *)
L_S_kin := 1/2 del[S, mu] del[S, mu];

(* Dilaton mass term *)
L_S_mass := -mS2/2 S S;

(* Dilaton quartic term *)
L_S_quartic := -lamS/24 S S S S;

(* Portal coupling S^2 |H|^2 *)
L_portal := -kappa/2 S S Phibar[ii] Phi[ii];

(* Top partner kinetic term *)
L_Tp_kin := I Tpbar[cc].Ga[mu].DC[Tp[cc], mu];

(* Top partner field-dependent mass term: - (M/f) S Tpbar Tp *)
L_Tp_mass := -Mscale/fDil S Tpbar[cc].Tp[cc];

(* Top partner Yukawa: -yp Tpbar_R (q3L . Phi) + HC *)
(* q3L = QL[sp, ii, 3, cc], Phi = Phi[jj], contraction with Eps[ii,jj] *)
(* Tpbar_R = Tpbar.ProjM *)
L_Tp_Yuk := -yp Tpbar[cc].ProjM[sp1,sp2] QL[sp2, ii, 3, cc] Phi[jj] Eps[ii, jj];

(* Total Lagrangian *)
LTotal := LSM + L_S_kin + L_S_mass + L_S_quartic + L_portal + L_Tp_kin + L_Tp_mass + L_Tp_Yuk + HC[L_Tp_Yuk];