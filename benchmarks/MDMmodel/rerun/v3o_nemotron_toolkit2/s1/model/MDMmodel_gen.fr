LTotal := LSkin + LSmass + LTkin + LTmass + LSpot + LTint + LTyuk;

LSkin := -1/2*del[S, mu]*del[S, mu];

LSmass := -1/2*MSdil^2*S^2;

LTkin := I*TPbar[sp, cc].Ga[mu].DC[TP, mu];

LTmass := -MTp*TPbar[sp, cc].TP[sp, cc];

LSpot := -lambdaS/24*S^4 - kappa/2*S^2*Phibar[ii]*Phi[ii];

LTint := -MTp/f*S*TPbar[sp, cc].TP[sp, cc] + MTp*TPbar[sp, cc].TP[sp, cc];

LTyuk := -yp*TPbar[sp, cc].ProjM[QL[sp, ii, 3, cc]]*Phi[jj]*Eps[ii, jj];
