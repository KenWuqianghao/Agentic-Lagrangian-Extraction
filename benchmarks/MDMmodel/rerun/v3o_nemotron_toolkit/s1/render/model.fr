LSkin := -1/2 del[S, mu] del[S, mu];

LSpot := - (mS2/2 S^2 + lambdaS/24 S^4 + kappa/2 S^2 Phibar[ii] Phi[ii] + mH2 Phibar[ii] Phi[ii] + lambdaH/4 (Phibar[ii] Phi[ii])^2);

LTkin := I Tcolbar.Ga[mu].DC[Tcol, mu];

LTmass := - M/f S Tcolbar.Tcol;

LTyuk := - yp Tcolbar.ProjM[sp, sp2] QL[sp2, 1, 3, cc] Phi[2] + HC[- yp Tcolbar.ProjM[sp, sp2] QL[sp2, 1, 3, cc] Phi[2]];

LTotal := LSM + LSkin + LSpot + LTkin + LTmass + LTyuk;
