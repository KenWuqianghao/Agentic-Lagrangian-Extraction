    },
    {
      "name": "kappa",
      "parameter_type": "Internal",
      "value": "Abs[mh^2 - Ms^2]/(2*f*v)*Abs[Sin[2*thetaS]]",
      "interaction_order": ["NP", 0],
      "description": "Higgs-dilaton portal coupling"
    },
    {
      "name": "lambdaH",
      "parameter_type": "Internal",
      "value": "Abs[mh^2 - Ms^2]/v^2*(Abs[(mh^2+Ms^2)/(mh^2-Ms^2)] + Sign[Sin[2*thetaS]]*Cos[2*thetaS])",
      "interaction_order": ["NP", 0],
      "description": "Higgs quartic coupling in MDM"
    },
    {
      "name": "lambdaS",
      "parameter_type": "Internal",
      "value": "3*Abs[mh^2 - Ms^2]/(2*f^2)*(Abs[(mh^2+Ms^2)/(mh^2-Ms^2)] - Sign[Sin[2*thetaS]]*Cos[2*thetaS])",
      "interaction_order": ["NP", 0],
      "description": "Dilaton quartic coupling"
    },
    {
      "name": "mS2",
      "parameter_type": "Internal",
      "value": "-lambdaS/6*f^2 - kappa/2*v^2",
      "interaction_order": ["NP", 0],
      "description": "Dilaton mass parameter in potential"
    },
    {
      "name": "mH2",
      "parameter_type": "Internal",
      "value": "-kappa/2*f^2 - lambdaH/4*v^2",
      "interaction_order": ["NP", 0],
      "description": "Higgs mass parameter in potential"
    },
    {
      "name": "muH",
      "parameter_type": "Internal",
      "value": "Sqrt[-mH2]",
      "definitions": [],
      "interaction_order": ["QED", -1],
      "description": "SM Higgs mu parameter (overridden)"
    },
    {
      "name": "lam",
      "parameter_type": "Internal",
      "value": "lambdaH/4",
      "definitions": [],
      "interaction_order": ["QED", 2],
      "description": "SM Higgs quartic (overridden)"
    },
    {
      "name": "MH",
      "parameter_type": "Internal",
      "value": "mh",
      "definitions": [],
      "interaction_order": ["NP", 0],
      "description": "Physical Higgs mass (overridden)"
    },
    {
      "name": "yt",
      "parameter_type": "Internal",
      "value": "Sqrt[2]*MT/vev*(Cos[thetaL]^2*Cos[thetaS] + eta*Sin[thetaL]^2*Sin[thetaS])",
      "interaction_order": ["NP", 1],
      "description": "Effective top Yukawa in MDM"
    }
  ],
