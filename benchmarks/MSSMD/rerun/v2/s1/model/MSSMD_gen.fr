LgaDkin := Block[{mu, nu}, -1/4 FS[gaD, mu, nu] FS[gaD, mu, nu] + 1/2 MgaD^2 gaD[mu] gaD[mu]];

LgaDmix := Block[{mu, nu}, -epsD/2 FS[A, mu, nu] FS[gaD, mu, nu]];

LgaDff := Block[{mu}, ExpandIndices[-epsD ee gaD[mu] (-(lbar.Ga[mu].l) + 2/3 (uqbar.Ga[mu].uq) - 1/3 (dqbar.Ga[mu].dq)), FlavorExpand -> {Generation}]];

Ln1kin := Block[{mu}, I/2 n1bar.Ga[mu].del[n1, mu] - 1/2 Mn1 n1bar.n1];

LnDkin := Block[{mu}, I/2 nDbar.Ga[mu].del[nD, mu] - 1/2 MnD nDbar.nD];

LnDn1 := Block[{mu}, gnD gaD[mu] nDbar.Ga[mu].n1 + HC[gnD gaD[mu] nDbar.Ga[mu].n1]];

Lhn1 := -1/2 ghn1 H n1bar.n1;

La1kin := Block[{mu}, 1/2 del[a1, mu] del[a1, mu] - 1/2 Ma1^2 a1 a1];

Lh1kin := Block[{mu}, 1/2 del[h1, mu] del[h1, mu] - 1/2 Mh1^2 h1 h1];

Lh2kin := Block[{mu}, 1/2 del[h2, mu] del[h2, mu] - 1/2 Mh2^2 h2 h2];

Lhaa := -1/2 lamh1aa vev h1 a1 a1 - 1/2 lamh2aa vev h2 a1 a1;

La1ff := Block[{sp1, sp2, ff, cc}, ExpandIndices[-I (tb/vev) a1 (Ml[ff] lbar[sp1, ff] Ga[5, sp1, sp2] l[sp2, ff] + Md[ff] dqbar[sp1, ff, cc] Ga[5, sp1, sp2] dq[sp2, ff, cc]) - I (1/(tb vev)) a1 Mu[ff] uqbar[sp1, ff, cc] Ga[5, sp1, sp2] uq[sp2, ff, cc], FlavorExpand -> {Generation}]];

LDarkSUSY := LgaDkin + LgaDff + Ln1kin + LnDkin + LnDn1 + Lhn1;

LNMSSM := La1kin + Lh1kin + Lh2kin + Lhaa + La1ff;

LMSSMD := LDarkSUSY + LNMSSM;

LTotal := LSM + LMSSMD;
