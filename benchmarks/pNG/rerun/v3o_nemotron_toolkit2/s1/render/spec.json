      "block_name": "PNG",
      "order_block": 2,
      "interaction_order": ["NP", 1],
      "description": "Singlet VEV v_s [GeV]"
    },
    {
      "name": "theta",
      "parameter_type": "External",
      "value": "0.1",
      "block_name": "PNG",
      "order_block": 3,
      "interaction_order": ["NP", 1],
      "description": "Higgs mixing angle [rad]"
    },
    {
      "name": "mH",
      "parameter_type": "External",
      "value": "200.",
      "block_name": "PNG",
      "order_block": 4,
      "interaction_order": ["NP", 1],
      "description": "Heavy Higgs mass [GeV]",
      "definitions": []
    },
    {
      "name": "lambdaPhi",
      "parameter_type": "Internal",
      "value": "(MH^2*Cos[theta]^2 + mH^2*Sin[theta]^2)/vev^2",
      "interaction_order": ["QED", 2],
      "description": "Higgs quartic coupling lambda_Phi"
    },
    {
      "name": "lambdaS",
      "parameter_type": "Internal",
      "value": "(MH^2*Sin[theta]^2 + mH^2*Cos[theta]^2)/vs^2",
      "interaction_order": ["NP", 1],
      "description": "Singlet quartic coupling lambda_S"
    },
    {
      "name": "lambdaPhiS",
      "parameter_type": "Internal",
      "value": "(mH^2 - MH^2)*Sin[theta]*Cos[theta]/(vev*vs)",
      "interaction_order": ["NP", 1],
      "description": "Portal coupling lambda_PhiS"
    },
    {
      "name": "muSprime2",
      "parameter_type": "Internal",
      "value": "m_chi^2",
      "description": "Soft breaking parameter mu_S'^2"
    },
    {
      "name": "muPhi2",
      "parameter_type": "Internal",
      "value": "lambdaPhi*vev^2 + lambdaPhiS*vs^2",
      "description": "Higgs quadratic parameter mu_Phi^2"
    },
    {
      "name": "muS2",
      "parameter_type": "Internal",
      "value": "lambdaS*vs^2 + lambdaPhiS*vev^2 - muSprime2",
      "description": "Singlet quadratic parameter mu_S^2"
    }
  ],
