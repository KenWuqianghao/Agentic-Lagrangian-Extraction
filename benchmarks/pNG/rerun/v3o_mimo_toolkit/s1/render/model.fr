LSoft := muSps2/4 (Sc^2 + Scbar^2);

LPotCorr := -muH^2 Phibar[ii] Phi[ii] + lam Phibar[ii] Phi[ii] Phibar[jj] Phi[jj] + muPhi2/2 PhiCbar[ii] PhiC[ii] - lamPhi/2 PhiCbar[ii] PhiC[ii] PhiCbar[jj] PhiC[jj];

LGaugeH2 := DC[PhiCbar[ii], mu] DC[PhiC[ii], mu] - DC[Phibar[ii], mu] DC[Phi[ii], mu];

LYukCorr := Block[{sp, ii, jj, cc, ff1, ff2, ff3, yuk1, yuk2}, yuk1 = ExpandIndices[-yd[ff2, ff3] CKM[ff1, ff2] QLbar[sp, ii, ff1, cc].dR[sp, ff3, cc] PhiC[ii] - yl[ff1, ff3] LLbar[sp, ii, ff1].lR[sp, ff3] PhiC[ii] - yu[ff1, ff2] QLbar[sp, ii, ff1, cc].uR[sp, ff2, cc] PhiCbar[jj] Eps[ii, jj], FlavorExpand -> SU2D]; yuk2 = ExpandIndices[-yd[ff2, ff3] CKM[ff1, ff2] QLbar[sp, ii, ff1, cc].dR[sp, ff3, cc] Phi[ii] - yl[ff1, ff3] LLbar[sp, ii, ff1].lR[sp, ff3] Phi[ii] - yu[ff1, ff2] QLbar[sp, ii, ff1, cc].uR[sp, ff2, cc] Phibar[jj] Eps[ii, jj], FlavorExpand -> SU2D]; (yuk1 + HC[yuk1]) - (yuk2 + HC[yuk2])];

LTotal := LH2Kin + LChiKin + LS + LSoft + LPotCorr + LGaugeH2 + LYukCorr;
