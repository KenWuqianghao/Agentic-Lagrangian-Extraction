LHiggsPortal := Block[{mu,ii,jj}, ExpandIndices[DC[Phibar[ii],mu] DC[Phi[ii],mu] + (muPhi2/2) Phibar[ii] Phi[ii] - (lamPhi/2) Phibar[ii] Phi[ii] Phibar[jj] Phi[jj], FlavorExpand->{SU2D,SU2W}]];

LSkin := Block[{mu,ii,jj}, ExpandIndices[DC[Ssingbar,mu] DC[Ssing,mu] + (muS2/2) Ssingbar Ssing - lamPhiS Phibar[ii] Phi[ii] Ssingbar Ssing - (lamS/2) (Ssingbar Ssing)^2, FlavorExpand->{SU2D,SU2W}]];

LSoftpNG := (muSp2/4) (Ssing^2 + Ssingbar^2);

LTotal := LGauge + LFermions + LYukawa + LGhost + LHiggsPortal + LSkin + LSoftpNG;
