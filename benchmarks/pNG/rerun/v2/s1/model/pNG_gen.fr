};

(* ******************************************************************** *)
(* pseudo-Nambu-Goldstone dark matter, arXiv:1912.04008, eqs.(2.1)-(2.3) *)
(* A complex scalar gauge singlet S with a softly broken global dark     *)
(* U(1) is added to the SM.  This file is an add-on to SM.fr.            *)
(*                                                                       *)
(* Field content:  S = (vsing + sing + I chi)/Sqrt[2], eq.(2.8).         *)
(*   chi : the pNG boson, the CP-odd dark matter candidate.              *)
(*   H2  : the second CP-even mass eigenstate (the paper calls it H).    *)
(*   H   : the 125 GeV mass eigenstate of SM.fr (the paper calls it h).  *)
(*                                                                       *)
(* IMPORTANT: the CP-even neutral component phi of the SM doublet mixes  *)
(* with the singlet by the angle th, eqs.(2.12)-(2.13):                  *)
(*    phi  =  Cos[th] H + Sin[th] H2 = phih,                             *)
(*    s    = -Sin[th] H + Cos[th] H2 = sing.                             *)
(* The SM.fr rule  Phi[2] -> (vev + H + I G0)/Sqrt[2]  must therefore be *)
(* replaced by     Phi[2] -> (vev + phih + I G0)/Sqrt[2],                *)
(* and the SM.fr quartic lam by lamPhi/2, so that all SM couplings of H  *)
(* are scaled by Cos[th] and H2 gets the Sin[th] fraction.               *)
(* ******************************************************************** *)

M$Parameters = {
  th == {
    ParameterType -> External,
    Value -> 1.53,
    BlockName -> PNGINPUTS,
    OrderBlock -> 1,
    TeX -> "\\[Theta]",
    Description -> "Mixing angle between the CP-even states H (125 GeV) and H2, eqs.(2.13)-(2.14) [rad]; best-fit value of table 2"
  },
  vsing == {
    ParameterType -> External,
    Value -> 13155.1,
    BlockName -> PNGINPUTS,
    OrderBlock -> 2,
    InteractionOrder -> {QED, -1},
    TeX -> "Subscript[v,s]",
    Description -> "Vacuum expectation value vs of the complex singlet S, eq.(2.8) [GeV]; best-fit vh/vs = 0.0187 of table 2"
  },
  lamPhi == {
    ParameterType -> Internal,
    Value -> (MH^2*Cos[th]^2 + MH2^2*Sin[th]^2)/vev^2,
    InteractionOrder -> {QED, 2},
    TeX -> "Subscript[\\[Lambda],\\[CapitalPhi]]",
    Description -> "Higgs quartic coupling lambda_Phi, eq.(2.18); in the pNG model the SM.fr coupling lam must be set to lamPhi/2"
  },
  lamS == {
    ParameterType -> Internal,
    Value -> (MH^2*Sin[th]^2 + MH2^2*Cos[th]^2)/vsing^2,
    InteractionOrder -> {QED, 2},
    TeX -> "Subscript[\\[Lambda],S]",
    Description -> "Quartic coupling lambda_S of the singlet, eq.(2.19); perturbative unitarity requires lamS < 8 Pi/3, eq.(3.2)"
  },
  lamPS == {
    ParameterType -> Internal,
    Value -> (MH2^2 - MH^2)*Sin[th]*Cos[th]/(vev*vsing),
    InteractionOrder -> {QED, 2},
    TeX -> "Subscript[\\[Lambda],\\[CapitalPhi]S]",
    Description -> "Higgs portal coupling lambda_PhiS, eq.(2.20)"
  },
  muSp2 == {
    ParameterType -> Internal,
    Value -> Mchi^2,
    TeX -> "Superscript[Subscript[\\[Mu],S],\\[Prime]2]",
    Description -> "Soft U(1)-breaking mass-squared mu'_S^2 of eq.(2.3), equal to the squared pNG dark matter mass, eq.(2.18) [GeV^2]"
  },
  muPhi2 == {
    ParameterType -> Internal,
    Value -> lamPhi*vev^2 + lamPS*vsing^2,
    TeX -> "Superscript[Subscript[\\[Mu],\\[CapitalPhi]],2]",
    Description -> "Squared mass parameter mu_Phi^2 of the SM Higgs potential, eqs.(2.9) and (2.19) [GeV^2]"
  },
  muS2 == {
    ParameterType -> Internal,
    Value -> lamS*vsing^2 + lamPS*vev^2 - muSp2,
    TeX -> "Superscript[Subscript[\\[Mu],S],2]",
    Description -> "Squared mass parameter mu_S^2 of the singlet potential, eqs.(2.10) and (2.20) [GeV^2]"
  },
  kchih == {
    ParameterType -> Internal,
    Value -> -MH^2*Sin[th]/vsing,
    InteractionOrder -> {QED, 1},
    TeX -> "Subscript[\\[Kappa],\\[Chi]\\[Chi]h]",
    Description -> "Dimensionful chi chi H coupling kappa_chichih, eq.(A.5) [GeV]"
  },
  kchiH == {
    ParameterType -> Internal,
    Value -> MH2^2*Cos[th]/vsing,
    InteractionOrder -> {QED, 1},
    TeX -> "Subscript[\\[Kappa],\\[Chi]\\[Chi]H]",
    Description -> "Dimensionful chi chi H2 coupling kappa_chichiH, eq.(A.6) [GeV]"
  }
};

M$ClassesDescription = {
  S[4] == {
    ClassName -> H2,
    SelfConjugate -> True,
    Mass -> {MH2, 125.30},
    Width -> {WH2, 0.00407},
    PDG -> 35,
    ParticleName -> "H2",
    FullName -> "Second CP-even scalar",
    PropagatorLabel -> "H2",
    PropagatorType -> D,
    PropagatorArrow -> None
  },
  S[5] == {
    ClassName -> chi,
    SelfConjugate -> True,
    Mass -> {Mchi, 62.573},
    Width -> 0,
    PDG -> 51,
    ParticleName -> "chi",
    FullName -> "pseudo-Nambu-Goldstone dark matter",
    PropagatorLabel -> "chi",
    PropagatorType -> D,
    PropagatorArrow -> None
  },
  S[12] == {
    ClassName -> SS,
    SelfConjugate -> False,
    Unphysical -> True,
    Definitions -> {SS -> (vsing + sing + I chi)/Sqrt[2]}
  },
  S[13] == {
    ClassName -> sing,
    SelfConjugate -> True,
    Unphysical -> True,
    Definitions -> {sing -> -Sin[th] H + Cos[th] H2}
  },
  S[14] == {
    ClassName -> phih,
    SelfConjugate -> True,
    Unphysical -> True,
    Definitions -> {phih -> Cos[th] H + Sin[th] H2}
  }
};

LSkin := Block[{mu}, ExpandIndices[del[SSbar, mu] del[SS, mu]]];

LSmass := Block[{}, ExpandIndices[muS2/2 SSbar SS]];

LSquartic := Block[{}, ExpandIndices[-lamS/2 (SSbar SS)^2]];

LSportal := Block[{ii}, ExpandIndices[-lamPS Phibar[ii] Phi[ii] SSbar SS, FlavorExpand -> SU2D]];

LSsoft := Block[{}, ExpandIndices[muSp2/4 (SS SS + SSbar SSbar)]];

LpNG := LSkin + LSmass + LSquartic + LSportal + LSsoft;

LTotal := LSM + LpNG;
