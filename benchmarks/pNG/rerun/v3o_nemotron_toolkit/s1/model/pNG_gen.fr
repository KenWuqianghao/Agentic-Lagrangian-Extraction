M$ClassesDescription = {
  S[100] == {
    ClassName -> S,
    SelfConjugate -> False,
    ParticleName -> "S",
    AntiParticleName -> "Sbar",
    FullName -> "Complex scalar singlet"
  },
  S[101] == {
