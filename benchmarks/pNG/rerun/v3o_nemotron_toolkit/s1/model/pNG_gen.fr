LKinS := DC[Sbar, mu] DC[S, mu];

LMassS := muS2/2 Sbar S + muSprime2/4 (S^2 + Sbar^2) - lambdaPhiS Phibar[ii] Phi[ii] Sbar S - lambdaS/2 (Sbar S)^2;

LKinChi := 1/2 del[Chi, mu] del[Chi, mu] - 1/2 mChi^2 Chi^2;

LKinH2 := 1/2 del[H2, mu] del[H2, mu] - 1/2 mH^2 H2^2;

LTotal := LKinS + LMassS + LKinChi + LKinH2;
