LNmajKin := Block[{mu}, ExpandIndices[I/2 Nmajbar.Ga[mu].del[Nmaj,mu] - 1/2 MN Nmajbar.Nmaj]];

LNCC := Block[{mu, ll, ccterm}, ccterm = ExpandIndices[-(gw/Sqrt[2]) W[mu] bar[CC[Nmaj]].Ga[mu].ProjM.l[ll] Conjugate[VlN[ll]]]; ccterm + HC[ccterm]];

LNNC := Block[{mu, ll, ncterm}, ncterm = ExpandIndices[-(gw/(2 cw)) Z[mu] bar[CC[Nmaj]].Ga[mu].ProjM.vl[ll] Conjugate[VlN[ll]]]; ncterm + HC[ncterm]];

LNH := Block[{ll, hterm}, hterm = ExpandIndices[-(gw MN/(2 MW)) H bar[CC[Nmaj]].ProjM.vl[ll] Conjugate[VlN[ll]]]; hterm + HC[hterm]];

LTotal := LNmajKin + LNCC + LNNC + LNH;
