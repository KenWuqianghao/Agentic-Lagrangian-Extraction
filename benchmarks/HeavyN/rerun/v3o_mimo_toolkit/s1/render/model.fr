LWN := -gw/Sqrt[2] W[mu] (VeN bar[CC[Nr]].Ga[mu].ProjP.l[1] + VmN bar[CC[Nr]].Ga[mu].ProjP.l[2] + VtN bar[CC[Nr]].Ga[mu].ProjP.l[3]) + HC[-gw/Sqrt[2] W[mu] (VeN bar[CC[Nr]].Ga[mu].ProjP.l[1] + VmN bar[CC[Nr]].Ga[mu].ProjP.l[2] + VtN bar[CC[Nr]].Ga[mu].ProjP.l[3])];

LZN := -gw/(2 cw) Z[mu] (VeN bar[CC[Nr]].Ga[mu].ProjP.vl[1] + VmN bar[CC[Nr]].Ga[mu].ProjP.vl[2] + VtN bar[CC[Nr]].Ga[mu].ProjP.vl[3]) + HC[-gw/(2 cw) Z[mu] (VeN bar[CC[Nr]].Ga[mu].ProjP.vl[1] + VmN bar[CC[Nr]].Ga[mu].ProjP.vl[2] + VtN bar[CC[Nr]].Ga[mu].ProjP.vl[3])];

LhN := -gw MN/(2 MW) H (VeN bar[CC[Nr]].ProjP.vl[1] + VmN bar[CC[Nr]].ProjP.vl[2] + VtN bar[CC[Nr]].ProjP.vl[3]) + HC[-gw MN/(2 MW) H (VeN bar[CC[Nr]].ProjP.vl[1] + VmN bar[CC[Nr]].ProjP.vl[2] + VtN bar[CC[Nr]].ProjP.vl[3])];

LTotal := LNRkin + LWN + LZN + LhN;
