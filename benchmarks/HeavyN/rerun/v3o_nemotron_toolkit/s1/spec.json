      "propagator_label": ["HN1", "HN2", "HN3"],
      "propagator_type": "Straight",
      "propagator_arrow": "Forward"
    }
  ],
  "gauge_xi": [],
  "lagrangian_terms": [
    {
      "name": "LNKin",
      "expression": "I HNbar.Ga[mu].DC[HN, mu]",
      "delayed": true
    },
    {
      "name": "LNMass",
      "expression": "-MN HNbar.HN",
      "delayed": true
    },
    {
      "name": "LNWbase",
      "expression": "-gw/Sqrt[2] W[mu] bar[CC[HNbar]].V.Ga[mu].ProjM[l]",
      "delayed": true
    },
    {
      "name": "LNW",
      "expression": "LNWbase + HC[LNWbase]",
      "delayed": true
    },
    {
      "name": "LNZbase",
      "expression": "-gw/(2*cw) Z[mu] bar[CC[HNbar]].V.Ga[mu].ProjM[vl]",
      "delayed": true
    },
    {
      "name": "LNZ",
      "expression": "LNZbase + HC[LNZbase]",
      "delayed": true
    },
    {
      "name": "LNHbase",
      "expression": "-gw*MN/(2*MW) H bar[CC[HNbar]].V.ProjM[vl]",
      "delayed": true
    },
    {
      "name": "LNH",
      "expression": "LNHbase + HC[LNHbase]",
      "delayed": true
    },
    {
      "name": "LTotal",
      "expression": "LNKin + LNMass + LNW + LNZ + LNH",
      "delayed": true
    }
  ],
