      "description": "Heavy neutrino mass [GeV]",
      "tex": "M_N"
    },
    {
      "name": "V",
      "parameter_type": "External",
      "indices": ["HeavyGeneration", "Generation"],
      "value_rules": [
        {"lhs": "V[1, 1]", "rhs": "0.01"},
        {"lhs": "V[1, 2]", "rhs": "0"},
        {"lhs": "V[1, 3]", "rhs": "0"},
        {"lhs": "V[2, 1]", "rhs": "0"},
        {"lhs": "V[2, 2]", "rhs": "0.01"},
        {"lhs": "V[2, 3]", "rhs": "0"},
        {"lhs": "V[3, 1]", "rhs": "0"},
        {"lhs": "V[3, 2]", "rhs": "0"},
        {"lhs": "V[3, 3]", "rhs": "0.01"}
      ],
      "interaction_order": ["NP", 1],
      "description": "Active-heavy neutrino mixing matrix V_\\ell N",
      "tex": "V"
    }
  ],
  "particles": [
    {
      "spin_type": "F",
      "class_index": 100,
      "class_name": "HN",
      "self_conjugate": false,
      "indices": ["HeavyGeneration"],
      "flavor_index": "HeavyGeneration",
      "class_members": ["HN1", "HN2", "HN3"],
