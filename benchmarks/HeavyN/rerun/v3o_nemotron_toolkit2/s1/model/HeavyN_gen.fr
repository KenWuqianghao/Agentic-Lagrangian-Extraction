LHiggs := Block[{sp, ff}, ExpandIndices[-g MN/(2 MW) h VN[ff] bar[CC[NHeavy]].ProjM. LL[sp, 1, ff], FlavorExpand -> Generation]];

LTotal := LNkin + LCC + HC[LCC] + LNC + HC[LNC] + LHiggs + HC[LHiggs];
