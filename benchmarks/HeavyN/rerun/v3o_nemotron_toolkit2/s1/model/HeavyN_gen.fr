LNkin := I/2 NHeavybar.Ga[mu].del[NHeavy, mu] - 1/2 MN NHeavybar.NHeavy;

LCC := Block[{sp, mu, ff}, ExpandIndices[-g/Sqrt[2] W[mu] VN[ff] bar[CC[NHeavy]].Ga[mu].ProjM. LL[sp, 2, ff], FlavorExpand -> Generation]];

