GaugeXi[Zp] = GaugeXi[Zp];

LZpKin := -1/4 FS[Zp, mu, nu] FS[Zp, mu, nu] + 1/2 MZp^2 Zp[mu] Zp[mu];

LPhiXKin := DC[PhiXbar, mu] DC[PhiX, mu] - MPhiX^2 PhiXbar PhiX;

LNRKin := I/2 NRbar.Ga[mu].del[NR, mu] - 1/2 MN NRbar.NR;

LZpInt := -gp * ( (xH/6 + 1/3) * QLbar.Ga[mu].ProjM.QL + (2*xH/3 + 1/3) * uRbar.Ga[mu].ProjP.uR + (-xH/3 + 1/3) * dRbar.Ga[mu].ProjP.dR + (-xH/2 - 1) * LLbar.Ga[mu].ProjM.LL + (-xH - 1) * lRbar.Ga[mu].ProjP.lR + (-1) * NRbar.Ga[mu].ProjP.NR ) * Zp[mu];

LPhiXPot := mPhiX2 PhiXbar PhiX - lamPhi (PhiXbar PhiX)^2 - lamMix (Phibar[ii] Phi[ii]) (PhiXbar PhiX);

LNuYuk := -Ynu[ff1, ff2] LLbar[sp, ii, ff1].NR[sp, ff2] Phibar[jj] Eps[ii, jj] - YN[ff1, ff2] PhiX * bar[CC[NR[ff1]]].NR[ff2] + HC[-Ynu[ff1, ff2] LLbar[sp, ii, ff1].NR[sp, ff2] Phibar[jj] Eps[ii, jj] - YN[ff1, ff2] PhiX * bar[CC[NR[ff1]]].NR[ff2]];

LTotal := LZpKin + LPhiXKin + LNRKin + LZpInt + LPhiXPot + LNuYuk;
