    "authors": ["Arindam Das", "P. S. Bhupal Dev", "Yutaka Hosotani", "Sanjoy Mandal"],
    "version": "1.0",
    "date": "2026-09-24",
    "institutions": ["Kyungpook National University", "Washington University", "Osaka University", "IFIC Valencia"],
    "emails": ["arindamdas@oia.hokudai.ac.jp", "bdev@wustl.edu", "hosotani@het.phys.sci.osaka-u.ac.jp", "smandal@ific.uv.es"]
  },
  "interaction_order_hierarchy": [["QCD", 1], ["QED", 2], ["NP", 1]],
  "interaction_order_limit": [["NP", 1]],
  "feynman_gauge": true,
  "vevs": [["Phi[2]", "vev"], ["PhiX", "vPhi"]],
  "gauge_groups": [],
  "index_decls": [],
  "parameters": [
    {
      "name": "gp",
      "parameter_type": "External",
      "value": "0.4",
      "block_name": "NP",
      "order_block": 1,
      "interaction_order": ["NP", 1],
      "description": "U(1)_X gauge coupling g'",
      "tex": "g'"
    },
    {
      "name": "xH",
      "parameter_type": "External",
      "value": "0",
      "block_name": "NP",
      "order_block": 2,
      "interaction_order": ["NP", 1],
      "description": "U(1)_X charge parameter x_H (x_Phi=1 fixed), x_H=0 is B-L limit",
      "tex": "x_H"
    },
    {
      "name": "vPhi",
      "parameter_type": "External",
      "value": "9375.",
      "block_name": "NP",
      "order_block": 3,
      "interaction_order": ["NP", 1],
      "description": "VEV of U(1)_X Higgs field PhiX [GeV]",
      "tex": "v_\\Phi"
    },
    {
      "name": "MZp",
      "parameter_type": "External",
      "value": "7500.",
      "block_name": "MASS",
      "order_block": 1,
      "interaction_order": ["NP", 1],
      "description": "Z' boson mass [GeV]",
      "tex": "M_{Z'}"
    },
    {
      "name": "MPhiX",
      "parameter_type": "External",
      "value": "1000.",
      "block_name": "MASS",
      "order_block": 2,
      "interaction_order": ["NP", 1],
      "description": "PhiX scalar mass [GeV]",
      "tex": "M_{\\Phi_X}"
    },
    {
      "name": "MN",
      "parameter_type": "External",
      "indices": ["Generation"],
      "value_rules": [
        {"lhs": "MN[1]", "rhs": "1000.", "delayed": false},
        {"lhs": "MN[2]", "rhs": "1000.", "delayed": false},
        {"lhs": "MN[3]", "rhs": "1000.", "delayed": false}
      ],
      "block_name": "MASS",
      "interaction_order": ["NP", 1],
      "description": "Majorana neutrino masses [GeV]",
      "tex": "M_N"
    },
    {
      "name": "Ynu",
      "parameter_type": "External",
      "indices": ["Generation", "Generation"],
      "value_rules": [
        {"lhs": "Ynu[1,1]", "rhs": "0.01", "delayed": false},
        {"lhs": "Ynu[1,2]", "rhs": "0", "delayed": false},
        {"lhs": "Ynu[1,3]", "rhs": "0", "delayed": false},
        {"lhs": "Ynu[2,1]", "rhs": "0", "delayed": false},
        {"lhs": "Ynu[2,2]", "rhs": "0.01", "delayed": false},
        {"lhs": "Ynu[2,3]", "rhs": "0", "delayed": false},
        {"lhs": "Ynu[3,1]", "rhs": "0", "delayed": false},
        {"lhs": "Ynu[3,2]", "rhs": "0", "delayed": false},
        {"lhs": "Ynu[3,3]", "rhs": "0.01", "delayed": false}
      ],
      "interaction_order": ["NP", 1],
      "description": "Dirac neutrino Yukawa couplings",
      "tex": "Y_\\nu"
    },
    {
      "name": "YN",
      "parameter_type": "External",
      "indices": ["Generation", "Generation"],
      "value_rules": [
        {"lhs": "YN[1,1]", "rhs": "0.1", "delayed": false},
        {"lhs": "YN[1,2]", "rhs": "0", "delayed": false},
        {"lhs": "YN[1,3]", "rhs": "0", "delayed": false},
        {"lhs": "YN[2,1]", "rhs": "0", "delayed": false},
        {"lhs": "YN[2,2]", "rhs": "0.1", "delayed": false},
        {"lhs": "YN[2,3]", "rhs": "0", "delayed": false},
        {"lhs": "YN[3,1]", "rhs": "0", "delayed": false},
        {"lhs": "YN[3,2]", "rhs": "0", "delayed": false},
        {"lhs": "YN[3,3]", "rhs": "0.1", "delayed": false}
      ],
      "interaction_order": ["NP", 1],
      "description": "Majorana neutrino Yukawa couplings",
      "tex": "Y_N"
    },
    {
      "name": "lamPhi",
      "parameter_type": "External",
      "value": "0.1",
      "block_name": "NP",
      "order_block": 4,
      "interaction_order": ["NP", 1],
      "description": "PhiX quartic coupling lambda_Phi",
      "tex": "\\lambda_\\Phi"
    },
    {
      "name": "lamMix",
      "parameter_type": "External",
      "value": "0.01",
      "block_name": "NP",
      "order_block": 5,
      "interaction_order": ["NP", 1],
      "description": "Higgs-PhiX portal coupling lambda'",
      "tex": "\\lambda'"
    },
    {
      "name": "mPhiX2",
      "parameter_type": "External",
      "value": "-1000000.",
      "block_name": "NP",
      "order_block": 6,
      "interaction_order": ["NP", 1],
      "description": "PhiX bare mass-squared parameter (negative for SSB) [GeV^2]",
      "tex": "m_{\\Phi_X}^2"
    }
  ],
  "particles": [
    {
      "spin_type": "V",
      "class_index": 100,
      "class_name": "Zp",
      "self_conjugate": true,
      "indices": [],
      "mass": {"sym": "MZp", "value": "7500."},
      "width": {"sym": "WZp", "value": "Auto"},
      "quantum_numbers": {"QX": "0"},
      "pdg": 32,
      "particle_name": "Zp",
      "antiparticle_name": "Zp",
      "full_name": "Z' boson",
      "propagator_label": "Zp",
      "propagator_type": "Sine",
      "propagator_arrow": "None"
    },
    {
      "spin_type": "S",
      "class_index": 101,
      "class_name": "PhiX",
      "self_conjugate": false,
      "indices": [],
      "mass": {"sym": "MPhiX", "value": "1000."},
      "width": {"sym": "WPhiX", "value": "Auto"},
      "quantum_numbers": {"QX": "2"},
      "pdg": 9000001,
      "particle_name": "PhiX",
      "antiparticle_name": "PhiXbar",
      "full_name": "U(1)_X Higgs scalar",
      "propagator_label": "PhiX",
      "propagator_type": "ScalarDash",
      "propagator_arrow": "None"
    },
    {
      "spin_type": "F",
      "class_index": 102,
      "class_name": "NR",
      "self_conjugate": true,
      "indices": ["Generation"],
      "flavor_index": "Generation",
      "class_members": ["NR1", "NR2", "NR3"],
      "mass": {"massless": true},
      "width": {"sym": "WNR", "value": "Auto"},
      "quantum_numbers": {},
      "pdg": [9900012, 9900014, 9900016],
      "particle_name": ["NR1", "NR2", "NR3"],
      "antiparticle_name": ["NR1", "NR2", "NR3"],
      "full_name": ["Right-handed neutrino 1", "Right-handed neutrino 2", "Right-handed neutrino 3"],
      "propagator_label": ["NR1", "NR2", "NR3"],
      "propagator_type": "Straight",
      "propagator_arrow": "Forward"
    }
  ],
  "gauge_xi": [
    ["Zp", "GaugeXi[Zp]"]
  ],
  "lagrangian_terms": [
    {
      "name": "LZpKin",
      "expression": "-1/4 FS[Zp, mu, nu] FS[Zp, mu, nu] + 1/2 MZp^2 Zp[mu] Zp[mu]",
      "delayed": true
    },
    {
      "name": "LPhiXKin",
      "expression": "DC[PhiXbar, mu] DC[PhiX, mu] - MPhiX^2 PhiXbar PhiX",
      "delayed": true
    },
    {
      "name": "LNRKin",
      "expression": "I/2 NRbar.Ga[mu].del[NR, mu] - 1/2 MN NRbar.NR",
      "delayed": true
    },
    {
      "name": "LZpInt",
      "expression": "-gp * ( (xH/6 + 1/3) * QLbar.Ga[mu].ProjM.QL + (2*xH/3 + 1/3) * uRbar.Ga[mu].ProjP.uR + (-xH/3 + 1/3) * dRbar.Ga[mu].ProjP.dR + (-xH/2 - 1) * LLbar.Ga[mu].ProjM.LL + (-xH - 1) * lRbar.Ga[mu].ProjP.lR + (-1) * NRbar.Ga[mu].ProjP.NR ) * Zp[mu]",
      "delayed": true
    },
    {
      "name": "LPhiXPot",
      "expression": "mPhiX2 PhiXbar PhiX - lamPhi (PhiXbar PhiX)^2 - lamMix (Phibar[ii] Phi[ii]) (PhiXbar PhiX)",
      "delayed": true
    },
    {
      "name": "LNuYuk",
      "expression": "-Ynu[ff1, ff2] LLbar[sp, ii, ff1].NR[sp, ff2] Phibar[jj] Eps[ii, jj] - YN[ff1, ff2] PhiX * bar[CC[NR[ff1]]].NR[ff2] + HC[-Ynu[ff1, ff2] LLbar[sp, ii, ff1].NR[sp, ff2] Phibar[jj] Eps[ii, jj] - YN[ff1, ff2] PhiX * bar[CC[NR[ff1]]].NR[ff2]]",
      "delayed": true
    },
    {
      "name": "LTotal",
      "expression": "LZpKin + LPhiXKin + LNRKin + LZpInt + LPhiXPot + LNuYuk",
      "delayed": true
    }
  ],
  "raw_preamble": [
    "AddGaugeRepresentation[U1X -> {QX, U1XCharge}];"
  ],
  "raw_blocks": []
}