GaugeXi[V[100]] = GaugeXi[Zp];

GaugeXi[S[100]] = 1;

GaugeXi[S[101]] = GaugeXi[Zp];

LZpKin := Block[{mu, nu}, ExpandIndices[-1/4 FS[Zp, mu, nu] FS[Zp, mu, nu]]];

LchiKin := Block[{mu}, ExpandIndices[(del[chixbar, mu] + I gX xPhis Zp[mu] chixbar) (del[chix, mu] - I gX xPhis Zp[mu] chix)]];

LchiPot := Block[{ii}, ExpandIndices[muX^2 chixbar chix - lamX chixbar chix chixbar chix - lamHX Phibar[ii] Phi[ii] chixbar chix, FlavorExpand -> SU2D]];

LZpHiggs := Block[{ii, mu}, ExpandIndices[I gX xHd Zp[mu] (Phibar[ii] DC[Phi[ii], mu] - DC[Phibar[ii], mu] Phi[ii]) + gX^2 xHd^2 Zp[mu] Zp[mu] Phibar[ii] Phi[ii], FlavorExpand -> {SU2D, SU2W}]];

LNKin := Block[{mu}, ExpandIndices[I/2 vRbar.Ga[mu].del[vR, mu]]];

LZpF := Block[{mu}, ExpandIndices[-gX Zp[mu] (xQL QLbar.Ga[mu].QL + xuR uRbar.Ga[mu].uR + xdR dRbar.Ga[mu].dR + xLL LLbar.Ga[mu].LL + xlR lRbar.Ga[mu].lR + xNR NRbar.Ga[mu].NR), FlavorExpand -> {SU2D}]];

LnuYuk := Block[{sp, ii, jj, ff1, ff2, yuk}, yuk = -ynu[ff1, ff2] LLbar[sp, ii, ff1].NR[sp, ff2] Phibar[jj] Eps[ii, jj]; ExpandIndices[yuk + HC[yuk], FlavorExpand -> SU2D]];

LNYuk := Block[{sp, ff, yuk}, yuk = -1/2 yN[ff] chix CC[NRbar[sp, ff]].NR[sp, ff]; ExpandIndices[yuk + HC[yuk]]];

LU1X := LZpKin + LchiKin + LchiPot + LZpHiggs + LNKin + LZpF + LnuYuk + LNYuk;

LTot := LSM + LU1X;
