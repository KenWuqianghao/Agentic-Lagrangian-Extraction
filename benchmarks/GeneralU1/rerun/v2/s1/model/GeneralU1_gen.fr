LZpkin := Block[{mu, nu}, -1/4 FS[Zp, mu, nu] FS[Zp, mu, nu] + 1/2 MZp^2 Zp[mu] Zp[mu]];

LNfree := Block[{mu, sp, ff}, ExpandIndices[I/2 Nhbar.Ga[mu].del[Nh, mu] - 1/2 MNh[ff] Nhbar[sp, ff].Nh[sp, ff], FlavorExpand -> Generation]];

LPhiX := Block[{mu, ii}, ExpandIndices[del[PhiXbar, mu] del[PhiX, mu] + muX^2 PhiXbar PhiX - lamPhi PhiXbar PhiX PhiXbar PhiX - lamHP Phibar[ii] Phi[ii] PhiXbar PhiX, FlavorExpand -> SU2D]];

LZpF := Block[{mu}, ExpandIndices[-gX Zp[mu] (xQL QLbar.Ga[mu].QL + xuR uRbar.Ga[mu].uR + xdR dRbar.Ga[mu].dR + xLL LLbar.Ga[mu].LL + xlR lRbar.Ga[mu].lR + xNR NRbar.Ga[mu].NR), FlavorExpand -> {SU2W, SU2D}] /. {CKM[a_, b_] Conjugate[CKM[a_, c_]] -> IndexDelta[b, c], CKM[b_, a_] Conjugate[CKM[c_, a_]] -> IndexDelta[b, c]}];

LZpS := Block[{mu}, gX^2 xPhiS^2 (vevX phiX + phiX^2/2) Zp[mu] Zp[mu]];

LNYukD := Block[{sp, ii, jj, ff1, ff2, yuk}, yuk = ExpandIndices[-yNu[ff1, ff2] LLbar[sp, ii, ff1].NR[sp, ff2] Phibar[jj] Eps[ii, jj], FlavorExpand -> SU2D]; yuk + HC[yuk]];

LNYukM := Block[{sp, ff1, ff2, yuk}, yuk = ExpandIndices[-1/(2 Sqrt[2]) yN[ff1, ff2] phiX bar[CC[NR[sp, ff1]]].NR[sp, ff2], FlavorExpand -> Generation]; yuk + HC[yuk]];

LU1X := LZpkin + LNfree + LPhiX + LZpF + LZpS + LNYukD + LNYukM;

LTotal := LSM + LU1X;
