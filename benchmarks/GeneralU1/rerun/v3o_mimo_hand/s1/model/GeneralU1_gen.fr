(*******************************************************************)
(*****  Minimal U(1)_X (GeneralU1) add-on model on top of SM.fr  *****)
(*****  Extracted from arXiv:2104.10902 (paper LaTeX source)      *****)
(*******************************************************************)

(* ************************** *)
(* *****  Information   ***** *)
(* ************************** *)

M$ModelName = "GeneralU1_gen";

M$Information = {
  Authors      -> {"Benchmark extraction"},
  Version      -> "1.0",
  Date         -> "24. 09. 2026",
  Description  -> "Minimal U(1)_X extension: Z', three right-handed neutrinos, singlet scalar, on top of SM.fr (arXiv:2104.10902)"
};

(* ************************** *)
(* ***** Interaction orders ***** *)
(* ************************** *)

M$InteractionOrderHierarchy = {
  {QCD, 1},
  {QED, 2},
  {NP, 2}
};

(* ************************** *)
(* ***** Particle classes ***** *)
(* ************************** *)

M$ClassesDescription = {

(* New gauge boson *)
  V[100] == {
    ClassName       -> Zp,
    SelfConjugate   -> True,
    Mass            -> {MZp, Internal},
    Width           -> 0,
    ParticleName    -> "Zp",
    PDG             -> 32,
    PropagatorLabel -> "Zp",
    PropagatorType  -> Sine,
    PropagatorArrow -> None,
    FullName        -> "Zprime"
  },

(* Right-handed neutrinos: Majorana mass eigenstates (paper: Gamma(Z' -> N N)) *)
  F[100] == {
    ClassName        -> NR,
    ClassMembers     -> {NR1, NR2, NR3},
    Indices          -> {Index[Generation]},
    FlavorIndex      -> Generation,
    SelfConjugate    -> True,
    Mass             -> {MNR, Internal},
    Width            -> 0,
    PDG              -> {9900012, 9900014, 9900016},
    ParticleName     -> {"N1", "N2", "N3"},
    PropagatorLabel  -> {"NR", "NR1", "NR2", "NR3"},
    PropagatorType   -> Straight,
    PropagatorArrow  -> None,
    FullName         -> {"Right-handed neutrino 1", "Right-handed neutrino 2", "Right-handed neutrino 3"}
  },

(* U(1)_X-breaking singlet scalar (paper field Phi, complex, X charge 2 x_Phi) *)
  S[100] == {
    ClassName       -> PhiX,
    SelfConjugate   -> False,
    Mass            -> {Mphi, 1000.},
    Width           -> 0,
    PDG             -> 26,
    ParticleName    -> "PhiX",
    AntiParticleName -> "PhiXbar",
    PropagatorLabel -> "PhiX",
    PropagatorType  -> D,
    PropagatorArrow -> None,
    FullName        -> "U(1)X singlet scalar"
  }
};

(* ************************** *)
(* *****   Parameters   ***** *)
(* ************************** *)

M$Parameters = {

(* External parameters *)
  gprime == {
    ParameterType    -> External,
    BlockName        -> U1XINPUTS,
    OrderBlock       -> 1,
    Value            -> 0.4,
    InteractionOrder -> {NP, 1},
    Description      -> "U(1)_X gauge coupling g' (paper benchmark 0.4)"
  },
  xH == {
    ParameterType -> External,
    BlockName     -> U1XINPUTS,
    OrderBlock    -> 2,
    Value         -> 1.,
    Description   -> "U(1)_X charge parameter x_H (paper benchmark 1, with x_Phi = 1)"
  },
  xPhi == {
    ParameterType -> External,
    BlockName     -> U1XINPUTS,
    OrderBlock    -> 3,
    Value         -> 1.,
    Description   -> "U(1)_X charge parameter x_Phi (paper fixes x_Phi = 1)"
  },
  vPhi == {
    ParameterType -> External,
    BlockName     -> U1XINPUTS,
    OrderBlock    -> 4,
    Value         -> 9375.,
    Description   -> "U(1)_X breaking scale v_Phi [GeV]; M_Z' ~ 2 g' v_Phi = 7.5 TeV at g' = 0.4"
  },
  yN == {
    ParameterType    -> External,
    BlockName        -> U1XINPUTS,
    OrderBlock       -> 5,
    Indices          -> {Index[Generation], Index[Generation]},
    Value            -> {yN[1,1] -> 0.01, yN[1,2] -> 0, yN[1,3] -> 0,
                         yN[2,1] -> 0, yN[2,2] -> 0.01, yN[2,3] -> 0,
                         yN[3,1] -> 0, yN[3,2] -> 0, yN[3,3] -> 0.01},
    InteractionOrder -> {NP, 1},
    Description      -> "Dirac neutrino Yukawa matrix Y_nu (paper Eq. LYk); benchmark diagonal 0.01"
  },
  YN == {
    ParameterType    -> External,
    BlockName        -> U1XINPUTS,
    OrderBlock       -> 6,
    Indices          -> {Index[Generation]},
    Value            -> {YN[1] -> 1.5, YN[2] -> 1.5, YN[3] -> 1.5},
    InteractionOrder -> {NP, 1},
    Description      -> "RHN Majorana Yukawa Y_N (paper Eq. LYk): m_N = Y_N v_Phi/Sqrt[2]"
  },
  lamPhi == {
    ParameterType    -> External,
    BlockName        -> U1XINPUTS,
    OrderBlock       -> 7,
    Value            -> 0.1,
    InteractionOrder -> {NP, 1},
    Description      -> "Singlet quartic lambda_Phi (paper Higgs potential)"
  },
  lamPrime == {
    ParameterType    -> External,
    BlockName        -> U1XINPUTS,
    OrderBlock       -> 8,
    Value            -> 0.01,
    InteractionOrder -> {NP, 1},
    Description      -> "Higgs portal lambda' (paper Higgs potential; small per paper)"
  },

(* Internal parameters *)
  MZp == {
    ParameterType -> Internal,
    Value         -> gprime Sqrt[4 xPhi^2 vPhi^2 + xH^2 vev^2/4],
    Description   -> "Z' mass, paper: M_Z' = g' Sqrt[4 v_Phi^2 + x_H^2 v^2/4]"
  },
  MNR == {
    ParameterType -> Internal,
    Value         -> YN[1] vPhi/Sqrt[2],
    Description   -> "RHN Majorana mass m_N = Y_N v_Phi/Sqrt[2] (universal benchmark)"
  }
};

(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

(* Free field: Z' (real vector, gauge boson of U(1)_X) *)
LZpkin := Block[{mu,nu},
  ExpandIndices[-1/4 FS[Zp,mu,nu] FS[Zp,mu,nu] + 1/2 MZp^2 Zp[mu] Zp[mu]]
];

(* Free field: right-handed neutrinos (Majorana fermions) *)
LNRkin := Block[{mu},
  ExpandIndices[I/2 NRbar.Ga[mu].del[NR,mu] - 1/2 MNR NRbar.NR]
];

(* Free field: singlet scalar (complex) *)
LPhixin := Block[{mu},
  ExpandIndices[DC[PhiXbar,mu] DC[PhiX,mu] - Mphi^2 PhiXbar PhiX]
];

(* New pieces of the scalar potential: V = ... + lamPhi (Phi^dag Phi)^2 + lamPrime (H^dag H)(Phi^dag Phi), L = -V *)
LVpot := Block[{jj},
  ExpandIndices[-lamPhi PhiXbar PhiX PhiXbar PhiX - lamPrime Phibar[jj] Phi[jj] PhiXbar PhiX, FlavorExpand -> SU2D]
];

(* Z' interactions with fermions (paper Eq. Lag1 + RHN current from Table 1 charge) *)
LZpf := Block[{mu},
  ExpandIndices[-gprime Zp[mu] (
      (xH/6 + xPhi/3) QLbar.Ga[mu].QL +
      (2 xH/3 + xPhi/3) uRbar.Ga[mu].uR +
      (-xH/3 + xPhi/3) dRbar.Ga[mu].dR +
      (-xH/2 - xPhi) LLbar.Ga[mu].LL +
      (-xH - xPhi) lRbar.Ga[mu].lR +
      (-xPhi) NRbar.Ga[mu].ProjP.NR
    ), FlavorExpand -> SU2D]
];

(* Z' interactions with the SM Higgs doublet (X charge of SM.fr Phi = +x_H/2) *)
LZpH := Block[{mu,jj},
  ExpandIndices[-I gprime (xH/2) Zp[mu] (Phibar[jj] del[Phi[jj],mu] - Phi[jj] del[Phibar[jj],mu])
    + gprime^2 (xH/2)^2 Zp[mu] Zp[mu] Phibar[jj] Phi[jj], FlavorExpand -> SU2D]
];

(* Z' interactions with the singlet scalar (X charge 2 x_Phi) *)
LZpPhi := Block[{mu},
  ExpandIndices[-I gprime (2 xPhi) Zp[mu] (PhiXbar del[PhiX,mu] - PhiX del[PhiXbar,mu])
    + gprime^2 (2 xPhi)^2 Zp[mu] Zp[mu] PhiXbar PhiX]
];

(* Dirac neutrino Yukawa: -Y_nu LLbar H N_R + h.c.  (paper Eq. LYk, H = i tau2 Phi* form) *)
LYnu := Block[{sp,ii,jj,ff1,ff2,yuk},
  yuk = ExpandIndices[-yN[ff1,ff2] LLbar[sp,ii,ff1].NR[sp,ff2] Phibar[jj] Eps[ii,jj], FlavorExpand -> SU2D];
  yuk + HC[yuk]
];

(* RHN Majorana Yukawa: -Y_N Phi Nbar^c N + h.c.  (paper Eq. LYk, Phi = (v_Phi + phi)/Sqrt[2]) *)
LYN := Block[{sp,ff,yuk},
  yuk = ExpandIndices[-YN[ff] PhiX bar[CC[NR[sp,ff]]] NR[sp,ff]];
  yuk + HC[yuk]
];

LTotal := LZpkin + LNRkin + LPhixin + LVpot + LZpf + LZpH + LZpPhi + LYnu + LYN;
