LZpKin := Block[{mu,nu}, -1/4 FS[Zp,mu,nu] FS[Zp,mu,nu] + 1/2 MZp^2 Zp[mu] Zp[mu]];

LZpInt := Block[{mu}, ExpandIndices[ -gX ( qXqL uqbar.Ga[mu].ProjM.uq + qXuR uqbar.Ga[mu].ProjP.uq + qXqL dqbar.Ga[mu].ProjM.dq + qXdR dqbar.Ga[mu].ProjP.dq + qXlL lbar.Ga[mu].ProjM.l + qXeR lbar.Ga[mu].ProjP.l + qXlL vlbar.Ga[mu].ProjM.vl + qXNR NRbar.Ga[mu].ProjP.NR ) Zp[mu] ] ];

LNRKin := Block[{sp,mu,ff}, ExpandIndices[ I/2 NRbar.Ga[mu].del[NR,mu] - 1/2 MN[ff] NRbar[sp,ff].NR[sp,ff] ] ];

LNuDirac := Block[{sp,ii,jj,ff1,ff2,yukNu}, yukNu = ExpandIndices[ -ynu[ff1,ff2] LLbar[sp,ii,ff1].NR[sp,ff2] Phibar[jj] Eps[ii,jj], FlavorExpand->SU2D]; yukNu + HC[yukNu] ];

LNRYuk := Block[{sp,ff}, ExpandIndices[ -(yN[ff]/Sqrt[2]) Sx NRbar[sp,ff].NR[sp,ff] ] ];

LSxKin := Block[{mu}, 1/2 del[Sx,mu] del[Sx,mu] - 1/2 MSx^2 Sx^2 - (lamPhi/4) Sx^4];

LSxPortal := Block[{ii}, ExpandIndices[ -lamP Phibar[ii] Phi[ii] Sx^2, FlavorExpand->SU2D] ];

LTotal := LZpKin + LZpInt + LNRKin + LNuDirac + LNRYuk + LSxKin + LSxPortal;
