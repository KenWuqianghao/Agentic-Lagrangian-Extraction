LZpKin := Block[{mu, nu}, ExpandIndices[-1/4 FS[Zp, mu, nu] FS[Zp, mu, nu] + 1/2 MZp^2 Zp[mu] Zp[mu]]];

LphiXKin := Block[{mu}, ExpandIndices[1/2 del[phiX, mu] del[phiX, mu] - 1/2 MphiX^2 phiX^2]];

LphiXPot := -lamX vX phiX^3 - lamX/4 phiX^4;

LphiXZp := Block[{mu}, ExpandIndices[gpX^2 xChi^2 (vX phiX + phiX^2/2) Zp[mu] Zp[mu]]];

LHZp := Block[{mu}, ExpandIndices[gpX^2 xPhiH^2 (vev H + H^2/2) Zp[mu] Zp[mu]]];

LPortalX := -lamHX/2 vev H phiX^2 - lamHX/2 vX H^2 phiX - lamHX/4 H^2 phiX^2;

LNKin := Block[{mu}, ExpandIndices[I/2 NRbar.Ga[mu].del[NR, mu] - 1/2 NRbar.MNm.NR]];

LNphiX := -1/(2 Sqrt[2]) phiX NRbar.yN.NR;

LNuYuk := Block[{yuk}, yuk = -1/Sqrt[2] H vlbar.ynu.ProjP.NR; ExpandIndices[yuk + HC[yuk]]];

LZpF := Block[{mu}, ExpandIndices[-gpX Zp[mu] (xQL (uqbar.Ga[mu].ProjM.uq + dqbar.Ga[mu].ProjM.dq) + xuR uqbar.Ga[mu].ProjP.uq + xdR dqbar.Ga[mu].ProjP.dq + xLL (vlbar.Ga[mu].ProjM.vl + lbar.Ga[mu].ProjM.l) + xlR lbar.Ga[mu].ProjP.l + xNR NRbar.Ga[mu].ProjP.NR)]];

LTotal := LZpKin + LphiXKin + LphiXPot + LphiXZp + LHZp + LPortalX + LNKin + LNphiX + LNuYuk + LZpF;
