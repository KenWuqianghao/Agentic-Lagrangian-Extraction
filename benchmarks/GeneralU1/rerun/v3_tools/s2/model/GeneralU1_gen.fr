LZpKin := -1/4 FS[Zp, mu, nu] FS[Zp, mu, nu] + 1/2 MZp^2 Zp[mu] Zp[mu];

LSXKin := 1/2 del[SX, mu] del[SX, mu] - 1/2 MSX^2 SX^2;

LNhKin := Block[{mu, ff}, ExpandIndices[I/2 Nhbar.Ga[mu].del[Nh, mu] - 1/2 MNh[ff] Nhbar[ff].Nh[ff]]];

LZpSX := Block[{mu}, gpX^2 qXSX^2 vX SX Zp[mu] Zp[mu] + 1/2 gpX^2 qXSX^2 SX^2 Zp[mu] Zp[mu]];

LSXSelf := -lamX vX SX^3 - lamX/4 SX^4;

LPortal := Block[{ii}, ExpandIndices[-lamHX/2 (Phibar[ii] Phi[ii] - vev^2/2) SX^2, FlavorExpand -> SU2D]];

LZpF := Block[{mu}, ExpandIndices[-gpX Zp[mu] (qXQL QLbar.Ga[mu].QL + qXuR uRbar.Ga[mu].uR + qXdR dRbar.Ga[mu].dR + qXLL LLbar.Ga[mu].LL + qXeR lRbar.Ga[mu].lR + qXNR Nhbar.Ga[mu].ProjP.Nh), FlavorExpand -> SU2D] /. {CKM[a_, b_] Conjugate[CKM[a_, c_]] -> IndexDelta[b, c], CKM[b_, a_] Conjugate[CKM[c_, a_]] -> IndexDelta[b, c]}];

LNYuk := Block[{sp, ii, jj, ff1, ff2, yuk}, yuk = ExpandIndices[-yNu[ff1, ff2] LLbar[sp, ii, ff1].Nh[sp, ff2] Phibar[jj] Eps[ii, jj], FlavorExpand -> SU2D]; yuk + HC[yuk]];

LNSX := Block[{sp, ff1, ff2}, ExpandIndices[-1/(2 Sqrt[2]) yN[ff1, ff2] SX Nhbar[sp, ff1].Nh[sp, ff2]]];

LTotal := LZpKin + LSXKin + LNhKin + LZpSX + LSXSelf + LPortal + LZpF + LNYuk + LNSX;
