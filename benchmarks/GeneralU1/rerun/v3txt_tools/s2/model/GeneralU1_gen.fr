LZpKin := Block[{mu, nu}, -1/4 FS[Zp, mu, nu] FS[Zp, mu, nu] + 1/2 MZp^2 Zp[mu] Zp[mu]];

LsxKin := Block[{mu}, 1/2 del[sx, mu] del[sx, mu] - 1/2 Msx^2 sx^2];

LNxKin := Block[{mu}, I/2 nxbar.Ga[mu].del[nx, mu] - 1/2 nxbar.mMaj.nx];

LZpF := Block[{mu}, -gX Zp[mu] (qxQ (uqbar.Ga[mu].ProjM.uq + dqbar.Ga[mu].ProjM.dq) + qxU uqbar.Ga[mu].ProjP.uq + qxD dqbar.Ga[mu].ProjP.dq + qxL (vlbar.Ga[mu].ProjM.vl + lbar.Ga[mu].ProjM.l) + qxE lbar.Ga[mu].ProjP.l + qxN nxbar.Ga[mu].ProjP.nx)];

LZpS := Block[{mu}, gX^2 qxS^2 Zp[mu] Zp[mu] (vX sx + 1/2 sx^2)];

LNuYuk := Block[{sp, ii, jj, ff1, ff2, yuk}, yuk = ExpandIndices[-yDN[ff1, ff2] LLbar[sp, ii, ff1].nx[sp, ff2] Phibar[jj] Eps[ii, jj], FlavorExpand -> SU2D]; yuk + HC[yuk]];

LNxYuk := -1/(2 Sqrt[2]) sx nxbar.yMN.nx;

LSPot := Block[{ii}, ExpandIndices[-lamX vX sx^3 - 1/4 lamX sx^4 - 1/2 lamHX vH H sx^2 - lamHX (vX sx + 1/2 sx^2) (Phibar[ii] Phi[ii] - vH^2/2 - vH H), FlavorExpand -> SU2D]];

LTotal := LZpKin + LsxKin + LNxKin + LZpF + LZpS + LNuYuk + LNxYuk + LSPot;
