LZpKin := Block[{mu, nu}, -1/4 FS[Zp, mu, nu] FS[Zp, mu, nu] + 1/2 MZp^2 Zp[mu] Zp[mu]];

LZpF := Block[{mu}, ExpandIndices[- gX Zp[mu] (xQ QLbar.Ga[mu].QL + xU uRbar.Ga[mu].uR + xD dRbar.Ga[mu].dR + xL LLbar.Ga[mu].LL + xE lRbar.Ga[mu].lR + xN NXbar.Ga[mu].ProjP.NX), FlavorExpand -> SU2D] /. {CKM[a_, b_] Conjugate[CKM[a_, c_]] -> IndexDelta[b, c], CKM[b_, a_] Conjugate[CKM[c_, a_]] -> IndexDelta[b, c]}];

LhXKin := Block[{mu}, 1/2 del[hX, mu] del[hX, mu] - 1/2 MhX^2 hX^2];

LhXPot := - lamX vX hX^3 - lamX/4 hX^4;

LZpS := Block[{mu}, 1/2 gX^2 xS^2 (2 vX hX + hX^2) Zp[mu] Zp[mu]];

LNKin := Block[{mu}, I/2 NXbar.Ga[mu].del[NX, mu] - 1/2 NXbar.MNdiag.NX];

LNMaj := Block[{yuk}, yuk = - 1/(2 Sqrt[2]) hX NXbar.yN.ProjP.NX; yuk + HC[yuk]];

LNDir := Block[{sp, ii, jj, ff1, ff2, yuk, feynmangaugerules}, feynmangaugerules = If[Not[FeynmanGauge], {G0 | GP | GPbar -> 0}, {}]; yuk = ExpandIndices[- yNu[ff1, ff2] LLbar[sp, ii, ff1].NR[sp, ff2] PhiFbar[jj] Eps[ii, jj], FlavorExpand -> SU2D]; yuk + HC[yuk] /. feynmangaugerules];

LTotal := LZpKin + LZpF + LhXKin + LhXPot + LZpS + LNKin + LNMaj + LNDir;
