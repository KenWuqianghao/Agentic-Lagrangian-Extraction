GaugeXi[Zp] = GaugeXi[Zp];

LZpkin := -1/4 FS[Zp, mu, nu] FS[Zp, mu, nu] + 1/2 MZp^2 Zp[mu] Zp[mu];

LPhiXkin := del[PhiXbar, mu] del[PhiX, mu] + 2*I*gX*Zp[mu]*(PhiXbar*del[PhiX, mu] - del[PhiXbar, mu]*PhiX) + 4*gX^2*Zp[mu]*Zp[mu]*PhiXbar*PhiX;

LPhiXpot := -mPhiX2*PhiXbar*PhiX - lambdaPhiX*(PhiXbar*PhiX)^2 - lambdaHPhiX*(PhiXbar*PhiX)*(Phibar[ii]*Phi[ii]);

LNRkin := I NRbar[ff].Ga[mu].del[NR[ff], mu] - NRbar[ff].MNR[ff].NR[ff];

LYukNu := -(LLbar.Phibar).yNu.NRR + HC[-(LLbar.Phibar).yNu.NRR];

LYukMajorana := -yN[ff] PhiX * bar[CC[NR[ff]]].ProjP.NR[ff] + HC[-yN[ff] PhiX * bar[CC[NR[ff]]].ProjP.NR[ff]];

LZpff := -gX * ( QqL * QLbar[sp, ii, ff, cc].Ga[mu].QL[sp, ii, ff, cc] + QuR * uRbar[sp, ff, cc].Ga[mu].uR[sp, ff, cc] + QdR * dRbar[sp, ff, cc].Ga[mu].dR[sp, ff, cc] + QlL * LLbar[sp, ii, ff].Ga[mu].LL[sp, ii, ff] + QeR * lRbar[sp, ff].Ga[mu].lR[sp, ff] + QNR * NRbar[sp, ff].Ga[mu].NR[sp, ff] ) * Zp[mu];

LTotal := LZpkin + LPhiXkin + LPhiXpot + LNRkin + LYukNu + LYukMajorana + LZpff;
