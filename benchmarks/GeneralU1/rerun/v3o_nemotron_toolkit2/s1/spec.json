  ],
  "gauge_groups": [],
  "index_decls": [],
  "parameters": [
    {
      "name": "gX",
      "parameter_type": "External",
      "value": "0.4",
      "block_name": "U1X",
      "order_block": 1,
      "interaction_order": ["NP", 1],
      "description": "U(1)_X gauge coupling"
    },
    {
      "name": "xH",
      "parameter_type": "External",
      "value": "0",
      "block_name": "U1X",
      "order_block": 2,
      "interaction_order": ["NP", 0],
      "description": "U(1)_X charge parameter x_H (x_Phi=1 fixed)"
    },
    {
      "name": "MZp",
      "parameter_type": "External",
      "value": "7500.",
      "block_name": "U1X",
      "order_block": 3,
      "interaction_order": ["NP", 0],
      "description": "Z' boson mass [GeV]"
    },
    {
      "name": "mPhiX2",
      "parameter_type": "External",
      "value": "-1000000.",
      "block_name": "U1X",
      "order_block": 4,
      "interaction_order": ["NP", 0],
      "description": "PhiX mass^2 parameter (m_Phi^2 in paper, negative for SSB) [GeV^2]"
    },
    {
      "name": "lambdaPhiX",
      "parameter_type": "External",
      "value": "0.1",
      "block_name": "U1X",
      "order_block": 5,
      "interaction_order": ["NP", 1],
      "description": "PhiX quartic coupling lambda_Phi"
    },
    {
      "name": "lambdaHPhiX",
      "parameter_type": "External",
      "value": "0.01",
      "block_name": "U1X",
      "order_block": 6,
      "interaction_order": ["NP", 1],
      "description": "Higgs-PhiX portal coupling lambda'"
    },
    {
      "name": "yNu",
      "parameter_type": "External",
      "indices": ["Generation", "Generation"],
      "value_rules": [
        {"lhs": "yNu[1,1]", "rhs": "0.001"},
        {"lhs": "yNu[1,2]", "rhs": "0"},
        {"lhs": "yNu[1,3]", "rhs": "0"},
        {"lhs": "yNu[2,1]", "rhs": "0"},
        {"lhs": "yNu[2,2]", "rhs": "0.001"},
        {"lhs": "yNu[2,3]", "rhs": "0"},
        {"lhs": "yNu[3,1]", "rhs": "0"},
        {"lhs": "yNu[3,2]", "rhs": "0"},
        {"lhs": "yNu[3,3]", "rhs": "0.001"}
      ],
      "block_name": "U1XNU",
      "interaction_order": ["NP", 1],
      "description": "Dirac neutrino Yukawa couplings Y_nu"
    },
    {
      "name": "yN",
      "parameter_type": "External",
      "indices": ["Generation"],
      "value_rules": [
        {"lhs": "yN[1]", "rhs": "0.1"},
        {"lhs": "yN[2]", "rhs": "0.1"},
        {"lhs": "yN[3]", "rhs": "0.1"}
      ],
      "block_name": "U1XN",
      "interaction_order": ["NP", 1],
      "description": "Majorana Yukawa couplings Y_N (diagonal)"
    },
    {
      "name": "vPhi",
      "parameter_type": "Internal",
      "value": "MZp/(2*gX)",
      "interaction_order": ["NP", -1],
      "description": "PhiX VEV v_Phi [GeV], from M_Z' = 2 gX v_Phi"
    },
    {
      "name": "QqL",
      "parameter_type": "Internal",
      "value": "xH/6 + 1/3",
      "description": "U(1)_X charge of q_L"
    },
    {
      "name": "QuR",
      "parameter_type": "Internal",
      "value": "2*xH/3 + 1/3",
      "description": "U(1)_X charge of u_R"
    },
    {
      "name": "QdR",
      "parameter_type": "Internal",
      "value": "-xH/3 + 1/3",
      "description": "U(1)_X charge of d_R"
    },
    {
      "name": "QlL",
      "parameter_type": "Internal",
      "value": "-xH/2 - 1",
      "description": "U(1)_X charge of l_L"
    },
    {
      "name": "QeR",
      "parameter_type": "Internal",
      "value": "-xH - 1",
      "description": "U(1)_X charge of e_R"
    },
    {
      "name": "QNR",
      "parameter_type": "Internal",
      "value": "-1",
      "description": "U(1)_X charge of N_R"
    },
    {
      "name": "MPhiX",
      "parameter_type": "Internal",
      "value": "Sqrt[-2*mPhiX2]",
      "description": "Physical PhiX (radial mode) mass [GeV]"
    },
    {
      "name": "MNR",
      "parameter_type": "Internal",
      "indices": ["Generation"],
      "value_rules": [
        {"lhs": "MNR[1]", "rhs": "yN[1]*vPhi/Sqrt[2]"},
        {"lhs": "MNR[2]", "rhs": "yN[2]*vPhi/Sqrt[2]"},
        {"lhs": "MNR[3]", "rhs": "yN[3]*vPhi/Sqrt[2]"}
      ],
      "description": "Majorana neutrino masses m_N = yN v_Phi/sqrt(2)"
    }
  ],
