  "gauge_xi": [
    ["Zp", "GaugeXi[Zp]"]
  ],
  "lagrangian_terms": [
    {
      "name": "LZpkin",
      "expression": "-1/4 FS[Zp, mu, nu] FS[Zp, mu, nu] + 1/2 MZp^2 Zp[mu] Zp[mu]",
      "delayed": true
    },
    {
      "name": "LPhiXkin",
      "expression": "del[PhiXbar, mu] del[PhiX, mu] + 2*I*gX*Zp[mu]*(PhiXbar*del[PhiX, mu] - del[PhiXbar, mu]*PhiX) + 4*gX^2*Zp[mu]*Zp[mu]*PhiXbar*PhiX",
      "delayed": true
    },
    {
      "name": "LPhiXpot",
      "expression": "-mPhiX2*PhiXbar*PhiX - lambdaPhiX*(PhiXbar*PhiX)^2 - lambdaHPhiX*(PhiXbar*PhiX)*(Phibar[ii]*Phi[ii])",
      "delayed": true
    },
    {
      "name": "LNRkin",
      "expression": "I NRbar[ff].Ga[mu].del[NR[ff], mu] - NRbar[ff].MNR[ff].NR[ff]",
      "delayed": true
    },
    {
      "name": "LYukNu",
      "expression": "-(LLbar.Phibar).yNu.NRR + HC[-(LLbar.Phibar).yNu.NRR]",
      "delayed": true
    },
    {
      "name": "LYukMajorana",
      "expression": "-yN[ff] PhiX * bar[CC[NR[ff]]].ProjP.NR[ff] + HC[-yN[ff] PhiX * bar[CC[NR[ff]]].ProjP.NR[ff]]",
      "delayed": true
    },
    {
      "name": "LZpff",
      "expression": "-gX * ( QqL * QLbar[sp, ii, ff, cc].Ga[mu].QL[sp, ii, ff, cc] + QuR * uRbar[sp, ff, cc].Ga[mu].uR[sp, ff, cc] + QdR * dRbar[sp, ff, cc].Ga[mu].dR[sp, ff, cc] + QlL * LLbar[sp, ii, ff].Ga[mu].LL[sp, ii, ff] + QeR * lRbar[sp, ff].Ga[mu].lR[sp, ff] + QNR * NRbar[sp, ff].Ga[mu].NR[sp, ff] ) * Zp[mu]",
      "delayed": true
    },
    {
      "name": "LTotal",
      "expression": "LZpkin + LPhiXkin + LPhiXpot + LNRkin + LYukNu + LYukMajorana + LZpff",
      "delayed": true
    }
  ],
  "raw_preamble": [],
  "raw_blocks": []
}