{
  "model_name": "GeneralU1_gen",
  "info": {
    "authors": ["Arindam Das", "P. S. Bhupal Dev", "Yutaka Hosotani", "Sanjoy Mandal"],
    "version": "1.0",
    "date": "2026-09-24",
    "institutions": ["Kyungpook National University", "Hokkaido University", "Osaka University", "Washington University in St. Louis", "IFIC-Valencia"],
    "emails": ["arindamdas@oia.hokudai.ac.jp", "bdev@wustl.edu", "hosotani@het.phys.sci.osaka-u.ac.jp", "smandal@ific.uv.es"]
  },
  "interaction_order_hierarchy": [["QCD", 1], ["QED", 2], ["NP", 1]],
  "gauge_groups": [],
  "index_decls": [],
  "vevs": [],
  "parameters": [
    {
      "name": "gp",
      "parameter_type": "External",
      "value": "0.4",
      "block_name": "U1XINPUTS",
      "order_block": 1,
      "interaction_order": ["NP", 1],
      "description": "U(1)_X gauge coupling g'"
    },
    {
      "name": "xH",
      "parameter_type": "External",
      "value": "1.",
      "block_name": "U1XINPUTS",
      "order_block": 2,
      "description": "U(1)_X charge parameter x_H (Table 1/2; benchmark default 1)"
    },
    {
      "name": "xPhi",
      "parameter_type": "External",
      "value": "1.",
      "block_name": "U1XINPUTS",
      "order_block": 3,
      "description": "U(1)_X charge parameter x_Phi (fixed to 1 in the paper)"
    },
    {
      "name": "yv",
      "parameter_type": "External",
      "indices": ["Generation", "Generation"],
      "interaction_order": ["NP", 1],
      "value_rules": [
        {"lhs": "yv[1,1]", "rhs": "1.*^-5"},
        {"lhs": "yv[1,2]", "rhs": "0."},
        {"lhs": "yv[1,3]", "rhs": "0."},
        {"lhs": "yv[2,1]", "rhs": "0."},
        {"lhs": "yv[2,2]", "rhs": "1.*^-5"},
        {"lhs": "yv[2,3]", "rhs": "0."},
        {"lhs": "yv[3,1]", "rhs": "0."},
        {"lhs": "yv[3,2]", "rhs": "0."},
        {"lhs": "yv[3,3]", "rhs": "1.*^-5"}
      ],
      "description": "Dirac neutrino Yukawa Y_nu (Eq. LYk fourth term); default gives m_D ~ 1.7 keV benchmark scale"
    },
    {
      "name": "lambdaPhi",
      "parameter_type": "External",
      "value": "0.1",
      "interaction_order": ["NP", 1],
      "block_name": "U1XINPUTS",
      "order_block": 4,
      "description": "Singlet scalar quartic lambda_Phi (Higgs potential)"
    },
    {
      "name": "lambdap",
      "parameter_type": "External",
      "value": "0.01",
      "interaction_order": ["NP", 1],
      "block_name": "U1XINPUTS",
      "order_block": 5,
      "description": "Higgs-singlet portal lambda' (H^dag H)(Phi^dag Phi)"
    }
  ],
  "particles": [
    {
      "spin_type": "V",
      "class_index": 100,
      "class_name": "Zp",
      "self_conjugate": true,
      "mass": {"sym": "MZp", "value": "7500."},
      "width": {"sym": "WZp", "value": "100."},
      "pdg": 9000001,
      "particle_name": "Zp",
      "full_name": "Z prime",
      "propagator_label": "Zp",
      "propagator_type": "Sine",
      "propagator_arrow": "None",
      "quantum_numbers": {}
    },
    {
      "spin_type": "F",
      "class_index": 101,
      "class_name": "NR",
      "self_conjugate": true,
      "indices": ["Generation"],
      "flavor_index": "Generation",
      "class_members": ["NR1", "NR2", "NR3"],
      "mass": {"sym": "MN", "value": "10000."},
      "width": {"massless": true},
      "pdg": [9000011, 9000013, 9000015],
      "particle_name": ["N1", "N2", "N3"],
      "full_name": ["Right-handed neutrino 1", "Right-handed neutrino 2", "Right-handed neutrino 3"],
      "propagator_label": ["NR", "N1", "N2", "N3"],
      "propagator_type": "Straight",
      "propagator_arrow": "None",
      "quantum_numbers": {}
    },
    {
      "spin_type": "S",
      "class_index": 102,
      "class_name": "Sphi",
      "self_conjugate": false,
      "mass": {"sym": "Mphi", "value": "1000."},
      "width": {"massless": true},
      "pdg": 9000021,
      "particle_name": "phi",
      "antiparticle_name": "phibar",
      "full_name": "U(1)_X singlet scalar",
      "propagator_label": "phi",
      "propagator_type": "D",
      "propagator_arrow": "None",
      "quantum_numbers": {}
    }
  ],
  "lagrangian_terms": [
    {
      "name": "LZpkin",
      "delayed": true,
      "expression": "-1/4 FS[Zp, mu, nu] FS[Zp, mu, nu] + 1/2 MZp^2 Zp[mu] Zp[mu]"
    },
    {
      "name": "LPhikin",
      "delayed": true,
      "expression": "DC[Sphibar, mu] DC[Sphi, mu] - Mphi^2 Sphibar Sphi"
    },
    {
      "name": "LNkin",
      "delayed": true,
      "expression": "ExpandIndices[I/2 NRbar.Ga[mu].del[NR, mu] - 1/2 MN NRbar.NR]"
    },
    {
      "name": "LZpQuark",
      "delayed": true,
      "expression": "ExpandIndices[-gp ((xH/6 + xPhi/3) uqbar.Ga[mu].ProjM.uq + (2*xH/3 + xPhi/3) uqbar.Ga[mu].ProjP.uq + (xH/6 + xPhi/3) dqbar.Ga[mu].ProjM.dq + (-xH/3 + xPhi/3) dqbar.Ga[mu].ProjP.dq) Zp[mu]]"
    },
    {
      "name": "LZpLepton",
      "delayed": true,
      "expression": "ExpandIndices[-gp ((-xH/2 - xPhi) lbar.Ga[mu].ProjM.l + (-xH - xPhi) lbar.Ga[mu].ProjP.l) Zp[mu]]"
    },
    {
      "name": "LZpNeutrino",
      "delayed": true,
      "expression": "ExpandIndices[-gp (-xH/2 - xPhi) vlbar.Ga[mu].ProjM.vl Zp[mu]]"
    },
    {
      "name": "LZpNR",
      "delayed": true,
      "expression": "ExpandIndices[-gp (-xPhi) NRbar.Ga[mu].ProjP.NR Zp[mu]]"
    },
    {
      "name": "LZpSphi",
      "delayed": true,
      "expression": "I*2*xPhi*gp*Zp[mu]*(Sphibar del[Sphi, mu] - Sphi del[Sphibar, mu]) + 4*xPhi^2*gp^2*Zp[mu] Zp[mu] Sphibar Sphi"
    },
    {
      "name": "LZpHiggs",
      "delayed": true,
      "expression": "ExpandIndices[I*(xH/2)*gp*Zp[mu]*(Phibar[ii] del[Phi[ii], mu] - Phi[ii] del[Phibar[ii], mu]) + xH^2/4*gp^2*Zp[mu] Zp[mu] Phibar[ii] Phi[ii]]"
    },
    {
      "name": "LYnu",
      "delayed": true,
      "expression": "Module[{yuk}, yuk = ExpandIndices[-LLbar[ii].yv.NR Phibar[jj] Eps[ii, jj]], yuk + HC[yuk]]"
    },
    {
      "name": "LPhiPot",
      "delayed": true,
      "expression": "-lambdaPhi Sphibar Sphi Sphibar Sphi - lambdap Phibar[ii] Phi[ii] Sphibar Sphi"
    },
    {
      "name": "LTotal",
      "delayed": true,
      "expression": "LZpkin + LPhikin + LNkin + LZpQuark + LZpLepton + LZpNeutrino + LZpNR + LZpSphi + LZpHiggs + LYnu + LPhiPot"
    }
  ],
  "raw_preamble": [],
  "raw_blocks": []
}
