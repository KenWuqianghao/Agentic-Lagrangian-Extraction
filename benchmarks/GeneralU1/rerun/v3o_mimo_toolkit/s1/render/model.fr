LZpkin := -1/4 FS[Zp, mu, nu] FS[Zp, mu, nu] + 1/2 MZp^2 Zp[mu] Zp[mu];

LPhikin := DC[Sphibar, mu] DC[Sphi, mu] - Mphi^2 Sphibar Sphi;

LNkin := ExpandIndices[I/2 NRbar.Ga[mu].del[NR, mu] - 1/2 MN NRbar.NR];

LZpQuark := ExpandIndices[-gp ((xH/6 + xPhi/3) uqbar.Ga[mu].ProjM.uq + (2*xH/3 + xPhi/3) uqbar.Ga[mu].ProjP.uq + (xH/6 + xPhi/3) dqbar.Ga[mu].ProjM.dq + (-xH/3 + xPhi/3) dqbar.Ga[mu].ProjP.dq) Zp[mu]];

LZpLepton := ExpandIndices[-gp ((-xH/2 - xPhi) lbar.Ga[mu].ProjM.l + (-xH - xPhi) lbar.Ga[mu].ProjP.l) Zp[mu]];

LZpNeutrino := ExpandIndices[-gp (-xH/2 - xPhi) vlbar.Ga[mu].ProjM.vl Zp[mu]];

LZpNR := ExpandIndices[-gp (-xPhi) NRbar.Ga[mu].ProjP.NR Zp[mu]];

LZpSphi := I*2*xPhi*gp*Zp[mu]*(Sphibar del[Sphi, mu] - Sphi del[Sphibar, mu]) + 4*xPhi^2*gp^2*Zp[mu] Zp[mu] Sphibar Sphi;

LZpHiggs := ExpandIndices[I*(xH/2)*gp*Zp[mu]*(Phibar[ii] del[Phi[ii], mu] - Phi[ii] del[Phibar[ii], mu]) + xH^2/4*gp^2*Zp[mu] Zp[mu] Phibar[ii] Phi[ii]];

LYnu := Module[{yuk}, yuk = ExpandIndices[-LLbar[ii].yv.NR Phibar[jj] Eps[ii, jj]], yuk + HC[yuk]];

LPhiPot := -lambdaPhi Sphibar Sphi Sphibar Sphi - lambdap Phibar[ii] Phi[ii] Sphibar Sphi;

LTotal := LZpkin + LPhikin + LNkin + LZpQuark + LZpLepton + LZpNeutrino + LZpNR + LZpSphi + LZpHiggs + LYnu + LPhiPot;
