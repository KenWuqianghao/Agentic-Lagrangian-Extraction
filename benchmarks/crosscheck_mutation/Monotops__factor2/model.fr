Lphikin := 1/2 del[phi, mu] del[phi, mu] - 1/2 Mphi^2 phi^2;

LVkin := -1/4 FS[V, mu, nu] FS[V, mu, nu] + 1/2 MV^2 V[mu] V[mu];

Lchikin := I chibar.Ga[mu].DC[chi, mu] - Mchi chibar.chi;

Lvphikin := DC[vphibar, mu] DC[vphi, mu] - Mvphi^2 vphibar vphi;

Lvphitkin := DC[vphitbar, mu] DC[vphit, mu] - Mvphit^2 vphitbar vphit;

LXkin := -1/2 FS[Xbar, mu, nu] FS[X, mu, nu] + MX^2 Xbar[mu] X[mu];

Lphiu := 2 (Block[{ff1,ff2,cc}, ExpandIndices[phi a0FC[ff1,ff2] uqbar[ff1,cc].uq[ff2,cc] + phi b0FC[ff1,ff2] uqbar[ff1,cc].Ga[5].uq[ff2,cc]]]);
LVu := Block[{mu,ff1,ff2,cc}, ExpandIndices[V[mu] a1FC[ff1,ff2] uqbar[ff1,cc].Ga[mu].uq[ff2,cc] + V[mu] b1FC[ff1,ff2] uqbar[ff1,cc].Ga[mu].Ga[5].uq[ff2,cc]]];

LvphiDiquark := Block[{cc1,cc2,cc3,ff2,ff3,term}, term = Eps[cc1,cc2,cc3] vphi[cc1] aqSR[ff2,ff3] bar[CC[dq[ff2,cc2]]].dq[ff3,cc3] + Eps[cc1,cc2,cc3] vphi[cc1] bqSR[ff2,ff3] bar[CC[dq[ff2,cc2]]].Ga[5].dq[ff3,cc3]; ExpandIndices[term + HC[term]]];

LvphiChi := Block[{ff,cc,term}, term = vphi[cc] ahalfSR[ff] uqbar[ff,cc].chi + vphi[cc] bhalfSR[ff] uqbar[ff,cc].Ga[5].chi; ExpandIndices[term + HC[term]]];

LvphitDiquark := Block[{cc1,cc2,cc3,ff2,ff3,term}, term = Eps[cc1,cc2,cc3] vphit[cc1] atildeqSR[ff2,ff3] bar[CC[dq[ff2,cc2]]].uq[ff3,cc3] + Eps[cc1,cc2,cc3] vphit[cc1] btildeqSR[ff2,ff3] bar[CC[dq[ff2,cc2]]].Ga[5].uq[ff3,cc3]; ExpandIndices[term + HC[term]]];

LvphitChi := Block[{ff,cc,term}, term = vphit[cc] atildehalfSR[ff] dqbar[ff,cc].chi + vphit[cc] btildehalfSR[ff] dqbar[ff,cc].Ga[5].chi; ExpandIndices[term + HC[term]]];

LXDiquark := Block[{mu,cc1,cc2,cc3,ff2,ff3,term}, term = Eps[cc1,cc2,cc3] X[mu,cc1] aqVR[ff2,ff3] bar[CC[dq[ff2,cc2]]].Ga[mu].dq[ff3,cc3] + Eps[cc1,cc2,cc3] X[mu,cc1] bqVR[ff2,ff3] bar[CC[dq[ff2,cc2]]].Ga[mu].Ga[5].dq[ff3,cc3]; ExpandIndices[term + HC[term]]];

LXChi := Block[{mu,ff,cc,term}, term = X[mu,cc] ahalfVR[ff] uqbar[ff,cc].Ga[mu].chi + X[mu,cc] bhalfVR[ff] uqbar[ff,cc].Ga[mu].Ga[5].chi; ExpandIndices[term + HC[term]]];

LTotal := Lphikin + LVkin + Lchikin + Lvphikin + Lvphitkin + LXkin + Lphiu + LVu + LvphiDiquark + LvphiChi + LvphitDiquark + LvphitChi + LXDiquark + LXChi;
