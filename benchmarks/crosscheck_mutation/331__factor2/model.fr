LZp := 2 (Block[{mu,nu}, -1/4 FS[Zp,mu,nu] FS[Zp,mu,nu] + 1/2 MZp^2 Zp[mu] Zp[mu]]);
LYp := Block[{mu,nu}, -1/2 FS[Ypbar,mu,nu] FS[Yp,mu,nu] + MYp^2 Ypbar[mu] Yp[mu]];

LVp := Block[{mu,nu}, -1/2 FS[Vpbar,mu,nu] FS[Vp,mu,nu] + MVp^2 Vpbar[mu] Vp[mu]];

LDQ := Block[{mu}, I DQbar.Ga[mu].DC[DQ,mu] - MDQ DQbar.DQ];

LSQ := Block[{mu}, I SQbar.Ga[mu].DC[SQ,mu] - MSQ SQbar.SQ];

LTQ := Block[{mu}, I TQbar.Ga[mu].DC[TQ,mu] - MTQ TQbar.TQ];

LEL := Block[{mu}, I ELbar.Ga[mu].DC[EL,mu] - MEE Eebar.Ee - MEM Emubar.Emu - MET Etaubar.Etau];

LH2 := Block[{mu}, 1/2 del[H2,mu] del[H2,mu] - 1/2 MH2^2 H2^2];

LH3 := Block[{mu}, 1/2 del[H3,mu] del[H3,mu] - 1/2 MH3^2 H3^2];

LH0 := Block[{mu}, 1/2 del[H0,mu] del[H0,mu] - 1/2 MH0^2 H0^2];

LHpm := Block[{mu}, DC[Hpmbar,mu] DC[Hpm,mu] - MHpm^2 Hpmbar Hpm];

LHQY := Block[{mu}, DC[HQYbar,mu] DC[HQY,mu] - MHQY^2 HQYbar HQY];

LHQV := Block[{mu}, DC[HQVbar,mu] DC[HQV,mu] - MHQV^2 HQVbar HQV];

LNPcc := Block[{mu}, (gw/Sqrt[2]) (ubar.Ga[mu].ProjM.DQ Yp[mu] + cbar.Ga[mu].ProjM.SQ Yp[mu] + dbar.Ga[mu].ProjM.DQ Vp[mu] + sbar.Ga[mu].ProjM.SQ Vp[mu]) + HC[(gw/Sqrt[2]) (ubar.Ga[mu].ProjM.DQ Yp[mu] + cbar.Ga[mu].ProjM.SQ Yp[mu] + dbar.Ga[mu].ProjM.DQ Vp[mu] + sbar.Ga[mu].ProjM.SQ Vp[mu])]];

LTotal := LZp + LYp + LVp + LDQ + LSQ + LTQ + LEL + LH2 + LH3 + LH0 + LHpm + LHQY + LHQV + LNPcc;
