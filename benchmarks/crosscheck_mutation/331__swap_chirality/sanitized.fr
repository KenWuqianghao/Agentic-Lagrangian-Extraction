  k == {
    ParameterType -> External,
    Value -> 1.,
    BlockName -> NPINPUTS,
    OrderBlock -> 5,
    Description -> ""
  },
  lam3 == {
    ParameterType -> External,
    Value -> 0.1,
    BlockName -> NPINPUTS,
    OrderBlock -> 6,
    InteractionOrder -> {NP, 1},
    Description -> ""
  },
  lampr12 == {
    ParameterType -> External,
    Value -> 0.1,
    BlockName -> NPINPUTS,
    OrderBlock -> 7,
    InteractionOrder -> {NP, 1},
    Description -> ""
  },
  lampr23 == {
    ParameterType -> External,
    Value -> 0.1,
    BlockName -> NPINPUTS,
    OrderBlock -> 8,
    InteractionOrder -> {NP, 1},
    Description -> ""
  },
  lampr13 == {
    ParameterType -> External,
    Value -> 0.1,
    BlockName -> NPINPUTS,
    OrderBlock -> 9,
    InteractionOrder -> {NP, 1},
    Description -> ""
  },
  v2 == {
    ParameterType -> Internal,
    Value -> Sqrt[vev^2 - v1^2],
    Description -> ""
  },
  f == {
    ParameterType -> Internal,
    Value -> k*v3,
    Description -> ""
  },
  MZp == {
    ParameterType -> Internal,
    Value -> Sqrt[(gw^2 + beta^2*gX^2)*v3^2/6],
    Description -> ""
  },
  MYp == {
    ParameterType -> Internal,
    Value -> Sqrt[gw^2*(v3^2+v2^2)/4],
    Description -> ""
  },
  MVp == {
    ParameterType -> Internal,
    Value -> Sqrt[gw^2*(v3^2+v1^2)/4],
    Description -> ""
  },
  MH2 == {
    ParameterType -> Internal,
    Value -> Sqrt[(vev^2/(v1*v2))*f*v3],
    Description -> ""
  },
  MH3 == {
    ParameterType -> Internal,
    Value -> Sqrt[2*lam3*v3^2],
    Description -> ""
  },
  MH0 == {
    ParameterType -> Internal,
    Value -> Sqrt[(v1*v2/v3 + v1*v3/v2 + v2*v3/v1)*f],
    Description -> ""
  },
  MHpm == {
    ParameterType -> Internal,
    Value -> Sqrt[(2*f*v3 + lampr12*v1*v2)*vev^2/(2*v1*v2)],
    Description -> ""
  },
  MHQY == {
    ParameterType -> Internal,
    Value -> Sqrt[(2*f*v1 + lampr23*v2*v3)*(v2^2+v3^2)/(2*v2*v3)],
    Description -> ""
  },
  MHQV == {
    ParameterType -> Internal,
    Value -> Sqrt[(2*f*v2 + lampr13*v1*v3)*(v1^2+v3^2)/(2*v1*v3)],
    Description -> ""
  }
};

