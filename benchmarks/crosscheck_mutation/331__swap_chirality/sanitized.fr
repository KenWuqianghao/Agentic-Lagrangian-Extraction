


M$ModelName = "ANON-MODEL";


M$InteractionOrderHierarchy = {{QCD, 1}, {QED, 2}, {NP, 1}};

M$Parameters = {
  beta == {
    ParameterType -> External,
    Value -> 0.5773502691896258,
    BlockName -> NPINPUTS,
    OrderBlock -> 1,
    Description -> ""
  },
  gX == {
    ParameterType -> External,
    Value -> 0.5,
    BlockName -> NPINPUTS,
    OrderBlock -> 2,
    InteractionOrder -> {NP, 1},
    Description -> ""
