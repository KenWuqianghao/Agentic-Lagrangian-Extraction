LWpKin := Block[{mu, nu}, ExpandIndices[-1/2 FS[Wpbar, mu, nu] FS[Wp, mu, nu] + MWp^2 Wpbar[mu] Wp[mu]]];

LNRKin := Block[{mu, sp1, sp2, ff}, ExpandIndices[I nRbar[sp1, ff].Ga[mu, sp1, sp2].del[nR[sp2, ff], mu] - MNR[ff] nRbar[sp1, ff].nR[sp1, ff]]];

LWpQuarks := Block[{mu, sp1, sp2, sp3, ff1, ff2, cc, LWpq}, LWpq = 1/Sqrt[2] Wp[mu] uqbar[sp1, ff1, cc].Ga[mu, sp1, sp2].(CRq[ff1, ff2] ProjP[sp2, sp3] + CLq[ff1, ff2] ProjM[sp2, sp3]).dq[sp3, ff2, cc]; ExpandIndices[LWpq + HC[LWpq]]];

LWpLeptons := Block[{mu, sp1, sp2, sp3, ff1, ff2, LWpl}, LWpl = 1/Sqrt[2] Wp[mu] (CLl[ff1, ff2] vlbar[sp1, ff1].Ga[mu, sp1, sp2].ProjM[sp2, sp3].l[sp3, ff2] + CRl[ff1, ff2] nRbar[sp1, ff1].Ga[mu, sp1, sp2].ProjP[sp2, sp3].l[sp3, ff2]); ExpandIndices[LWpl + HC[LWpl]]];

LWprime := LWpKin + LNRKin + LWpQuarks + LWpLeptons;
