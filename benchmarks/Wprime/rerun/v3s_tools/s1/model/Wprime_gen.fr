(* Wprime charged current, hep-ph/0207290 Eq.(4): (1/Sqrt[2]) fbar_i Ga[mu] (gR Exp[I omega] Cos[zeta] VR PR + gL Sin[zeta] VL PL) f_j Wp[mu] + H.c. *)
currWp := Block[{mu}, ExpandIndices[ 1/Sqrt[2] ( gR*Exp[I*omega]*Cos[zeta]*uqbar.VqR.Ga[mu].ProjP.dq*Wp[mu] + gL*Sin[zeta]*uqbar.VqL.Ga[mu].ProjM.dq*Wp[mu] + gR*Exp[I*omega]*Cos[zeta]*NRbar.VlR.Ga[mu].ProjP.l*Wp[mu] + gL*Sin[zeta]*vlbar.VlL.Ga[mu].ProjM.l*Wp[mu] ) ] ];

LWpKin := Block[{mu,nu}, ExpandIndices[ -1/2 FS[Wpbar,mu,nu] FS[Wp,mu,nu] + MWp^2 Wpbar[mu] Wp[mu] ] ];;

LNRKin := Block[{mu}, ExpandIndices[ I NRbar.Ga[mu].DC[NR,mu] - MNR NRbar.NR ] ];;

LWpInt := currWp + HC[currWp];;

LTotal := LWpKin + LNRKin + LWpInt;;
