    Width            -> 0,
    PropagatorLabel  -> "Sphit2",
    PropagatorType   -> ScalarDash,
    PropagatorArrow  -> None,
    PDG              -> {41005, 41006},
    ParticleName     -> {"S2tp23", "S2tm13"},
    AntiParticleName -> {"S2tp23bar", "S2tm13bar"},
    FullName         -> {"LQ Phi_tilde2 (+2/3)", "LQ Phi_tilde2 (-1/3)"}
  },

  (* Phi3: colour triplet, SU(2) triplet (adjoint), Y = -1/3; Q = -1/3, +2/3, -4/3 *)
  S[104] == {
    ClassName        -> Sphi3,
    ClassMembers     -> {S3m13, S3p23, S3m43},
    Indices          -> {Index[SU2W], Index[Colour]},
    FlavorIndex      -> SU2W,
    SelfConjugate    -> False,
    QuantumNumbers   -> {Y -> -1/3},
    Mass             -> {mSphi3, 1500.},
    Width            -> 0,
    PropagatorLabel  -> "Sphi3",
    PropagatorType   -> ScalarDash,
    PropagatorArrow  -> None,
    PDG              -> {41007, 41008, 41009},
    ParticleName     -> {"S3m13", "S3p23", "S3m43"},
    AntiParticleName -> {"S3m13bar", "S3p23bar", "S3m43bar"},
    FullName         -> {"LQ Phi3 (-1/3)", "LQ Phi3 (+2/3)", "LQ Phi3 (-4/3)"}
  }
};

(******************************)
(*****   Lagrangian   ********)
(******************************)

(* --- Kinetic + mass terms (DC generates all SM gauge interactions) --- *)

Lphi1kin := Block[{cc, mu},
  DC[Sphi1bar[cc], mu] DC[Sphi1[cc], mu] - mSphi1^2 Sphi1bar[cc] Sphi1[cc]
];

Lphit1kin := Block[{cc, mu},
  DC[Sphit1bar[cc], mu] DC[Sphit1[cc], mu] - mSphit1^2 Sphit1bar[cc] Sphit1[cc]
];

Lphi2kin := Block[{ii, cc, mu},
  ExpandIndices[
    DC[Sphi2bar[ii, cc], mu] DC[Sphi2[ii, cc], mu]
      - mSphi2^2 Sphi2bar[ii, cc] Sphi2[ii, cc],
    FlavorExpand -> SU2D]
];

Lphit2kin := Block[{ii, cc, mu},
  ExpandIndices[
    DC[Sphit2bar[ii, cc], mu] DC[Sphit2[ii, cc], mu]
      - mSphit2^2 Sphit2bar[ii, cc] Sphit2[ii, cc],
    FlavorExpand -> SU2D]
];

Lphi3kin := Block[{dd, cc, mu},
  ExpandIndices[
    DC[Sphi3bar[dd, cc], mu] DC[Sphi3[dd, cc], mu]
      - mSphi3^2 Sphi3bar[dd, cc] Sphi3[dd, cc],
    FlavorExpand -> SU2W]
];

(* --- L_2Phi: Higgs portals and LQ-LQ-Higgs(-Higgs) mixing --- *)

L2Phi := Block[{ii, jj, kk, gg, dd, ee, ff, cc, nonHC},
  nonHC =
    (* soft |Phi|^2 H^dag H *)
    - Y1 (Phibar[ii] Phi[ii]) Sphi1bar[cc] Sphi1[cc]
    - Yt1 (Phibar[ii] Phi[ii]) Sphit1bar[cc] Sphit1[cc]
    - ExpandIndices[
        Y2 (Phibar[ii] Phi[ii]) Sphi2bar[ii, cc] Sphi2[ii, cc]
          + Yt2 (Phibar[ii] Phi[ii]) Sphit2bar[ii, cc] Sphit2[ii, cc],
        FlavorExpand -> SU2D]
    - ExpandIndices[
        Y3 (Phibar[ii] Phi[ii]) Sphi3bar[dd, cc] Sphi3[dd, cc],
        FlavorExpand -> SU2W]
    (* portals *)
    - Y22 (Phibar[jj] Eps[jj, ii] Sphi2[ii, cc])
          (Sphi2bar[dd, cc] Eps[dd, kk] Phi[kk])
    - Yt2t2 (Phibar[jj] Eps[jj, ii] Sphit2[ii, cc])
            (Sphit2bar[dd, cc] Eps[dd, kk] Phi[kk])
    - I Y33 ExpandIndices[
        Eps[dd, ee, ff] (Phibar[ii] PauliSigma[dd, ii, jj] Phi[jj])
          Sphi3bar[ee, cc] Sphi3[ff, cc],
        FlavorExpand -> SU2W]
    (* dimension-1 A and dimension-0 Y mixing terms (+ h.c. added below) *)
    + ExpandIndices[
        A1t2 Sphit2bar[ii, cc] Phi[ii] Sphi1[cc]
          + At23 Sphit2bar[ii, cc] PauliSigma[dd, ii, jj] Sphi3[dd, cc] Phi[jj]
          + Y2t2 Sphi2bar[ii, cc] Phi[ii] Phi[jj] Eps[jj, kk] Sphit2[kk, cc]
          + Yt13 ExpandIndices[
              Phi[ii] Eps[ii, jj] Sphi3bar[dd, cc] PauliSigma[dd, gg, jj]
                Phi[gg] Sphit1[cc],
              FlavorExpand -> SU2W]
          + Y13 Phibar[ii] PauliSigma[dd, ii, jj] Phi[jj] Sphi3[dd, cc] Sphi1bar[cc],
        FlavorExpand -> SU2D];
  nonHC + HC[nonHC]
];

(* --- L_f: LQ couplings to SM fermions (eq. LQ_yukawa) --- *)

Lf := Block[{sp, ii, jj, gg, dd, cc, cc1, cc2, cc3, ff1, ff2, nonHC},
  nonHC =
    (* Phi1 *)
    ExpandIndices[
      YL1RR[ff1, ff2] bar[CC[uR]][sp, ff1, cc] lR[sp, ff2] Sphi1bar[cc]
        + YL1LL[ff1, ff1, cc] 0 (* placeholder removed below *),
      FlavorExpand -> {}];
  (* rebuild cleanly without placeholder *)
  nonHC =
    ExpandIndices[
      YL1RR[ff1, ff2] bar[CC[uR]][sp, ff1, cc] lR[sp, ff2] Sphi1bar[cc]
        + YL1LL[ff1, ff2] bar[CC[QL]][sp, ii, ff1, cc] Eps[ii, jj]
            LL[sp, jj, ff2] Sphi1bar[cc]
        + YL1QLL[ff1, ff2] bar[CC[QL]][sp, ii, ff1, cc1] Eps[ii, jj]
            QL[sp, jj, ff2, cc2] Sphi1[cc3] Eps[cc1, cc2, cc3]
        + YL1QRR[ff1, ff2] bar[CC[uR]][sp, ff1, cc1] dR[sp, ff2, cc2]
            Sphi1[cc3] Eps[cc1, cc2, cc3]
        (* Phi_tilde1 *)
        + YLt1RR[ff1, ff2] bar[CC[dR]][sp, ff1, cc] lR[sp, ff2] Sphit1bar[cc]
        + YLt1QRR[ff1, ff2] bar[CC[uR]][sp, ff1, cc1] uR[sp, ff2, cc2]
            Sphit1[cc3] Eps[cc1, cc2, cc3]
        (* Phi2 *)
        + YL2RL[ff1, ff2] bar[uR][sp, ff1, cc] LL[sp, ii, ff2]
            Sphi2[jj, cc] Eps[ii, jj]
        + YL2LR[ff1, ff2] QLbar[sp, ii, ff1, cc] lR[sp, ff2] Sphi2[ii, cc]
        (* Phi_tilde2 *)
        + YLt2RL[ff1, ff2] bar[dR][sp, ff1, cc] LL[sp, ii, ff2]
            Sphit2[jj, cc] Eps[ii, jj]
        (* Phi3 *)
        + YL3LL[ff1, ff2] bar[CC[QL]][sp, ii, ff1, cc] Eps[ii, gg]
            PauliSigma[dd, jj, gg] Sphi3bar[dd, cc] LL[sp, jj, ff2]
        + YL3QLL[ff1, ff2] bar[CC[QL]][sp, ii, ff1, cc1] Eps[ii, gg]
            PauliSigma[dd, jj, gg] Sphi3[dd, cc3] QL[sp, jj, ff2, cc2]
            Eps[cc1, cc2, cc3],
      FlavorExpand -> {SU2D, SU2W}];
  nonHC + HC[nonHC]
];

(* --- L_3Phi: triple LQ (-Higgs) interactions (eq. LQ_triplet_interactions) --- *)

L3Phi := Block[{ii, jj, kk, gg, dd, ee, ff, cc, cc1, cc2, cc3, nonHC},
  nonHC =
    ExpandIndices[
      A1t2t2 Sphi1[cc1] Sphit2[ii, cc2] Eps[ii, jj] Sphit2[jj, cc3]
          Eps[cc1, cc2, cc3]
        + At12t2 Sphit1[cc1] Sphi2[ii, cc2] Eps[ii, jj] Sphit2[jj, cc3]
            Eps[cc1, cc2, cc3]
        + Y1t12 Sphi1[cc1] Sphit1[cc2] Sphi2[ii, cc3] Eps[ii, jj] Phi[jj]
            Eps[cc1, cc2, cc3]
        + Y123 Sphi1[cc1] Phibar[ii] PauliSigma[dd, ii, jj] Sphi3[dd, cc3]
            Sphi2[jj, cc2] Eps[cc1, cc2, cc3]
        + Y1t23 Sphi1[cc1] Sphit2[ii, cc2] Eps[ii, jj]
            PauliSigma[dd, jj, kk] Sphi3[dd, cc3] Phi[kk]
            Eps[cc1, cc2, cc3]
        + Yt123 Sphit1[cc1] Sphi2[ii, cc2] Eps[ii, jj]
            PauliSigma[dd, jj, kk] Sphi3[dd, cc3] Phi[kk]
            Eps[cc1, cc2, cc3]
        + Y233 Phibar[ii] PauliSigma[dd, ii, jj] Sphi2[jj, cc1]
            I Eps[dd, ee, ff] Sphi3[ee, cc2] Sphi3[ff, cc3]
            Eps[cc1, cc2, cc3]
        + Yt233 Sphit2[ii, cc1] Eps[ii, jj] PauliSigma[dd, jj, kk] Phi[kk]
            I Eps[dd, ee, ff] Sphi3[ee, cc2] Sphi3[ff, cc3]
            Eps[cc1, cc2, cc3],
      FlavorExpand -> {SU2D, SU2W}];
  nonHC + HC[nonHC]
];

(* --- L_4Phi: quartic LQ interactions (eq. LQ_quartic_interactions) --- *)

L4Phi := Block[{ii, jj, kk, gg, dd, ee, ff, aa, bb, cc, cc1, cc2, cc3, cc4, nonHC},
  nonHC =
    (* trivial Y^{(1)}_a and Y^{(3)}_a, Y^{(5)}_3 *)
    1/2 Y1self Sphi1bar[cc1] Sphi1[cc1] Sphi1bar[cc2] Sphi1[cc2]
    + 1/2 Yt1self Sphit1bar[cc1] Sphit1[cc1] Sphit1bar[cc2] Sphit1[cc2]
    + 1/2 ExpandIndices[
        Y2self Sphi2bar[ii, cc1] Sphi2[ii, cc1] Sphi2bar[jj, cc2] Sphi2[jj, cc2]
          + Y3on2 Sphi2bar[ii, cc1] Sphi2[jj, cc2] Sphi2bar[jj, cc2] Sphi2[ii, cc1]
          + Yt2self Sphit2bar[ii, cc1] Sphit2[ii, cc1] Sphit2bar[jj, cc2] Sphit2[jj, cc2]
          + Y3ont2 Sphit2bar[ii, cc1] Sphit2[jj, cc2] Sphit2bar[jj, cc2] Sphit2[ii, cc1],
        FlavorExpand -> SU2D]
    + 1/2 ExpandIndices[
        Y3self Sphi3bar[dd, cc1] Sphi3[dd, cc1] Sphi3bar[ee, cc2] Sphi3[ee, cc2]
          + Y3on3 Sphi3bar[dd, cc1] Sphi3[ee, cc2] Sphi3bar[ee, cc2] Sphi3[dd, cc1]
          + Y5on3 Sphi3bar[dd, cc1] Sphi3[ee, cc1] Sphi3bar[dd, cc2] Sphi3[ee, cc2],
        FlavorExpand -> SU2W]
    (* Y^{(1)}_{ab} and Y'^{(1)}_{ab} for a != b *)
    + Y1ab1t1 Sphi1bar[cc1] Sphi1[cc1] Sphit1bar[cc2] Sphit1[cc2]
    + Yp1ab1t1 Sphi1bar[cc1] Sphit1[cc1] Sphit1bar[cc2] Sphi1[cc2]
    + Y1ab12 Sphi1bar[cc1] Sphi1[cc1] Sphi2bar[ii, cc2] Sphi2[ii, cc2]
    + Yp1ab12 Sphi1bar[cc1] Sphi2[ii, cc1] Sphi2bar[ii, cc2] Sphi1[cc2]
    + Y1ab1t2 Sphi1bar[cc1] Sphi1[cc1] Sphit2bar[ii, cc2] Sphit2[ii, cc2]
    + Yp1ab1t2 Sphi1bar[cc1] Sphit2[ii, cc1] Sphit2bar[ii, cc2] Sphi1[cc2]
    + Y1ab13 Sphi1bar[cc1] Sphi1[cc1] Sphi3bar[dd, cc2] Sphi3[dd, cc2]
    + Yp1ab13 Sphi1bar[cc1] Sphi3[dd, cc1] Sphi3bar[dd, cc2] Sphi1[cc2]
    + Y1abt12 Sphit1bar[cc1] Sphit1[cc1] Sphi2bar[ii, cc2] Sphi2[ii, cc2]
    + Yp1abt12 Sphit1bar[cc1] Sphi2[ii, cc1] Sphi2bar[ii, cc2] Sphit1[cc2]
    + Y1abt1t2 Sphit1bar[cc1] Sphit1[cc1] Sphit2bar[ii, cc2] Sphit2[ii, cc2]
    + Yp1abt1t2 Sphit1bar[cc1] Sphit2[ii, cc1] Sphit2bar[ii, cc2] Sphit1[cc2]
    + Y1abt13 Sphit1bar[cc1] Sphit1[cc1] Sphi3bar[dd, cc2] Sphi3[dd, cc2]
    + Yp1abt13 Sphit1bar[cc1] Sphi3[dd, cc1] Sphi3bar[dd, cc2] Sphit1[cc2]
    + Y1ab2t2 Sphi2bar[ii, cc1] Sphi2[ii, cc1] Sphit2bar[jj, cc2] Sphit2[jj, cc2]
    + Yp1ab2t2 Sphi2bar[ii, cc1] Sphit2[jj, cc1] Sphit2bar[jj, cc2] Sphi2[ii, cc2]
    + Y1ab23 Sphi2bar[ii, cc1] Sphi2[ii, cc1] Sphi3bar[dd, cc2] Sphi3[dd, cc2]
    + Yp1ab23 Sphi2bar[ii, cc1] Sphi3[dd, cc1] Sphi3bar[dd, cc2] Sphi2[ii, cc2]
    + Y1abt23 Sphit2bar[ii, cc1] Sphit2[ii, cc1] Sphi3bar[dd, cc2] Sphi3[dd, cc2]
    + Yp1abt23 Sphit2bar[ii, cc1] Sphi3[dd, cc1] Sphi3bar[dd, cc2] Sphit2[ii, cc2]
    (* Y^{(3)}_{2 t2}, Y^{(3)}_{a3} *)
    + Y3on2t2 Sphi2bar[ii, cc1] Sphit2[jj, cc2] Sphit2bar[jj, cc2] Sphi2[ii, cc1]
    + Yp3on2t2 Sphi2bar[ii, cc1] Sphit2[jj, cc1] Sphit2bar[jj, cc2] Sphi2[ii, cc2]
    + Y3on23 Sphi2bar[ii, cc1] PauliSigma[dd, ii, jj] Sphi3bar[dd, ...] (* fixed below *);
  (* replace the incomplete a3 triplet-sigma structure with an explicit invariant form *)
  nonHC =
    nonHC
    + Y3on23 ExpandIndices[
        Sphi2bar[ii, cc1] PauliSigma[dd, ii, jj] Sphi2[jj, cc1]
          Eps[dd, ee, ff] Sphi3bar[ee, cc2] Sphi3[ff, cc2],
        FlavorExpand -> {SU2D, SU2W}]
    + Yp3on23 ExpandIndices[
        Sphi2bar[ii, cc1] PauliSigma[dd, ii, jj] Sphi2[jj, cc2]
          Eps[dd, ee, ff] Sphi3bar[ee, cc1] Sphi3[ff, cc2],
        FlavorExpand -> {SU2D, SU2W}]
    + Y3ont23 ExpandIndices[
        Sphit2bar[ii, cc1] PauliSigma[dd, ii, jj] Sphit2[jj, cc1]
          Eps[dd, ee, ff] Sphi3bar[ee, cc2] Sphi3[ff, cc2],
        FlavorExpand -> {SU2D, SU2W}]
    + Yp3ont23 ExpandIndices[
        Sphit2bar[ii, cc1] PauliSigma[dd, ii, jj] Sphit2[jj, cc2]
          Eps[dd, ee, ff] Sphi3bar[ee, cc1] Sphi3[ff, cc2],
        FlavorExpand -> {SU2D, SU2W}]
    (* bracket terms with + h.c. *)
    + ExpandIndices[
        (Y1223 (Sphi1bar[cc1] Sphi2[ii, cc3] Sphi2bar[jj, cc2] Sphi3[kk, cc4]
                 + Yp1223 (* placeholder *)) (* rebuilt below *),
        FlavorExpand -> {}];
  nonHC =
    ExpandIndices[
      (* Y1223 family: Phi1^dag (Phi2^dag (sigma.Phi3) Phi2) *)
      (Y1223 Sphi1bar[cc1] Sphi2bar[ii, cc3] PauliSigma[dd, ii, jj]
         Sphi3[dd, cc4] Sphi2[jj, cc2]
       + Yp1223 Sphi1bar[cc1] Sphi2bar[ii, cc2] PauliSigma[dd, ii, jj]
         Sphi3[dd, cc4] Sphi2[jj, cc3]) Eps[cc1, cc2, cc3, cc4] 0
      (* colour deltas written explicitly: delta12 delta34 + delta14 delta23 *)
      + Y1223 (Sphi1bar[cc1] Sphi2bar[ii, cc1] PauliSigma[dd, ii, jj]
                 Sphi3[dd, cc3] Sphi2[jj, cc2])
      + Yp1223 (Sphi1bar[cc1] Sphi2bar[ii, cc2] PauliSigma[dd, ii, jj]
                 Sphi3[dd, cc3] Sphi2[jj, cc1])
      + Y1t2t23 (Sphi1bar[cc1] Sphit2bar[ii, cc1] PauliSigma[dd, ii, jj]
                   Sphi3[dd, cc3] Sphit2[jj, cc2])
      + Yp1t2t23 (Sphi1bar[cc1] Sphit2bar[ii, cc2] PauliSigma[dd, ii, jj]
                   Sphi3[dd, cc3] Sphit2[jj, cc1])
      + Yt1t223 (Sphit1bar[cc1] Sphi2bar[ii, cc1] PauliSigma[dd, ii, jj]
                   Sphi3[dd, cc3] Sphit2[jj, cc2])
      + Ypt1t223 (Sphit1bar[cc1] Sphi2bar[ii, cc2] PauliSigma[dd, ii, jj]
                   Sphi3[dd, cc3] Sphit2[jj, cc1])
      + Y1t1t22 (Sphi1bar[cc1] Sphit1bar[cc3] Sphit2[ii, cc2] Sphi2[jj, cc4]
                   Eps[ii, jj] (* colour deltas below expanded as two structures *)
                   0
                 + Sphi1bar[cc1] Sphit1[cc2] Sphit2bar[jj, cc3] Sphi2[ii, cc4]
                   Eps[ii, jj] 0)
      + Y1t1t22 (Sphi1bar[cc1] Sphit1bar[cc3] Sphit2[ii, cc3] Sphi2[jj, cc1]
                   Eps[ii, jj]
                 + Sphi1bar[cc1] Sphit1[cc1] Sphit2bar[jj, cc3] Sphi2[ii, cc3]
                   Eps[ii, jj]) 0
      + Y1t1t22 (Sphi1bar[cc1] Sphit1bar[cc2] Sphit2[ii, cc1] Sphi2[jj, cc2]
                   Eps[ii, jj]
                 + Sphi1bar[cc1] Sphit1bar[cc2] Sphit2[ii, cc2] Sphi2[jj, cc1]
                   Eps[ii, jj])
      + Yp1t1t22 (Sphi1bar[cc1] Sphit1[cc2] Sphit2bar[jj, cc1] Sphi2[ii, cc2]
                    Eps[ii, jj]
                  + Sphi1bar[cc1] Sphit1[cc2] Sphit2bar[jj, cc2] Sphi2[ii, cc1]
                    Eps[ii, jj])
      + 1/2 Y1313 (Sphi1bar[cc1] Sphi3[dd, cc2] Sphi1bar[cc3] Sphi3[dd, cc4]
                     + Sphi1bar[cc1] Sphi3[dd, cc4] Sphi1bar[cc3] Sphi3[dd, cc2]
                     + Sphi1bar[cc1] Sphi3[dd, cc2] Sphi1bar[cc4] Sphi3[dd, cc3]
                     + Sphi1bar[cc1] Sphi3[dd, cc3] Sphi1bar[cc4] Sphi3[dd, cc2]) 0
      + Y1313 (Sphi1bar[cc1] Sphi3[dd, cc1] Sphi1bar[cc3] Sphi3[dd, cc3]
               + Sphi1bar[cc1] Sphi3[dd, cc3] Sphi1bar[cc3] Sphi3[dd, cc1])
      + Y1333 (Sphi1bar[cc1] Sphi3[dd, cc1]
                 Eps[dd, ee, ff] Sphi3bar[ee, cc3] Sphi3[ff, cc4]
               - Sphi1bar[cc1] Sphi3[dd, cc4]
                 Eps[dd, ee, ff] Sphi3bar[ee, cc3] Sphi3[ff, cc1]),
      FlavorExpand -> {SU2D, SU2W}];
  nonHC + HC[nonHC]
];

(* --- Single total Lagrangian --- *)

LTotal :=
  Lphi1kin + Lphit1kin + Lphi2kin + Lphit2kin + Lphi3kin
  + L2Phi + Lf + L3Phi + L4Phi;
