(*****************************************************************************************)
(*****   SLQrules_gen: scalar leptoquark add-on on top of SM.fr (arXiv:2105.04844)  *****)
(*****************************************************************************************)

M$ModelName = "SLQrules_gen";

M$Information = {
  Authors      -> {"SLQrules extraction"},
  Version      -> "1.0",
  Date         -> "24. 09. 2026",
  Institutions -> {"extracted from arXiv:2105.04844"},
  Emails       -> {"n/a"},
  URLs         -> "https://arxiv.org/abs/2105.04844"
};

M$InteractionOrderHierarchy = {
  {QCD, 1},
  {QED, 2},
  {NP, 1}
};

