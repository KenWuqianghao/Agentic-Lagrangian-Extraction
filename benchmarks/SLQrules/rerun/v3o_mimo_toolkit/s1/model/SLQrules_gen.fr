Lkin = ExpandIndices[ I*(LQ1bar.Ga[mu].DC[LQ1, mu] + LQ1tbar.Ga[mu].DC[LQ1t, mu] + LQ2bar[ii].Ga[mu].DC[LQ2[ii], mu] + LQ2tbar[ii].Ga[mu].DC[LQ2t[ii], mu] + LQ3bar[II].Ga[mu].DC[LQ3[II], mu]) + DC[S1m13bar, mu] DC[S1m13, mu] - MS1m13^2 S1m13bar S1m13 + DC[R2tm13bar, mu] DC[R2tm13, mu] - MR2tm13^2 R2tm13bar R2tm13 + DC[S3m13bar, mu] DC[S3m13, mu] - MS3m13^2 S3m13bar S3m13 + DC[S2p23bar, mu] DC[S2p23, mu] - MS2p23^2 S2p23bar S2p23 + DC[R2tp23bar, mu] DC[R2tp23, mu] - MR2tp23^2 R2tp23bar R2tp23 + DC[S3p23bar, mu] DC[S3p23, mu] - MS3p23^2 S3p23bar S3p23 + DC[R1tm43bar, mu] DC[R1tm43, mu] - MR1tm43^2 R1tm43bar R1tm43 + DC[S3m43bar, mu] DC[S3m43, mu] - MS3m43^2 S3m43bar S3m43 + DC[S2p53bar, mu] DC[S2p53, mu] - MS2p53^2 S2p53bar S2p53, FlavorExpand -> SU2D];

L2Phi = ExpandIndices[ -Y1 Hbar[ii] H[ii] LQ1bar.LQ1 - Yt1 Hbar[ii] H[ii] LQ1tbar.LQ1t - Y2 Hbar[ii] H[ii] LQ2bar[ii1].LQ2[ii1] - Yt2 Hbar[ii] H[ii] LQ2tbar[ii1].LQ2t[ii1] - Y3 Hbar[ii] H[ii] LQ3bar[II1].LQ3[II1] - Y22 (Hbar[jj] LQ2[ii] Eps[ii, jj])(Hbar[jj1] LQ2[jj2] Eps[jj1, jj2]) - Yt2t2 (Hbar[jj] LQ2t[ii] Eps[ii, jj])(Hbar[jj1] LQ2t[jj2] Eps[jj1, jj2]) - I*Y33 Eps[IIa, IIb, IIc] Hbar[ii] PauliSigma[ii, jj, IIa] H[jj] LQ3bar[IIb] LQ3[IIc] + HC[-A1t2 LQ2tbar[ii] Phi[ii] LQ1 + At23 LQ2tbar[ii] PauliSigma[ii, jj, IIa] LQ3[IIa] Phi[jj] + Y2t2 LQ2bar[ii] Phi[ii] Hbar[jj] LQ2t[kk] Eps[jj, kk] + Yt13 Hbar[jj] LQ3bar[IIa] PauliSigma[IIa, kk, jj1] H[jj1] LQ1t + Y13 Hbar[ii] PauliSigma[ii, jj, IIa] LQ3[IIa] H[jj] LQ1bar], FlavorExpand -> {SU2D, SU2W}];

Lyuk := Block[{sp, sp1, ii, jj, ff1, ff2, cc1, cc2, cc3}, ExpandIndices[ Y1RR[ff1, ff2] bar[CC[uq]][sp, ff1, cc1] l[sp, ff2] LQ1bar[cc1] + Y1LL[ff1, ff2] bar[CC[QL]][sp, ii, ff1, cc1] LL[sp, jj, ff2] Eps[ii, jj] LQ1bar[cc1] + Y1QLL[ff1, ff2] bar[CC[QL]][sp1, ii, ff1, cc1] QL[sp, jj, ff2, cc2] Eps[ii, jj] LQ1[cc3] Eps[cc1, cc2, cc3] + Y1QRR[ff1, ff2] bar[CC[uq]][sp, ff1, cc1] dq[sp, ff2, cc2] LQ1[cc3] Eps[cc1, cc2, cc3] + Yt1RR[ff1, ff2] bar[CC[dq]][sp, ff1, cc1] l[sp, ff2] LQ1tbar[cc1] + Yt1QRR[ff1, ff2] bar[CC[uq]][sp, ff1, cc1] uq[sp, ff2, cc2] LQ1t[cc3] Eps[cc1, cc2, cc3] + Y2RL[ff1, ff2] LQ2[ii] bar[uq][sp, ff1, cc1] LL[sp, jj, ff2] Eps[ii, jj] IndexDelta[cc1, cc1] + Y2LR[ff1, ff2] QLbar[sp, ii, ff1, cc1] l[sp, ff2] LQ2[jj] IndexDelta[cc1, cc1] Eps[ii, jj] + Yt2RL[ff1, ff2] LQ2t[ii] bar[dq][sp, ff1, cc1] LL[sp, jj, ff2] Eps[ii, jj] + Y3LL[ff1, ff2] bar[CC[QL]][sp, ii, ff1, cc1] LL[sp, jj, ff2] LQ3bar[IIa] PauliSigma[IIa, kk, jj] Eps[ii, kk] + Y3QLL[ff1, ff2] bar[CC[QL]][sp1, ii, ff1, cc1] QL[sp, jj, ff2, cc2] LQ3[IIa] PauliSigma[ii, kk, jj] Eps[cc1, cc2, cc3] IndexDelta[cc3, cc3], FlavorExpand -> {SU2D, SU2W}] + HC[ExpandIndices[ Y1RR[ff1, ff2] bar[CC[uq]][sp, ff1, cc1] l[sp, ff2] LQ1bar[cc1] + Y1LL[ff1, ff2] bar[CC[QL]][sp, ii, ff1, cc1] LL[sp, jj, ff2] Eps[ii, jj] LQ1bar[cc1] + Y1QLL[ff1, ff2] bar[CC[QL]][sp1, ii, ff1, cc1] QL[sp, jj, ff2, cc2] Eps[ii, jj] LQ1[cc3] Eps[cc1, cc2, cc3] + Y1QRR[ff1, ff2] bar[CC[uq]][sp, ff1, cc1] dq[sp, ff2, cc2] LQ1[cc3] Eps[cc1, cc2, cc3] + Yt1RR[ff1, ff2] bar[CC[dq]][sp, ff1, cc1] l[sp, ff2] LQ1tbar[cc1] + Yt1QRR[ff1, ff2] bar[CC[uq]][sp, ff1, cc1] uq[sp, ff2, cc2] LQ1t[cc3] Eps[cc1, cc2, cc3] + Y2RL[ff1, ff2] LQ2[ii] bar[uq][sp, ff1, cc1] LL[sp, jj, ff2] Eps[ii, jj] + Y2LR[ff1, ff2] QLbar[sp, ii, ff1, cc1] l[sp, ff2] LQ2[jj] Eps[ii, jj] + Yt2RL[ff1, ff2] LQ2t[ii] bar[dq][sp, ff1, cc1] LL[sp, jj, ff2] Eps[ii, jj] + Y3LL[ff1, ff2] bar[CC[QL]][sp, ii, ff1, cc1] LL[sp, jj, ff2] LQ3bar[IIa] PauliSigma[IIa, kk, jj] Eps[ii, kk] + Y3QLL[ff1, ff2] bar[CC[QL]][sp1, ii, ff1, cc1] QL[sp, jj, ff2, cc2] LQ3[IIa] PauliSigma[ii, kk, jj] Eps[cc1, cc2, cc3], FlavorExpand -> {SU2D, SU2W}]];

L3Phi = HC[A1t2t2 LQ1[cc1] LQ2t[cc2] LQ2t[cc3] Eps[cc1, cc2, cc3] + At12t2 LQ1t[cc1] LQ2[cc2] LQ2t[cc3] Eps[cc1, cc2, cc3] + Y1t12 LQ1[cc1] LQ1t[cc2] LQ2[ii] Phi[jj] Eps[ii, jj] Eps[cc1, cc2, cc3] IndexDelta[cc3, cc3] + Y123 LQ1[cc1] Hbar[ii] PauliSigma[ii, jj, IIa] LQ3[IIa, cc3] LQ2[jj, cc2] Eps[cc1, cc2, cc3] + Y1t23 LQ1[cc1] LQ2t[ii] Phi[jj] Eps[ii, jj1] LQ3[IIa] PauliSigma[jj1, kk, IIa1] H[kk] Eps[IIa, IIa1, IIb] IndexDelta[cc1, cc1] + Yt123 LQ1t[cc1] LQ2[ii] Phi[jj] Eps[ii, jj1] LQ3[IIa] PauliSigma[jj1, kk, IIa1] H[kk] Eps[IIa, IIa1, IIb] IndexDelta[cc1, cc1] + Y233 Hbar[ii] PauliSigma[ii, jj, IIa] LQ2[jj, cc1] LQ3[IIb, cc2] LQ3[IIc, cc3] Eps[IIa, IIb, IIc] Eps[cc1, cc2, cc3] + Yt233 LQ2t[ii] Phi[jj] Eps[ii, jj1] PauliSigma[jj1, kk, IIa] H[kk] LQ3[IIb, cc2] LQ3[IIc, cc3] Eps[IIa, IIb, IIc] Eps[cc1, cc2, cc3] IndexDelta[cc1, cc1], FlavorExpand -> {SU2D, SU2W}];

L4Phi = ExpandIndices[ Yq1a (LQ1bar[cc1] LQ1[cc1])(LQ1bar[cc2] LQ1[cc2]) + Yq1a (LQ1tbar[cc1] LQ1t[cc1])(LQ1tbar[cc2] LQ1t[cc2]) + Yq1a (LQ2bar[ii1, cc1] LQ2[ii1, cc1])(LQ2bar[ii1, cc2] LQ2[ii1, cc2]) + Yq1a (LQ2tbar[ii1, cc1] LQ2t[ii1, cc1])(LQ2tbar[ii1, cc2] LQ2t[ii1, cc2]) + Yq1a (LQ3bar[IIa, cc1] LQ3[IIa, cc1])(LQ3bar[IIa, cc2] LQ3[IIa, cc2]) + Yq3a (LQ2bar[ii1, cc1] LQ2[ii2, cc1])(LQ2bar[ii2, cc2] LQ2[ii1, cc2]) + Yq3a (LQ2tbar[ii1, cc1] LQ2t[ii2, cc1])(LQ2tbar[ii2, cc2] LQ2t[ii1, cc2]) + Yq3a (LQ3bar[IIa, cc1] LQ3[IIb, cc1])(LQ3bar[IIb, cc2] LQ3[IIa, cc2]) + Yq5a3 LQ3bar[IIa, cc1] LQ3[IIb, cc1] LQ3bar[IIa, cc2] LQ3[IIb, cc2] + Yq1ab (LQ1bar[cc1] LQ1[cc2])(LQ1tbar[cc3] LQ1t[cc4]) IndexDelta[cc1, cc2] IndexDelta[cc3, cc4] + Yq1pab (LQ1bar[cc1] LQ1[cc2])(LQ1tbar[cc3] LQ1t[cc4]) IndexDelta[cc1, cc4] IndexDelta[cc2, cc3] + Yq1ab (LQ1bar[cc1] LQ1[cc2])(LQ2bar[ii1, cc3] LQ2[ii1, cc4]) IndexDelta[cc1, cc2] IndexDelta[cc3, cc4] + Yq1pab (LQ1bar[cc1] LQ1[cc2])(LQ2bar[ii1, cc3] LQ2[ii1, cc4]) IndexDelta[cc1, cc4] IndexDelta[cc2, cc3] + Yq1ab (LQ1bar[cc1] LQ1[cc2])(LQ2tbar[ii1, cc3] LQ2t[ii1, cc4]) IndexDelta[cc1, cc2] IndexDelta[cc3, cc4] + Yq1pab (LQ1bar[cc1] LQ1[cc2])(LQ2tbar[ii1, cc3] LQ2t[ii1, cc4]) IndexDelta[cc1, cc4] IndexDelta[cc2, cc3] + Yq1ab (LQ1bar[cc1] LQ1[cc2])(LQ3bar[IIa, cc3] LQ3[IIa, cc4]) IndexDelta[cc1, cc2] IndexDelta[cc3, cc4] + Yq1pab (LQ1bar[cc1] LQ1[cc2])(LQ3bar[IIa, cc3] LQ3[IIa, cc4]) IndexDelta[cc1, cc4] IndexDelta[cc2, cc3] + Yq1ab (LQ1tbar[cc1] LQ1t[cc2])(LQ2bar[ii1, cc3] LQ2[ii1, cc4]) IndexDelta[cc1, cc2] IndexDelta[cc3, cc4] + Yq1pab (LQ1tbar[cc1] LQ1t[cc2])(LQ2bar[ii1, cc3] LQ2[ii1, cc4]) IndexDelta[cc1, cc4] IndexDelta[cc2, cc3] + Yq1ab (LQ1tbar[cc1] LQ1t[cc2])(LQ2tbar[ii1, cc3] LQ2t[ii1, cc4]) IndexDelta[cc1, cc2] IndexDelta[cc3, cc4] + Yq1pab (LQ1tbar[cc1] LQ1t[cc2])(LQ2tbar[ii1, cc3] LQ2t[ii1, cc4]) IndexDelta[cc1, cc4] IndexDelta[cc2, cc3] + Yq1ab (LQ1tbar[cc1] LQ1t[cc2])(LQ3bar[IIa, cc3] LQ3[IIa, cc4]) IndexDelta[cc1, cc2] IndexDelt