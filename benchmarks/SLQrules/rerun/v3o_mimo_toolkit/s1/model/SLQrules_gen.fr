a[cc1, cc2] IndexDelta[cc3, cc4] IndexDelta[cc4, cc5] + Yq1pt223 LQ1tbar[cc1] LQ1t[cc2] LQ2[ii, cc3] PauliSigma[ii, jj, IIa] LQ3[IIa, cc4] LQ2tbar[jj, cc5] IndexDelta[cc1, cc5] IndexDelta[cc2, cc3] IndexDelta[cc3, cc4] + Yq1313 LQ1bar[cc1] LQ1[cc2] LQ3[IIa, cc3] LQ1bar[cc4] LQ1[cc5] LQ3[IIa, cc6] IndexDelta[cc1, cc2] IndexDelta[cc3, cc4] IndexDelta[cc5, cc6] + Yq1333 LQ1bar[cc1] LQ1[cc2] LQ3[IIa, cc3] LQ3bar[IIb, cc4] LQ3[IIc, cc5] Eps[IIa, IIb, IIc] IndexDelta[cc1, cc2] IndexDelta[cc3, cc4] IndexDelta[cc4, cc5], FlavorExpand -> {SU2D, SU2W}];

LTotal := Lkin + L2Phi + Lyuk + L3Phi + L4Phi;
