LkinPhi1 := DC[Phi1bar[cc],mu] DC[Phi1[cc],mu] - M1^2 Phi1bar[cc] Phi1[cc];

LkinPhi1t := DC[Phi1tbar[cc],mu] DC[Phi1t[cc],mu] - M1t^2 Phi1tbar[cc] Phi1t[cc];

LkinPhi2 := DC[Phi2bar[ii,cc],mu] DC[Phi2[ii,cc],mu] - M2[ii]^2 Phi2bar[ii,cc] Phi2[ii,cc];

LkinPhi2t := DC[Phi2tbar[ii,cc],mu] DC[Phi2t[ii,cc],mu] - M2t[ii]^2 Phi2tbar[ii,cc] Phi2t[ii,cc];

LkinPhi3 := DC[Phi3bar[jj,cc],mu] DC[Phi3[jj,cc],mu] - M3[jj]^2 Phi3bar[jj,cc] Phi3[jj,cc];

L2PhiDiag := - c2pY1 Phibar[jj] Phi[jj] Phi1bar[cc] Phi1[cc] - c2pY1t Phibar[jj] Phi[jj] Phi1tbar[cc] Phi1t[cc] - c2pY2 Phibar[jj] Phi[jj] Phi2bar[ii,cc] Phi2[ii,cc] - c2pY2t Phibar[jj] Phi[jj] Phi2tbar[ii,cc] Phi2t[ii,cc] - c2pY3 Phibar[jj] Phi[jj] Phi3bar[kk,cc] Phi3[kk,cc] - c2pY22 (Eps[ii,jj] Phibar[ii] Phi2bar[jj,cc]) (Eps[kk,ll] Phi[kk] Phi2[ll,cc]) - c2pY2t2t (Eps[ii,jj] Phibar[ii] Phi2tbar[jj,cc]) (Eps[kk,ll] Phi[kk] Phi2t[ll,cc]) - I c2pY33 Eps[II,JJ,KK] (2 Ta[II,ii,jj] Phibar[ii] Phi[jj]) Phi3bar[JJ,cc] Phi3[KK,cc];

L2PhiMix := ( - c2pA1t2 Phi2tbar[ii,cc] Phi[ii] Phi1[cc] + c2pAt23 Phi2tbar[ii,cc] 2 Ta[KK,ii,jj] Phi3[KK,cc] Phi[jj] + c2pY2t2 Phi2bar[ii,cc] Phi[ii] Eps[jj,kk] Phi[jj] Phi2t[kk,cc] + c2pY1t3 Eps[ii,jj] Phi[ii] 2 Ta[KK,jj,ll] Phi3bar[KK,cc] Phi[ll] Phi1t[cc] + c2pY13 Phibar[ii] 2 Ta[KK,ii,jj] Phi3[KK,cc] Phi[jj] Phi1bar[cc] ) + HC[ - c2pA1t2 Phi2tbar[ii,cc] Phi[ii] Phi1[cc] + c2pAt23 Phi2tbar[ii,cc] 2 Ta[KK,ii,jj] Phi3[KK,cc] Phi[jj] + c2pY2t2 Phi2bar[ii,cc] Phi[ii] Eps[jj,kk] Phi[jj] Phi2t[kk,cc] + c2pY1t3 Eps[ii,jj] Phi[ii] 2 Ta[KK,jj,ll] Phi3bar[KK,cc] Phi[ll] Phi1t[cc] + c2pY13 Phibar[ii] 2 Ta[KK,ii,jj] Phi3[KK,cc] Phi[jj] Phi1bar[cc] ];

LfPhi1 := ( yf1RR[ff1,ff2] bar[CC[uR[sp,ff1,cc]]].lR[sp,ff2] Phi1bar[cc] + yf1LL[ff1,ff2] Eps[ii,jj] bar[CC[QL[sp,ii,ff1,cc]]].LL[sp,jj,ff2] Phi1bar[cc] + yf1QLL[ff1,ff2] Eps[ii,jj] Eps[cc1,cc2,cc3] bar[CC[QL[sp,ii,ff1,cc1]]].QL[sp,jj,ff2,cc2] Phi1[cc3] + yf1QRR[ff1,ff2] Eps[cc1,cc2,cc3] bar[CC[uR[sp,ff1,cc1]]].dR[sp,ff2,cc2] Phi1[cc3] ) + HC[ yf1RR[ff1,ff2] bar[CC[uR[sp,ff1,cc]]].lR[sp,ff2] Phi1bar[cc] + yf1LL[ff1,ff2] Eps[ii,jj] bar[CC[QL[sp,ii,ff1,cc]]].LL[sp,jj,ff2] Phi1bar[cc] + yf1QLL[ff1,ff2] Eps[ii,jj] Eps[cc1,cc2,cc3] bar[CC[QL[sp,ii,ff1,cc1]]].QL[sp,jj,ff2,cc2] Phi1[cc3] + yf1QRR[ff1,ff2] Eps[cc1,cc2,cc3] bar[CC[uR[sp,ff1,cc1]]].dR[sp,ff2,cc2] Phi1[cc3] ];

LfPhi1t := ( yf1tRR[ff1,ff2] bar[CC[dR[sp,ff1,cc]]].lR[sp,ff2] Phi1tbar[cc] + yf1tQRR[ff1,ff2] Eps[cc1,cc2,cc3] bar[CC[uR[sp,ff1,cc1]]].uR[sp,ff2,cc2] Phi1t[cc3] ) + HC[ yf1tRR[ff1,ff2] bar[CC[dR[sp,ff1,cc]]].lR[sp,ff2] Phi1tbar[cc] + yf1tQRR[ff1,ff2] Eps[cc1,cc2,cc3] bar[CC[uR[sp,ff1,cc1]]].uR[sp,ff2,cc2] Phi1t[cc3] ];

LfPhi2 := ( yf2RL[ff1,ff2] Eps[ii,jj] Phi2[ii,cc] bar[uR[sp,ff1,cc]].LL[sp,jj,ff2] + yf2LR[ff1,ff2] bar[QL[sp,ii,ff1,cc]].lR[sp,ff2] Phi2[ii,cc] ) + HC[ yf2RL[ff1,ff2] Eps[ii,jj] Phi2[ii,cc] bar[uR[sp,ff1,cc]].LL[sp,jj,ff2] + yf2LR[ff1,ff2] bar[QL[sp,ii,ff1,cc]].lR[sp,ff2] Phi2[ii,cc] ];

LfPhi2t := yf2tRL[ff1,ff2] Eps[ii,jj] Phi2t[ii,cc] bar[dR[sp,ff1,cc]].LL[sp,jj,ff2] + HC[ yf2tRL[ff1,ff2] Eps[ii,jj] Phi2t[ii,cc] bar[dR[sp,ff1,cc]].LL[sp,jj,ff2] ];

LfPhi3 := ( yf3LL[ff1,ff2] Eps[ii,kk] 2 Ta[jj,kk,ll] bar[CC[QL[sp,ii,ff1,cc]]].LL[sp,ll,ff2] Phi3bar[jj,cc] + yf3QLL[ff1,ff2] Eps[ii,kk] 2 Ta[jj,kk,ll] Eps[cc1,cc2,cc3] bar[CC[QL[sp,ii,ff1,cc1]]].QL[sp,ll,ff2,cc2] Phi3[jj,cc3] ) + HC[ yf3LL[ff1,ff2] Eps[ii,kk] 2 Ta[jj,kk,ll] bar[CC[QL[sp,ii,ff1,cc]]].LL[sp,ll,ff2] Phi3bar[jj,cc] + yf3QLL[ff1,ff2] Eps[ii,kk] 2 Ta[jj,kk,ll] Eps[cc1,cc2,cc3] bar[CC[QL[sp,ii,ff1,cc1]]].QL[sp,ll,ff2,cc2] Phi3[jj,cc3] ];

L3Phi := ( c3A1t2t2 Eps[cc1,cc2,cc3] Phi1[cc1] Eps[ii,jj] Phi2t[ii,cc2] Phi2t[jj,cc3] + c3At12t2 Eps[cc1,cc2,cc3] Phi1t[cc1] Eps[ii,jj] Phi2[ii,cc2] Phi2t[jj,cc3] + c3Y1t12 Eps[cc1,cc2,cc3] Phi1[cc1] Phi1t[cc2] Eps[ii,jj] Phi2[ii,cc3] Phi[jj] + c3Y123 Eps[cc1,cc2,cc3] Phi1[cc1] Phibar[ii] 2 Ta[KK,ii,jj] Phi3[KK,cc3] Phi2[jj,cc2] + c3Y1t23 Eps[cc1,cc2,cc3] Phi1[cc1] Eps[ii,jj] Phi2t[ii,cc2] 2 Ta[KK,jj,ll] Phi3[KK,cc3] Phi[ll] + c3Yt123 Eps[cc1,cc2,cc3] Phi1t[cc1] Eps[ii,jj] Phi2[ii,cc2] 2 Ta[KK,jj,ll] Phi3[KK,cc3] Phi[ll] + c3Y233 Eps[cc1,cc2,cc3] (Phibar[ii] 2 Ta[II,ii,jj] Phi2[jj,cc1]) I Eps[II,JJ,KK] Phi3[JJ,cc2] Phi3[KK,cc3] + c3Yt233 Eps[cc1,cc2,cc3] (Eps[ii,jj] Phi2t[ii,cc1] 2 Ta[II,jj,kk] Phi[kk]) I Eps[II,JJ,KK] Phi3[JJ,cc2] Phi3[KK,cc3] ) + HC[ c3A1t2t2 Eps[cc1,cc2,cc3] Phi1[cc1] Eps[ii,jj] Phi2t[ii,cc2] Phi2t[jj,cc3] + c3At12t2 Eps[cc1,cc2,cc3] Phi1t[cc1] Eps[ii,jj] Phi2[ii,cc2] Phi2t[jj,cc3] + c3Y1t12 Eps[cc1,cc2,cc3] Phi1[cc1] Phi1t[cc2] Eps[ii,jj] Phi2[ii,cc3] Phi[jj] + c3Y123 Eps[cc1,cc2,cc3] Phi1[cc1] Phibar[ii] 2 Ta[KK,ii,jj] Phi3[KK,cc3] Phi2[jj,cc2] + c3Y1t23 Eps[cc1,cc2,cc3] Phi1[cc1] Eps[ii,jj] Phi2t[ii,cc2] 2 Ta[KK,jj,ll] Phi3[KK,cc3] Phi[ll] + c3Yt123 Eps[cc1,cc2,cc3] Phi1t[cc1] Eps[ii,jj] Phi2[ii,cc2] 2 Ta[KK,jj,ll] Phi3[KK,cc3] Phi[ll] + c3Y233 Eps[cc1,cc2,cc3] (Phibar[ii] 2 Ta[II,ii,jj] Phi2[jj,cc1]) I Eps[II,JJ,KK] Phi3[JJ,cc2] Phi3[KK,cc3] + c3Yt233 Eps[cc1,cc2,cc3] (Eps[ii,jj] Phi2t[ii,cc1] 2 Ta[II,jj,kk] Phi[kk]) I Eps[II,JJ,KK] Phi3[JJ,cc2] Phi3[KK,cc3] ];

L4PhiDiag := 1/2 c4Y1 (Phi1bar[cc1] Phi1[cc1]) (Phi1bar[cc2] Phi1[cc2]) + 1/2 c4Y1t (Phi1tbar[cc1] Phi1t[cc1]) (Phi1tbar[cc2] Phi1t[cc2]) + 1/2 c4Y2 (Phi2bar[ii,cc1] Phi2[ii,cc1]) (Phi2bar[jj,cc2] Phi2[jj,cc2]) + 1/2 c4Y2t (Phi2tbar[ii,cc1] Phi2t[ii,cc1]) (Phi2tbar[jj,cc2] Phi2t[jj,cc2]) + 1/2 c4Y3 (Phi3bar[kk,cc1] Phi3[kk,cc1]) (Phi3bar[ll,cc2] Phi3[ll,cc2]) + 1/2 c4Y3_2 (Phi2bar[ii,cc1] Phi2[ii,cc2]) (Phi2bar[jj,cc2] Phi2[jj,cc1]) + 1/2 c4Y3_2t (Phi2tbar[ii,cc1] Phi2t[ii,cc2]) (Phi2tbar[jj,cc2] Phi2t[jj,cc1]) + 1/2 c4Y3_3 (Phi3bar[kk,cc1] Phi3[kk,cc2]) (Phi3bar[ll,cc2] Phi3[ll,cc1]) + 1/2 c4Y5_3 (Phi3bar[II,cc1] Phi3[JJ,cc1]) (Phi3bar[II,cc2] Phi3[JJ,cc2]);

L4PhiPair := c4Y_11t (Phi1bar[cc1] Phi1[cc1]) (Phi1tbar[cc2] Phi1t[cc2]) + c4Yp_11t (Phi1bar[cc1] Phi1[cc2]) (Phi1tbar[cc2] Phi1t[cc1]) + c4Y_12 (Phi1bar[cc1] Phi1[cc1]) (Phi2bar[ii,cc2] Phi2[ii,cc2]) + c4Yp_12 (Phi1bar[cc1] Phi1[cc2]) (Phi2bar[ii,cc2] Phi2[ii,cc1]) + c4Y_12t (Phi1bar[cc1] Phi1[cc1]) (Phi2tbar[ii,cc2] Phi2t[ii,cc2]) + c4Yp_12t (Phi1bar[cc1] Phi1[cc2]) (Phi2tbar[ii,cc2] Phi2t[ii,cc1]) + c4Y_13 (Phi1bar[cc1] Phi1[cc1]) (Phi3bar[jj,cc2] Phi3[jj,cc2]) + c4Yp_13 (Phi1bar[cc1] Phi1[cc2]) (Phi3bar[jj,cc2] Phi3[jj,cc1]) + c4Y_1t2 (Phi1tbar[cc1] Phi1t[cc1]) (Phi2bar[ii,cc2] Phi2[ii,cc2]) + c4Yp_1t2 (Phi1tbar[cc1] Phi1t[cc2]) (Phi2bar[ii,cc2] Phi2[ii,cc1]) + c4Y_1t2t (Phi1tbar[cc1] Phi1t[cc1]) (Phi2tbar[ii,cc2] Phi2t[ii,cc2]) + c4Yp_1t2t (Phi1tbar[cc1] Phi1t[cc2]) (Phi2tbar[ii,cc2] Phi2t[ii,cc1]) + c4Y_1t3 (Phi1tbar[cc1] Phi1t[cc1]) (Phi3bar[jj,cc2] Phi3[jj,cc2]) + c4Yp_1t3 (Phi1tbar[cc1] Phi1t[cc2]) (Phi3bar[jj,cc2] Phi3[jj,cc1]) + c4Y_22t (Phi2bar[ii,cc1] Phi2[ii,cc1]) (Phi2tbar[jj,cc2] Phi2t[jj,cc2]) + c4Yp_22t (Phi2bar[ii,cc1] Phi2[ii,cc2]) (Phi2tbar[jj,cc2] Phi2t[jj,cc1]) + c4Y_23 (Phi2bar[ii,cc1] Phi2[ii,cc1]) (Phi3bar[jj,cc2] Phi3[jj,cc2]) + c4Yp_23 (Phi2bar[ii,cc1] Phi2[ii,cc2]) (Phi3bar[jj,cc2] Phi3[jj,cc1]) + c4Y_2t3 (Phi2tbar[ii,cc1] Phi2t[ii,cc1]) (Phi3bar[jj,cc2] Phi3[jj,cc2]) + c4Yp_2t3 (Phi2tbar[ii,cc1] Phi2t[ii,cc2]) (Phi3bar[jj,cc2] Phi3[jj,cc1]);

LTotal := LkinPhi1 + LkinPhi1t + LkinPhi2 + LkinPhi2t + LkinPhi3 + L2PhiDiag + L2PhiMix + LfPhi1 + LfPhi1t + LfPhi2 + LfPhi2t + LfPhi3 + L3Phi + L4PhiDiag + L4PhiPair;
