LXkin := Block[{mu, nu}, -1/(4 gX^2) (del[X[nu], mu] - del[X[mu], nu])^2 + MX^2/2 (del[thX, mu] + X[mu])^2];

LPhikin := Block[{mu}, DC[PhiXbar, mu] DC[PhiX, mu] - Mphi^2 PhiXbar PhiX];

LPsi1Lkin := Block[{mu}, ExpandIndices[I Psi1Lbar.Ga[mu].DC[Psi1L, mu], FlavorExpand -> SU2D]];

LPsi1Rkin := Block[{mu}, I Psi1Rbar.Ga[mu].DC[Psi1R, mu]];

LPsi2Lkin := Block[{mu}, I Psi2Lbar.Ga[mu].DC[Psi2L, mu]];

LPsi2Rkin := Block[{mu}, ExpandIndices[I Psi2Rbar.Ga[mu].DC[Psi2R, mu], FlavorExpand -> SU2D]];

LChi1Lkin := Block[{mu}, I Chi1Lbar.Ga[mu].DC[Chi1L, mu]];

LChi1Rkin := Block[{mu}, ExpandIndices[I Chi1Rbar.Ga[mu].DC[Chi1R, mu], FlavorExpand -> SU2D]];

LChi2Lkin := Block[{mu}, ExpandIndices[I Chi2Lbar.Ga[mu].DC[Chi2L, mu], FlavorExpand -> SU2D]];

LChi2Rkin := Block[{mu}, I Chi2Rbar.Ga[mu].DC[Chi2R, mu]];

LFdm1mass := -Mfdm1 Fdm1bar.Fdm1;

LFdm2mass := -Mfdm2 Fdm2bar.Fdm2;

LFup1mass := -Mfup1 Fup1bar.Fup1;

LFdn3mass := -Mfdn3 Fdn3bar.Fdn3;

LFdn4mass := -Mfdn4 Fdn4bar.Fdn4;

LFup2mass := -Mfup2 Fup2bar.Fup2;

LYf1 := Block[{sp, ii}, f1 Psi1Lbar[sp, ii].Psi1R[sp] Phi[ii] + HC[f1 Psi1Lbar[sp, ii].Psi1R[sp] Phi[ii]]];

LYF1 := Block[{sp, ii}, F1 Psi1Lbar[sp, ii].Chi1R[sp, ii] PhiXbar + HC[F1 Psi1Lbar[sp, ii].Chi1R[sp, ii] PhiXbar]];

LYF2 := Block[{sp, ii}, F2 Psi2Rbar[sp, ii].Chi2L[sp, ii] PhiXbar + HC[F2 Psi2Rbar[sp, ii].Chi2L[sp, ii] PhiXbar]];

LYFt1 := Block[{sp}, Ft1 Psi1Rbar[sp].Chi1L[sp] PhiX + HC[Ft1 Psi1Rbar[sp].Chi1L[sp] PhiX]];

LYFt2 := Block[{sp}, Ft2 Psi2Lbar[sp].Chi2R[sp] PhiX + HC[Ft2 Psi2Lbar[sp].Chi2R[sp] PhiX]];

LDH1 := Block[{mu, nu, la, rho, ii, jj}, ExpandIndices[c1 Eps[mu, nu, la, rho] (Phibar[ii] DC[Phi[ii], mu])/(Phibar[jj] Phi[jj]) (del[thX, nu] + X[nu]) FS[B, la, rho], FlavorExpand -> {SU2D, SU2W}]];

LDH2 := Block[{mu, nu, la, rho, aa, bb, jj, ll}, ExpandIndices[c2 Eps[mu, nu, la, rho] DC[Phibar[aa], mu] PauliSigma[jj, aa, bb] FS[Wi, la, rho, jj] Phi[bb] (del[thX, nu] + X[nu])/(Phibar[ll] Phi[ll]), FlavorExpand -> {SU2D, SU2W}]];

LTotal := LXkin + LPhikin + LPsi1Lkin + LPsi1Rkin + LPsi2Lkin + LPsi2Rkin + LChi1Lkin + LChi1Rkin + LChi2Lkin + LChi2Rkin + LFdm1mass + LFdm2mass + LFup1mass + LFdn3mass + LFdn4mass + LFup2mass + LYf1 + LYF1 + LYF2 + LYFt1 + LYFt2 + LDH1 + LDH2;
