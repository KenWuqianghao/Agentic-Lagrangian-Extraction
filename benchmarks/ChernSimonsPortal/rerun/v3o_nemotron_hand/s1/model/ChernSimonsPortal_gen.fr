  Date -> "2026-09-24",
  Institutions -> {"N/A"},
  Emails -> {"N/A"},
  URLs -> "https://arxiv.org/abs/0901.0639"
};

M$InteractionOrderHierarchy = {
  {QCD, 1},
  {QED, 2},
  {NP, 1}
};

M$Parameters = {
  MX == {
    ParameterType -> External,
    BlockName -> CHERNSIMONS,
    Value -> 1000.,
    InteractionOrder -> {NP, 0},
    TeX -> Subscript[M, X],
    Description -> "Mass of the X boson [GeV]"
  },
  c1 == {
    ParameterType -> External,
    BlockName -> CHERNSIMONS,
    Value -> 1.,
    InteractionOrder -> {NP, 1},
    TeX -> Subscript[c, 1],
    Description -> "Dimensionless Chern-Simons coupling c1 (XZZ/XZγ)"
  },
  c2 == {
    ParameterType -> External,
    BlockName -> CHERNSIMONS,
    Value -> 1.,
    InteractionOrder -> {NP, 1},
    TeX -> Subscript[c, 2],
    Description -> "Dimensionless Chern-Simons coupling c2 (XW+W-)"
  }
};

M$ClassesDescription = {
  V[100] == {
    ClassName -> X,
    SelfConjugate -> True,
    Mass -> {MX, 1000.},
    Width -> {WX, 0.},
    ParticleName -> "X",
    PDG -> 9000001,
    PropagatorLabel -> "X",
    PropagatorType -> Sine,
    PropagatorArrow -> None,
    FullName -> "Chern-Simons portal vector boson"
  }
};

LXkin := -1/4 (del[X[nu], mu] - del[X[mu], nu]) (del[X[nu], mu] - del[X[mu], nu]) + 1/2 MX^2 X[mu] X[mu];

LXZZ := c1/2 * sw * Eps[mu, nu, lambda, rho] * X[mu] * Z[nu] * del[Z[rho], lambda];

LXZγ := -c1 * cw * Eps[mu, nu, rho, sigma] * X[mu] * Z[nu] * del[A[rho], sigma];

LXWpWm := c2 * Eps[mu, nu, lambda, rho] * X[mu] * W[nu] * del[Wbar[rho], lambda];

LTotal := LXkin + LXZZ + LXZγ + LXWpWm + HC[LXWpWm];