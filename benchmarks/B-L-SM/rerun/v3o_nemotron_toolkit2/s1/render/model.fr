GaugeXi[Zp] = GaugeXi[Zp];

LZpKin := -1/4 FS[Zp, mu, nu] FS[Zp, mu, nu] + 1/2 MZp^2 Zp[mu] Zp[mu];

LChiKin := DC[Chibar, mu] DC[Chi, mu];

LPot := mu2 Chibar Chi + lam2 (Chibar Chi)^2 + lam3 Phibar[ii] Phi[ii] Chibar Chi;

LZpFermion := gp*(1/3)*(uqbar.Ga[mu].uq + dqbar.Ga[mu].dq)*Zp[mu] + gp*(-1)*(vlbar.Ga[mu].vl + lbar.Ga[mu].l)*Zp[mu] + gp*(-1)*(NRbar.Ga[mu].NR)*Zp[mu];

LNuYukDirac := -(LLbar.ynu.NR)[ii] Phibar[jj] Eps[ii, jj];

LNuYukMajorana := -NRbar.yM.CC[NR] Chi;

LTotal := LZpKin + LChiKin + LPot + LZpFermion + LNuYukDirac + HC[LNuYukDirac] + LNuYukMajorana + HC[LNuYukMajorana];
