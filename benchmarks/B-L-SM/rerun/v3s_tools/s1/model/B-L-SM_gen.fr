GaugeXi[S[101]] = 1;

GaugeXi[S[102]] = GaugeXi[Zp];

LZpKin := Block[{mu,nu}, ExpandIndices[-1/4 FS[Zp,mu,nu] FS[Zp,mu,nu] + 1/2 MZp^2 Zp[mu] Zp[mu]]];

LScalarBL := Block[{mu,ii}, ExpandIndices[DCBL[chibar,mu,-2] DCBL[chi,mu,2] - muX2 chibar chi - lamX (chibar chi)^2 - lamHX Phibar[ii] Phi[ii] chibar chi, FlavorExpand->SU2D]];

LHNKin := Block[{mu}, ExpandIndices[I/2 HNbar.Ga[mu].del[HN,mu] - 1/2 MHN HNbar.HN - (gp/2) HNbar.Ga[mu].Ga[5].HN Zp[mu], FlavorExpand->Generation]];

LZpFermions := Block[{mu}, ExpandIndices[-gp Zp[mu] (1/3 (uqbar.Ga[mu].uq + dqbar.Ga[mu].dq) - (lbar.Ga[mu].l + vlbar.Ga[mu].vl))]];

LYukNu := Block[{sp,ii,jj,ff1,ff2,yuk}, yuk = ExpandIndices[-yv[ff1,ff2] LLbar[sp,ii,ff1].HNR[sp,ff2] Phibar[jj] Eps[ii,jj], FlavorExpand->SU2D]; yuk + HC[yuk]];

LYukNMaj := Block[{ff1,ff2,yukM}, yukM = ExpandIndices[-(bar[CC[HNR]].yM.HNR) chi, FlavorExpand->Generation]; yukM + HC[yukM]];

LTotal := LZpKin + LScalarBL + LHNKin + LZpFermions + LYukNu + LYukNMaj;
