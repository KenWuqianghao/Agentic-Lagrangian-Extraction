GaugeXi[Zp] = GaugeXi[Zp];

LZpKin := -1/4 FS[Zp, mu, nu] FS[Zp, mu, nu] + 1/2 MZp^2 Zp[mu] Zp[mu];

LchiKin := DC[chibar, mu] DC[chi, mu];

Lh2Kin := 1/2 del[h2, mu] del[h2, mu] - 1/2 MHH^2 h2^2;

LGpKin := 1/2 del[Gp, mu] del[Gp, mu] - 1/2 MZp^2 Gp^2;

LNuRKin := I NuRbar[ff].Ga[mu].DC[NuR, mu];

LPotential := mH2 Phibar[ii] Phi[ii] + mu2 chibar chi + lam1 (Phibar[ii] Phi[ii])^2 + lam2 (chibar chi)^2 + lam3 Phibar[ii] Phi[ii] chibar chi;

LYukawaNu := -ynu[ff] LLbar[sp, ii, ff].ProjP[NuR[ff]] Phibar[jj] Eps[ii, jj];

LYukawaM := -yM[ff] bar[CC[NuR[ff]]].ProjP[NuR[ff]] chi;

LZpSM := gp*Zp[mu]*( (1/3)*(uqbar.Ga[mu].uq + dqbar.Ga[mu].dq) - (vlbar.Ga[mu].vl + lbar.Ga[mu].l) );

LTotal := LZpKin + LchiKin + Lh2Kin + LGpKin + LNuRKin + LPotential + LYukawaNu + LYukawaM + LZpSM + HC[LYukawaNu] + HC[LYukawaM] + LSM;
