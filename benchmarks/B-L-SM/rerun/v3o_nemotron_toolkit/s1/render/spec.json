{
  "model_name": "B-L-SM_gen",
  "info": {
    "authors": ["S. Amrith", "J. M. Butterworth", "F. F. Deppisch", "W. Liu", "A. Varma", "D. Yallup"],
    "version": "1.0",
    "date": "2024-01-01",
    "institutions": ["UCL"],
    "emails": ["f.deppisch@ucl.ac.uk"]
  },
  "interaction_order_hierarchy": [["QCD", 1], ["QED", 2], ["NP", 1]],
  "interaction_order_limit": [["NP", 1]],
  "feynman_gauge": true,
  "vevs": [["Phi[2]", "vev"], ["chi", "x"]],
  "gauge_groups": [
    {
      "name": "U1BL",
      "abelian": true,
      "gauge_boson": "Zp",
      "coupling_constant": "gp",
      "charge": "BL",
      "representations": []
    }
  ],
  "index_decls": [],
  "parameters": [
    {
      "name": "gp",
      "parameter_type": "External",
      "value": "0.2",
      "block_name": "BLINPUTS",
      "order_block": 1,
      "interaction_order": ["NP", 1],
      "description": "U(1)_{B-L} gauge coupling"
    },
    {
      "name": "MZp",
      "parameter_type": "External",
      "value": "7000.",
      "block_name": "BLINPUTS",
      "order_block": 2,
      "interaction_order": ["NP", 1],
      "description": "Z' boson mass [GeV]"
    },
    {
      "name": "MHH",
      "parameter_type": "External",
      "value": "200.",
      "block_name": "BLINPUTS",
      "order_block": 3,
      "interaction_order": ["NP", 1],
      "description": "Heavy Higgs mass [GeV]"
    },
    {
      "name": "SA",
      "parameter_type": "External",
      "value": "0.2",
      "block_name": "BLINPUTS",
      "order_block": 4,
      "interaction_order": ["NP", 1],
      "description": "Sine of Higgs mixing angle alpha"
    },
    {
      "name": "MN",
      "parameter_type": "External",
      "value": "1400.",
      "block_name": "BLINPUTS",
      "order_block": 5,
      "interaction_order": ["NP", 1],
      "description": "RH neutrino mass (degenerate) [GeV]"
    },
    {
      "name": "x",
      "parameter_type": "Internal",
      "value": "MZp/(2*gp)",
      "interaction_order": ["NP", -1],
      "description": "B-L breaking VEV [GeV]"
    },
    {
      "name": "CA",
      "parameter_type": "Internal",
      "value": "Sqrt[1-SA^2]",
      "description": "Cosine of Higgs mixing angle alpha"
    },
    {
      "name": "lam1",
      "parameter_type": "Internal",
      "value": "(1/(4*vev^2))*((MH^2+MHH^2)-CA*(MHH^2-MH^2))",
      "interaction_order": ["NP", 2],
      "description": "Higgs quartic lambda_1"
    },
    {
      "name": "lam2",
      "parameter_type": "Internal",
      "value": "(1/(4*x^2))*((MH^2+MHH^2)+CA*(MHH^2-MH^2))",
      "interaction_order": ["NP", 2],
      "description": "Higgs quartic lambda_2"
    },
    {
      "name": "lam3",
      "parameter_type": "Internal",
      "value": "(1/(2*vev*x))*SA*(MHH^2-MH^2)",
      "interaction_order": ["NP", 2],
      "description": "Higgs portal coupling lambda_3"
    },
    {
      "name": "mH2",
      "parameter_type": "Internal",
      "value": "-lam1*vev^2 - lam3*x^2/2 - MH^2/2",
      "interaction_order": ["NP", 2],
      "description": "Quadratic shift for H†H: m^2 - muH^2"
    },
    {
      "name": "mu2",
      "parameter_type": "Internal",
      "value": "-lam2*x^2 - lam3*vev^2/2",
      "interaction_order": ["NP", 2],
      "description": "Quadratic coefficient for |chi|^2"
    },
    {
      "name": "yM",
      "parameter_type": "Internal",
      "indices": ["Generation"],
      "value_rules": [
        {"lhs": "yM[1]", "rhs": "MN/(Sqrt[2]*x)"},
        {"lhs": "yM[2]", "rhs": "MN/(Sqrt[2]*x)"},
        {"lhs": "yM[3]", "rhs": "MN/(Sqrt[2]*x)"}
      ],
      "interaction_order": ["NP", 1],
      "description": "Majorana Yukawa coupling (diagonal)"
    },
    {
      "name": "VlN",
      "parameter_type": "Internal",
      "value": "Sqrt[0.1*^-9/MN]",
      "interaction_order": ["NP", 1],
      "description": "Active-sterile mixing V_lN = sqrt(m_nu/MN) with m_nu=0.1 eV"
    },
    {
      "name": "ynu",
      "parameter_type": "Internal",
      "indices": ["Generation"],
      "value_rules": [
        {"lhs": "ynu[1]", "rhs": "Sqrt[2]*MN*VlN/vev"},
        {"lhs": "ynu[2]", "rhs": "Sqrt[2]*MN*VlN/vev"},
        {"lhs": "ynu[3]", "rhs": "Sqrt[2]*MN*VlN/vev"}
      ],
      "interaction_order": ["NP", 1],
      "description": "Dirac neutrino Yukawa coupling (diagonal)"
    }
  ],
  "particles": [
    {
      "spin_type": "V",
      "class_index": 100,
      "class_name": "Zp",
      "self_conjugate": true,
      "indices": [],
      "mass": {"sym": "MZp", "value": "MZp"},
      "width": {"sym": "WZp", "value": "Auto"},
      "quantum_numbers": {"BL": "0"},
      "pdg": 32,
      "particle_name": "Zp",
      "antiparticle_name": "Zp",
      "full_name": "Z' boson",
      "propagator_label": "Zp",
      "propagator_type": "Sine",
      "propagator_arrow": "None"
    },
    {
      "spin_type": "S",
      "class_index": 101,
      "class_name": "chi",
      "self_conjugate": false,
      "indices": [],
      "mass": {"sym": "Mchi", "value": "Internal"},
      "width": {"sym": "Wchi", "value": "Auto"},
      "quantum_numbers": {"BL": "2"},
      "pdg": 9000001,
      "particle_name": "chi",
      "antiparticle_name": "chibar",
      "full_name": "B-L Higgs singlet",
      "propagator_label": "chi",
      "propagator_type": "ScalarDash",
      "propagator_arrow": "None"
    },
    {
      "spin_type": "S",
      "class_index": 102,
      "class_name": "h2",
      "self_conjugate": true,
      "indices": [],
      "mass": {"sym": "MHH", "value": "MHH"},
      "width": {"sym": "Wh2", "value": "Auto"},
      "quantum_numbers": {},
      "pdg": 35,
      "particle_name": "h2",
      "antiparticle_name": "h2",
      "full_name": "Heavy Higgs",
      "propagator_label": "h2",
      "propagator_type": "ScalarDash",
      "propagator_arrow": "None"
    },
    {
      "spin_type": "S",
      "class_index": 103,
      "class_name": "Gp",
      "self_conjugate": true,
      "indices": [],
      "mass": {"sym": "MZp", "value": "Internal"},
      "width": {"sym": "WZp", "value": "Internal"},
      "quantum_numbers": {},
      "pdg": 9000002,
      "particle_name": "Gp",
      "antiparticle_name": "Gp",
      "full_name": "Z' Goldstone",
      "propagator_label": "Gp",
      "propagator_type": "ScalarDash",
      "propagator_arrow": "None",
      "goldstone": "Zp"
    },
    {
      "spin_type": "F",
      "class_index": 104,
      "class_name": "NuR",
      "self_conjugate": false,
      "indices": ["Generation"],
      "flavor_index": "Generation",
      "class_members": ["NuR1", "NuR2", "NuR3"],
      "mass": {"sym": "MN", "members": [["MN1", "MN"], ["MN2", "MN"], ["MN3", "MN"]]},
      "width": {"sym": "WNuR", "value": "Auto"},
      "quantum_numbers": {"BL": "-1", "LeptonNumber": "1"},
      "pdg": [9900012, 9900014, 9900016],
      "particle_name": ["NuR1", "NuR2", "NuR3"],
      "antiparticle_name": ["NuR1bar", "NuR2bar", "NuR3bar"],
      "full_name": ["RH neutrino 1", "RH neutrino 2", "RH neutrino 3"],
      "propagator_label": ["NuR1", "NuR2", "NuR3"],
      "propagator_type": "Straight",
      "propagator_arrow": "Forward"
    }
  ],
  "gauge_xi": [["Zp", "GaugeXi[Zp]"]],
  "lagrangian_terms": [
    {
      "name": "LZpKin",
      "expression": "-1/4 FS[Zp, mu, nu] FS[Zp, mu, nu] + 1/2 MZp^2 Zp[mu] Zp[mu]",
      "delayed": true
    },
    {
      "name": "LchiKin",
      "expression": "DC[chibar, mu] DC[chi, mu]",
      "delayed": true
    },
    {
      "name": "Lh2Kin",
      "expression": "1/2 del[h2, mu] del[h2, mu] - 1/2 MHH^2 h2^2",
      "delayed": true
    },
    {
      "name": "LGpKin",
      "expression": "1/2 del[Gp, mu] del[Gp, mu] - 1/2 MZp^2 Gp^2",
      "delayed": true
    },
    {
      "name": "LNuRKin",
      "expression": "I NuRbar[ff].Ga[mu].DC[NuR, mu]",
      "delayed": true
    },
    {
      "name": "LPotential",
      "expression": "mH2 Phibar[ii] Phi[ii] + mu2 chibar chi + lam1 (Phibar[ii] Phi[ii])^2 + lam2 (chibar chi)^2 + lam3 Phibar[ii] Phi[ii] chibar chi",
      "delayed": true
    },
    {
      "name": "LYukawaNu",
      "expression": "-ynu[ff] LLbar[sp, ii, ff].ProjP[NuR[ff]] Phibar[jj] Eps[ii, jj]",
      "delayed": true
    },
    {
      "name": "LYukawaM",
      "expression": "-yM[ff] bar[CC[NuR[ff]]].ProjP[NuR[ff]] chi",
      "delayed": true
    },
    {
      "name": "LZpSM",
      "expression": "gp*Zp[mu]*( (1/3)*(uqbar.Ga[mu].uq + dqbar.Ga[mu].dq) - (vlbar.Ga[mu].vl + lbar.Ga[mu].l) )",
      "delayed": true
    },
    {
      "name": "LTotal",
      "expression": "LZpKin + LchiKin + Lh2Kin + LGpKin + LNuRKin + LPotential + LYukawaNu + LYukawaM + LZpSM + HC[LYukawaNu] + HC[LYukawaM] + LSM",
      "delayed": true
    }
  ],
  "raw_preamble": [
    "(* B-L gauge group *)",
    "AddGaugeGroup[U1BL, gp, Zp, BL, Abelian -> True];"
  ],
  "raw_blocks": []
}