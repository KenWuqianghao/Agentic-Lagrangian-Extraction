    Unphysical -> True,
    Definitions -> {vR[sp1_, ff_] :> Module[{sp2}, ProjP[sp1, sp2] (Sqrt[1 - VlN[ff]^2] NN[sp2, ff] + VlN[ff] vl[sp2, ff])]}
