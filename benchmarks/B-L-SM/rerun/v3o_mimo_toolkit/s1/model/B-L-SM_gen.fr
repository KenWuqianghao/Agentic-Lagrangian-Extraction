LYnuM = -bar[CC[Nrg]].yM.Nrg Chi;

LHportal = lam3 Phibar[ii] Phi[ii] bar[Chi] Chi;

Llam2 = lam2 (bar[Chi] Chi)^2;

LTotal := LZpKin + LHsKin + LNrKin + LZpGauge + LYnu + LYnuM + LHportal + Llam2;
