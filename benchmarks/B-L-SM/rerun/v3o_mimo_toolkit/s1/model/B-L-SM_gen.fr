LZpKin = -1/4 FS[Zp, mu, nu] FS[Zp, mu, nu] + 1/2 MZp^2 Zp[mu] Zp[mu];

LHsKin = 1/2 del[Hs, mu] del[Hs, mu] - 1/2 MHs^2 Hs^2;

LNrKin = I/2 NRbar.Ga[mu].del[NR, mu] - 1/2 MN NRbar.NR;

LZpGauge = gp (-1/3 (uqbar.Ga[mu].uq + dqbar.Ga[mu].dq) + LLbar.Ga[mu].LL + lRbar.Ga[mu].lR + NRbar.Ga[mu].ProjP.NR) Zp[mu];

