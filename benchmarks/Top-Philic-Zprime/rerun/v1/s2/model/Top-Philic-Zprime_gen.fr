M$ModelName = "Top-Philic-Zprime_gen";

M$Information = {
  Authors -> {"Jeong Han Kim", "Kyoungchul Kong", "Seung J. Lee", "Gopolang Mohlabeng"},
  Version -> "1.0",
  Date -> "2016-11-03",
  Institutions -> {"KAIST and Center for Theoretical Physics of the Universe, IBS", "University of Kansas", "Korea University and KIAS", "Fermilab"},
  Emails -> {"jeonghan.kim@kaist.ac.kr", "kckong@ku.edu", "sjjlee@korea.edu", "gopolang.mohlabeng@ku.edu"}
};

M$InteractionOrderHierarchy = {{QCD, 1}, {NP, 1}, {QED, 2}};

M$Parameters = {
  ct == {
    ParameterType -> External,
    Value -> 2.0,
    BlockName -> TOPPHILIC,
    OrderBlock -> 1,
    InteractionOrder -> {NP, 1},
    TeX -> "c_t",
    Description -> "Overall coupling strength of the top-philic vector resonance V1 to the top quark, ct = Sqrt[cL^2+cR^2]"
  },
  theta == {
    ParameterType -> External,
    Value -> 1.570796326794897,
    BlockName -> TOPPHILIC,
    OrderBlock -> 2,
    TeX -> "\\theta",
    Description -> "Chirality angle, tan(theta) = cR/cL; theta = Pi/2 is the purely right-handed case, theta = 3Pi/4 the axial case"
  },
  cL == {
    ParameterType -> Internal,
    Value -> ct*Cos[theta],
    InteractionOrder -> {NP, 1},
    TeX -> "c_L",
    Description -> "Left-handed coupling of V1 to the top quark"
  },
  cR == {
    ParameterType -> Internal,
    Value -> ct*Sin[theta],
    InteractionOrder -> {NP, 1},
    TeX -> "c_R",
    Description -> "Right-handed coupling of V1 to the top quark"
  },
  WV1 == {
    ParameterType -> Internal,
    Value -> ct^2*MV1/(8*Pi)*Sqrt[1 - 4*MT^2/MV1^2]*(1 - MT^2/MV1^2*(1 - 3*Sin[2*theta])),
    TeX -> "\\Gamma_{V_1}",
    Description -> "Total width of V1, saturated by V1 -> t tbar (Eq. 2.2)"
  }
};

M$ClassesDescription = {
  V[100] == {
    ClassName -> V1,
    SelfConjugate -> True,
    Mass -> {MV1, 1500.},
    Width -> {WV1, Internal},
    QuantumNumbers -> {Q -> 0},
    PDG -> 32,
    ParticleName -> "V1",
    FullName -> "Top-philic vector resonance",
    PropagatorLabel -> "V1",
    PropagatorType -> Sine,
    PropagatorArrow -> None
  }
};

LV1Kin := Block[{mu,nu}, -1/4 FS[V1,mu,nu] FS[V1,mu,nu] + 1/2 MV1^2 V1[mu] V1[mu]];

LV1Int := Block[{mu,sp1,sp2,sp3,cc}, ExpandIndices[ct*(Cos[theta]*(tbar[sp1,cc].Ga[mu,sp1,sp2].ProjM[sp2,sp3].t[sp3,cc]) + Sin[theta]*(tbar[sp1,cc].Ga[mu,sp1,sp2].ProjP[sp2,sp3].t[sp3,cc]))*V1[mu]]];

LTopPhilic := LV1Kin + LV1Int;
