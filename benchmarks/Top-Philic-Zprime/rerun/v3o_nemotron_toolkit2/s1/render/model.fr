M$ModelName = "Top-Philic-Zprime_gen";

M$Information = {
  Authors -> {"Jeong Han Kim", "Kyoungchul Kong", "Seung J. Lee", "Gopolang Mohlabeng"},
  Version -> "1.0.0",
  Date -> "2026-09-25",
  Institutions -> {"KAIST", "University of Kansas", "Korea University", "IBS"},
  Emails -> {"jeonghan.kim@kaist.ac.kr", "kckong@ku.edu", "sjjlee@korea.edu", "gopolang.mohlabeng@ku.edu"}
};

M$InteractionOrderHierarchy = {{QCD, 1}, {QED, 2}, {NP, 1}};

M$InteractionOrderLimit = {{NP, 2}};

FeynmanGauge = True;

MV1 == { ParameterType -> External, Value -> 1500., BlockName -> TOPPHILIC, OrderBlock -> 1, InteractionOrder -> {NP, 0}, Description -> "Mass of the top-philic vector resonance V1 [GeV], Eq.(1)" };

M$Parameters = {
  ct == {
    ParameterType -> External,
    Value -> 2.0,
    BlockName -> TOPPHILIC,
    OrderBlock -> 2,
    InteractionOrder -> {NP, 1},
    Description -> "Overall coupling strength of V1 to top quarks, Eq.(1)"
  },
  theta == {
    ParameterType -> External,
    Value -> Pi/2,
    BlockName -> TOPPHILIC,
    OrderBlock -> 3,
    InteractionOrder -> {NP, 0},
    Description -> "Chirality angle, tan(theta) = cR/cL. Set to Pi/2 for right-handed coupling as in paper benchmark, Eq.(1)"
  }
};

M$ClassesDescription = {
  V[100] == {
    ClassName -> V1,
    SelfConjugate -> True,
    Mass -> {MV1},
    Width -> {WV1, Internal},
    QuantumNumbers -> {Q -> 0},
    PDG -> 9000001,
    ParticleName -> "V1",
    AntiParticleName -> "V1",
    FullName -> "Top-Philic Zprime",
    PropagatorLabel -> "V1",
    PropagatorType -> Sine,
    PropagatorArrow -> None
  }
};

GaugeXi[V[100]] = GaugeXi[V1];

L_V1_kin_mass := -1/4 FS[V1, mu, nu] FS[V1, mu, nu] + 1/2 MV1^2 V1[mu] V1[mu];

L_V1_int := ct * uqbar[sp, 3, cc].Ga[mu].(Cos[theta] * ProjM[sp, sp2] + Sin[theta] * ProjP[sp, sp2]).uq[sp2, 3, cc] * V1[mu];

LTotal := L_V1_kin_mass + L_V1_int;
