GaugeXi[V[100]] = GaugeXi[V1];

LV1kin := -1/4 FS[V1, mu, nu] FS[V1, mu, nu] + 1/2 MV1^2 V1[mu] V1[mu];

LV1int := cL*uqbar[3, cc].Ga[mu].ProjM.uq[3, cc]*V1[mu] + cR*uqbar[3, cc].Ga[mu].ProjP.uq[3, cc]*V1[mu];

LTotal := LV1kin + LV1int;
