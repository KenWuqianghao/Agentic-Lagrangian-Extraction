    InteractionOrder -> {NP, 1},
    Definitions -> {MV1 -> 1500.},
    Description -> "Mass of the top-philic vector resonance V1 [GeV], Eq.(1)"
  },
  ct == {
    ParameterType -> External,
    Value -> 2.0,
    BlockName -> TOPPHILIC,
    OrderBlock -> 2,
    InteractionOrder -> {NP, 1},
    Description -> "Overall coupling strength of V1 to top quarks, Eq.(1)"
  },
  theta == {
    ParameterType -> External,
    Value -> 1.5707963267948966,
    BlockName -> TOPPHILIC,
    OrderBlock -> 3,
    InteractionOrder -> {NP, 1},
    Description -> "Chirality angle: tan(theta) = cR/cL, Eq.(1). Pi/2 = right-handed coupling"
  },
  cL == {
    ParameterType -> Internal,
    Value -> ct*Cos[theta],
    InteractionOrder -> {NP, 1},
    Description -> "Left-handed coupling: cL = ct*cos(theta)"
  },
  cR == {
    ParameterType -> Internal,
