LXdkin := Block[{mu}, I Xdbar.Ga[mu].DC[Xd, mu] - MXd Xdbar.Xd];

LXrkin := Block[{mu}, 1/2 del[Xr, mu] del[Xr, mu] - 1/2 MXr^2 Xr Xr];

LXckin := Block[{mu}, DC[Xcbar, mu] DC[Xc, mu] - MXc^2 Xcbar Xc];

LY0kin := Block[{mu}, 1/2 del[Y0, mu] del[Y0, mu] - 1/2 MY0^2 Y0 Y0];

LY1kin := Block[{mu, nu}, -1/4 FS[Y1, mu, nu] FS[Y1, mu, nu] + 1/2 MY1^2 Y1[mu] Y1[mu]];

LY0DM := gSXd Xdbar.Xd Y0 + I gPXd Xdbar.Ga[5].Xd Y0;

LY0SM := yt0/Sqrt[2] (gSt tbar.t + I gPt tbar.Ga[5].t) Y0;

LY1DM := Block[{mu}, (gVXd Xdbar.Ga[mu].Xd + gAXd Xdbar.Ga[mu].Ga[5].Xd) Y1[mu]];

LY1SM := Block[{mu}, (gVt tbar.Ga[mu].t + gAt tbar.Ga[mu].Ga[5].t - gAt bbar.Ga[mu].Ga[5].b) Y1[mu]];

LXrY0 := 1/2 gSXr Y0 Xr Xr;

LXcY0 := gSXc Y0 Xcbar Xc;

LXcY1 := Block[{mu}, I gVXc Y1[mu] (Xcbar del[Xc, mu] - del[Xcbar, mu] Xc)];

LY0GG := Block[{mu, nu, ro, si, aa}, gYGGS Y0 FS[G, mu, nu, aa] FS[G, mu, nu, aa] + gYGGP/2 Y0 Eps[mu, nu, ro, si] FS[G, mu, nu, aa] FS[G, ro, si, aa]];

LDMsimp := LXdkin + LXrkin + LXckin + LY0kin + LY1kin + LY0DM + LY0SM + LY1DM + LY1SM + LXrY0 + LXcY0 + LXcY1;

LDMsimpTopEFT := LXdkin + LXrkin + LXckin + LY0kin + LY1kin + LY0DM + LY1DM + LY1SM + LXrY0 + LXcY0 + LXcY1 + LY0GG;
