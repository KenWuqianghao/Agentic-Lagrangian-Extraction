L0X := 1/2 MXr gSXr Xr Xr Y0 + MXc gSXc Xcbar Xc Y0 + Xdbar.(gSXd + I gPXd Ga[5]).Xd Y0;

L0SM := 1/Sqrt[2] yt tbar.(gSt + I gPt Ga[5]).t Y0;

L0SMg := 1/Lambda FS[G,mu,nu,a] (gSg FS[G,mu,nu,a] + gPg Dual[FS][G,mu,nu,a]) Y0;

L0DM := L0X + L0SM + L0SMg;

L1X := I gVXc/2 (Xcbar del[Xc,mu] - del[Xcbar,mu] Xc) Y1[mu] + Xdbar.Ga[mu].(gVXd + gAXd Ga[5]).Xd Y1[mu];

L1SM := tbar.Ga[mu].(gVt + gAt Ga[5]).t Y1[mu] + bbar.Ga[mu].(-gAt Ga[5]).b Y1[mu];

L1DM := L1X + L1SM;
