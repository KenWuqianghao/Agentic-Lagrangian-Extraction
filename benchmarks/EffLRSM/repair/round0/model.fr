LWRQuarksNonHC := Block[{mu,ii,jj,cc}, -gWRq Sum[CKMR[ii,jj] bar[u[ii,cc]].Ga[mu].ProjP.d[jj,cc] WR[mu], {ii,1,3}, {jj,1,3}, {cc,1,3}]];

LWRQuarks := LWRQuarksNonHC + HC[LWRQuarksNonHC];

LWRLeptonsNonHC := Block[{mu,ll,nn}, -gWRl Sum[YR[ll,nn] bar[N[nn]].Ga[mu].ProjP.l[ll] WR[mu], {ll,1,3}, {nn,1,3}]];

LWRLightNuNonHC := Block[{mu,ll,nn}, -gWRl Sum[XL[ll,nn] bar[ve[nn]].Ga[mu].ProjP.l[ll] WR[mu], {ll,1,3}, {nn,1,3}]];

LWRLeptons := LWRLeptonsNonHC + LWRLightNuNonHC + HC[LWRLeptonsNonHC + LWRLightNuNonHC];

LZRQuarks := Block[{mu,ii,cc}, gZRq Sum[(bar[u[ii,cc]].Ga[mu].(gZRuL ProjM + gZRuR ProjP).u[ii,cc] + bar[d[ii,cc]].Ga[mu].(gZRdL ProjM + gZRdR ProjP).d[ii,cc]) ZR[mu], {ii,1,3}, {cc,1,3}]];

LZRLeptons := Block[{mu,ii}, gZRl Sum[(bar[l[ii]].Ga[mu].(gZReL ProjM + gZReR ProjP).l[ii] + bar[ve[ii]].Ga[mu].gZRnuL ProjM.ve[ii] + bar[N[ii]].Ga[mu].gZRNR ProjP.N[ii]) ZR[mu], {ii,1,3}]];

LBSM = LWRQuarks + LWRLeptons + LZRQuarks + LZRLeptons;
