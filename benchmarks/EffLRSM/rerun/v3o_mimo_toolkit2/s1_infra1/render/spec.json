{
  "model_name": "EffLRSM_gen",
  "info": {
    "authors": ["O. Mattelaer", "M. Mitra", "R. Ruiz"],
    "version": "1.0",
    "date": "2016-10-27",
    "institutions": ["CP3, Universite catholique de Louvain", "IISER Mohali", "IPPP, Durham University"],
    "emails": ["olivier.mattelaer@uclouvain.be", "manimala@iisermohali.ac.in", "richard.ruiz@durham.ac.uk"]
  },
  "interaction_order_hierarchy": [["QCD", 1], ["QED", 2], ["NP", 1]],
  "interaction_order_limit": [],
  "feynman_gauge": null,
  "vevs": [],
  "gauge_groups": [],
  "index_decls": [],
  "raw_preamble": [],
  "raw_blocks": [],
  "gauge_xi": [],
  "parameters": [
    {
      "name": "kRq",
      "parameter_type": "External",
      "value": "1.",
      "block_name": "NPINPUTS",
      "order_block": 1,
      "interaction_order": ["NP", 1],
      "description": "kappa_R^q, normalization of the W_R coupling to quarks (Eq. 6); 1. is the paper benchmark"
    },
    {
      "name": "kRl",
      "parameter_type": "External",
      "value": "1.",
      "block_name": "NPINPUTS",
      "order_block": 2,
      "interaction_order": ["NP", 1],
      "description": "kappa_R^l, normalization of the W_R and Z_R couplings to leptons (Eqs. 7, 8); 1. is the paper benchmark"
    },
    {
      "name": "Xnu",
      "parameter_type": "External",
      "block_name": "XNUBLOCK",
      "interaction_order": ["NP", 1],
      "indices": ["Generation", "Generation"],
      "value_rules": [
        {"lhs": "Xnu[1,1]", "rhs": "0"},
        {"lhs": "Xnu[1,2]", "rhs": "0"},
        {"lhs": "Xnu[1,3]", "rhs": "0"},
        {"lhs": "Xnu[2,1]", "rhs": "0"},
        {"lhs": "Xnu[2,2]", "rhs": "0"},
        {"lhs": "Xnu[2,3]", "rhs": "0"},
        {"lhs": "Xnu[3,1]", "rhs": "0"},
        {"lhs": "Xnu[3,2]", "rhs": "0"},
        {"lhs": "Xnu[3,3]", "rhs": "0"}
      ],
      "description": "X[neutrino,lepton] light-heavy mixing of Eq. (4); all entries vanish in the benchmark Eq. (5)"
    },
    {
      "name": "Ynu",
      "parameter_type": "External",
      "block_name": "YNUBLOCK",
      "interaction_order": ["NP", 1],
      "indices": ["Generation", "Generation"],
      "value_rules": [
        {"lhs": "Ynu[1,1]", "rhs": "1"},
        {"lhs": "Ynu[1,2]", "rhs": "0"},
        {"lhs": "Ynu[1,3]", "rhs": "0"},
        {"lhs": "Ynu[2,1]", "rhs": "0"},
        {"lhs": "Ynu[2,2]", "rhs": "1"},
        {"lhs": "Ynu[2,3]", "rhs": "0"},
        {"lhs": "Ynu[3,1]", "rhs": "0"},
        {"lhs": "Ynu[3,2]", "rhs": "0"},
        {"lhs": "Ynu[3,3]", "rhs": "1"}
      ],
      "description": "Y[heavy neutrino, charged lepton] of Eq. (4) with |Y_eN1|=|Y_muN2|=|Y_tauN3|=1 (Eq. 5); first index is the N flavour, i.e. the transpose of the paper's Y_lm"
    },
    {
      "name": "VCKMR",
      "parameter_type": "Internal",
      "indices": ["Generation", "Generation"],
      "unitary": true,
      "value_rules": [
        {"lhs": "VCKMR[1,1]", "rhs": "1"},
        {"lhs": "VCKMR[1,2]", "rhs": "0"},
        {"lhs": "VCKMR[1,3]", "rhs": "0"},
        {"lhs": "VCKMR[2,1]", "rhs": "0"},
        {"lhs": "VCKMR[2,2]", "rhs": "1"},
        {"lhs": "VCKMR[2,3]", "rhs": "0"},
        {"lhs": "VCKMR[3,1]", "rhs": "0"},
        {"lhs": "VCKMR[3,2]", "rhs": "0"},
        {"lhs": "VCKMR[3,3]", "rhs": "1"}
      ],
      "description": "Right-handed CKM matrix V^CKM' of Eq. (6), taken diagonal with unit entries"
    },
    {
      "name": "gZuL",
      "parameter_type": "Internal",
      "value": "-1/6 sw^2/cw^2/kRq^2",
      "description": "g_L^{ZR,u}=(T3L-Q) tan^2(thetaW)/kappa_R^2 with T3L=1/2, Q=2/3 (Eq. 9)"
    },
    {
      "name": "gZuR",
      "parameter_type": "Internal",
      "value": "1/2 - 2/3 sw^2/cw^2/kRq^2",
      "description": "g_R^{ZR,u}=T3R-(1/kappa_R^2)tan^2(thetaW) Q with T3R=1/2, Q=2/3 (Eq. 10)"
    },
    {
      "name": "gZdL",
      "parameter_type": "Internal",
      "value": "-1/6 sw^2/cw^2/kRq^2",
      "description": "g_L^{ZR,d}=(T3L-Q) tan^2(thetaW)/kappa_R^2 with T3L=-1/2, Q=-1/3 (Eq. 9)"
    },
    {
      "name": "gZdR",
      "parameter_type": "Internal",
      "value": "-1/2 + 1/3 sw^2/cw^2/kRq^2",
      "description": "g_R^{ZR,d}=T3R-(1/kappa_R^2)tan^2(thetaW) Q with T3R=-1/2, Q=-1/3 (Eq. 10)"
    },
    {
      "name": "gZlL",
      "parameter_type": "Internal",
      "value": "1/2 sw^2/cw^2/kRl^2",
      "description": "g_L^{ZR,l}=(T3L-Q) tan^2(thetaW)/kappa_R^2 with T3L=-1/2, Q=-1 (Eq. 9)"
    },
    {
      "name": "gZlR",
      "parameter_type": "Internal",
      "value": "-1/2 + sw^2/cw^2/kRl^2",
      "description": "g_R^{ZR,l}=T3R-(1/kappa_R^2)tan^2(thetaW) Q with T3R=-1/2, Q=-1 (Eq. 10)"
    },
    {
      "name": "gZnL",
      "parameter_type": "Internal",
      "value": "1/2 sw^2/cw^2/kRl^2",
      "description": "g_L^{ZR,nu}=(T3L-Q) tan^2(thetaW)/kappa_R^2 with T3L=1/2, Q=0 (Eq. 9); g_R^{ZR,nu}=0 since the SM has no nu_R"
    },
    {
      "name": "gZNR",
      "parameter_type": "Internal",
      "value": "1/2",
      "description": "g_R^{ZR,N}=T3R-(1/kappa_R^2)tan^2(thetaW) Q with T3R=1/2, Q=0; g_L^{ZR,N}=0 (Eq. 10, Tbl. I)"
    }
  ],
  "particles": [
    {
      "spin_type": "V",
      "class_index": 100,
      "class_name": "WR",
      "self_conjugate": false,
      "mass": {"sym": "MWR", "value": "3000."},
      "width": {"sym": "WRW", "value": "84.3"},
      "quantum_numbers": {"Q": "1"},
      "pdg": 9900024,
      "particle_name": "wr+",
      "antiparticle_name": "wr-",
      "full_name": "WR",
      "propagator_label": "wr",
      "propagator_type": "Sine",
      "propagator_arrow": "Forward"
    },
    {
      "spin_type": "V",
      "class_index": 101,
      "class_name": "ZR",
      "self_conjugate": true,
      "mass": {"sym": "MZR", "value": "5070."},
      "width": {"sym": "ZRW", "value": "114"},
      "pdg": 9900023,
      "particle_name": "zr",
      "full_name": "ZR",
      "propagator_label": "zr",
      "propagator_type": "Sine",
      "propagator_arrow": "None"
    },
    {
      "spin_type": "F",
      "class_index": 100,
      "class_name": "NR",
      "self_conjugate": true,
      "indices": ["Generation"],
      "flavor_index": "Generation",
      "class_members": ["N1", "N2", "N3"],
      "mass": {
        "sym": "MN",
        "members": [["MN1", "173.3"], ["MN2", "1.*^12"], ["MN3", "1.*^12"]]
      },
      "width": {
        "sym": "WN",
        "members": [["WN1", "2.12*^-8"], ["WN2", "0"], ["WN3", "0"]]
      },
      "pdg": [9900012, 9900014, 9900016],
      "particle_name": ["n1", "n2", "n3"],
      "full_name": ["Heavy-neutrino-1", "Heavy-neutrino-2", "Heavy-neutrino-3"],
      "propagator_label": ["nr", "n1", "n2", "n3"],
      "propagator_type": "S",
      "propagator_arrow": "None"
    }
  ],
  "lagrangian_terms": [
    {
      "name": "LWRkin",
      "delayed": true,
      "expression": "-1/2 FS[WRbar, mu, nu] FS[WR, mu, nu] + MWR^2 WRbar[mu] WR[mu]"
    },
    {
      "name": "LZRkin",
      "delayed": true,
      "expression": "-1/4 FS[ZR, mu, nu] FS[ZR, mu, nu] + 1/2 MZR^2 ZR[mu] ZR[mu]"
    },
    {
      "name": "LNkin",
      "delayed": true,
      "expression": "I/2 NRbar.Ga[mu].del[NR, mu] - 1/2 (MN1 N1bar.N1 + MN2 N2bar.N2 + MN3 N3bar.N3)"
    },
    {
      "name": "LWRqq",
      "delayed": true,
      "expression": "-kRq gw/Sqrt[2] ((uqbar.VCKMR.Ga[mu].ProjP.dq) WR[mu] + HC[(uqbar.VCKMR.Ga[mu].ProjP.dq) WR[mu]])"
    },
    {
      "name": "LWRlnu",
      "delayed": true,
      "expression": "-kRl gw/Sqrt[2] ((NRbar.Ynu.Ga[mu].ProjP.l) WR[mu] + HC[(NRbar.Ynu.Ga[mu].ProjP.l) WR[mu]])"
    },
    {
      "name": "LZRuq",
      "delayed": true,
      "expression": "-kRq gw/Sqrt[1-(1/kRq)^2 sw^2/cw^2] (gZuL (uqbar.Ga[mu].ProjM.uq) + gZuR (uqbar.Ga[mu].ProjP.uq)) ZR[mu]"
    },
    {
      "name": "LZRdq",
      "delayed": true,
      "expression": "-kRq gw/Sqrt[1-(1/kRq)^2 sw^2/cw^2] (gZdL (dqbar.Ga[mu].ProjM.dq) + gZdR (dqbar.Ga[mu].ProjP.dq)) ZR[mu]"
    },
    {
      "name": "LZRl",
      "delayed": true,
      "expression": "-kRl gw/Sqrt[1-(1/kRl)^2 sw^2/cw^2] (gZlL (lbar.Ga[mu].ProjM.l) + gZlR (lbar.Ga[mu].ProjP.l)) ZR[mu]"
    },
    {
      "name": "LZRvl",
      "delayed": true,
      "expression": "-kRl gw/Sqrt[1-(1/kRl)^2 sw^2/cw^2] gZnL (vlbar.Ga[mu].ProjM.vl) ZR[mu]"
    },
    {
      "name": "LZRN",
      "delayed": true,
      "expression": "-kRl gw/Sqrt[1-(1/kRl)^2 sw^2/cw^2] gZNR (NRbar.Ga[mu].ProjP.NR) ZR[mu]"
    },
    {
      "name": "LTotal",
      "delayed": true,
      "expression": "LWRkin + LZRkin + LNkin + LWRqq + LWRlnu + LZRuq + LZRdq + LZRl + LZRvl + LZRN"
    }
  ]
}
