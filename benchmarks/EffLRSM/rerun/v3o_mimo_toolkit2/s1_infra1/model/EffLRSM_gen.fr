LWRkin := -1/2 FS[WRbar, mu, nu] FS[WR, mu, nu] + MWR^2 WRbar[mu] WR[mu];

LZRkin := -1/4 FS[ZR, mu, nu] FS[ZR, mu, nu] + 1/2 MZR^2 ZR[mu] ZR[mu];

LNkin := I/2 NRbar.Ga[mu].del[NR, mu] - 1/2 (MN1 N1bar.N1 + MN2 N2bar.N2 + MN3 N3bar.N3);

LWRqq := -kRq gw/Sqrt[2] ((uqbar.VCKMR.Ga[mu].ProjP.dq) WR[mu] + HC[(uqbar.VCKMR.Ga[mu].ProjP.dq) WR[mu]]);

LWRlnu := -kRl gw/Sqrt[2] ((NRbar.Ynu.Ga[mu].ProjP.l) WR[mu] + HC[(NRbar.Ynu.Ga[mu].ProjP.l) WR[mu]]);

LZRuq := -kRq gw/Sqrt[1-(1/kRq)^2 sw^2/cw^2] (gZuL (uqbar.Ga[mu].ProjM.uq) + gZuR (uqbar.Ga[mu].ProjP.uq)) ZR[mu];

LZRdq := -kRq gw/Sqrt[1-(1/kRq)^2 sw^2/cw^2] (gZdL (dqbar.Ga[mu].ProjM.dq) + gZdR (dqbar.Ga[mu].ProjP.dq)) ZR[mu];

LZRl := -kRl gw/Sqrt[1-(1/kRl)^2 sw^2/cw^2] (gZlL (lbar.Ga[mu].ProjM.l) + gZlR (lbar.Ga[mu].ProjP.l)) ZR[mu];

LZRvl := -kRl gw/Sqrt[1-(1/kRl)^2 sw^2/cw^2] gZnL (vlbar.Ga[mu].ProjM.vl) ZR[mu];

LZRN := -kRl gw/Sqrt[1-(1/kRl)^2 sw^2/cw^2] gZNR (NRbar.Ga[mu].ProjP.NR) ZR[mu];

LTotal := LWRkin + LZRkin + LNkin + LWRqq + LWRlnu + LZRuq + LZRdq + LZRl + LZRvl + LZRN;
