LWRkin := Block[{mu, nu}, ExpandIndices[-1/2 FS[WRbar, mu, nu] FS[WR, mu, nu] + MWR^2 WRbar[mu] WR[mu]]];

LZRkin := Block[{mu, nu}, ExpandIndices[-1/4 FS[ZR, mu, nu] FS[ZR, mu, nu] + 1/2 MZR^2 ZR[mu] ZR[mu]]];

LNkin := Block[{mu, ff}, ExpandIndices[I/2 NRbar[ff].Ga[mu].del[NR[ff], mu] - 1/2 MN[ff] NRbar[ff].NR[ff], FlavorExpand -> Generation]];

LWRq := Block[{mu, ff1, ff2, cc, lag}, lag = -kqR gw/Sqrt[2] CKMR[ff1, ff2] WR[mu] (uqbar[ff1, cc].Ga[mu].ProjP.dq[ff2, cc]); ExpandIndices[lag + HC[lag], FlavorExpand -> Generation]];

LWRl := Block[{mu, ff1, ff2, lag}, lag = -klR gw/Sqrt[2] WR[mu] (Xmix[ff1, ff2] (bar[CC[vl[ff2]]].Ga[mu].ProjP.l[ff1]) + Ymix[ff1, ff2] (NRbar[ff2].Ga[mu].ProjP.l[ff1])); ExpandIndices[lag + HC[lag], FlavorExpand -> Generation]];

LZRff := Block[{mu, ff, cc}, ExpandIndices[-ZR[mu] (gZRq (uqbar[ff, cc].Ga[mu].(gZRLu ProjM + gZRRu ProjP).uq[ff, cc] + dqbar[ff, cc].Ga[mu].(gZRLd ProjM + gZRRd ProjP).dq[ff, cc]) + gZRl (lbar[ff].Ga[mu].(gZRLe ProjM + gZRRe ProjP).l[ff] + gZRLv vlbar[ff].Ga[mu].ProjM.vl[ff] + gZRRN NRbar[ff].Ga[mu].ProjP.NR[ff])), FlavorExpand -> Generation]];

LEffLRSM := LWRkin + LZRkin + LNkin + LWRq + LWRl + LZRff;

LTotal := LSM + LEffLRSM;
