LWRkin := -1/2 FS[WRbar, mu, nu] FS[WR, mu, nu] + MWR^2 WRbar[mu] WR[mu];

LZRkin := -1/4 FS[ZR, mu, nu] FS[ZR, mu, nu] + 1/2 MZR^2 ZR[mu] ZR[mu];

LNkin := I/2 Nbar[sp1, ff].Ga[mu, sp1, sp2].del[N[sp2, ff], mu] - 1/2 MN[ff] Nbar[sp1, ff].N[sp1, ff];

LWRqq := -kQR gw/Sqrt[2] VCKMR[ff1, ff2] uqbar[sp1, ff1, cc].Ga[mu, sp1, sp2].ProjP[sp2, sp3].dq[sp3, ff2, cc] WR[mu];

LWRlN := -kLR gw/Sqrt[2] YN[ff1, ff2] Nbar[sp1, ff2].Ga[mu, sp1, sp2].ProjP[sp2, sp3].l[sp3, ff1] WR[mu];

LWRlv := -kLR gw/Sqrt[2] XN[ff1, ff2] bar[CC[vl[sp1, ff2]]].Ga[mu, sp1, sp2].ProjP[sp2, sp3].l[sp3, ff1] WR[mu];

LZRu := -gZRq uqbar[sp1, ff, cc].Ga[mu, sp1, sp2].(gZRuL ProjM[sp2, sp3] + gZRuR ProjP[sp2, sp3]).uq[sp3, ff, cc] ZR[mu];

LZRd := -gZRq dqbar[sp1, ff, cc].Ga[mu, sp1, sp2].(gZRdL ProjM[sp2, sp3] + gZRdR ProjP[sp2, sp3]).dq[sp3, ff, cc] ZR[mu];

LZRl := -gZRl lbar[sp1, ff].Ga[mu, sp1, sp2].(gZRlL ProjM[sp2, sp3] + gZRlR ProjP[sp2, sp3]).l[sp3, ff] ZR[mu];

LZRv := -gZRl gZRvL vlbar[sp1, ff].Ga[mu, sp1, sp2].ProjM[sp2, sp3].vl[sp3, ff] ZR[mu];

LZRN := -gZRl gZRNR Nbar[sp1, ff].Ga[mu, sp1, sp2].ProjP[sp2, sp3].N[sp3, ff] ZR[mu];

LEffLRSM := LWRkin + LZRkin + LNkin + (LWRqq + HC[LWRqq]) + (LWRlN + HC[LWRlN]) + (LWRlv + HC[LWRlv]) + LZRu + LZRd + LZRl + LZRv + LZRN;
