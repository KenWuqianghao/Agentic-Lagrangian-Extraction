LWRkin = -1/2 FS[WRbar, mu, nu] FS[WR, mu, nu] + MWR^2 WRbar[mu] WR[mu];

LZRkin = -1/4 FS[ZR, mu, nu] FS[ZR, mu, nu] + 1/2 MZR^2 ZR[mu] ZR[mu];

LNRkin = I/2 NRbar[ff].Ga[mu].del[NR[ff], mu] - 1/2 mN[ff] NRbar[ff].NR[ff];

LWRqq = -kRq*gw/Sqrt[2] (uqbar[ff1, cc].Ga[mu].ProjP.dq[ff2, cc] WR[mu] + HC[uqbar[ff1, cc].Ga[mu].ProjP.dq[ff2, cc] WR[mu]]);

LWRlep = -kRl*gw/Sqrt[2] (Ymix[ff] NRbar[ff].Ga[mu].ProjP.l[ff] WR[mu] + HC[Ymix[ff] NRbar[ff].Ga[mu].ProjP.l[ff] WR[mu]]);

LZRqq = -kRq*gw/Sqrt[1 - (1/kRq)^2*sw2/cw2] ( uqbar[ff, cc].Ga[mu].(gLZu*ProjM + gRZu*ProjP).uq[ff, cc] ZR[mu] + dqbar[ff, cc].Ga[mu].(gLZd*ProjM + gRZd*ProjP).dq[ff, cc] ZR[mu] );

LZRlep = -kRl*gw/Sqrt[1 - (1/kRl)^2*sw2/cw2] ( vbar[ff].Ga[mu].(gLZv*ProjM + gRZv*ProjP).vl[ff] ZR[mu] + lbar[ff].Ga[mu].(gLZl*ProjM + gRZl*ProjP).l[ff] ZR[mu] );

LZRNR = -kRl*gw/Sqrt[1 - (1/kRl)^2*sw2/cw2] ( gLZN*NRbar[ff].Ga[mu].ProjM.NR[ff] + gRZN*NRbar[ff].Ga[mu].ProjP.NR[ff] ) ZR[mu];

LTotal = LWRkin + LZRkin + LNRkin + LWRqq + LWRlep + LZRqq + LZRlep + LZRNR;
