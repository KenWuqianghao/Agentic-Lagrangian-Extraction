  "lagrangian_terms": [
    {
      "name": "LWRkin",
      "expression": "-1/2 FS[WRbar, mu, nu] FS[WR, mu, nu] + MWR^2 WRbar[mu] WR[mu]",
      "delayed": false
    },
    {
      "name": "LZRkin",
      "expression": "-1/4 FS[ZR, mu, nu] FS[ZR, mu, nu] + 1/2 MZR^2 ZR[mu] ZR[mu]",
      "delayed": false
    },
    {
      "name": "LNRkin",
      "expression": "I/2 NRbar[ff].Ga[mu].del[NR[ff], mu] - 1/2 mN[ff] NRbar[ff].NR[ff]",
      "delayed": false
    },
    {
      "name": "LWRqq",
      "expression": "-kRq*gw/Sqrt[2] (uqbar[ff1, cc].Ga[mu].ProjP.dq[ff2, cc] WR[mu] + HC[uqbar[ff1, cc].Ga[mu].ProjP.dq[ff2, cc] WR[mu]])",
      "delayed": false
    },
    {
      "name": "LWRlep",
      "expression": "-kRl*gw/Sqrt[2] (Ymix[ff] NRbar[ff].Ga[mu].ProjP.l[ff] WR[mu] + HC[Ymix[ff] NRbar[ff].Ga[mu].ProjP.l[ff] WR[mu]])",
      "delayed": false
    },
    {
      "name": "LZRqq",
      "expression": "-kRq*gw/Sqrt[1 - (1/kRq)^2*sw2/cw2] ( uqbar[ff, cc].Ga[mu].(gLZu*ProjM + gRZu*ProjP).uq[ff, cc] ZR[mu] + dqbar[ff, cc].Ga[mu].(gLZd*ProjM + gRZd*ProjP).dq[ff, cc] ZR[mu] )",
      "delayed": false
    },
    {
      "name": "LZRlep",
      "expression": "-kRl*gw/Sqrt[1 - (1/kRl)^2*sw2/cw2] ( vbar[ff].Ga[mu].(gLZv*ProjM + gRZv*ProjP).vl[ff] ZR[mu] + lbar[ff].Ga[mu].(gLZl*ProjM + gRZl*ProjP).l[ff] ZR[mu] )",
      "delayed": false
    },
    {
      "name": "LZRNR",
      "expression": "-kRl*gw/Sqrt[1 - (1/kRl)^2*sw2/cw2] ( gLZN*NRbar[ff].Ga[mu].ProjM.NR[ff] + gRZN*NRbar[ff].Ga[mu].ProjP.NR[ff] ) ZR[mu]",
      "delayed": false
    },
    {
      "name": "LTotal",
      "expression": "LWRkin + LZRkin + LNRkin + LWRqq + LWRlep + LZRqq + LZRlep + LZRNR",
      "delayed": false
    }
  ],
  "raw_preamble": [
    "gLZu = (1/2 - 2/3)*(1/kRq^2)*sw2/cw2;",
    "gRZu = 1/2 - (1/kRq^2)*sw2/cw2*(2/3);",
    "gLZd = (-1/2 + 1/3)*(1/kRq^2)*sw2/cw2;",
    "gRZd = -1/2 - (1/kRq^2)*sw2/cw2*(-1/3);",
    "gLZv = (1/2 - 0)*(1/kRl^2)*sw2/cw2;",
    "gRZv = 0;",
    "gLZl = (-1/2 + 1)*(1/kRl^2)*sw2/cw2;",
    "gRZl = -1/2 - (1/kRl^2)*sw2/cw2*(-1);",
    "gLZN = 0;",
    "gRZN = 1/2;"
  ],
  "raw_blocks": []
