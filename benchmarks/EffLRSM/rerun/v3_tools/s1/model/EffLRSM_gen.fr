LWRkin := Block[{mu, nu}, ExpandIndices[-1/2 FS[WRbar, mu, nu] FS[WR, mu, nu] + MWR^2 WRbar[mu] WR[mu]]];

LZRkin := Block[{mu, nu}, ExpandIndices[-1/4 FS[ZR, mu, nu] FS[ZR, mu, nu] + 1/2 MZR^2 ZR[mu] ZR[mu]]];

LNHkin := Block[{mu, sp, ff}, ExpandIndices[I/2 NHLbar.Ga[mu].del[NHL, mu] - 1/2 MNH[ff] NHLbar[sp, ff].NHL[sp, ff]]];

LWRq := Block[{mu, lag}, lag = ExpandIndices[-kapRq*gw/Sqrt[2]*(uqbar.VCKMR.Ga[mu].ProjP.dq)*WR[mu]]; lag + HC[lag]];

LWRl := Block[{mu, lag}, lag = ExpandIndices[-kapRl*gw/Sqrt[2]*(bar[CC[vl]].XLN.Ga[mu].ProjP.l + NHLbar.YLN.Ga[mu].ProjP.l)*WR[mu]]; lag + HC[lag]];

LZRf := Block[{mu}, ExpandIndices[-gw*gZRq*(uqbar.Ga[mu].(gLZRu*ProjM + gRZRu*ProjP).uq + dqbar.Ga[mu].(gLZRd*ProjM + gRZRd*ProjP).dq)*ZR[mu] - gw*gZRl*(lbar.Ga[mu].(gLZRe*ProjM + gRZRe*ProjP).l + vlbar.Ga[mu].(gLZRv*ProjM).vl + NHLbar.Ga[mu].(gRZRn*ProjP).NHL)*ZR[mu]]];

LTotal := LWRkin + LZRkin + LNHkin + LWRq + LWRl + LZRf;
