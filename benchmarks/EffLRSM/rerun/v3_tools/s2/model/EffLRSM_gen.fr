LWRkin := Block[{mu, nu}, -1/2 FS[WRbar, mu, nu] FS[WR, mu, nu] + MWR^2 WRbar[mu] WR[mu]];

LZRkin := Block[{mu, nu}, -1/4 FS[ZR, mu, nu] FS[ZR, mu, nu] + 1/2 MZR^2 ZR[mu] ZR[mu]];

LNkin := Block[{mu}, I/2 NNbar.Ga[mu].del[NN, mu] - 1/2 NNbar.MNmat.NN];

LWRq := Block[{mu}, gWRq uqbar.VCKMR.Ga[mu].ProjP.dq WR[mu] + HC[gWRq uqbar.VCKMR.Ga[mu].ProjP.dq WR[mu]]];

LWRlN := Block[{mu}, gWRl NNbar.YN.Ga[mu].ProjP.l WR[mu] + HC[gWRl NNbar.YN.Ga[mu].ProjP.l WR[mu]]];

LWRlnu := Block[{mu}, gWRl CC[vlbar].XL.Ga[mu].ProjP.l WR[mu] + HC[gWRl CC[vlbar].XL.Ga[mu].ProjP.l WR[mu]]];

LZRff := Block[{mu}, zRuL uqbar.Ga[mu].ProjM.uq ZR[mu] + zRuR uqbar.Ga[mu].ProjP.uq ZR[mu] + zRdL dqbar.Ga[mu].ProjM.dq ZR[mu] + zRdR dqbar.Ga[mu].ProjP.dq ZR[mu] + zReL lbar.Ga[mu].ProjM.l ZR[mu] + zReR lbar.Ga[mu].ProjP.l ZR[mu] + zRvL vlbar.Ga[mu].ProjM.vl ZR[mu] + zRnR NNbar.Ga[mu].ProjP.NN ZR[mu]];

LTotal := LWRkin + LZRkin + LNkin + LWRq + LWRlN + LWRlnu + LZRff;
