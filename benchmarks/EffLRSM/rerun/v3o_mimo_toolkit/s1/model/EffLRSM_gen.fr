LWRkin := -1/2 FS[WRbar, mu, nu] FS[WR, mu, nu] + MWR^2 WRbar[mu] WR[mu];

LZRkin := -1/4 FS[ZR, mu, nu] FS[ZR, mu, nu] + 1/2 MZR^2 ZR[mu] ZR[mu];

LNkin := I/2 NRbar.Ga[mu].del[NR, mu] - 1/2 MN1 N1bar.N1 - 1/2 MN2 N2bar.N2 - 1/2 MN3 N3bar.N3;

LWRqq := -(kRq gw/Sqrt[2]) uqbar.VCKMR.Ga[mu].ProjP.dq WR[mu] + HC[-(kRq gw/Sqrt[2]) uqbar.VCKMR.Ga[mu].ProjP.dq WR[mu]];

LWRln := -(kRl gw/Sqrt[2]) NRbar.YR.Ga[mu].ProjP.l WR[mu] + HC[-(kRl gw/Sqrt[2]) NRbar.YR.Ga[mu].ProjP.l WR[mu]];

LZRff := ZR[mu] (cZqL uqbar.Ga[mu].ProjM.uq + cZuR uqbar.Ga[mu].ProjP.uq + cZqL dqbar.Ga[mu].ProjM.dq + cZdR dqbar.Ga[mu].ProjP.dq + cZlL lbar.Ga[mu].ProjM.l + cZeR lbar.Ga[mu].ProjP.l + cZlL vlbar.Ga[mu].ProjM.vl + cZNR NRbar.Ga[mu].ProjP.NR);

LTotal := LWRkin + LZRkin + LNkin + LWRqq + LWRln + LZRff;
