LWrkin := Block[{mu,nu}, ExpandIndices[ -1/2 FS[Wrbar,mu,nu] FS[Wr,mu,nu] + MWR^2 Wrbar[mu] Wr[mu] ]];

LZrkin := Block[{mu,nu}, ExpandIndices[ -1/4 FS[Zr,mu,nu] FS[Zr,mu,nu] + 1/2 MZR^2 Zr[mu] Zr[mu] ]];

LNkin := Block[{sp,mu,ff}, ExpandIndices[ I/2 Nhbar.Ga[mu].del[Nh,mu] - 1/2 MN[ff] Nhbar[sp,ff].Nh[sp,ff], FlavorExpand->Generation ]];

LWRqq := Block[{mu, cur}, cur = -(kappaRq*gw/Sqrt[2]) uqbar.VCKMR.Ga[mu].ProjP.dq Wr[mu]; ExpandIndices[cur + HC[cur], FlavorExpand->Generation]];

LWRlN := Block[{mu, curN, curNu}, curN = -(kappaRl*gw/Sqrt[2]) Nhbar.YR.Ga[mu].ProjP.lR Wr[mu]; curNu = -(kappaRl*gw/Sqrt[2]) bar[CC[vl]].XR.Ga[mu].ProjP.lR Wr[mu]; ExpandIndices[curN + curNu + HC[curN + curNu], FlavorExpand->Generation]];

LZRuu := Block[{mu}, ExpandIndices[ -(kappaRq*gw/normQ) uqbar.Ga[mu].(gLu*ProjM + gRu*ProjP).uq Zr[mu], FlavorExpand->Generation ]];

LZRdd := Block[{mu}, ExpandIndices[ -(kappaRq*gw/normQ) dqbar.Ga[mu].(gLd*ProjM + gRd*ProjP).dq Zr[mu], FlavorExpand->Generation ]];

LZRee := Block[{mu}, ExpandIndices[ -(kappaRl*gw/normL) lbar.Ga[mu].(gLe*ProjM + gRe*ProjP).l Zr[mu], FlavorExpand->Generation ]];

LZRnn := Block[{mu}, ExpandIndices[ -(kappaRl*gw/normL) vlbar.Ga[mu].(gLnu*ProjM + gRnu*ProjP).vl Zr[mu], FlavorExpand->Generation ]];

LZRNN := Block[{mu}, ExpandIndices[ -(kappaRl*gw/normL) Nhbar.Ga[mu].(gLN*ProjM + gRN*ProjP).Nh Zr[mu], FlavorExpand->Generation ]];

LTotal := LWrkin + LZrkin + LNkin + LWRqq + LWRlN + LZRuu + LZRdd + LZRee + LZRnn + LZRNN;
