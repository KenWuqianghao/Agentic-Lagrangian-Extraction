LVRKin := Block[{mu,nu}, ExpandIndices[-1/2*FS[WRbar,mu,nu]*FS[WR,mu,nu] + MWR^2*WRbar[mu]*WR[mu] - 1/4*FS[ZR,mu,nu]*FS[ZR,mu,nu] + 1/2*MZR^2*ZR[mu]*ZR[mu]]];

LNRKin := Block[{mu,sp1,sp2,ff}, ExpandIndices[I/2*NRbar[sp1,ff].Ga[mu,sp1,sp2].del[NR[sp2,ff],mu] - 1/2*MN[ff]*NRbar[sp1,ff].NR[sp1,ff], FlavorExpand->{Generation}]];

LWRQuark := Block[{mu,sp1,sp2,sp3,ff1,ff2,cc,lag}, lag = -kqR*gw/Sqrt[2]*CKMR[ff1,ff2]*uqbar[sp1,ff1,cc].Ga[mu,sp1,sp2].ProjP[sp2,sp3].dq[sp3,ff2,cc]*WR[mu]; ExpandIndices[lag + HC[lag], FlavorExpand->{Generation}]];

LWRLepton := Block[{mu,sp1,sp2,sp3,ff1,ff2,lag}, lag = -klR*gw/Sqrt[2]*(YN[ff1,ff2]*NRbar[sp1,ff2].Ga[mu,sp1,sp2].ProjP[sp2,sp3].l[sp3,ff1] + XL[ff1,ff2]*CC[vlbar][sp1,ff2].Ga[mu,sp1,sp2].ProjP[sp2,sp3].l[sp3,ff1])*WR[mu]; ExpandIndices[lag + HC[lag], FlavorExpand->{Generation}]];

LZRNC := Block[{mu,sp1,sp2,sp3,ff,cc}, ExpandIndices[-gZRq*(uqbar[sp1,ff,cc].Ga[mu,sp1,sp2].(gZRLu*ProjM[sp2,sp3] + gZRRu*ProjP[sp2,sp3]).uq[sp3,ff,cc] + dqbar[sp1,ff,cc].Ga[mu,sp1,sp2].(gZRLd*ProjM[sp2,sp3] + gZRRd*ProjP[sp2,sp3]).dq[sp3,ff,cc])*ZR[mu] - gZRl*(lbar[sp1,ff].Ga[mu,sp1,sp2].(gZRLe*ProjM[sp2,sp3] + gZRRe*ProjP[sp2,sp3]).l[sp3,ff] + gZRLv*vlbar[sp1,ff].Ga[mu,sp1,sp2].ProjM[sp2,sp3].vl[sp3,ff] + 1/2*gZRRN*NRbar[sp1,ff].Ga[mu,sp1,sp2].ProjP[sp2,sp3].NR[sp3,ff])*ZR[mu], FlavorExpand->{Generation}]];

LEffLRSM := LVRKin + LNRKin + LWRQuark + LWRLepton + LZRNC;
