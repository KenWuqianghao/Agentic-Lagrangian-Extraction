    Description -> "Right-handed ZR chiral coefficient of down-type quarks, Eq. (10)"
  },
  gZRLe == {
    ParameterType -> Internal,
    Value -> tw^2/(2*klR^2),
    Description -> "Left-handed ZR chiral coefficient of charged leptons, Eq. (9)"
  },
  gZRRe == {
