LVRkin := Block[{mu,nu}, ExpandIndices[ -1/2 FS[WRbar,mu,nu] FS[WR,mu,nu] + MWR^2 WRbar[mu] WR[mu] - 1/4 FS[ZR,mu,nu] FS[ZR,mu,nu] + 1/2 MZR^2 ZR[mu] ZR[mu] ]];

LNRkin := Block[{mu,ff}, ExpandIndices[ I/2 NRbar[ff].Ga[mu].del[NR[ff],mu] - 1/2 MNR[ff] NRbar[ff].NR[ff] ]];

LWRq := Block[{mu,ff1,ff2,cc}, ExpandIndices[ -(kqR*gw/Sqrt[2]) VCKMR[ff1,ff2] (uqbar[ff1,cc].Ga[mu].ProjP.dq[ff2,cc]) WR[mu] ]];

LWRl := Block[{mu,ff1,ff2}, ExpandIndices[ -(klR*gw/Sqrt[2]) YLN[ff1,ff2] (NRbar[ff2].Ga[mu].ProjP.l[ff1]) WR[mu] ]];

LZRff := Block[{mu,ff,cc}, ExpandIndices[ gZRq ( uqbar[ff,cc].Ga[mu].(gZRLu ProjM + gZRRu ProjP).uq[ff,cc] + dqbar[ff,cc].Ga[mu].(gZRLd ProjM + gZRRd ProjP).dq[ff,cc] ) ZR[mu] + gZRl ( lbar[ff].Ga[mu].(gZRLe ProjM + gZRRe ProjP).l[ff] + vlbar[ff].Ga[mu].(gZRLv ProjM + gZRRv ProjP).vl[ff] + 1/2 NRbar[ff].Ga[mu].(gZRLn ProjM + gZRRn ProjP).NR[ff] ) ZR[mu] ]];

LEffLRSM := LVRkin + LNRkin + LWRq + HC[LWRq] + LWRl + HC[LWRl] + LZRff;
