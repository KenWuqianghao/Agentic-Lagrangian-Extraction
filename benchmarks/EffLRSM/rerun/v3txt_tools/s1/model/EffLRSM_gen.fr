LWRkin := Block[{mu, nu}, -1/2 FS[WRbar, mu, nu] FS[WR, mu, nu] + MWR^2 WRbar[mu] WR[mu]];

LZRkin := Block[{mu, nu}, -1/4 FS[ZR, mu, nu] FS[ZR, mu, nu] + 1/2 MZR^2 ZR[mu] ZR[mu]];

LNkin := Block[{mu, ff, sp}, ExpandIndices[I/2 NHbar.Ga[mu].del[NH, mu] - 1/2 MNH[ff] NHbar[sp, ff].NH[sp, ff]]];

LWRq := Block[{mu}, ExpandIndices[cWRq uqbar.VCKMR.Ga[mu].ProjP.dq WR[mu]]];

LWRlN := Block[{mu}, ExpandIndices[cWRl NHbar.YNL.Ga[mu].ProjP.l WR[mu]]];

LWRlv := Block[{mu}, ExpandIndices[cWRl lbar.XNL.Ga[mu].ProjP.CC[vl] WRbar[mu]]];

LZRq := Block[{mu}, ExpandIndices[cZRq (gZRuL uqbar.Ga[mu].ProjM.uq + gZRuR uqbar.Ga[mu].ProjP.uq + gZRdL dqbar.Ga[mu].ProjM.dq + gZRdR dqbar.Ga[mu].ProjP.dq) ZR[mu]]];

LZRl := Block[{mu}, ExpandIndices[cZRl (gZReL lbar.Ga[mu].ProjM.l + gZReR lbar.Ga[mu].ProjP.l + gZRvL vlbar.Ga[mu].ProjM.vl) ZR[mu]]];

LZRN := Block[{mu}, ExpandIndices[1/2 cZRl NHbar.Ga[mu].ProjP.NH ZR[mu]]];

LTotal := LWRkin + LZRkin + LNkin + LWRq + HC[LWRq] + LWRlN + HC[LWRlN] + LWRlv + HC[LWRlv] + LZRq + LZRl + LZRN;
