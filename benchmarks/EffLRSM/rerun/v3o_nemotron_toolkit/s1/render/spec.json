  "lagrangian_terms": [
    {
      "name": "LWRkin",
      "expression": "-1/2 FS[WRbar, mu, nu] FS[WR, mu, nu] + MWR^2 WRbar[mu] WR[mu]",
      "delayed": true
    },
    {
      "name": "LZRkin",
      "expression": "-1/4 FS[ZR, mu, nu] FS[ZR, mu, nu] + 1/2 MZR^2 ZR[mu] ZR[mu]",
      "delayed": true
    },
    {
      "name": "LNkin",
      "expression": "I/2 NRbar[ff].Ga[mu].del[NR[ff], mu] - 1/2 NRbar[ff].MN[ff].NR[ff]",
      "delayed": true
    },
    {
      "name": "LWRqq",
      "expression": "-kappaRq*gw/Sqrt[2] * uqbar[ff1, cc].Ga[mu].ProjP.dq[ff2, cc] * VCKMR[ff1, ff2] * WR[mu]",
      "delayed": true
    },
    {
      "name": "LWRll",
      "expression": "-kappaRl*gw/Sqrt[2] * NRbar[ff].Ga[mu].ProjP.l[ff] * WR[mu]",
      "delayed": true
    },
    {
      "name": "LZRff",
      "expression": "normZRq * ( uqbar[ff, cc].Ga[mu].( (-1/6)*tW2/kappaRq^2*ProjM + (-2/3)*tW2/kappaRq^2*ProjP ).uq[ff, cc] + dqbar[ff, cc].Ga[mu].( (-1/6)*tW2/kappaRq^2*ProjM + (1/3)*tW2/kappaRq^2*ProjP ).dq[ff, cc] + uqbar[ff, cc].Ga[mu].( (-2/3)*tW2/kappaRq^2*ProjM + (1/2 - (2/3)*tW2/kappaRq^2)*ProjP ).uq[ff, cc] + dqbar[ff, cc].Ga[mu].( (1/3)*tW2/kappaRq^2*ProjM + (-1/2 + (1/3)*tW2/kappaRq^2)*ProjP ).dq[ff, cc] ) * ZR[mu] + normZRl * ( vlbar[ff].Ga[mu].( (1/2)*tW2/kappaRl^2*ProjM ).vl[ff] + lbar[ff].Ga[mu].( (1/2)*tW2/kappaRl^2*ProjM + tW2/kappaRl^2*ProjP ).l[ff] + NRbar[ff].Ga[mu].( (1/2)*ProjP ).NR[ff] + lbar[ff].Ga[mu].( (-1/2 + tW2/kappaRl^2)*ProjP ).l[ff] ) * ZR[mu]",
      "delayed": true
    },
    {
      "name": "LTotal",
      "expression": "LWRkin + LZRkin + LNkin + LWRqq + HC[LWRqq] + LWRll + HC[LWRll] + LZRff",
      "delayed": true
    }
  ],
