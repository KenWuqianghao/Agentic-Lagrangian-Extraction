LintPhiUChi = phi3[i] * (ahalfSR[ff] * uqbar[ff, i].ProjP.chi + bhalfSR[ff] * uqbar[ff, i].ProjM.chi);

LintPhiTildeDU = eps3[i, j, k] * phitilde[i] * (aqtildeSR[ff1, ff2] * CC[dqbar[ff1, j]].ProjP.uq[ff2, k] + bqtildeSR[ff1, ff2] * CC[dqbar[ff1, j]].ProjM.uq[ff2, k]);

LintPhiTildeDChi = phitilde[i] * (ahalftildeSR[ff] * dqbar[ff, i].ProjP.chi + bhalftildeSR[ff] * dqbar[ff, i].ProjM.chi);

LintXDD = eps3[i, j, k] * X[mu, i] * (aqVR[ff1, ff2] * CC[dqbar[ff1, j]].Ga[mu].ProjP.dq[ff2, k] + bqVR[ff1, ff2] * CC[dqbar[ff1, j]].Ga[mu].ProjM.dq[ff2, k]);

LintXUChi = X[mu, i] * (ahalfVR[ff] * uqbar[ff, i].Ga[mu].ProjP.chi + bhalfVR[ff] * uqbar[ff, i].Ga[mu].ProjM.chi);

LTotal = LphiKin + LchiKin + LVKin + Lphi3Kin + LphitildeKin + LXKin + LintFCNCscalar + HC[LintFCNCscalar] + LintFCNCvector + HC[LintFCNCvector] + LintPhiDD + HC[LintPhiDD] + LintPhiUChi + HC[LintPhiUChi] + LintPhiTildeDU + HC[LintPhiTildeDU] + LintPhiTildeDChi + HC[LintPhiTildeDChi] + LintXDD + HC[LintXDD] + LintXUChi + HC[LintXUChi];
