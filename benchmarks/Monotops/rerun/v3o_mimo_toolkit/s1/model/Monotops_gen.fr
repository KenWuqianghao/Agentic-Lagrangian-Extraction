Lkinphi := DC[phibar, mu] DC[phi, mu] - Mphi^2 phibar phi;

LkinV0 := -1/2 FS[V0bar, mu, nu] FS[V0, mu, nu] + MV0^2 V0bar[mu] V0[mu];

Lkinchi := I chibar.Ga[mu].DC[chi, mu] - Mchi chibar.chi;

Lkinvphi := DC[vphibar, mu] DC[vphi, mu] - Mvphi^2 vphibar vphi;

Lkintvphi := DC[tvphibar, mu] DC[tvphi, mu] - Mtvphi^2 tvphibar tvphi;

LkinX := -1/2 FS[Xbar, mu, nu, cc] FS[X, mu, nu, cc] + MX^2 Xbar[mu,cc] X[mu,cc];

LFC := phi (uqbar.aFC0.uq + uqbar.bFC0.Ga[5].uq) + V0[mu] uqbar.aFC1.Ga[mu].uq + V0[mu] uqbar.bFC1.Ga[mu].Ga[5].uq + HC[phi (uqbar.aFC0.uq + uqbar.bFC0.Ga[5].uq) + V0[mu] uqbar.aFC1.Ga[mu].uq + V0[mmu] uqbar.bFC1.Ga[mmu].Ga[5].uq];

LSR := Eps[cc1,cc2,cc3] vphi[cc1] aqSR[ff1,ff2] bar[CC[dq]][sp,ff1,cc2].dq[sp,ff2,cc3] + Eps[cc1,cc2,cc3] vphi[cc1] bqSR[ff1,ff2] bar[CC[dq]][sp,ff1,cc2].Ga[5].dq[sp,ff2,cc3] + vphi (uqbar.afSR.chi + uqbar.bfSR.Ga[5].chi) + HC[Eps[cc1,cc2,cc3] vphi[cc1] aqSR[ff1,ff2] bar[CC[dq]][sp,ff1,cc2].dq[sp,ff2,cc3] + Eps[cc1,cc2,cc3] vphi[cc1] bqSR[ff1,ff2] bar[CC[dq]][sp,ff1,cc2].Ga[5].dq[sp,ff2,cc3] + vphi (uqbar.afSR.chi + uqbar.bfSR.Ga[5].chi)];

LSRt := Eps[cc1,cc2,cc3] tvphi[cc1] taqSR[ff1,ff2] bar[CC[dq]][sp,ff1,cc2].uq[sp,ff2,cc3] + Eps[cc1,cc2,cc3] tvphi[cc1] tbqSR[ff1,ff2] bar[CC[dq]][sp,ff1,cc2].Ga[5].uq[sp,ff2,cc3] + tvphi (dqbar.tafSR.chi + dqbar.tbfSR.Ga[5].chi) + HC[Eps[cc1,cc2,cc3] tvphi[cc1] taqSR[ff1,ff2] bar[CC[dq]][sp,ff1,cc2].uq[sp,ff2,cc3] + Eps[cc1,cc2,cc3] tvphi[cc1] tbqSR[ff1,ff2] bar[CC[dq]][sp,ff1,cc2].Ga[5].uq[sp,ff2,cc3] + tvphi (dqbar.tafSR.chi + dqbar.tbfSR.Ga[5].chi)];

LVR := Eps[cc1,cc2,cc3] X[mu,cc1] aqVR[ff1,ff2] bar[CC[dq]][sp,ff1,cc2].Ga[mu].dq[sp,ff2,cc3] + Eps[cc1,cc2,cc3] X[mu,cc1] bqVR[ff1,ff2] bar[CC[dq]][sp,ff1,cc2].Ga[mu].Ga[5].dq[sp,ff2,cc3] + X[mu] uqbar.afVR.Ga[mu].chi + X[mu] uqbar.bfVR.Ga[mu].Ga[5].chi + HC[Eps[cc1,cc2,cc3] X[mu,cc1] aqVR[ff1,ff2] bar[CC[dq]][sp,ff1,cc2].Ga[mu].dq[sp,ff2,cc3] + Eps[cc1,cc2,cc3] X[mu,cc1] bqVR[ff1,ff2] bar[CC[dq]][sp,ff1,cc2].Ga[mu].Ga[5].dq[sp,ff2,cc3] + X[mmu] uqbar.afVR.Ga[mmu].chi + X[mmu] uqbar.bfVR.Ga[mmu].Ga[5].chi];

LTotal := Lkinphi + LkinV0 + Lkinchi + Lkinvphi + Lkintvphi + LkinX + LFC + LSR + LSRt + LVR;
