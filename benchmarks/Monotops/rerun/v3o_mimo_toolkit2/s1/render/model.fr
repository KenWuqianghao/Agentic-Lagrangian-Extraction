Lkin_sPhi := DC[sPhibar, mu] DC[sPhi, mu] - Mphi^2 sPhibar sPhi;

Lkin_vVec := -1/2 FS[vVecbar, mu, nu] FS[vVec, mu, nu] + Mvec^2 vVecbar[mu] vVec[mu];

Lkin_fChi := I fChibar.Ga[mu].DC[fChi, mu] - Mchi fChibar.fChi;

Lkin_sVarph := DC[sVarphbar, mu] DC[sVarph, mu] - Mvarphi^2 sVarphbar sVarph;

Lkin_sTvarph := DC[sTvarphbar, mu] DC[sTvarph, mu] - Mtvarphi^2 sTvarphbar sTvarph;

Lkin_vXcol := -1/2 FS[vXcolbar, mu, nu] FS[vXcol, mu, nu] + Mxvec^2 vXcolbar[mu] vXcol[mu];

LphiFC := sPhi (uqbar.a0FC.uq + uqbar.b0FC.Ga[5].uq) + HC[sPhi (uqbar.a0FC.uq + uqbar.b0FC.Ga[5].uq)];

LVFC := vVec[mu] (uqbar.a1FC.Ga[mu].uq + uqbar.b1FC.Ga[mu].Ga[5].uq) + HC[vVec[mu] (uqbar.a1FC.Ga[mu].uq + uqbar.b1FC.Ga[mu].Ga[5].uq)];

Lsvarphq := epsC[cc1,cc2,cc3] sVarph[cc1] aqSR[ff1,ff2] (bar[CC[dq[ff1,cc2]]].dq[ff2,cc3] + bar[CC[dq[ff1,cc2]]].Ga[5].dq[ff2,cc3]) + HC[epsC[cc1,cc2,cc3] sVarph[cc1] aqSR[ff1,ff2] (bar[CC[dq[ff1,cc2]]].dq[ff2,cc3] + bar[CC[dq[ff1,cc2]]].Ga[5].dq[ff2,cc3])];

Lsvarphu := sVarph[cc1] (uqbar[ff1,cc1].fChi aSRu[ff1] + uqbar[ff1,cc1].Ga[5].fChi bSRu[ff1]) + HC[sVarph[cc1] (uqbar[ff1,cc1].fChi aSRu[ff1] + uqbar[ff1,cc1].Ga[5].fChi bSRu[ff1])];

Ltvarphq := epsC[cc1,cc2,cc3] sTvarph[cc1] atqSR[ff1,ff2] (bar[CC[dq[ff1,cc2]]].uq[ff2,cc3] + bar[CC[dq[ff1,cc2]]].Ga[5].uq[ff2,cc3]) + HC[epsC[cc1,cc2,cc3] sTvarph[cc1] atqSR[ff1,ff2] (bar[CC[dq[ff1,cc2]]].uq[ff2,cc3] + bar[CC[dq[ff1,cc2]]].Ga[5].uq[ff2,cc3])];

Ltvarphd := sTvarph[cc1] (dqbar[ff1,cc1].fChi atSRd[ff1] + dqbar[ff1,cc1].Ga[5].fChi btSRd[ff1]) + HC[sTvarph[cc1] (dqbar[ff1,cc1].fChi atSRd[ff1] + dqbar[ff1,cc1].Ga[5].fChi btSRd[ff1])];

Lxq := epsC[cc1,cc2,cc3] vXcol[mu,cc1] aqVR[ff1,ff2] (bar[CC[dq[ff1,cc2]]].Ga[mu].dq[ff2,cc3] + bar[CC[dq[ff1,cc2]]].Ga[mu].Ga[5].dq[ff2,cc3]) + HC[epsC[cc1,cc2,cc3] vXcol[mu,cc1] aqVR[ff1,ff2] (bar[CC[dq[ff1,cc2]]].Ga[mu].dq[ff2,cc3] + bar[CC[dq[ff1,cc2]]].Ga[mu].Ga[5].dq[ff2,cc3])];

Lxu := vXcol[mu,cc1] (uqbar[ff1,cc1].Ga[mu].fChi aVRu[ff1] + uqbar[ff1,cc1].Ga[mu].Ga[5].fChi bVRu[ff1]) + HC[vXcol[mu,cc1] (uqbar[ff1,cc1].Ga[mu].fChi aVRu[ff1] + uqbar[ff1,cc1].Ga[mu].Ga[5].fChi bVRu[ff1])];

LTotal := Lkin_sPhi + Lkin_vVec + Lkin_fChi + Lkin_sVarph + Lkin_sTvarph + Lkin_vXcol + LphiFC + LVFC + Lsvarphq + Lsvarphu + Ltvarphq + Ltvarphd + Lxq + Lxu;
