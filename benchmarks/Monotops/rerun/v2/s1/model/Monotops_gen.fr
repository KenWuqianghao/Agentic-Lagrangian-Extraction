LphivKin := Block[{mu}, 1/2 del[phiv, mu] del[phiv, mu] - 1/2 Mphiv^2 phiv phiv];

LvecvKin := Block[{mu, nu}, -1/4 FS[vecv, mu, nu] FS[vecv, mu, nu] + 1/2 Mvecv^2 vecv[mu] vecv[mu]];

LchiKin := Block[{mu}, I chibar.Ga[mu].del[chi, mu] - Mchi chibar.chi];

LphiresKin := Block[{mu, cc}, DC[phiresbar[cc], mu] DC[phires[cc], mu] - Mphires^2 phiresbar[cc] phires[cc]];

LphitilKin := Block[{mu, cc}, DC[phitilbar[cc], mu] DC[phitil[cc], mu] - Mphitil^2 phitilbar[cc] phitil[cc]];

LxresKin := Block[{mu, nu, cc}, -1/2 (DC[xresbar[nu, cc], mu] - DC[xresbar[mu, cc], nu]) (DC[xres[nu, cc], mu] - DC[xres[mu, cc], nu]) + Mxres^2 xresbar[mu, cc] xres[mu, cc]];

LFC := Block[{mu, ff1, ff2, cc}, phiv (aFC0[ff1, ff2] uqbar[ff1, cc].uq[ff2, cc] + bFC0[ff1, ff2] uqbar[ff1, cc].Ga[5].uq[ff2, cc]) + vecv[mu] (aFC1[ff1, ff2] uqbar[ff1, cc].Ga[mu].uq[ff2, cc] + bFC1[ff1, ff2] uqbar[ff1, cc].Ga[mu].Ga[5].uq[ff2, cc])];

LSRphi := Block[{ff1, ff2, cc1, cc2, cc3}, Eps[cc1, cc2, cc3] phires[cc1] (aqSR[ff1, ff2] CC[dqbar[ff1, cc2]].dq[ff2, cc3] + bqSR[ff1, ff2] CC[dqbar[ff1, cc2]].Ga[5].dq[ff2, cc3]) + phires[cc1] (aSR12[ff1] uqbar[ff1, cc1].chi + bSR12[ff1] uqbar[ff1, cc1].Ga[5].chi)];

LSRphitil := Block[{ff1, ff2, cc1, cc2, cc3}, Eps[cc1, cc2, cc3] phitil[cc1] (aqSRt[ff1, ff2] CC[dqbar[ff1, cc2]].uq[ff2, cc3] + bqSRt[ff1, ff2] CC[dqbar[ff1, cc2]].Ga[5].uq[ff2, cc3]) + phitil[cc1] (aSR12t[ff1] dqbar[ff1, cc1].chi + bSR12t[ff1] dqbar[ff1, cc1].Ga[5].chi)];

LVRX := Block[{mu, ff1, ff2, cc1, cc2, cc3}, Eps[cc1, cc2, cc3] xres[mu, cc1] (aqVR[ff1, ff2] CC[dqbar[ff1, cc2]].Ga[mu].dq[ff2, cc3] + bqVR[ff1, ff2] CC[dqbar[ff1, cc2]].Ga[mu].Ga[5].dq[ff2, cc3]) + xres[mu, cc1] (aVR12[ff1] uqbar[ff1, cc1].Ga[mu].chi + bVR12[ff1] uqbar[ff1, cc1].Ga[mu].Ga[5].chi)];

LKinMT := LphivKin + LvecvKin + LchiKin + LphiresKin + LphitilKin + LxresKin;

LIntMT := LFC + LSRphi + LSRphitil + LVRX;

LMonotop := LKinMT + LIntMT + HC[LIntMT];
