GaugeXi[V[5]] = GaugeXi[Wp];

GaugeXi[V[6]] = GaugeXi[Zp];

GaugeXi[S[4]] = GaugeXi[Zp];

GaugeXi[S[5]] = GaugeXi[Wp];

LWpKin := Block[{mu,nu}, ExpandIndices[-1/2 FS[Wpbar,mu,nu] FS[Wp,mu,nu] + MWp^2 Wpbar[mu] Wp[mu]]];

LZpKin := Block[{mu,nu}, ExpandIndices[-1/4 FS[Zp,mu,nu] FS[Zp,mu,nu] + 1/2 MZp^2 Zp[mu] Zp[mu]]];

LGoldPKin := Block[{mu}, ExpandIndices[del[GpPbar,mu] del[GpP,mu] - MWp^2 GpPbar GpP + 1/2 del[Gp0,mu] del[Gp0,mu] - 1/2 MZp^2 Gp0 Gp0]];

LHeavyKin := Block[{mu}, ExpandIndices[I vlPbar.Ga[mu].DC[vlP,mu] - MF vlPbar.vlP + I lPbar.Ga[mu].DC[lP,mu] - MF lPbar.lP + I uqPbar.Ga[mu].DC[uqP,mu] - MF uqPbar.uqP + I dqPbar.Ga[mu].DC[dqP,mu] - MF dqPbar.dqP]];

LWpff := Block[{mu,sp1,sp2,ff,cc,tmp}, tmp = ExpandIndices[gWpf/Sqrt[2] Wp[mu] (QLbar[sp1,1,ff,cc].Ga[mu,sp1,sp2].QL[sp2,2,ff,cc] + LLbar[sp1,1,ff].Ga[mu,sp1,sp2].LL[sp2,2,ff])]; tmp + HC[tmp]];

LZpff := Block[{mu,sp1,sp2,ff,cc}, ExpandIndices[gZpf/2 Zp[mu] (QLbar[sp1,1,ff,cc].Ga[mu,sp1,sp2].QL[sp2,1,ff,cc] - QLbar[sp1,2,ff,cc].Ga[mu,sp1,sp2].QL[sp2,2,ff,cc] + LLbar[sp1,1,ff].Ga[mu,sp1,sp2].LL[sp2,1,ff] - LLbar[sp1,2,ff].Ga[mu,sp1,sp2].LL[sp2,2,ff])]];

LWpFF := Block[{mu,tmp}, tmp = ExpandIndices[gp1/Sqrt[2] Wp[mu] (uqPbar.Ga[mu].dqP + vlPbar.Ga[mu].lP)]; tmp + HC[tmp]];

LZpFF := Block[{mu}, ExpandIndices[gp1/2 Zp[mu] (uqPbar.Ga[mu].uqP - dqPbar.Ga[mu].dqP + vlPbar.Ga[mu].vlP - lPbar.Ga[mu].lP)]];

LmixCC := Block[{mu,sp1,sp2,ff,cc,tmp}, tmp = ExpandIndices[gWFf/Sqrt[2] W[mu] (uqPbar[sp1,ff,cc].Ga[mu,sp1,sp2].QL[sp2,2,ff,cc] + QLbar[sp1,1,ff,cc].Ga[mu,sp1,sp2].dqP[sp2,ff,cc] + vlPbar[sp1,ff].Ga[mu,sp1,sp2].LL[sp2,2,ff] + LLbar[sp1,1,ff].Ga[mu,sp1,sp2].lP[sp2,ff]) + gWpFf/Sqrt[2] Wp[mu] (uqPbar[sp1,ff,cc].Ga[mu,sp1,sp2].QL[sp2,2,ff,cc] + QLbar[sp1,1,ff,cc].Ga[mu,sp1,sp2].dqP[sp2,ff,cc] + vlPbar[sp1,ff].Ga[mu,sp1,sp2].LL[sp2,2,ff] + LLbar[sp1,1,ff].Ga[mu,sp1,sp2].lP[sp2,ff])]; tmp + HC[tmp]];

LmixNC := Block[{mu,sp1,sp2,ff,cc,tmp}, tmp = ExpandIndices[gZFf Z[mu] (uqPbar[sp1,ff,cc].Ga[mu,sp1,sp2].QL[sp2,1,ff,cc] - dqPbar[sp1,ff,cc].Ga[mu,sp1,sp2].QL[sp2,2,ff,cc] + vlPbar[sp1,ff].Ga[mu,sp1,sp2].LL[sp2,1,ff] - lPbar[sp1,ff].Ga[mu,sp1,sp2].LL[sp2,2,ff]) + gZpFf Zp[mu] (uqPbar[sp1,ff,cc].Ga[mu,sp1,sp2].QL[sp2,1,ff,cc] - dqPbar[sp1,ff,cc].Ga[mu,sp1,sp2].QL[sp2,2,ff,cc] + vlPbar[sp1,ff].Ga[mu,sp1,sp2].LL[sp2,1,ff] - lPbar[sp1,ff].Ga[mu,sp1,sp2].LL[sp2,2,ff])]; tmp + HC[tmp]];

LWWpZ := Block[{mu,nu,tmp}, tmp = ExpandIndices[-I gWWpZ ((FS[Wp,mu,nu] Wbar[mu] - FS[Wbar,mu,nu] Wp[mu]) Z[nu] + FS[Z,mu,nu] Wp[mu] Wbar[nu])]; tmp + HC[tmp]];

LWpWpV := Block[{mu,nu}, ExpandIndices[-I ee ((FS[Wp,mu,nu] Wpbar[mu] - FS[Wpbar,mu,nu] Wp[mu]) A[nu] + FS[A,mu,nu] Wp[mu] Wpbar[nu]) - I gWpWpZ ((FS[Wp,mu,nu] Wpbar[mu] - FS[Wpbar,mu,nu] Wp[mu]) Z[nu] + FS[Z,mu,nu] Wp[mu] Wpbar[nu])]];

LGoldF := Block[{tmp}, tmp = ExpandIndices[-I Sqrt[2] gGpF GpP (uqPbar.ProjP.dqP - uqPbar.ProjM.dqP + vlPbar.ProjP.lP - vlPbar.ProjM.lP)]; tmp + HC[tmp] + ExpandIndices[I gGpF Gp0 (uqPbar.Ga[5].uqP - dqPbar.Ga[5].dqP + vlPbar.Ga[5].vlP - lPbar.Ga[5].lP)]];

LGoldFf := Block[{sp1,sp2,ff,cc,tmp}, tmp = ExpandIndices[-I Sqrt[2] gGpF epsL (GpP (uqPbar[sp1,ff,cc].ProjM[sp1,sp2].QL[sp2,2,ff,cc] + vlPbar[sp1,ff].ProjM[sp1,sp2].LL[sp2,2,ff]) + GpPbar (dqPbar[sp1,ff,cc].ProjM[sp1,sp2].QL[sp2,1,ff,cc] + lPbar[sp1,ff].ProjM[sp1,sp2].LL[sp2,1,ff])) + I gGpF epsL Gp0 (uqPbar[sp1,ff,cc].ProjM[sp1,sp2].QL[sp2,1,ff,cc] - dqPbar[sp1,ff,cc].ProjM[sp1,sp2].QL[sp2,2,ff,cc] + vlPbar[sp1,ff].ProjM[sp1,sp2].LL[sp2,1,ff] - lPbar[sp1,ff].ProjM[sp1,sp2].LL[sp2,2,ff]) - I gGpF (epsRd[ff] GpP uqPbar[sp1,ff,cc].ProjP[sp1,sp2].dR[sp2,ff,cc] + epsRu[ff] GpPbar dqPbar[sp1,ff,cc].ProjP[sp1,sp2].uR[sp2,ff,cc] + epsRl[ff] GpP vlPbar[sp1,ff].ProjP[sp1,sp2].lR[sp2,ff])]; tmp + HC[tmp]];

LMHM := LWpKin + LZpKin + LGoldPKin + LHeavyKin + LWpff + LZpff + LWpFF + LZpFF + LmixCC + LmixNC + LWWpZ + LWpWpV + LGoldF + LGoldFf;

LTot := LSM + LMHM;
