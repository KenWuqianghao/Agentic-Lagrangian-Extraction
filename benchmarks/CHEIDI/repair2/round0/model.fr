LHEIDI::usage = "LHEIDI: HEIDI lagrangian";

LHEIDIgg::usage = "LHEIDIgg[mode]: HEIDI effective scalar-gluon-gluon couplings; mode may be \"heavytop\"";

LHEIDI := (LSM /. {muH -> 0, \[Lambda] -> 0}) /. H -> (Hh[n]*xi[n]);

LHEIDIgg := Block[{fun, piece, tt, mm, hh}, tt[m_] := 4*MT^2/m^2; fun[tau_] := tau*(1 + (1 - tau)*If[NumericalValue[tau] > 1, ArcSin[Sqrt[1/tau]]^2, -1/4*(Log[(1 + Sqrt[1 + tau])/(1 - Sqrt[1 - tau])] - I*Pi)^2]); mm[n_] := Symbol["mhh" <> ToString[n]]; hh[n_] := Symbol["Hh" <> ToString[n]]; piece[n_] := Sqrt[kggh]*gs^2/32/Pi^2/v*fun[tt[mm[n]]]*xi[n]*hh[n]*(del[G[mu, a], nu] - del[G[nu, a], mu])^2; Plus @@ (piece /@ Range[Heidi$nmodes])];

LHEIDIggHeavyTop := Block[{piece, mm, hh}, mm[n_] := Symbol["mhh" <> ToString[n]]; hh[n_] := Symbol["Hh" <> ToString[n]]; piece[n_] := Sqrt[kggh]*gs^2/32/Pi^2/v*(2/3)*xi[n]*hh[n]*(del[G[mu, a], nu] - del[G[nu, a], mu])^2; Plus @@ (piece /@ Range[Heidi$nmodes])];
